[Unit]
Description=SLR Copilot (Node/Express)
After=network.target

[Service]
Type=simple
User=slr
Group=slr
WorkingDirectory=/opt/slr
EnvironmentFile=/etc/slr.env
# 关键:让 Node spawn 出的 claude CLI 能读到 slr 用户的 OAuth 凭证
Environment=HOME=/var/lib/slr/claude-home
# 2026-05-31:全平台时间统一新加坡时间(SGT, +08:00)。Node Date / 日志时间戳跟这个 TZ;
# SQLite datetime('now', '+8 hours') 在 SQL 层独立保证 SGT(存进 DB 的字符串无 TZ 后缀)。
Environment=TZ=Asia/Singapore
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# 资源限制(服务器 1.6G 内存,留余量给 knowledge-share + Claude CLI 子进程)
# B4.8:加 MemoryHigh(soft)— 超过 500M 时 systemd 会 throttle 该 cgroup
# (而不是 OOM kill),让 Node GC 有机会跑;到 MemoryMax=600M 才硬杀。
# 这给 600M 留了 100M 的告警窗口 → systemd journal 里能看到 "memory.high reached"
# 比直接 OOM kill 友好得多,也不会被 systemd Restart=always 死循环重启。
MemoryHigh=500M
MemoryMax=600M
TasksMax=200

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/slr

[Install]
WantedBy=multi-user.target

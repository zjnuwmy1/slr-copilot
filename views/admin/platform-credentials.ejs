<%- include('../partials/header', { title }) %>

<section class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-amber-600">Super Admin</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">平台凭证</h1>
      <p class="mt-1 text-sm text-slate-500">
        所有普通用户(包括非超管的 admin)的 LLM 调用统一走这里设置的凭证 ——
        Claude / Codex 用的是你这套订阅 token,他们无需自己绑定。
      </p>
    </div>
    <a href="/admin" class="text-sm text-slate-500 hover:text-slate-900">← 返回管理后台</a>
  </div>

  <% current.forEach((c) => {
    const providerLabel = c.provider === 'anthropic' ? 'Anthropic (Claude)' : 'OpenAI (Codex / GPT)'
    const options = byProvider[c.provider] || []
  %>
    <div class="rounded-2xl border <%= c.healthy ? 'border-emerald-200 bg-emerald-50/30' : (c.configured ? 'border-amber-200 bg-amber-50/30' : 'border-slate-200 bg-white') %> p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold text-slate-900"><%= providerLabel %></h2>
          <% if (c.healthy) { %>
            <p class="mt-1 text-sm text-emerald-700">
              ✓ 已配置 · 凭证:<span class="font-mono text-xs"><%= c.row.label %></span>
              · 类型:<span class="font-mono text-xs"><%= c.row.auth_type %></span>
            </p>
            <p class="mt-0.5 text-xs text-slate-500">所有用户调用 <%= c.provider %> 时使用本条。</p>
          <% } else if (c.configured) { %>
            <p class="mt-1 text-sm text-amber-700">
              ⚠ 已配置但凭证当前不可用(<%= c.reason %>)
            </p>
          <% } else { %>
            <p class="mt-1 text-sm text-slate-600">尚未配置 —— 普通用户暂时无法调用 <%= c.provider %>。</p>
          <% } %>
        </div>
        <% if (c.configured) { %>
          <form method="post" action="/admin/platform-credentials/<%= c.provider %>/clear"
                onsubmit="return confirm('清除 <%= c.provider %> 平台凭证后,所有普通用户调用 <%= c.provider %> 将失败。继续?')">
            <button type="submit" class="rounded-lg border border-rose-300 px-3 py-1.5 text-sm text-rose-700 hover:bg-rose-50 transition">
              清除
            </button>
          </form>
        <% } %>
      </div>

      <% if (options.length === 0) { %>
        <div class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white/60 p-4 text-sm text-slate-500">
          你的账号下还没有 <%= c.provider %> 的 active 凭证。
          先去 <a href="/account/credentials" class="text-slate-900 underline hover:no-underline">凭证页面</a>
          绑定一个(API key 或 OAuth 订阅都行),然后回来设置。
        </div>
      <% } else { %>
        <form method="post" action="/admin/platform-credentials/<%= c.provider %>/set" class="mt-4">
          <p class="text-xs font-medium uppercase text-slate-400">选一条作为平台共享凭证</p>
          <div class="mt-2 space-y-1.5">
            <% options.forEach((opt) => { %>
              <label class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 hover:border-slate-400 transition cursor-pointer">
                <input type="radio" name="credential_id" value="<%= opt.id %>" required
                       <%= (c.row && c.row.id === opt.id) ? 'checked' : '' %>>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-slate-800 truncate"><%= opt.label %></p>
                  <p class="text-[11px] text-slate-500">
                    <%= opt.auth_type %> · 绑定 <%= opt.created_at %>
                    <% if (opt.last_used_at) { %>· 最近使用 <%= opt.last_used_at %><% } %>
                  </p>
                </div>
                <span class="text-[11px] font-mono text-slate-400"><%= opt.id.slice(0, 12) %>…</span>
              </label>
            <% }) %>
          </div>
          <div class="mt-3 flex justify-end">
            <button type="submit" class="rounded-lg bg-slate-900 px-4 py-1.5 text-sm text-white hover:bg-slate-700 transition">
              设为平台凭证
            </button>
          </div>
        </form>
      <% } %>
    </div>
  <% }) %>

  <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 text-xs text-slate-600">
    <p class="font-medium text-slate-700">说明</p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <li>本页设置只有你(超级管理员)可见。</li>
      <li>设置后,所有非超管用户的 LLM 调用都自动走这套凭证 —— 他们不需要自己绑定。</li>
      <li>超管自己调用 LLM 时也走平台凭证(就是你这套),保持账本一致。</li>
      <li>清除某个 provider 的凭证后,所有用户对该 provider 的调用会立即返回 no_platform_credential 提示。</li>
      <li>如果你把当前选中的凭证在 <a href="/account/credentials" class="underline">凭证页</a> 删除或撤销了,本页也会同步显示为"不可用"。</li>
    </ul>
  </div>
</section>

<%- include('../partials/footer') %>

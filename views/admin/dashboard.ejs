<%- include('../partials/header', { title }) %>

<%
// 项目总数:在 EJS 里直接算,避免改 Agent A 的 dashboard handler
let projectCount = 0
try {
  const dbRef = (typeof req !== 'undefined' && req && req.app && req.app.locals && req.app.locals.db) ? req.app.locals.db : null
  if (dbRef) {
    projectCount = dbRef.prepare('SELECT COUNT(*) AS c FROM projects').get().c || 0
  }
} catch (_) { projectCount = 0 }
%>

<section class="space-y-6">
  <div>
    <p class="text-xs font-medium uppercase tracking-wider <%= user.is_super_admin ? 'text-purple-600' : 'text-amber-600' %>">
      <%= user.is_super_admin ? 'Super Admin' : 'Admin' %>
    </p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight">管理后台</h1>
    <p class="mt-1 text-sm text-slate-500">欢迎,<%= user.display_name || user.email %></p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">总用户</p>
      <p class="mt-2 text-2xl font-semibold"><%= stats.userCount %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">活跃用户</p>
      <p class="mt-2 text-2xl font-semibold"><%= stats.activeCount %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">未使用邀请码</p>
      <p class="mt-2 text-2xl font-semibold"><%= stats.inviteCount %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">项目总数</p>
      <p class="mt-2 text-2xl font-semibold"><%= projectCount %></p>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <a
      href="/admin/users"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">用户管理</p>
      <p class="mt-1 text-xs text-slate-500">查看、邀请、停启、改角色、设配额</p>
    </a>
    <a
      href="/admin/projects"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">全部项目</p>
      <p class="mt-1 text-xs text-slate-500">只读查看所有用户的项目(支持 / 审计用途)</p>
    </a>
    <a
      href="/admin/usage"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">使用记录</p>
      <p class="mt-1 text-xs text-slate-500">查看所有用户的 LLM 调用 / 耗时 / 错误</p>
    </a>
    <a
      href="/admin/usage/by-user-model"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">用量 · 用户 × 模型</p>
      <p class="mt-1 text-xs text-slate-500">按用户和模型聚合的 token 用量矩阵(7/30/90 天)</p>
    </a>
    <a
      href="/admin/audit"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">审计日志</p>
      <p class="mt-1 text-xs text-slate-500">登录 / 注册 / 凭证 / 角色等敏感事件</p>
    </a>
    <% if (user.is_super_admin) { %>
      <a
        href="/admin/step-presets"
        class="block rounded-xl border-2 border-blue-300 bg-blue-50/40 p-5 transition hover:border-blue-500 hover:shadow-sm"
      >
        <p class="text-base font-semibold text-blue-900">⭐ Plan 配置(3 套预设)</p>
        <p class="mt-1 text-xs text-blue-700">编辑 高性能 / 平衡 / 经济 各自的 step × 模型 × reasoning</p>
      </a>
    <% } %>
    <a
      href="/admin/settings"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">旧版步骤模型(全局)</p>
      <p class="mt-1 text-xs text-slate-500">老的全局 step_model 配置(已被 Plan 系统取代,作 fallback 保留)</p>
    </a>
    <a
      href="/admin/storage"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">储存空间</p>
      <p class="mt-1 text-xs text-slate-500">磁盘 / DB / 项目占用 + 孤儿清理</p>
    </a>
    <% if (user.is_super_admin) { %>
      <a
        href="/admin/platform-credentials"
        class="block rounded-xl border border-purple-200 bg-purple-50/30 p-5 transition hover:border-purple-400 hover:shadow-sm"
      >
        <p class="text-base font-semibold text-purple-900">平台凭证</p>
        <p class="mt-1 text-xs text-purple-700">配置所有用户共享的 Claude / Codex token</p>
      </a>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>

<%- include('../partials/header', { title }) %>

<%
// 项目总数:在 EJS 里直接算,避免改 Agent A 的 dashboard handler
let projectCount = 0
try {
  const dbRef = (typeof req !== 'undefined' && req && req.app && req.app.locals && req.app.locals.db) ? req.app.locals.db : null
  if (dbRef) {
    projectCount = dbRef.prepare('SELECT COUNT(*) AS c FROM projects').get().c || 0
  }
} catch (_) { projectCount = 0 }
%>

<section class="space-y-6">
  <div>
    <p class="text-xs font-medium uppercase tracking-wider <%= user.is_super_admin ? 'text-purple-600' : 'text-amber-600' %>">
      <%= user.is_super_admin ? 'Super Admin' : 'Admin' %>
    </p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight">管理后台</h1>
    <p class="mt-1 text-sm text-slate-500">欢迎,<%= user.display_name || user.email %></p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">总用户</p>
      <p class="mt-2 text-2xl font-semibold"><%= stats.userCount %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">活跃用户</p>
      <p class="mt-2 text-2xl font-semibold"><%= stats.activeCount %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">未使用邀请码</p>
      <p class="mt-2 text-2xl font-semibold"><%= stats.inviteCount %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase text-slate-400">项目总数</p>
      <p class="mt-2 text-2xl font-semibold"><%= projectCount %></p>
    </div>
  </div>

  <!-- === 运行健康 widget === -->
  <div class="grid gap-4 sm:grid-cols-1 lg:grid-cols-2">
    <!-- 近 24h LLM 错误 -->
    <%
      const errTotal = (typeof llmErrors24h !== 'undefined' && llmErrors24h) ? (llmErrors24h.total || 0) : 0
      const errByStatus = (typeof llmErrors24h !== 'undefined' && llmErrors24h && Array.isArray(llmErrors24h.byStatus)) ? llmErrors24h.byStatus : []
      const errAccent = errTotal === 0 ? 'border-emerald-200 bg-emerald-50/40' : (errTotal < 10 ? 'border-amber-200 bg-amber-50/40' : 'border-rose-200 bg-rose-50/40')
      const errNumCls = errTotal === 0 ? 'text-emerald-700' : (errTotal < 10 ? 'text-amber-700' : 'text-rose-700')
    %>
    <a href="/admin/usage" class="block rounded-xl border <%= errAccent %> p-5 transition hover:shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium uppercase text-slate-500">近 24h LLM 错误</p>
          <p class="mt-2 text-3xl font-semibold <%= errNumCls %>"><%= errTotal %></p>
        </div>
        <span class="rounded-full bg-white/60 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-500">usage_logs</span>
      </div>
      <% if (errByStatus.length === 0) { %>
        <p class="mt-3 text-xs text-slate-500">过去 24 小时无失败记录。</p>
      <% } else { %>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <% errByStatus.forEach(s => {
               const cls = s.status === 'rate_limited' ? 'bg-amber-100 text-amber-700'
                         : s.status === 'quota_exceeded' ? 'bg-purple-100 text-purple-700'
                         : s.status === 'timeout' ? 'bg-blue-100 text-blue-700'
                         : 'bg-rose-100 text-rose-700' %>
            <span class="rounded-full <%= cls %> px-2 py-0.5 text-[11px]"><%= s.status %> · <%= s.c %></span>
          <% }) %>
        </div>
      <% } %>
    </a>

    <!-- 各 plan 用户数 -->
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium uppercase text-slate-400">各 Plan 活跃用户</p>
          <p class="mt-1 text-xs text-slate-500">NULL 折叠到默认 preset</p>
        </div>
        <a href="/admin/step-presets" class="text-[11px] text-blue-600 hover:underline">配置</a>
      </div>
      <% if (!presetCounts || presetCounts.length === 0) { %>
        <p class="mt-3 text-xs text-slate-400">暂无 preset 数据</p>
      <% } else { %>
        <%
          const totalP = presetCounts.reduce((s, p) => s + (p.count || 0), 0) || 1
        %>
        <div class="mt-3 space-y-2">
          <% presetCounts.forEach(p => {
               const pct = Math.round((p.count / totalP) * 100)
               const barCls = p.id === 'performance' ? 'bg-purple-500'
                            : p.id === 'balanced'    ? 'bg-blue-500'
                            : p.id === 'economy'     ? 'bg-emerald-500'
                            : 'bg-slate-400' %>
            <div>
              <div class="flex items-baseline justify-between text-xs">
                <span class="text-slate-700">
                  <%= p.label %>
                  <% if (p.isDefault) { %><span class="ml-1 rounded bg-slate-100 px-1 py-0.5 text-[10px] text-slate-500">默认</span><% } %>
                </span>
                <span class="font-mono text-slate-500"><%= p.count %> · <%= pct %>%</span>
              </div>
              <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
                <div class="h-full <%= barCls %>" style="width: <%= pct %>%"></div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- 进行中批量任务(占位) -->
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50/60 p-5">
      <p class="text-xs font-medium uppercase text-slate-400">进行中批量任务</p>
      <p class="mt-2 text-2xl font-semibold text-slate-300">—</p>
      <p class="mt-2 text-xs text-slate-500">等批量任务表(batch_jobs)上线后展示。</p>
    </div>

    <!-- 磁盘 + DB 大小 -->
    <a href="/admin/storage" class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium uppercase text-slate-400">储存占用</p>
          <% if (storageSummary) { %>
            <p class="mt-2 text-2xl font-semibold text-slate-800"><%= storageSummary.totalLabel %></p>
          <% } else { %>
            <p class="mt-2 text-2xl font-semibold text-slate-300">—</p>
          <% } %>
        </div>
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-500">total</span>
      </div>
      <% if (storageSummary) { %>
        <dl class="mt-3 grid grid-cols-3 gap-2 text-[11px]">
          <div>
            <dt class="text-slate-400">DB</dt>
            <dd class="font-mono text-slate-700"><%= storageSummary.dbLabel %></dd>
          </div>
          <div>
            <dt class="text-slate-400">上传</dt>
            <dd class="font-mono text-slate-700"><%= storageSummary.uploadsLabel %></dd>
          </div>
          <div>
            <dt class="text-slate-400">用户 HOME</dt>
            <dd class="font-mono text-slate-700"><%= storageSummary.userHomesLabel %></dd>
          </div>
        </dl>
      <% } else { %>
        <p class="mt-3 text-xs text-slate-400">读取储存信息失败。</p>
      <% } %>
    </a>
  </div>

  <!-- === 未处理密码重置请求(B4.5,MVP 无邮件,超管手工转发) === -->
  <%
    const resets = (typeof pendingResets !== 'undefined' && Array.isArray(pendingResets)) ? pendingResets : []
  %>
  <% if (resets.length > 0) { %>
    <div class="rounded-xl border-2 border-amber-300 bg-amber-50/60">
      <div class="flex items-center justify-between border-b border-amber-200 px-5 py-3">
        <div>
          <p class="text-sm font-semibold text-amber-900">
            <span class="mr-1">!</span>未处理的密码重置请求
            <span class="ml-2 rounded-full bg-amber-200 px-2 py-0.5 text-[11px] font-mono text-amber-900"><%= resets.length %></span>
          </p>
          <p class="text-xs text-amber-700">把对应链接转给用户(15 分钟内有效,用过即失效)</p>
        </div>
      </div>
      <ul class="divide-y divide-amber-100">
        <% resets.forEach(r => {
             // 构造完整可分享链接 — 用请求 host(超管在哪个域名打开 dashboard 就用哪个)
             const host = (req && req.get) ? (req.get('host') || '') : ''
             const proto = (req && req.protocol) ? req.protocol : 'https'
             const link = host ? (proto + '://' + host + '/reset-password/' + r.token) : ('/reset-password/' + r.token)
        %>
          <li class="space-y-2 px-5 py-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate font-medium text-slate-800"><%= r.email %></p>
                <p class="text-xs text-slate-500">
                  申请于 <%- include('../partials/_time', { value: r.created_at }) %>
                  <% if (r.requested_ip) { %> · IP <span class="font-mono"><%= r.requested_ip %></span><% } %>
                  · 过期于 <%- include('../partials/_time', { value: r.expires_at, mono: true }) %>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="text"
                readonly
                value="<%= link %>"
                class="flex-1 rounded border border-amber-200 bg-white px-2 py-1 font-mono text-xs text-slate-700"
                onclick="this.select()"
              >
              <button
                type="button"
                class="shrink-0 rounded bg-amber-600 px-3 py-1 text-xs font-medium text-white hover:bg-amber-700"
                onclick="navigator.clipboard.writeText(this.previousElementSibling.value).then(() => { this.textContent = '已复制'; setTimeout(() => this.textContent = '复制链接', 1500) })"
              >
                复制链接
              </button>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- === 最近 audit event === -->
  <div class="rounded-xl border border-slate-200 bg-white">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
      <div>
        <p class="text-sm font-semibold text-slate-800">最近活动</p>
        <p class="text-xs text-slate-500">最新 10 条 audit 事件</p>
      </div>
      <a href="/admin/audit" class="text-xs text-blue-600 hover:underline">查看全部 →</a>
    </div>
    <% if (!recentAudit || recentAudit.length === 0) { %>
      <p class="px-5 py-6 text-center text-xs text-slate-400">暂无 audit 事件</p>
    <% } else { %>
      <ul class="divide-y divide-slate-100">
        <% recentAudit.forEach(r => {
             const isError = /fail|error|deactivated|revoke|timeout/.test(r.event_type)
             const isAdmin = /admin|role|quota|invite|preset/.test(r.event_type)
             const badgeCls = isError ? 'bg-rose-100 text-rose-700'
                            : isAdmin ? 'bg-amber-100 text-amber-700'
                            : 'bg-slate-100 text-slate-700'
             const who = r.user_email || r.actor_email || (r.user_id ? r.user_id.slice(0, 12) + '…' : '系统') %>
          <li class="flex items-center justify-between gap-3 px-5 py-2.5 text-sm">
            <div class="flex min-w-0 items-center gap-3">
              <span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] <%= badgeCls %>"><%= r.event_type %></span>
              <span class="truncate text-xs text-slate-600"><%= who %></span>
              <% if (r.target_email && r.target_email !== r.user_email) { %>
                <span class="truncate text-xs text-slate-400">→ <%= r.target_email %></span>
              <% } %>
            </div>
            <span class="shrink-0 text-[11px] text-slate-400"><%- include('../partials/_time', { value: r.created_at, mono: true }) %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <a
      href="/admin/users"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">用户管理</p>
      <p class="mt-1 text-xs text-slate-500">查看、邀请、停启、改角色、设配额</p>
    </a>
    <a
      href="/admin/projects"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">全部项目</p>
      <p class="mt-1 text-xs text-slate-500">只读查看所有用户的项目(支持 / 审计用途)</p>
    </a>
    <a
      href="/admin/usage"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">使用记录</p>
      <p class="mt-1 text-xs text-slate-500">查看所有用户的 LLM 调用 / 耗时 / 错误</p>
    </a>
    <a
      href="/admin/usage/by-user-model"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">用量 · 用户 × 模型</p>
      <p class="mt-1 text-xs text-slate-500">按用户和模型聚合的 token 用量矩阵(7/30/90 天)</p>
    </a>
    <a
      href="/admin/audit"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">审计日志</p>
      <p class="mt-1 text-xs text-slate-500">登录 / 注册 / 凭证 / 角色等敏感事件</p>
    </a>
    <% if (user.is_super_admin) { %>
      <a
        href="/admin/step-presets"
        class="block rounded-xl border-2 border-blue-300 bg-blue-50/40 p-5 transition hover:border-blue-500 hover:shadow-sm"
      >
        <p class="text-base font-semibold text-blue-900">⭐ Plan 配置(3 套预设)</p>
        <p class="mt-1 text-xs text-blue-700">编辑 高性能 / 平衡 / 经济 各自的 step × 模型 × reasoning</p>
      </a>
    <% } %>
    <a
      href="/admin/settings"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">旧版步骤模型(全局)</p>
      <p class="mt-1 text-xs text-slate-500">老的全局 step_model 配置(已被 Plan 系统取代,作 fallback 保留)</p>
    </a>
    <a
      href="/admin/storage"
      class="block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
    >
      <p class="text-base font-semibold text-slate-800">储存空间</p>
      <p class="mt-1 text-xs text-slate-500">磁盘 / DB / 项目占用 + 孤儿清理</p>
    </a>
    <% if (user.is_super_admin) { %>
      <a
        href="/admin/platform-credentials"
        class="block rounded-xl border border-purple-200 bg-purple-50/30 p-5 transition hover:border-purple-400 hover:shadow-sm"
      >
        <p class="text-base font-semibold text-purple-900">平台凭证</p>
        <p class="mt-1 text-xs text-purple-700">配置所有用户共享的 Claude / Codex token</p>
      </a>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>

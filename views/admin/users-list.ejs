<%- include('../partials/header', { title }) %>

<%
// 项目数:每个用户的 project_count(在 EJS 注入,不改 Agent A 的 handler)
let projectCountByUser = new Map()
try {
  const dbRef = (typeof req !== 'undefined' && req && req.app && req.app.locals && req.app.locals.db) ? req.app.locals.db : null
  if (dbRef) {
    const counts = dbRef.prepare('SELECT user_id, COUNT(*) AS c FROM projects GROUP BY user_id').all()
    for (const r of counts) projectCountByUser.set(r.user_id, r.c)
  }
} catch (_) { /* keep empty map */ }
%>

<section class="space-y-6">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-amber-600">Admin</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">用户管理</h1>
      <p class="mt-1 text-sm text-slate-500">共 <%= users.length %> 个账号</p>
    </div>
    <a
      href="/admin/users/new"
      class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
    >+ 生成邀请码</a>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3 text-left font-medium">邮箱</th>
          <th class="px-4 py-3 text-left font-medium">显示名</th>
          <th class="px-4 py-3 text-left font-medium">角色</th>
          <th class="px-4 py-3 text-left font-medium">状态</th>
          <th class="px-4 py-3 text-left font-medium">Plan(模型方案)</th>
          <th class="px-4 py-3 text-left font-medium">创建</th>
          <th class="px-4 py-3 text-left font-medium">最后登录</th>
          <th class="px-4 py-3 text-right font-medium">项目</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% users.forEach(function(u) { %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium text-slate-800"><%= u.email %></td>
            <td class="px-4 py-3 text-slate-600"><%= u.display_name || '—' %></td>
            <td class="px-4 py-3">
              <% if (u.is_super_admin) { %>
                <span class="rounded bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">SUPER ADMIN</span>
              <% } else if (u.role === 'admin') { %>
                <span class="rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">ADMIN</span>
              <% } else { %>
                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">user</span>
              <% } %>
            </td>
            <td class="px-4 py-3">
              <% if (u.is_active) { %>
                <span class="inline-flex items-center gap-1 text-xs text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> active
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 text-xs text-slate-500">
                  <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span> inactive
                </span>
              <% } %>
            </td>
            <td class="px-4 py-3">
              <%
                const effective = u.step_model_preset || defaultPresetId
                const presetColors = {
                  performance: 'bg-rose-100 text-rose-700',
                  balanced:    'bg-blue-100 text-blue-700',
                  economy:     'bg-emerald-100 text-emerald-700',
                }
                const presetLabels = {
                  performance: '高性能', balanced: '平衡', economy: '经济',
                }
                const isExplicit = !!u.step_model_preset
              %>
              <% if (user && user.is_super_admin) { %>
                <!-- 超管:下拉 + 自动提交 -->
                <form method="post" action="/admin/users/<%= encodeURIComponent(u.id) %>/preset" class="inline-flex items-center gap-1">
                  <select name="preset"
                          onchange="this.form.submit()"
                          class="rounded border <%= isExplicit ? 'border-slate-400' : 'border-slate-200' %> bg-white px-2 py-0.5 text-xs">
                    <option value="" <%= !isExplicit ? 'selected' : '' %>>跟随默认(<%= presetLabels[defaultPresetId] || defaultPresetId %>)</option>
                    <% presetIds.forEach(function(p) { %>
                      <option value="<%= p %>" <%= u.step_model_preset === p ? 'selected' : '' %>><%= presetLabels[p] || p %></option>
                    <% }) %>
                  </select>
                </form>
              <% } else { %>
                <!-- 普通管理员:只读 -->
                <span class="rounded px-1.5 py-0.5 text-xs font-medium <%= presetColors[effective] || 'bg-slate-100 text-slate-600' %>">
                  <%= presetLabels[effective] || effective %><% if (!isExplicit) { %> <span class="text-[10px] opacity-60">(默认)</span><% } %>
                </span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= u.created_at %></td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= u.last_login_at || '—' %></td>
            <td class="px-4 py-3 text-right font-mono text-xs text-slate-700">
              <% const pc = projectCountByUser.get(u.id) || 0 %>
              <% if (pc > 0) { %>
                <a href="/admin/users/<%= encodeURIComponent(u.id) %>/projects" class="underline hover:text-slate-900"><%= pc %></a>
              <% } else { %>
                <span class="text-slate-400">0</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-right">
              <a href="/admin/users/<%= encodeURIComponent(u.id) %>" class="text-xs text-slate-700 underline hover:text-slate-900">详情</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (invites && invites.length) { %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-base font-semibold text-slate-800">未使用的邀请码</h2>
      <p class="mt-1 text-xs text-slate-500">共 <%= invites.length %> 个(最多显示 20)</p>
      <ul class="mt-4 divide-y divide-slate-100 text-sm">
        <% invites.forEach(function(inv) {
             const isAdminInvite = inv.preset_role === 'admin'
             const canDelete = !isAdminInvite || (user && user.is_super_admin)
        %>
          <li class="flex items-center justify-between gap-4 py-2.5">
            <div class="flex items-center gap-3 min-w-0">
              <code class="rounded bg-slate-100 px-2 py-1 font-mono text-sm tracking-wider"><%= inv.code %></code>
              <% if (isAdminInvite) { %>
                <span class="rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">ADMIN</span>
              <% } else { %>
                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">user</span>
              <% } %>
              <% if (inv.note) { %>
                <span class="truncate text-xs text-slate-500"><%= inv.note %></span>
              <% } %>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs text-slate-500">
                <% if (inv.expires_at) { %>过期:<%= inv.expires_at %><% } else { %>永不过期<% } %>
              </span>
              <button type="button"
                      onclick="navigator.clipboard.writeText(location.origin + '/register?code=' + '<%= inv.code %>').then(()=>{this.textContent='✓ 已复制';setTimeout(()=>this.textContent='复制链接',1200)})"
                      class="rounded-md border border-slate-200 px-2 py-1 text-[11px] text-slate-600 hover:bg-slate-50 transition">
                复制链接
              </button>
              <% if (canDelete) { %>
                <form method="post" action="/admin/users/invites/<%= encodeURIComponent(inv.code) %>/delete" class="inline"
                      onsubmit="return confirm('删除邀请码 <%= inv.code %>?该链接将立即失效。')">
                  <button type="submit"
                          class="rounded-md border border-rose-200 px-2 py-1 text-[11px] text-rose-600 hover:bg-rose-50 hover:border-rose-300 transition">
                    删除
                  </button>
                </form>
              <% } else { %>
                <span class="rounded-md border border-slate-200 px-2 py-1 text-[11px] text-slate-400" title="仅超级管理员可删除">删除</span>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>

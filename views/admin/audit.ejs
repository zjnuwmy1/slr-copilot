<%- include('../partials/header', { title }) %>

<section class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-amber-600">Admin · Audit</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">审计日志</h1>
      <p class="mt-1 text-sm text-slate-500">登录、注册、邀请、凭证绑定、角色变更等所有敏感事件。</p>
    </div>
    <a href="/admin" class="text-sm text-slate-500 hover:text-slate-900">← 返回管理后台</a>
  </div>

  <form method="get" action="/admin/audit" class="grid gap-3 rounded-xl border border-slate-200 bg-white p-4 sm:grid-cols-4">
    <input name="user" value="<%= filters.user %>" placeholder="用户邮箱或 ID(模糊)" class="rounded-md border-slate-300 px-3 py-1.5 text-sm" />
    <select name="event" class="rounded-md border-slate-300 px-3 py-1.5 text-sm">
      <option value="">全部事件</option>
      <% eventTypes.forEach(t => { %>
        <option value="<%= t %>" <%= filters.event === t ? 'selected' : '' %>><%= t %></option>
      <% }) %>
    </select>
    <input name="since" type="date" value="<%= filters.since %>" class="rounded-md border-slate-300 px-3 py-1.5 text-sm" />
    <button type="submit" class="rounded-md bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-700">过滤</button>
  </form>

  <% if (rows.length === 0) { %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white/60 p-10 text-center text-sm text-slate-500">
      暂无匹配的审计事件。
    </div>
  <% } else { %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
      <table class="min-w-full text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2">#</th>
            <th class="px-4 py-2">时间</th>
            <th class="px-4 py-2">事件</th>
            <th class="px-4 py-2">用户</th>
            <th class="px-4 py-2">操作者</th>
            <th class="px-4 py-2">目标</th>
            <th class="px-4 py-2">详情</th>
            <th class="px-4 py-2">IP</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% rows.forEach(r => { %>
            <tr>
              <td class="px-4 py-2 font-mono text-xs text-slate-400"><%= r.id %></td>
              <td class="px-4 py-2 text-xs text-slate-500"><%- include('../partials/_time', { value: r.created_at, mono: true }) %></td>
              <td class="px-4 py-2">
                <% const isError = /fail|error|deactivated|revoke|timeout/.test(r.event_type) %>
                <% const isAdmin = /admin|role|quota|invite/.test(r.event_type) %>
                <span class="rounded-full px-2 py-0.5 text-xs <%= isError ? 'bg-rose-100 text-rose-700' : isAdmin ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-700' %>">
                  <%= r.event_type %>
                </span>
              </td>
              <td class="px-4 py-2 text-xs"><%= r.user_email || (r.user_id ? r.user_id.slice(0, 12) + '…' : '—') %></td>
              <td class="px-4 py-2 text-xs"><%= r.actor_email || (r.actor_user_id ? r.actor_user_id.slice(0, 12) + '…' : '—') %></td>
              <td class="px-4 py-2 text-xs"><%= r.target_email || (r.target_user_id ? r.target_user_id.slice(0, 12) + '…' : '—') %></td>
              <td class="px-4 py-2 max-w-md">
                <% if (r.payloadParsed) { %>
                  <details>
                    <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-900">查看</summary>
                    <pre class="mt-1 max-h-48 overflow-auto rounded bg-slate-50 p-2 text-[10px]"><%= JSON.stringify(r.payloadParsed, null, 2) %></pre>
                  </details>
                <% } else { %>
                  <span class="text-slate-400">—</span>
                <% } %>
              </td>
              <td class="px-4 py-2 font-mono text-xs text-slate-400"><%= r.ip_address || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-slate-400">显示最近 <%= rows.length %> 条(上限 <%= filters.limit %>)</p>
  <% } %>
</section>

<%- include('../partials/footer') %>

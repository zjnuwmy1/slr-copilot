<%- include('../partials/header', { title }) %>

<section class="mx-auto max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold tracking-tight">重置密码</h1>
    <% if (!invalid) { %>
      <p class="mt-1 text-sm text-slate-500">请输入新密码,设置后旧密码立即失效</p>
    <% } %>

    <% if (error) { %>
      <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-800">
        <%= error %>
      </div>
    <% } %>

    <% if (invalid) { %>
      <div class="mt-6 space-y-3 text-center">
        <p class="text-sm text-slate-600">链接无法使用。可能原因:已过期(15 分钟)、已被使用,或链接错误。</p>
        <a
          href="/forgot-password"
          class="inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
        >
          重新申请
        </a>
        <p class="text-xs text-slate-500">
          或 <a href="/login" class="underline hover:text-slate-900">返回登录</a>
        </p>
      </div>
    <% } else { %>
      <form action="/reset-password/<%= token %>" method="post" class="mt-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700">新密码</label>
          <input
            type="password"
            name="password"
            required
            minlength="10"
            autocomplete="new-password"
            autofocus
            class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
          <p class="mt-1 text-xs text-slate-500">至少 10 位</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700">确认新密码</label>
          <input
            type="password"
            name="password_confirm"
            required
            minlength="10"
            autocomplete="new-password"
            class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>
        <button
          type="submit"
          class="w-full rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
        >
          设置新密码
        </button>
      </form>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>

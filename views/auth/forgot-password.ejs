<%- include('../partials/header', { title }) %>

<section class="mx-auto max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold tracking-tight">忘记密码</h1>
    <p class="mt-1 text-sm text-slate-500">填写注册邮箱,系统会生成一次性重置链接</p>

    <% if (error) { %>
      <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-800">
        <%= error %>
      </div>
    <% } %>

    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
      MVP 阶段尚未开放邮件发送。生成链接后,请联系超级管理员获取你的重置链接。
    </div>

    <form action="/forgot-password" method="post" class="mt-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700">邮箱</label>
        <input
          type="email"
          name="email"
          value="<%= email %>"
          required
          autocomplete="email"
          autofocus
          class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>
      <button
        type="submit"
        class="w-full rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
      >
        申请重置链接
      </button>
    </form>

    <p class="mt-6 text-center text-xs text-slate-500">
      想起来了?<a href="/login" class="text-slate-700 underline hover:text-slate-900">返回登录</a>
    </p>
  </div>
</section>

<%- include('../partials/footer') %>

<%- include('../../partials/header', { title }) %>

<section class="mx-auto max-w-2xl">
  <div class="rounded-2xl border border-rose-200 bg-white p-8 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-rose-600">
      绑定失败<%= session.state === 'timeout' ? '(超时)' : '' %>
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">
      <%= session.provider === 'anthropic' ? 'Claude' : 'Codex' %> 绑定未完成
    </h1>
    <% if (session.error_message) { %>
      <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-mono text-rose-800">
        <%= session.error_message %>
      </div>
    <% } %>

    <ul class="mt-5 list-disc space-y-1 pl-5 text-sm text-slate-600">
      <li>检查授权 URL 是否在 5 分钟内完成了 Anthropic / OpenAI 那一侧的授权</li>
      <li>检查粘贴的 code 是否完整(不要带前后空白)</li>
      <li>本地开发请确认 <code>CLAUDE_BIN</code> 或 <code>CODEX_BIN</code> 指向真实可执行文件,或设为 <code>mock</code> 走假流程</li>
      <li>如多次失败,把 <code>audit_events</code> 表里 <code>oauth_bind_failed</code> 的 payload 拿给 admin 看</li>
    </ul>

    <div class="mt-6 flex gap-3">
      <a
        href="/account/oauth/start?provider=<%= session.provider %>"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
      >重试</a>
      <a
        href="/account/credentials"
        class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-700 hover:bg-slate-100"
      >返回凭证</a>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>

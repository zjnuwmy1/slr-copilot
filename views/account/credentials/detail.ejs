<%- include('../../partials/header', { title }) %>

<%
  function statusBadge(status) {
    const map = {
      active:  { cls: 'bg-emerald-100 text-emerald-700 border-emerald-200', label: 'active' },
      expired: { cls: 'bg-amber-100 text-amber-700 border-amber-200',       label: 'expired' },
      revoked: { cls: 'bg-slate-100 text-slate-600 border-slate-200',       label: 'revoked' },
      error:   { cls: 'bg-red-100 text-red-700 border-red-200',             label: 'error' },
    }
    return map[status] || { cls: 'bg-slate-100 text-slate-600 border-slate-200', label: status || 'unknown' }
  }
  function providerLabel(p) {
    if (p === 'anthropic') return 'Anthropic'
    if (p === 'openai') return 'OpenAI'
    return p
  }
  function authTypeLabel(t) {
    if (t === 'api_key') return 'API key'
    if (t === 'oauth') return 'OAuth 订阅'
    return t
  }
  var b = statusBadge(cred.status)
%>

<section class="space-y-6">
  <div>
    <a href="/account/credentials" class="text-xs text-slate-500 hover:text-slate-900">&larr; 返回凭证列表</a>
    <div class="mt-2 flex items-center gap-3">
      <h1 class="text-2xl font-semibold tracking-tight"><%= cred.label %></h1>
      <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium <%= b.cls %>">
        <%= b.label %>
      </span>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <dl class="grid grid-cols-1 gap-x-6 gap-y-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">Provider</dt>
        <dd class="mt-1 text-slate-900"><%= providerLabel(cred.provider) %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">类型</dt>
        <dd class="mt-1 text-slate-900"><%= authTypeLabel(cred.auth_type) %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">凭证 ID</dt>
        <dd class="mt-1 break-all font-mono text-xs text-slate-700"><%= cred.id %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">状态</dt>
        <dd class="mt-1">
          <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium <%= b.cls %>">
            <%= b.label %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">创建时间</dt>
        <dd class="mt-1 text-slate-900"><%= cred.created_at || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">最近测活</dt>
        <dd class="mt-1 text-slate-900"><%= cred.last_validated_at || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">最近使用</dt>
        <dd class="mt-1 text-slate-900"><%= cred.last_used_at || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">最近错误</dt>
        <dd class="mt-1 break-all text-slate-900">
          <% if (cred.last_validation_error) { %>
            <code class="rounded bg-red-50 px-1.5 py-0.5 text-xs text-red-700"><%= cred.last_validation_error %></code>
          <% } else { %>
            —
          <% } %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="flex flex-wrap gap-2">
    <% if (cred.auth_type === 'api_key' && cred.status !== 'revoked') { %>
      <form action="/account/credentials/<%= encodeURIComponent(cred.id) %>/retest" method="post" class="inline">
        <button type="submit"
                class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          重新测活
        </button>
      </form>
    <% } %>
    <% if (cred.status !== 'revoked') { %>
      <form action="/account/credentials/<%= encodeURIComponent(cred.id) %>/revoke" method="post"
            onsubmit="return confirm('确定撤销凭证 “<%= cred.label.replace(/'/g, "\\'") %>” 吗?该操作不可恢复。')"
            class="inline">
        <button type="submit"
                class="rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50">
          撤销
        </button>
      </form>
    <% } else { %>
      <span class="text-xs text-slate-500">该凭证已撤销,如需重新使用请添加新凭证。</span>
    <% } %>
  </div>
</section>

<%- include('../../partials/footer') %>

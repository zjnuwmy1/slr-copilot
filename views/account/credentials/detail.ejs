<%- include('../../partials/header', { title }) %>

<%
  function statusBadge(status) {
    const map = {
      active:  { cls: 'bg-emerald-100 text-emerald-700 border-emerald-200', label: 'active' },
      expired: { cls: 'bg-amber-100 text-amber-700 border-amber-200',       label: 'expired' },
      revoked: { cls: 'bg-slate-100 text-slate-600 border-slate-200',       label: 'revoked' },
      error:   { cls: 'bg-red-100 text-red-700 border-red-200',             label: 'error' },
    }
    return map[status] || { cls: 'bg-slate-100 text-slate-600 border-slate-200', label: status || 'unknown' }
  }
  function providerLabel(p) {
    if (p === 'anthropic') return 'Anthropic'
    if (p === 'openai') return 'OpenAI'
    return p
  }
  function authTypeLabel(t) {
    if (t === 'api_key') return 'API key'
    if (t === 'oauth') return 'OAuth 订阅'
    return t
  }
  var b = statusBadge(cred.status)
%>

<section class="space-y-6">
  <div>
    <a href="/account/credentials" class="text-xs text-slate-500 hover:text-slate-900">&larr; 返回凭证列表</a>
    <div class="mt-2 flex items-center gap-3">
      <h1 class="text-2xl font-semibold tracking-tight"><%= cred.label %></h1>
      <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium <%= b.cls %>">
        <%= b.label %>
      </span>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <dl class="grid grid-cols-1 gap-x-6 gap-y-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">Provider</dt>
        <dd class="mt-1 text-slate-900"><%= providerLabel(cred.provider) %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">类型</dt>
        <dd class="mt-1 text-slate-900"><%= authTypeLabel(cred.auth_type) %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">凭证 ID</dt>
        <dd class="mt-1 break-all font-mono text-xs text-slate-700"><%= cred.id %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">状态</dt>
        <dd class="mt-1">
          <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium <%= b.cls %>">
            <%= b.label %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">创建时间</dt>
        <dd class="mt-1 text-slate-900"><%= cred.created_at || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">最近测活</dt>
        <dd class="mt-1 text-slate-900"><%= cred.last_validated_at || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">最近使用</dt>
        <dd class="mt-1 text-slate-900"><%= cred.last_used_at || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-slate-400">最近错误</dt>
        <dd class="mt-1 break-all text-slate-900">
          <% if (cred.last_validation_error) { %>
            <code class="rounded bg-red-50 px-1.5 py-0.5 text-xs text-red-700"><%= cred.last_validation_error %></code>
          <% } else { %>
            —
          <% } %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="flex flex-wrap gap-2">
    <% if (cred.auth_type === 'api_key' && cred.status !== 'revoked') { %>
      <form action="/account/credentials/<%= encodeURIComponent(cred.id) %>/retest" method="post" class="inline">
        <button type="submit"
                class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          重新测活
        </button>
      </form>
    <% } %>
    <% if (cred.status !== 'revoked') { %>
      <form action="/account/credentials/<%= encodeURIComponent(cred.id) %>/revoke" method="post"
            onsubmit="return confirm('确定撤销凭证 “<%= cred.label.replace(/'/g, "\\'") %>” 吗?该操作不可恢复。')"
            class="inline">
        <button type="submit"
                class="rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50">
          撤销
        </button>
      </form>
    <% } else { %>
      <span class="text-xs text-slate-500">该凭证已撤销,如需重新使用请添加新凭证。</span>
    <% } %>
  </div>
</section>

<!-- ============================ 凭证共享 ============================ -->
<% if (cred.status === 'active') { %>
<section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-semibold text-slate-900">凭证共享</h2>
      <p class="mt-1 text-sm text-slate-500">把这条凭证共享给其他用户使用。被共享方在自己没绑凭证时会回落到这条。</p>
    </div>
    <% if (typeof shares !== 'undefined' && shares.length > 0) { %>
      <span class="rounded-full bg-emerald-100 px-3 py-0.5 text-xs text-emerald-700">已共享给 <%= shares.length %> 人</span>
    <% } else { %>
      <span class="rounded-full bg-slate-100 px-3 py-0.5 text-xs text-slate-600">未共享</span>
    <% } %>
  </div>

  <form action="/account/credentials/<%= encodeURIComponent(cred.id) %>/share" method="post"
        class="mt-5 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
    <input type="email" name="target_email" required
           placeholder="对方注册邮箱(必须已在平台注册)"
           class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none" />
    <input type="text" name="notes" maxlength="500"
           placeholder="备注(可选,如 “项目 X 团队”)"
           class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none" />
    <button type="submit"
            class="rounded-md bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">
      共享
    </button>
  </form>

  <% if (typeof shares !== 'undefined' && shares.length > 0) { %>
    <div class="mt-5 overflow-hidden rounded-lg border border-slate-200">
      <table class="min-w-full text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2">用户</th>
            <th class="px-4 py-2">备注</th>
            <th class="px-4 py-2">共享时间</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% shares.forEach(s => { %>
            <tr>
              <td class="px-4 py-2">
                <%= s.display_name || s.email %>
                <% if (s.display_name) { %><span class="text-xs text-slate-400"> · <%= s.email %></span><% } %>
                <% if (!s.is_active) { %><span class="ml-2 rounded bg-red-100 px-1.5 py-0.5 text-[10px] text-red-700">已停用</span><% } %>
              </td>
              <td class="px-4 py-2 text-slate-600 text-xs"><%= s.notes || '—' %></td>
              <td class="px-4 py-2 font-mono text-xs text-slate-500"><%= s.created_at %></td>
              <td class="px-4 py-2 text-right">
                <form method="post" action="/account/credentials/<%= encodeURIComponent(cred.id) %>/unshare/<%= encodeURIComponent(s.user_id) %>"
                      onsubmit="return confirm('确定取消对 ' + '<%= s.email %>' + ' 的共享?')"
                      class="inline">
                  <button type="submit" class="rounded-md border border-slate-200 px-2 py-1 text-xs text-red-700 hover:bg-red-50">
                    取消共享
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <p class="mt-3 text-xs text-slate-400">
    ⚠️ 共享后,对方调用 LLM 时<strong>使用的是你绑定的订阅/额度</strong>,但他们各自的配额(daily_call_limit / monthly_token_limit)仍按各自的 user_quotas 算。请确认对方可信。
  </p>
</section>
<% } %>

<%- include('../../partials/footer') %>

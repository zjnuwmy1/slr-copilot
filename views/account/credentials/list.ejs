<%- include('../../partials/header', { title }) %>

<%
  function statusBadge(status) {
    const map = {
      active:  { cls: 'bg-emerald-100 text-emerald-700 border-emerald-200', label: 'active' },
      expired: { cls: 'bg-amber-100 text-amber-700 border-amber-200',       label: 'expired' },
      revoked: { cls: 'bg-slate-100 text-slate-600 border-slate-200',       label: 'revoked' },
      error:   { cls: 'bg-red-100 text-red-700 border-red-200',             label: 'error' },
    }
    return map[status] || { cls: 'bg-slate-100 text-slate-600 border-slate-200', label: status || 'unknown' }
  }
  function providerLabel(p) {
    if (p === 'anthropic') return 'Anthropic'
    if (p === 'openai') return 'OpenAI'
    return p
  }
  function authTypeLabel(t) {
    if (t === 'api_key') return 'API key'
    if (t === 'oauth') return 'OAuth 订阅'
    return t
  }
%>

<section class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">凭证</h1>
      <% if (isSuperAdmin) { %>
        <p class="mt-1 text-sm text-slate-600">
          作为超级管理员,你在这里管理的凭证既是你自己的,也用于
          <a href="/admin/platform-credentials" class="text-slate-900 underline hover:no-underline">平台共享给所有用户</a>
          的 Claude / Codex 调用。
        </p>
      <% } else { %>
        <p class="mt-1 text-sm text-slate-600">
          本平台的 LLM 调用统一使用超级管理员配置的 Claude / Codex token,
          <strong>你无需自行绑定</strong>。
        </p>
      <% } %>
    </div>
    <% if (isSuperAdmin) { %>
      <div class="flex shrink-0 gap-2">
        <a href="/account/credentials/new?type=api_key"
           class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
          + 添加 API Key 凭证
        </a>
        <a href="/account/credentials/new?type=oauth"
           class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50">
          绑定订阅(OAuth)
        </a>
      </div>
    <% } %>
  </div>

  <!-- 平台凭证状态摘要(所有用户都能看到) -->
  <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-5">
    <h2 class="text-xs font-medium uppercase tracking-wider text-slate-500">平台凭证状态</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <% platformCreds.forEach((pc) => {
           const label = pc.provider === 'anthropic' ? 'Anthropic (Claude)' : 'OpenAI (Codex / GPT)'
      %>
        <div class="rounded-xl border <%= pc.healthy ? 'border-emerald-200 bg-white' : 'border-slate-200 bg-white/60' %> px-4 py-3">
          <p class="text-sm font-medium text-slate-800"><%= label %></p>
          <% if (pc.healthy) { %>
            <p class="mt-0.5 text-xs text-emerald-700">✓ 可用 · 凭证:<%= pc.row.label %> · <%= pc.row.auth_type %></p>
          <% } else if (pc.configured) { %>
            <p class="mt-0.5 text-xs text-amber-700">⚠ 已配置但暂不可用,请联系超级管理员</p>
          <% } else { %>
            <p class="mt-0.5 text-xs text-slate-500">尚未配置 —— 联系超级管理员开通</p>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <% if (!isSuperAdmin) {
       // 普通用户:不显示个人凭证管理界面 — 平台已经替你配置好了
  %>
    <div class="rounded-2xl border border-dashed border-slate-200 bg-white/60 p-8 text-center">
      <p class="text-sm text-slate-600">
        平台凭证已由超级管理员统一配置,你的所有 LLM 调用都会走平台账号。<br>
        <span class="text-xs text-slate-400">如果你看到模型调用失败,请联系超级管理员检查上方"平台凭证状态"。</span>
      </p>
    </div>
  <% } else if (!credentials || credentials.length === 0) { %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white/60 p-10 text-center">
      <h2 class="text-base font-semibold text-slate-800">还没有任何凭证</h2>
      <p class="mt-2 text-sm text-slate-600">
        添加一个 Anthropic 或 OpenAI 的 API key,SLR Copilot 才能代你调用 LLM。<br>
        如果你已经付费订阅了 Claude / ChatGPT,也可以走 OAuth 流绑定订阅(无需 API key)。
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/account/credentials/new?type=api_key"
           class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
          粘贴 API Key
        </a>
        <a href="/account/credentials/new?type=oauth"
           class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          绑定订阅
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-4 py-3">Label</th>
            <th class="px-4 py-3">Provider</th>
            <th class="px-4 py-3">类型</th>
            <th class="px-4 py-3">状态</th>
            <th class="px-4 py-3">最近测活</th>
            <th class="px-4 py-3">创建时间</th>
            <th class="px-4 py-3 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% credentials.forEach(function(c) { var b = statusBadge(c.status); %>
            <tr>
              <td class="px-4 py-3 font-medium text-slate-900">
                <a href="/account/credentials/<%= encodeURIComponent(c.id) %>" class="hover:underline">
                  <%= c.label %>
                </a>
              </td>
              <td class="px-4 py-3 text-slate-700"><%= providerLabel(c.provider) %></td>
              <td class="px-4 py-3 text-slate-700"><%= authTypeLabel(c.auth_type) %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium <%= b.cls %>">
                  <%= b.label %>
                </span>
              </td>
              <td class="px-4 py-3 text-slate-600">
                <%= c.last_validated_at || '—' %>
              </td>
              <td class="px-4 py-3 text-slate-600"><%= c.created_at %></td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <% if (c.auth_type === 'api_key' && c.status !== 'revoked') { %>
                    <form action="/account/credentials/<%= encodeURIComponent(c.id) %>/retest" method="post" class="inline">
                      <button type="submit"
                              class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs text-slate-700 hover:border-slate-400 hover:bg-slate-50">
                        重新测活
                      </button>
                    </form>
                  <% } %>
                  <% if (c.status !== 'revoked') { %>
                    <form action="/account/credentials/<%= encodeURIComponent(c.id) %>/revoke" method="post"
                          onsubmit="return confirm('确定撤销凭证 “<%= c.label.replace(/'/g, "\\'") %>” 吗?该操作不可恢复。')"
                          class="inline">
                      <button type="submit"
                              class="rounded-md border border-red-200 bg-white px-2.5 py-1 text-xs text-red-700 hover:bg-red-50">
                        撤销
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <!-- =============== 共享给我的凭证(仅超管自己绑/被共享时显示) =============== -->
  <% if (isSuperAdmin && typeof sharedWithMe !== 'undefined' && sharedWithMe.length > 0) { %>
    <div class="mt-8">
      <div class="flex items-center gap-2">
        <h2 class="text-base font-semibold text-slate-900">共享给我</h2>
        <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs text-blue-700"><%= sharedWithMe.length %> 条</span>
      </div>
      <p class="mt-1 text-xs text-slate-500">其他用户共享给你的凭证。你没自己绑凭证时,LLM 调用会回落到这些(优先级低于你自己的)。</p>

      <div class="mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white">
        <table class="min-w-full text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase text-slate-500">
            <tr>
              <th class="px-4 py-2">标签</th>
              <th class="px-4 py-2">Provider</th>
              <th class="px-4 py-2">共享方</th>
              <th class="px-4 py-2">备注</th>
              <th class="px-4 py-2">状态</th>
              <th class="px-4 py-2">共享时间</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% sharedWithMe.forEach(s => { %>
              <tr>
                <td class="px-4 py-2 font-medium"><%= s.label %></td>
                <td class="px-4 py-2 text-slate-600"><%= s.provider %> / <%= s.auth_type %></td>
                <td class="px-4 py-2 text-slate-600 text-xs"><%= s.owner_email %></td>
                <td class="px-4 py-2 text-slate-500 text-xs"><%= s.notes || '—' %></td>
                <td class="px-4 py-2">
                  <% const sc = s.status === 'active' ? 'bg-emerald-100 text-emerald-700' :
                                  s.status === 'revoked' ? 'bg-slate-100 text-slate-600' :
                                  s.status === 'expired' ? 'bg-amber-100 text-amber-700' :
                                  'bg-red-100 text-red-700' %>
                  <span class="rounded-full px-2 py-0.5 text-xs <%= sc %>"><%= s.status %></span>
                </td>
                <td class="px-4 py-2 font-mono text-xs text-slate-500"><%= s.shared_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white/60 p-5 text-xs text-slate-500">
    <p class="font-medium text-slate-700">安全说明</p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <li>API key 经 AES-256-GCM 加密后存放,平台不会以明文显示。</li>
      <li>"撤销"会立刻停用,不会删除审计记录。</li>
      <li>如需切换 key,建议先撤销旧的再添加新的,便于审计追溯。</li>
      <li>把凭证共享给别人后,对方调用用的是你的订阅/额度;随时可在凭证详情页取消。</li>
    </ul>
  </div>
</section>

<%- include('../../partials/footer') %>

<%- include('../partials/header', { title }) %>

<div class="mx-auto max-w-4xl px-4 py-6">
  <header class="mb-6">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">账户偏好</p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">模型方案</h1>
    <p class="mt-1 text-sm text-slate-600">
      选一套预设,影响你后续所有项目的 AI 调用(协议生成 / 检索式 / 初筛 / 抽取 / 综合 / 写作)。
      系统默认 = <strong><%= defaultId %></strong>;你当前生效 = <strong><%= effectiveId %></strong>
      <%= userExplicitChoice ? '(自选)' : '(跟随默认)' %>。
    </p>
  </header>

  <form method="post" action="/account/preferences" class="space-y-4">
    <!-- 跟随系统默认 -->
    <label class="block rounded-2xl border-2 <%= userExplicitChoice == null ? 'border-blue-500 bg-blue-50/40' : 'border-slate-200 bg-white' %> p-5 cursor-pointer hover:border-blue-400">
      <div class="flex items-start gap-3">
        <input type="radio" name="preset" value="" <%= userExplicitChoice == null ? 'checked' : '' %> class="mt-1" />
        <div class="flex-1">
          <p class="font-medium text-slate-900">跟随系统默认</p>
          <p class="mt-1 text-sm text-slate-600">超管选的默认预设(当前 = <strong><%= defaultId %></strong>)。超管未来改方案时自动跟随。</p>
        </div>
      </div>
    </label>

    <!-- 3 套预设 -->
    <% presets.forEach(function(p) { %>
      <label class="block rounded-2xl border-2 <%= userExplicitChoice === p.id ? 'border-blue-500 bg-blue-50/40' : 'border-slate-200 bg-white' %> p-5 cursor-pointer hover:border-blue-400">
        <div class="flex items-start gap-3">
          <input type="radio" name="preset" value="<%= p.id %>" <%= userExplicitChoice === p.id ? 'checked' : '' %> class="mt-1" />
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <p class="font-medium text-slate-900"><%= p.label %></p>
              <% if (p.id === defaultId) { %><span class="rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-medium text-emerald-700">系统默认</span><% } %>
            </div>
            <p class="mt-1 text-sm text-slate-600"><%= p.description %></p>

            <!-- 摘要表:仅显示模型 -->
            <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-xs sm:grid-cols-3">
              <% stepKeys.forEach(function(step) {
                   const m = p.config?.step_model?.[step] || '(默认 tier)'
              %>
                <div class="flex items-center justify-between border-b border-slate-100 pb-1">
                  <span class="text-slate-500"><%= stepSpecs[step].label.split(' (')[0] %></span>
                  <span class="font-mono text-[10px] text-slate-700"><%= m.replace('claude-', '').replace('gpt-', 'gpt') %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </label>
    <% }) %>

    <div class="flex justify-end pt-4">
      <button type="submit" class="rounded-lg bg-slate-900 px-5 py-2 text-sm text-white hover:bg-slate-700">
        保存选择
      </button>
    </div>
  </form>

  <p class="mt-6 text-xs text-slate-500">
    提示:每个预设的具体配置由超管在 <a href="/admin/step-presets" class="text-blue-700 underline">/admin/step-presets</a> 维护(普通用户无权访问)。
  </p>
</div>

<%- include('../partials/footer') %>

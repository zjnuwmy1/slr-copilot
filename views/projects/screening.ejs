<%- include('../partials/header', { title }) %>
<%- include('partials/project-header', { project }) %>

<%
  // ===== helpers =====
  function escAttr(v) { return v == null ? '' : String(v) }
  function aiBadge(s) {
    return ({
      include:   ['bg-emerald-100 text-emerald-700', '建议纳入'],
      exclude:   ['bg-rose-100 text-rose-700',       '建议排除'],
      uncertain: ['bg-amber-100 text-amber-800',     '不确定'],
      not_run:   ['bg-slate-100 text-slate-500',     '未跑'],
    })[s] || ['bg-slate-100 text-slate-500', s]
  }
  function humanBadge(s) {
    return ({
      include:     ['bg-emerald-600 text-white',  '纳入'],
      exclude:     ['bg-rose-600 text-white',     '排除'],
      uncertain:   ['bg-amber-500 text-white',    '不确定'],
      not_decided: ['bg-slate-200 text-slate-600','未决定'],
    })[s] || ['bg-slate-200 text-slate-600', s]
  }
  const filterBase = `/projects/${project.id}/screening`
  // 旧 filterHref:只切 ai / human chip。新版用 buildHref(从路由传下来)保留所有过滤参数
  function filterHref(opts) {
    if (typeof buildHref === 'function') {
      // 用路由的 buildHref:保留 q / 年份 / PDF / DOI / 多语言等
      return buildHref(opts || {})
    }
    // fallback(老路由,只支持 ai/human)
    const params = new URLSearchParams()
    const ai = opts && Object.prototype.hasOwnProperty.call(opts, 'ai') ? opts.ai : filterAi
    const hu = opts && Object.prototype.hasOwnProperty.call(opts, 'human') ? opts.human : filterHuman
    if (ai)  params.set('ai', ai)
    if (hu)  params.set('human', hu)
    const qs = params.toString()
    return qs ? `${filterBase}?${qs}` : filterBase
  }

  // 全部过滤合并的"是否有过滤"判定
  const ff = (typeof filters === 'object' && filters) ? filters : {}
  const hasAnyFilter = !!(filterAi || filterHuman || ff.q || ff.year_from || ff.year_to
                          || ff.has_pdf || ff.has_doi || ff.only_multi_language || ff.only_non_english)
  const yearRangeView = (typeof yearRange === 'object' && yearRange) ? yearRange : { min_year: null, max_year: null }
%>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress: progress || { stepStatus: {}, prismaProgress: { donePct: 0, done: 0, total: 42 } }, currentStep: 'screening' }) %>

  <section class="space-y-6 min-w-0">
    <%- include('partials/step-banner', {
      stepNum: 3,
      stepTitle: '题录筛选',
      stepIntro: 'AI 依据您的纳排标准,对每篇文献的标题与摘要给出"纳入 / 排除 / 待定"建议;最终决定由您作出。本步骤滤除大量不相关文献,后续仅对"纳入"文献进行全文细读。',
      prismaItems: '#9a Selection process · #16a Study selection · #16b Reasons for exclusion',
    }) %>

    <!-- 顶部操作栏 — 手动新增 / 文献导出 / CSV log / 一键清空 -->
    <div class="flex flex-wrap items-center justify-end gap-2">
      <a href="/projects/<%= project.id %>/records/new"
         class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-3 py-2 text-sm text-white hover:bg-slate-700">
        <span aria-hidden="true">+</span> 手动新增
      </a>

      <!-- 文献元数据导出 -->
      <div class="relative" data-export-menu>
        <button type="button"
                aria-haspopup="true" aria-expanded="false"
                onclick="(function(b){var m=b.parentNode.querySelector('[data-export-list]');var open=m.classList.toggle('hidden')===false;b.setAttribute('aria-expanded', open?'true':'false');})(this)"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
          导出文献 <span aria-hidden="true" class="text-xs">▾</span>
        </button>
        <div data-export-list
             class="absolute right-0 z-10 mt-1 hidden w-56 rounded-lg border border-slate-200 bg-white shadow-lg">
          <a href="/projects/<%= project.id %>/records.bib" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">BibTeX (.bib)</a>
          <a href="/projects/<%= project.id %>/records.ris" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">RIS (.ris)</a>
          <a href="/projects/<%= project.id %>/records.csl.json" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">CSL JSON</a>
          <div class="border-t border-slate-100 px-3 py-1.5 text-[10px] font-medium uppercase tracking-wider text-slate-400">References Markdown</div>
          <a href="/projects/<%= project.id %>/records.refs.md?style=apa" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">APA</a>
          <a href="/projects/<%= project.id %>/records.refs.md?style=ieee" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">IEEE</a>
          <a href="/projects/<%= project.id %>/records.refs.md?style=gb_t_7714" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">GB/T 7714</a>
          <a href="/projects/<%= project.id %>/records.refs.md?style=chicago" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">Chicago</a>
          <a href="/projects/<%= project.id %>/records.refs.md?style=mla" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">MLA</a>
        </div>
      </div>

      <a href="<%= filterBase %>/export.csv"
         class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-100">
        导出筛选 CSV
      </a>

      <!-- 一键清空(红底,二次确认走 /records/clear-pool) -->
      <% if (stats.total > 0) { %>
        <a href="/projects/<%= project.id %>/records/clear-pool"
           class="inline-flex items-center gap-1 rounded-lg border border-rose-300 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-100"
           title="清空全部论文 + AI 筛选 / 抽取记录(需在确认页输入 CLEAR)">
          🗑 一键清空论文池
        </a>
      <% } %>
    </div>

    <script>
      // 点空白处收起导出下拉
      document.addEventListener('click', function (e) {
        document.querySelectorAll('[data-export-menu]').forEach(function (m) {
          if (!m.contains(e.target)) {
            var l = m.querySelector('[data-export-list]')
            if (l && !l.classList.contains('hidden')) l.classList.add('hidden')
            var b = m.querySelector('button[aria-expanded]')
            if (b) b.setAttribute('aria-expanded', 'false')
          }
        })
      })
    </script>

    <!-- 协议状态 -->
    <% if (!protocol) { %>
      <%
        // 区分两种 "无 protocol":
        //   A. 完全没生成 → 引导生成
        //   B. 生成了但没审批 → 引导审批
        const stepProto = (progress && progress.stepStatus && progress.stepStatus.protocol) || {}
        const hasUnapproved = stepProto.status === 'in_progress'
      %>
      <div class="rounded-2xl border-2 border-amber-300 bg-amber-50 p-5">
        <div class="flex items-start gap-3">
          <span class="text-2xl flex-none" aria-hidden="true">⚠</span>
          <div class="min-w-0 flex-1">
            <p class="text-base font-semibold text-amber-900">
              <% if (hasUnapproved) { %>
                还没审批研究方案,无法初筛
              <% } else { %>
                还没生成研究方案,无法初筛
              <% } %>
            </p>
            <p class="mt-1 text-sm text-amber-800">
              <% if (hasUnapproved) { %>
                AI 初筛必须依据<strong>已审批</strong>的纳排标准。
                现有协议草稿还在待审批状态 — 请回 Step 1,审阅后点击「审批」让 v1 生效。
              <% } else { %>
                AI 初筛会逐篇拿你的纳入/排除标准去判断 — 没协议就没法跑。
                请先回 Step 1,让 Claude 起草一份研究方案,再人工审批。
              <% } %>
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a href="/projects/<%= project.id %>/protocol"
                 class="inline-flex items-center rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-500 shadow-sm">
                → 回 Step 1 <%= hasUnapproved ? '审批协议' : '生成协议' %>
              </a>
              <span class="text-xs text-amber-700 self-center">
                <% if (hasUnapproved) { %>(协议已生成,只差审批一步)<% } else { %>(生成约需 1-3 分钟)<% } %>
              </span>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4">
        <p class="text-sm font-medium text-emerald-900">已基于协议 v<%= protocol.version %> 进行筛选</p>
        <p class="mt-0.5 text-xs text-emerald-800">
          纳入标准 <%= (protocol.inclusion_criteria || []).length %> 条 ·
          排除标准 <%= (protocol.exclusion_criteria || []).length %> 条
        </p>
      </div>
    <% } %>

    <!-- 统计卡 4 个 -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-slate-400">总条数</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900"><%= stats.total %></p>
        <p class="mt-0.5 text-[11px] text-slate-400">已去重</p>
      </div>
      <div class="rounded-xl border border-blue-100 bg-blue-50/40 p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-blue-700">AI 已建议</p>
        <p class="mt-1 text-2xl font-semibold text-blue-900"><%= stats.ai_done %></p>
        <p class="mt-0.5 text-[11px] text-blue-700/80">
          纳 <%= stats.ai_include %> · 排 <%= stats.ai_exclude %> · 疑 <%= stats.ai_uncertain %>
        </p>
      </div>
      <div class="rounded-xl border border-emerald-100 bg-emerald-50/40 p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-emerald-700">人工已决</p>
        <p class="mt-1 text-2xl font-semibold text-emerald-900"><%= stats.human_done %></p>
        <p class="mt-0.5 text-[11px] text-emerald-700/80">
          纳 <%= stats.human_include %> · 排 <%= stats.human_exclude %> · 疑 <%= stats.human_uncertain %>
        </p>
      </div>
      <div class="rounded-xl border border-amber-100 bg-amber-50/40 p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-amber-700">待决定</p>
        <p class="mt-1 text-2xl font-semibold text-amber-900"><%= stats.human_pending %></p>
        <p class="mt-0.5 text-[11px] text-amber-700/80">还有 <%= stats.ai_pending %> 条未跑 AI</p>
      </div>
    </div>

    <!-- 自动 callout:当真实纳入率偏低时建议复盘 -->
    <%
      const decided = (stats.human_include || 0) + (stats.human_exclude || 0) + (stats.human_uncertain || 0)
      const includeRate = decided > 0 ? (stats.human_include / decided) : null
      const showIterationHint = decided >= 30 && includeRate != null && includeRate < 0.1
    %>
    <% if (showIterationHint) { %>
      <div class="rounded-2xl border-2 border-purple-300 bg-purple-50/50 p-5">
        <div class="flex items-start gap-4">
          <span class="text-2xl">🔄</span>
          <div class="min-w-0 flex-1">
            <p class="text-base font-semibold text-purple-900">真实纳入率偏低 — 要不要让 AI 复盘前面的工作?</p>
            <p class="mt-1 text-sm text-purple-800">
              你已决定 <%= decided %> 条,其中纳入率 <strong><%= (includeRate * 100).toFixed(1) %>%</strong>。
              通常 SLR title/abstract 的纳入率 10–25% 是健康范围;低于 10% 多半说明
              <strong>协议 / 概念组 / 检索式</strong> 与你真实研究意图错位。
            </p>
            <p class="mt-2 text-xs text-purple-700">
              复盘时 AI 会综合你的协议 + 检索式 + 命中数 + 实际排除原因(包括你写的 reason),
              用旗舰模型 + 高思考诊断问题、给一份优化后的协议 v_next 让你审批。
            </p>
            <div class="mt-3 flex gap-2">
              <a href="/projects/<%= project.id %>/iterate"
                 class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white hover:bg-purple-500">
                让 AI 复盘 →
              </a>
              <span class="rounded-lg border border-purple-200 px-3 py-2 text-xs text-purple-700">
                也可以继续筛选,这个提示不会强制阻止你
              </span>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- 批量运行 + 进度 -->
    <% if (protocol) { %>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 space-y-3">
        <!-- 目标通过率配置 -->
        <%
          const tgtPct = (typeof targetIncludePct === 'number') ? targetIncludePct : null
          const actPct = (typeof actualIncludePct === 'number') ? actualIncludePct : null
        %>
        <div class="rounded-lg border border-blue-100 bg-blue-50/50 p-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-sm font-medium text-blue-900">🎯 目标通过率(软目标,影响 AI 对边缘 case 的判断)</p>
            <% if (actPct != null) { %>
              <span class="text-xs text-blue-700">
                当前实际:<strong><%= actPct %>%</strong>
                <% if (tgtPct != null) { %>
                  <span class="<%= (Math.abs(actPct - tgtPct) <= 5) ? 'text-emerald-700' : 'text-amber-700' %>">
                    (目标 <%= tgtPct %>%,差 <%= actPct - tgtPct >= 0 ? '+' : '' %><%= actPct - tgtPct %>)
                  </span>
                <% } %>
              </span>
            <% } %>
          </div>
          <form method="post" action="<%= filterBase %>/target" id="target-form"
                class="mt-2 flex flex-wrap items-end gap-2">
            <div>
              <label for="target-pct-input" class="block text-[11px] text-slate-500">目标 %(留空 = 不设)</label>
              <input id="target-pct-input" type="number" name="target_include_pct"
                     min="0" max="100" step="1"
                     value="<%= tgtPct != null ? tgtPct : '' %>"
                     placeholder="如 20"
                     class="mt-0.5 w-24 rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-blue-500 focus:outline-none" />
            </div>
            <button type="submit" class="rounded-md bg-blue-600 px-3 py-1 text-xs text-white hover:bg-blue-500">保存</button>
            <button type="button" id="ai-suggest-btn"
                    class="rounded-md border border-blue-300 bg-white px-3 py-1 text-xs text-blue-700 hover:bg-blue-50 disabled:opacity-60">
              🤖 让 AI 根据协议推荐
            </button>
            <span id="ai-suggest-result" class="text-xs text-slate-600"></span>
          </form>
          <p class="mt-2 text-[11px] text-slate-500 leading-relaxed">
            5-15% = 主题细分严控  ·  <strong>15-25%</strong> = 典型 SLR  ·  25-40% = 较宽 / scoping 倾向。
            目标只影响 LLM 对"勉强相关"边缘 case 的方向倾斜,**不会改判**客观 exclude(命中排除标准 / 类型不符 / 无概念重叠)。
          </p>
        </div>

        <!-- 批量运行按钮 + 重跑失败按钮 -->
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-slate-900">批量 AI 初筛</p>
            <p class="mt-0.5 text-xs text-slate-500">
              对所有未跑 AI 的条目串行调用(~15-25s 每条)。批量任务跑在内存,Node 重启 / 进程崩溃会丢进度(可重启再点)。
              <% if (stats.ai_failed > 0) { %>
                <br/><span class="text-amber-700">⚠ 有 <strong><%= stats.ai_failed %></strong> 条 LLM 调用失败,可一键重跑(右侧 ▶︎)。</span>
              <% } %>
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <%# 一键确认 AI 建议 — 仅管理员;按钮可点条件:
                  1. AI 跑过(ai_done > 0)
                  2. 有可应用的(bulk_accept_eligible > 0:AI 给了 include/exclude 且人工还没决定)
                eligible=0 时按钮置灰 → 防止按完后再按一次,误覆盖用户已经手动调整过的决定。
                重新可点的途径:
                  · Step 2 改检索式 + 重新导入论文(records 被清,有新条目)
                  · 重新跑 AI(产出新建议)
                  · 用户手动把某些 record 改回"未决定"(此时 eligible > 0,按钮自动恢复) %>
            <% if (user && user.role === 'admin' && stats.ai_done > 0) {
                 const eligible = stats.bulk_accept_eligible || 0
                 const uncertainEstimate = stats.ai_uncertain || 0
                 const buttonDisabled = (batch && batch.status === 'running') || eligible === 0
                 const lockReason = eligible === 0 ? '已无 AI 建议待应用 — 改 Step 2 检索式后会重置,或重新跑 AI 产生新建议' : ''
            %>
              <form method="post" action="<%= filterBase %>/bulk-accept-ai"
                    onsubmit="return confirm('⚡ 一键确认 AI 筛查结论(管理员操作)\n\n将把 AI 建议为 纳入 / 排除 的全部条目自动设为人工决定(只覆盖未决定过的)。\nAI 建议为 不确定 的将保留,需人工逐条复核。\n\n精确数量:服务端会重算并 audit。\n\n继续吗?');">
                <input type="hidden" name="confirm" value="yes" />
                <button type="submit"
                        title="<%= lockReason || '管理员专属:把 AI include/exclude 全部应用为人工决定;uncertain 保留待复核' %>"
                        class="rounded-lg border-2 px-4 py-2 text-sm font-medium <%=
                          buttonDisabled
                            ? 'border-slate-300 bg-slate-100 text-slate-400 cursor-not-allowed'
                            : 'border-purple-400 bg-purple-50 text-purple-800 hover:bg-purple-100'
                        %>"
                        <%= buttonDisabled ? 'disabled' : '' %>>
                  ⚡ 一键确认 AI(<%= eligible %><% if (uncertainEstimate > 0) { %>,<%= uncertainEstimate %> 疑保留<% } %>)
                  <% if (eligible === 0) { %><span class="ml-1 text-[10px]">已处理完</span><% } %>
                </button>
              </form>
            <% } %>
            <!-- 重跑失败 — 只在有失败时显示 -->
            <% if (stats.ai_failed > 0) { %>
              <form method="post" action="<%= filterBase %>/run-failed"
                    onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='重跑中…';">
                <button type="submit"
                        title="只重跑那些 LLM 调用报错的条目(ai_reason 以 llm_/codex_/json_parse_failed/spawn_ 开头)"
                        class="rounded-lg border border-amber-400 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-800 hover:bg-amber-100 disabled:opacity-60 disabled:cursor-wait"
                        <%= (batch && batch.status === 'running') ? 'disabled' : '' %>>
                  ↻ 重跑失败 <%= stats.ai_failed %> 条
                </button>
              </form>
            <% } %>
            <!-- 批量运行 — 跑未跑的 -->
            <form method="post" action="<%= filterBase %>/run-batch"
                  onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='启动中…';">
              <button type="submit"
                      class="rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700 disabled:bg-slate-500 disabled:cursor-wait"
                      <%= (batch && batch.status === 'running') ? 'disabled' : '' %>>
                <% if (batch && batch.status === 'running') { %>
                  正在运行(<%= batch.done %>/<%= batch.total %>)
                <% } else if (stats.ai_pending === 0) { %>
                  全部已跑(可重新生成单条)
                <% } else { %>
                  对未跑的 <%= stats.ai_pending %> 条运行 AI
                <% } %>
              </button>
            </form>
          </div>
        </div>

        <!-- 进度条 — 即使没在跑也保留一次结果展示;运行中由 JS 轮询更新 -->
        <div id="batch-progress" class="mt-3 <%= batch ? '' : 'hidden' %>">
          <div class="flex items-center justify-between text-xs text-slate-500">
            <span id="bp-status"><%= batch && batch.status === 'running' ? '运行中' : (batch ? '已完成' : '') %></span>
            <span id="bp-counts"><%= batch ? (batch.done + '/' + batch.total + (batch.errors ? ' · 错 ' + batch.errors : '')) : '' %></span>
          </div>
          <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
            <div id="bp-bar" class="h-full bg-blue-500 transition-all duration-300"
                 style="width: <%= batch && batch.total ? Math.round((batch.done / batch.total) * 100) : 0 %>%"></div>
          </div>
          <p id="bp-current" class="mt-1 truncate text-[11px] text-slate-400">
            <%= batch && batch.current_title ? '正在处理:' + batch.current_title : '' %>
          </p>
        </div>
      </div>
    <% } %>

    <!-- 过滤 -->
    <!-- 过滤区 — 上半:关键词 + 年份 + 含 PDF/DOI / 语言;下半:AI / 人工 状态 chips -->
    <div class="rounded-2xl border border-slate-200 bg-white p-4 space-y-4">
      <!-- 元数据过滤表单(GET 提交) -->
      <form method="get" action="<%= filterBase %>" class="space-y-3">
        <!-- 保留 AI/Human 过滤为 hidden(避免提交时丢) -->
        <% if (filterAi) { %><input type="hidden" name="ai" value="<%= filterAi %>" /><% } %>
        <% if (filterHuman) { %><input type="hidden" name="human" value="<%= filterHuman %>" /><% } %>

        <div class="flex flex-wrap items-end gap-3">
          <div class="min-w-[200px] flex-1">
            <label class="block text-xs font-medium text-slate-500">关键词</label>
            <input type="text" name="q" value="<%= escAttr(ff.q || '') %>" placeholder="标题 / 作者 / 期刊 / DOI"
                   class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-500">年份起</label>
            <input type="number" name="year_from" value="<%= escAttr(ff.year_from || '') %>"
                   placeholder="<%= yearRangeView.min_year || '' %>"
                   min="1900" max="2100"
                   class="mt-1 w-24 rounded-lg border border-slate-300 px-2 py-2 text-sm focus:border-slate-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-500">年份止</label>
            <input type="number" name="year_to" value="<%= escAttr(ff.year_to || '') %>"
                   placeholder="<%= yearRangeView.max_year || '' %>"
                   min="1900" max="2100"
                   class="mt-1 w-24 rounded-lg border border-slate-300 px-2 py-2 text-sm focus:border-slate-500 focus:outline-none" />
          </div>
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <label class="inline-flex items-center gap-1.5" title="只看已经有 PDF 全文的">
              <input type="checkbox" name="has_pdf" value="1" <%= ff.has_pdf ? 'checked' : '' %> class="rounded border-slate-300" />
              <span class="text-emerald-700">仅含 PDF</span>
            </label>
            <label class="inline-flex items-center gap-1.5" title="只看暂无 PDF 且未审过的 — 这批是 triage 待办,需要补传或确认容缺">
              <input type="checkbox" name="missing_pdf" value="1" <%= ff.missing_pdf ? 'checked' : '' %> class="rounded border-slate-300" />
              <span class="text-rose-700">仅暂无</span>
            </label>
            <label class="inline-flex items-center gap-1.5" title="只看用户已确认找不到原文(容缺) — Step 4 勾'容缺原文'后会跑这批">
              <input type="checkbox" name="only_unavailable" value="1" <%= ff.only_unavailable ? 'checked' : '' %> class="rounded border-slate-300" />
              <span class="text-slate-600">仅容缺</span>
            </label>
            <label class="inline-flex items-center gap-1.5">
              <input type="checkbox" name="has_doi" value="1" <%= ff.has_doi ? 'checked' : '' %> class="rounded border-slate-300" />
              <span>仅含 DOI</span>
            </label>
            <label class="inline-flex items-center gap-1.5" title="WoS LA= 实际上是『语言列表包含英文』,韩文/中文期刊带英文摘要的论文会漏进来。勾上只看这些可疑条目。">
              <input type="checkbox" name="only_multi_language" value="1" <%= ff.only_multi_language ? 'checked' : '' %> class="rounded border-slate-300" />
              <span class="text-amber-700">仅多语言</span>
            </label>
            <label class="inline-flex items-center gap-1.5" title="Language 字段不含英文(纯非英文论文)">
              <input type="checkbox" name="only_non_english" value="1" <%= ff.only_non_english ? 'checked' : '' %> class="rounded border-slate-300" />
              <span class="text-rose-700">仅非英文</span>
            </label>
          </div>
          <div class="ml-auto flex gap-2">
            <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">筛选</button>
            <% if (hasAnyFilter) { %>
              <a href="<%= filterBase %>"
                 class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">重置全部</a>
            <% } %>
          </div>
        </div>
      </form>

      <!-- 状态 chips(AI 建议 / 人工决定) -->
      <div class="flex flex-wrap items-center gap-2 text-xs border-t border-slate-100 pt-3">
        <span class="text-slate-500">AI 建议:</span>
        <% ['include', 'exclude', 'uncertain', 'not_run'].forEach(v => {
             const [cls, label] = aiBadge(v)
             const active = filterAi === v
        %>
          <a href="<%= filterHref({ ai: active ? '' : v }) %>"
             class="rounded-full px-2.5 py-0.5 <%= cls %> <%= active ? 'ring-2 ring-offset-1 ring-blue-400' : '' %>">
            <%= label %>
          </a>
        <% }) %>
        <span class="mx-2 text-slate-300">|</span>
        <span class="text-slate-500">人工决定:</span>
        <% ['include', 'exclude', 'uncertain', 'not_decided'].forEach(v => {
             const [cls, label] = humanBadge(v)
             const active = filterHuman === v
        %>
          <a href="<%= filterHref({ human: active ? '' : v }) %>"
             class="rounded-full px-2.5 py-0.5 <%= cls %> <%= active ? 'ring-2 ring-offset-1 ring-blue-400' : '' %>">
            <%= label %>
          </a>
        <% }) %>
      </div>
    </div>

    <!-- 当前过滤摘要条 -->
    <% if (typeof totalFiltered === 'number' && typeof totalPages === 'number' && totalPages > 0) { %>
      <div class="flex items-center justify-between text-xs text-slate-500">
        <span>
          显示第 <strong class="text-slate-700"><%= (page - 1) * pageSize + 1 %></strong>
          – <strong class="text-slate-700"><%= Math.min(page * pageSize, totalFiltered) %></strong>
          / 共 <strong class="text-slate-700"><%= totalFiltered %></strong> 条匹配
          <% if (totalFiltered !== stats.total) { %>(项目共 <%= stats.total %> 条)<% } %>
        </span>
        <span>第 <%= page %> / <%= totalPages %> 页</span>
      </div>
    <% } %>

    <!-- 列表 -->
    <% if (rows.length === 0) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">
        <% if (hasAnyFilter) { %>
          当前过滤下没有匹配的条目。<a href="<%= filterBase %>" class="text-blue-700 hover:underline">清空过滤</a>。
        <% } else { %>
          还没有导入文献条目。先去 <a href="/projects/<%= project.id %>/zotero" class="text-blue-700 hover:underline">Zotero 导入</a>。
        <% } %>
      </div>
    <% } else { %>
      <div class="rounded-2xl border border-slate-200 bg-white">
        <% rows.forEach((r, idx) => {
             const [aiCls, aiLabel] = aiBadge(r.ai_suggestion)
             const [huCls, huLabel] = humanBadge(r.human_decision)
        %>
          <article id="row-<%= r.id %>"
                   class="border-b border-slate-100 p-4 last:border-b-0 <%= r.human_decision === 'include' ? 'bg-emerald-50/30' : r.human_decision === 'exclude' ? 'bg-rose-50/20' : '' %>">

            <header class="flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <!-- 第 1 行:序号 + 年 + 期刊 + 缺摘要警告 -->
                <div class="flex items-center gap-2 text-xs">
                  <span class="text-slate-400">#<%= idx + 1 %></span>
                  <% if (r.year) { %><span class="font-mono text-slate-500"><%= r.year %></span><% } %>
                  <% if (r.journal) { %><span class="truncate text-slate-500"><%= r.journal %></span><% } %>
                  <% if (!r.has_abstract) { %>
                    <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] text-amber-700">缺摘要</span>
                  <% } %>
                </div>

                <%# 第 2 行:来源数据库 + PDF/无PDF/DOI/多语言/非英文 等"线索"徽章。
                    始终渲染(即使全空也展示"无 PDF"提醒,方便用户一眼看到哪些要补 PDF)。 %>
                <% if (true) { %>
                  <div class="mt-1 flex flex-wrap items-center gap-1">
                    <% (r.source_databases_list || []).forEach(function(d) {
                         const dbBadgeCls = ({
                           wos:    'bg-blue-100 text-blue-700 ring-1 ring-blue-200',
                           scopus: 'bg-amber-100 text-amber-800 ring-1 ring-amber-200',
                           pubmed: 'bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200',
                           ieee:   'bg-rose-100 text-rose-700 ring-1 ring-rose-200',
                         })[d] || 'bg-slate-100 text-slate-600 ring-1 ring-slate-200'
                         const dbLabel = ({wos:'WoS',scopus:'Scopus',pubmed:'PubMed',ieee:'IEEE'})[d] || d.toUpperCase()
                    %>
                      <span class="rounded px-1.5 py-0.5 text-[10px] font-medium <%= dbBadgeCls %>"
                            title="导入来源:<%= dbLabel %>"><%= dbLabel %></span>
                    <% }) %>
                    <% if ((r.source_databases_list || []).length > 1) { %>
                      <span class="rounded bg-violet-50 px-1.5 py-0.5 text-[10px] font-medium text-violet-700 ring-1 ring-violet-200"
                            title="同一篇论文在多个库都被检出 — 跨库交集证据,纳入可信度更高">跨库</span>
                    <% } %>
                    <%# PDF 状态三态:
                        - has_pdf=1 → 绿色 PDF
                        - has_pdf=0 + pdf_status='unavailable' → 灰色 容缺(已确认找不到)
                        - has_pdf=0 + pdf_status=null/pending → 红色 暂无(待 triage) %>
                    <% if (r.has_pdf) { %>
                      <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[10px] font-medium text-emerald-700 ring-1 ring-emerald-200"
                            title="有 PDF 全文 — Step 4 批量抽取默认会跑这批">PDF</span>
                    <% } else if (r.pdf_status === 'unavailable') { %>
                      <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 ring-1 ring-slate-300"
                            title="用户已确认找不到原文 — Step 4 勾'容缺原文'后会用标题+摘要跑">容缺</span>
                    <% } else { %>
                      <span class="rounded bg-rose-50 px-1.5 py-0.5 text-[10px] font-medium text-rose-700 ring-1 ring-rose-200"
                            title="暂无 PDF + 未审过 — 请去论文详情页补传,或确认找不到后标'容缺'">暂无</span>
                    <% } %>
                    <% if (r.has_doi) { %>
                      <span class="rounded bg-slate-50 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 ring-1 ring-slate-200"
                            title="<%= r.doi || '有 DOI' %>">DOI</span>
                    <% } %>
                    <% if (r.is_non_english_only) { %>
                      <span class="rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-medium text-rose-700"
                            title="语言字段:<%= (r.language_list || []).join(' / ') %> — 不含英文,可能需要排除">非英文</span>
                    <% } else if (r.is_multi_language) { %>
                      <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-800"
                            title="语言字段:<%= (r.language_list || []).join(' / ') %> — 多语言论文,WoS LA= 可能误纳">多语言</span>
                    <% } %>
                  </div>
                <% } %>

                <%# Scopus/WoS 双语标题用 `; [<other-lang>]` 拼一起 — 列表里只显主标题(英文),
                    省得卡片被翻译撑爆 + 看起来像重复。详情页会把翻译展示出来。 %>
                <% const __sTitleRaw = r.title || '(无标题)'
                   const __sMatch = __sTitleRaw.match(/^(.+?)\s*;\s*\[(.+)\]\s*$/s)
                   const __sTitle = __sMatch ? __sMatch[1].trim() : __sTitleRaw %>
                <a href="/projects/<%= project.id %>/records/<%= r.id %>"
                   class="mt-1 block text-sm font-medium text-slate-900 hover:text-blue-700"
                   <% if (__sMatch) { %>title="双语标题:也叫 <%= __sMatch[2].trim() %>"<% } %>>
                  <%= __sTitle %>
                </a>
                <% if (r.authors_text) { %>
                  <p class="mt-0.5 truncate text-xs text-slate-500"><%= r.authors_text %></p>
                <% } %>
              </div>
              <div class="flex flex-none items-center gap-2">
                <span class="rounded-full px-2.5 py-0.5 text-[11px] font-medium <%= aiCls %>"><%= aiLabel %></span>
                <% if (r.ai_confidence != null) { %>
                  <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-mono text-slate-500" title="置信度">
                    <%= r.ai_confidence.toFixed(2) %>
                  </span>
                <% } %>
                <span class="rounded-full px-2.5 py-0.5 text-[11px] font-medium <%= huCls %>"><%= huLabel %></span>
              </div>
            </header>

            <!-- AI 理由 -->
            <% if (r.ai_suggestion !== 'not_run' && r.ai_reason) { %>
              <div class="mt-2 rounded-lg bg-slate-50/80 p-3 text-xs text-slate-700">
                <p class="font-medium text-slate-500">AI 理由<% if (r.ai_model) { %> <span class="font-mono text-slate-400">· <%= r.ai_model %></span><% } %></p>
                <p class="mt-1 leading-relaxed"><%= r.ai_reason %></p>
                <% if (r.ai_matched_concepts && r.ai_matched_concepts.length) { %>
                  <p class="mt-1 text-blue-700">命中概念:<%= r.ai_matched_concepts.join(' · ') %></p>
                <% } %>
                <% if (r.ai_matched_inclusion && r.ai_matched_inclusion.length) { %>
                  <p class="mt-1 text-emerald-700">命中纳入:<%= r.ai_matched_inclusion.join(' · ') %></p>
                <% } %>
                <% if (r.ai_matched_exclusion && r.ai_matched_exclusion.length) { %>
                  <p class="mt-1 text-rose-700">命中排除:<%= r.ai_matched_exclusion.join(' · ') %></p>
                <% } %>
                <% if (r.ai_need_full_text && r.ai_need_full_text.length) { %>
                  <p class="mt-1 text-amber-700">需看全文:<%= r.ai_need_full_text.join(' · ') %></p>
                <% } %>
              </div>
            <% } %>

            <!-- 操作行 -->
            <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
              <!-- 单条 AI 重跑 -->
              <% if (protocol) { %>
                <form method="post" action="<%= filterBase %>/run-one/<%= r.id %>"
                      onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='跑 AI 中…';">
                  <button type="submit"
                          class="rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-50 disabled:cursor-wait disabled:opacity-60">
                    <%= r.ai_suggestion === 'not_run' ? '让 AI 建议' : '重跑 AI' %>
                  </button>
                </form>
              <% } else { %>
                <span class="text-xs text-slate-400">先审批协议才能跑 AI</span>
              <% } %>

              <!-- 人工决定(AJAX — 点按钮即提交,不需要勾选 radio + 保存两步) -->
              <form method="post" action="<%= filterBase %>/decide/<%= r.id %>"
                    data-ajax-decide
                    data-record-id="<%= r.id %>"
                    class="flex flex-wrap items-center gap-2">
                <input type="text" name="reason" maxlength="2000"
                       value="<%= escAttr(r.human_reason) %>"
                       placeholder="备注(可选,先填再点决定按钮)"
                       class="w-56 rounded-md border border-slate-300 px-2 py-1 text-xs focus:border-slate-500 focus:outline-none" />
                <% ['include', 'exclude', 'uncertain'].forEach(v => {
                     const [cls, label] = humanBadge(v)
                     const checked = r.human_decision === v
                     // 当前已是该决定 → 灰一点,提示"这就是当前选择",但仍可点(等同重新保存)
                     const btnCls = checked
                       ? `${cls} ring-2 ring-blue-300`
                       : 'bg-white text-slate-700 border border-slate-300 hover:bg-slate-50'
                %>
                  <button type="submit" name="decision" value="<%= v %>"
                          title="<%= checked ? '当前选择是 ' + label + ',点击重新保存' : '设为 ' + label %>"
                          class="rounded-md px-2.5 py-1 text-xs font-medium <%= btnCls %> disabled:opacity-60">
                    <%= label %>
                  </button>
                <% }) %>
                <span class="ajax-feedback text-xs text-slate-500" aria-live="polite"></span>
              </form>

              <%# PDF 状态快速操作:仅在 has_pdf=0 时显示 — 已有 PDF 不需要标"容缺"
                  显示两个按钮:
                    - pdf_status 'unavailable' → 显示"取消容缺"
                    - pdf_status 'pending/null' → 显示"标记容缺(找不到)" + 提示"或去补传 PDF" %>
              <% if (!r.has_pdf) { %>
                <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                  <span class="text-slate-400">PDF:</span>
                  <% if (r.pdf_status === 'unavailable') { %>
                    <span class="rounded bg-slate-100 px-2 py-0.5 text-slate-600 ring-1 ring-slate-300">已标:容缺(确认找不到)</span>
                    <form method="post" action="/projects/<%= project.id %>/screening/pdf-status/<%= r.id %>" class="inline">
                      <input type="hidden" name="status" value="pending" />
                      <button type="submit"
                              class="rounded border border-slate-300 bg-white px-2 py-0.5 text-slate-600 hover:bg-slate-50">
                        取消容缺
                      </button>
                    </form>
                  <% } else { %>
                    <a href="/projects/<%= project.id %>/records/<%= r.id %>"
                       class="rounded border border-emerald-300 bg-white px-2 py-0.5 text-emerald-700 hover:bg-emerald-50"
                       title="去论文详情页补传 PDF">
                      ↑ 去补传 PDF
                    </a>
                    <form method="post" action="/projects/<%= project.id %>/screening/pdf-status/<%= r.id %>"
                          onsubmit="return confirm('确认找不到这篇的全文 PDF?\n\n标为「容缺」后:\n· Step 4 勾「容缺原文」时会用标题+摘要跑 AI 抽取\n· 不再出现在「仅暂无」筛选里(脱离 triage 待办)\n· 后续如果补到 PDF,容缺标记会自动清掉')"
                          class="inline">
                      <input type="hidden" name="status" value="unavailable" />
                      <button type="submit"
                              class="rounded border border-slate-300 bg-white px-2 py-0.5 text-slate-600 hover:bg-slate-50">
                        ✕ 标记容缺(确实找不到)
                      </button>
                    </form>
                  <% } %>
                </div>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>

      <!-- 分页(沿用 records 的样式 — 首页 / 当前 ±1 / 末页 + 省略号) -->
      <% if (typeof totalPages === 'number' && totalPages > 1 && typeof pageHref === 'function') { %>
        <div class="flex items-center justify-center gap-1 text-sm">
          <% if (page > 1) { %>
            <a href="<%= pageHref(page - 1) %>"
               class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50">← 上一页</a>
          <% } else { %>
            <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300">← 上一页</span>
          <% } %>

          <%
            const pagesToShow = new Set([1, totalPages, page - 1, page, page + 1])
            const sorted = Array.from(pagesToShow).filter(n => n >= 1 && n <= totalPages).sort((a, b) => a - b)
            let prev = 0
          %>
          <% sorted.forEach(n => { %>
            <% if (n - prev > 1) { %>
              <span class="px-2 text-slate-400">…</span>
            <% } %>
            <% if (n === page) { %>
              <span class="rounded-lg bg-slate-900 px-3 py-1.5 font-medium text-white"><%= n %></span>
            <% } else { %>
              <a href="<%= pageHref(n) %>"
                 class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50"><%= n %></a>
            <% } %>
            <% prev = n %>
          <% }) %>

          <% if (page < totalPages) { %>
            <a href="<%= pageHref(page + 1) %>"
               class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50">下一页 →</a>
          <% } else { %>
            <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300">下一页 →</span>
          <% } %>
        </div>
      <% } %>
    <% } %>

  </section>
</div>

<script>
(function() {
  // —— AI 推荐通过率按钮 ——
  var sugBtn = document.getElementById('ai-suggest-btn')
  var sugOut = document.getElementById('ai-suggest-result')
  var pctInput = document.getElementById('target-pct-input')
  if (sugBtn) {
    sugBtn.addEventListener('click', function() {
      sugBtn.disabled = true
      sugBtn.innerText = '🤖 AI 思考中…'
      if (sugOut) sugOut.textContent = ''
      fetch(<%- JSON.stringify(`/projects/${project.id}/screening/target/suggest`) %>, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(function(r) { return r.json() })
        .then(function(d) {
          sugBtn.disabled = false
          sugBtn.innerText = '🤖 让 AI 根据协议推荐'
          if (!d || !d.ok) {
            if (sugOut) sugOut.textContent = '✗ ' + ((d && d.error) || '失败')
            return
          }
          if (pctInput) pctInput.value = d.recommended_pct
          if (sugOut) {
            sugOut.innerHTML = '✓ 推荐 <strong>' + d.recommended_pct + '%</strong>:' +
              (d.reasoning ? d.reasoning.replace(/[<>&]/g, '') : '') +
              '(点保存生效)'
          }
        })
        .catch(function(err) {
          sugBtn.disabled = false
          sugBtn.innerText = '🤖 让 AI 根据协议推荐'
          if (sugOut) sugOut.textContent = '✗ 网络错误'
        })
    })
  }

  // ============================================================
  // AJAX 人工决定按钮 — 提交后不跳转,直接视觉反馈
  // ============================================================
  function decideBadge(d) {
    return ({
      include: ['#059669', '纳入'],  exclude: ['#e11d48', '排除'],
      uncertain: ['#d97706', '不确定'],
    })[d] || ['#64748b', d]
  }
  document.querySelectorAll('form[data-ajax-decide]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault()
      var fb = form.querySelector('.ajax-feedback')
      // 改用 event.submitter 拿被点击的按钮(每个按钮 name="decision" value="include/exclude/uncertain")
      var submitter = e.submitter
      if (!submitter || !submitter.value) {
        if (fb) { fb.textContent = '请点击纳/排/疑按钮'; fb.style.color = '#e11d48' }
        return
      }
      var decisionValue = submitter.value
      var btn = submitter
      var prevBtnText = btn ? btn.textContent : ''
      if (btn) { btn.disabled = true; btn.textContent = '…' }
      if (fb) { fb.textContent = ''; fb.style.color = '' }
      var fd = new FormData(form)
      // 显式带上 decision(因为 FormData(form) 不会自动包含 submit button 的 value)
      fd.set('decision', decisionValue)
      // ⚠ 关键:server 装的是 express.urlencoded + express.json,**不解析 multipart**。
      //    直接传 fd 会走 multipart → req.body 是 {} → 后端拒"决定值非法"。
      //    用 URLSearchParams 包一层,Content-Type 自动 application/x-www-form-urlencoded。
      var body = new URLSearchParams(fd)
      fetch(form.action, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: body,
      })
        .then(function(r) { return r.json().catch(function() { return { ok: false, error: 'HTTP ' + r.status } }) })
        .then(function(d) {
          if (btn) { btn.disabled = false; btn.textContent = prevBtnText || '保存' }
          if (!d || !d.ok) {
            if (fb) { fb.style.color = '#e11d48'; fb.textContent = '✗ ' + ((d && d.error) || '保存失败') }
            return
          }
          var v = decideBadge(d.decision)
          // 行底色:include → emerald;exclude → rose
          var row = document.getElementById('row-' + (d.record_id || form.dataset.recordId))
          if (row) {
            row.style.background = d.decision === 'include' ? 'rgba(16,185,129,0.06)'
              : d.decision === 'exclude' ? 'rgba(244,63,94,0.05)' : ''
          }
          if (fb) {
            fb.style.color = v[0]
            fb.textContent = '✓ 已保存:' + v[1]
            setTimeout(function() { if (fb.textContent.indexOf('✓') === 0) fb.textContent = '' }, 2000)
          }
          // 更新 radio 选中视觉:同 form 内 label 的 ring 切换
          form.querySelectorAll('label').forEach(function(lb) {
            var inp = lb.querySelector('input[type=radio]')
            if (!inp) return
            if (inp.checked) {
              lb.classList.add('border-blue-500', 'ring-2', 'ring-blue-200')
              lb.classList.remove('border-slate-300')
            } else {
              lb.classList.remove('border-blue-500', 'ring-2', 'ring-blue-200')
              lb.classList.add('border-slate-300')
            }
          })
        })
        .catch(function(err) {
          if (btn) { btn.disabled = false; btn.textContent = prevBtnText || '保存' }
          if (fb) { fb.style.color = '#e11d48'; fb.textContent = '✗ 网络错误' }
        })
    })
  })

  // ============================================================
  // 批量进度轮询 + 完成通知(Web Notification + title 闪动 + 页内 toast)
  // ============================================================
  var pjId = <%- JSON.stringify(project.id) %>;
  var pjTitle = <%- JSON.stringify(project.title || 'SLR') %>;
  var box = document.getElementById('batch-progress');
  var bar = document.getElementById('bp-bar');
  var status = document.getElementById('bp-status');
  var counts = document.getElementById('bp-counts');
  var current = document.getElementById('bp-current');
  if (!box) return;

  // ---- 通知工具 ----
  var origTitle = document.title
  var titleBlinkTimer = null
  function blinkTitle(text) {
    if (titleBlinkTimer) clearInterval(titleBlinkTimer)
    var on = true
    titleBlinkTimer = setInterval(function() {
      document.title = on ? text : origTitle
      on = !on
    }, 1000)
    // 用户切回标签 → 停止闪动
    var stop = function() {
      if (document.visibilityState === 'visible') {
        if (titleBlinkTimer) { clearInterval(titleBlinkTimer); titleBlinkTimer = null }
        document.title = origTitle
        document.removeEventListener('visibilitychange', stop)
      }
    }
    document.addEventListener('visibilitychange', stop)
  }
  function showToast(msg, kind) {
    kind = kind || 'success'
    var t = document.createElement('div')
    var bg = kind === 'error' ? '#e11d48' : '#059669'
    t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;background:' + bg +
      ';color:#fff;padding:14px 18px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.18);' +
      'font-size:13px;max-width:380px;line-height:1.5;cursor:pointer'
    t.textContent = msg
    t.addEventListener('click', function() { t.remove() })
    document.body.appendChild(t)
    setTimeout(function() { if (t.parentNode) t.remove() }, 8000)
  }
  function notifyDone(p) {
    var msg = 'AI 初筛完成:' + p.done + '/' + p.total +
      (p.errors ? '(错误 ' + p.errors + ')' : '') + ' — ' + pjTitle
    // 页内 toast(始终有)
    showToast('✓ ' + msg, p.errors ? 'error' : 'success')
    // 标签页非激活 → 闪动 title + 尝试系统通知
    if (document.visibilityState !== 'visible') {
      blinkTitle('🔔 完成 · ' + origTitle)
      if ('Notification' in window && Notification.permission === 'granted') {
        try { new Notification('SLR 批量初筛完成', { body: msg, tag: 'screening-' + pjId, icon: '/favicon.ico' }) }
        catch (e) { /* ignore */ }
      }
    }
  }
  // 启动前主动申请通知权限(只在用户启动批量后才请求)
  function ensureNotificationPermission() {
    if (!('Notification' in window)) return
    if (Notification.permission === 'default') {
      Notification.requestPermission().catch(function() { /* ignore */ })
    }
  }
  // 监听批量启动 form(让它请求权限)
  var batchForm = document.querySelector('form[action*="/screening/run-batch"]')
  if (batchForm) batchForm.addEventListener('submit', ensureNotificationPermission)

  // ---- 轮询 ----
  var initialBatch = <%- JSON.stringify(batch || null) %>;
  var notifiedDone = false
  var poll = function() {
    fetch('/projects/' + pjId + '/screening/progress.json', { credentials: 'same-origin' })
      .then(function(r) { return r.json() })
      .then(function(p) {
        if (!p || !p.total) {
          box.classList.add('hidden');
          return;
        }
        box.classList.remove('hidden');
        var pct = p.pct || 0;
        bar.style.width = pct + '%';
        status.textContent = p.running ? '运行中(' + pct + '%)' : '已完成';
        counts.textContent = p.done + '/' + p.total + (p.errors ? ' · 错 ' + p.errors : '');
        current.textContent = p.current_title ? '正在处理:' + p.current_title : '';
        if (p.running) {
          setTimeout(poll, 3000);
        } else {
          if (!notifiedDone) {
            notifiedDone = true
            notifyDone(p)
          }
          // 完成后 3 秒刷新页面,把新结果显出来(给 toast/notification 一点显示时间)
          setTimeout(function() { window.location.reload(); }, 3000);
        }
      })
      .catch(function() {
        // 出错就 8s 后再试一次
        setTimeout(poll, 8000);
      });
  };
  // 只有当前有任务在跑时才轮询(根据初始状态)
  if (initialBatch && initialBatch.status === 'running') {
    // 进入页面就主动申请通知权限(用户可能是刚启动批量后导航回这页)
    ensureNotificationPermission()
    setTimeout(poll, 1500);
  }
})();
</script>

<%- include('../partials/footer') %>

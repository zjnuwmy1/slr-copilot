  const _draftingPlanInFlight = (typeof draftingPlanInFlight !== 'undefined') ? !!draftingPlanInFlight : false
  const _draftingPlanStale = (typeof draftingPlanStale !== 'undefined') ? !!draftingPlanStale : false
  const _draftingPlanStaleReason = (typeof draftingPlanStaleReason !== 'undefined') ? (draftingPlanStaleReason || null) : null
  const _draftingPlanGeneratedAt = (typeof draftingPlanGeneratedAt !== 'undefined') ? (draftingPlanGeneratedAt || null) : null
  const _draftingPlanAtProtocolVersion = (typeof draftingPlanAtProtocolVersion !== 'undefined') ? (draftingPlanAtProtocolVersion || null) : null
  const _draftingPlanLockStarted = (typeof draftingPlanLockStarted !== 'undefined') ? (draftingPlanLockStarted || '') : ''
  const _draftingPlanStatus = (typeof draftingPlanStatus !== 'undefined') ? (draftingPlanStatus || null) : null
  const _draftingPlanError = (typeof draftingPlanError !== 'undefined') ? (draftingPlanError || null) : null
  const _draftingPlanSystemVersion = (typeof draftingPlanSystemVersion !== 'undefined') ? (draftingPlanSystemVersion || null) : null
  const _draftingPlanWithOverlay = (typeof draftingPlanWithOverlay !== 'undefined') ? !!draftingPlanWithOverlay : false
  const _planParaCount = _draftingPlan && Array.isArray(_draftingPlan.sections)
    ? _draftingPlan.sections.reduce((a, s) => a + ((Array.isArray(s.paragraphs) ? s.paragraphs.length : 0)), 0)

<%- include('../partials/header', { title: project.title + ' · ' + stepLabel }) %>
<%- include('partials/project-header', { project, currentStep: 'report' }) %>

<%
  // ============================================================
  // Phase 8.A — safe fallbacks for fields Agent B 还没接好
  // ============================================================
  const _customSections = (typeof customSections !== 'undefined' && Array.isArray(customSections)) ? customSections : []
  const _draftSummary = (typeof draftSummary !== 'undefined' && draftSummary && typeof draftSummary === 'object') ? draftSummary : { total: 0, generated: 0, in_progress: 0, failed: 0, pending: 0, by_name: {} }
  const _byName = (_draftSummary && _draftSummary.by_name && typeof _draftSummary.by_name === 'object') ? _draftSummary.by_name : {}
  const _draftingRunInFlight = (typeof draftingRunInFlight !== 'undefined') ? !!draftingRunInFlight : false
  const _draftingRunStarted = (typeof draftingRunStarted !== 'undefined') ? (draftingRunStarted || '') : ''
  const _draftingRunFinished = (typeof draftingRunFinished !== 'undefined') ? (draftingRunFinished || '') : ''
  const _draftingRunStatus = (typeof draftingRunStatus !== 'undefined') ? (draftingRunStatus || '') : ''
  const _draftingRunError = (typeof draftingRunError !== 'undefined') ? (draftingRunError || '') : ''
  const _draftingRunMeta = (typeof draftingRunMeta !== 'undefined' && draftingRunMeta && typeof draftingRunMeta === 'object') ? draftingRunMeta : null
  const _topoSortedSections = (typeof topoSortedSections !== 'undefined' && Array.isArray(topoSortedSections) && topoSortedSections.length) ? topoSortedSections : _customSections.slice().sort((a, b) => (a.order || 0) - (b.order || 0))

  // 撰写主进度估时:每章 5min,至少 10min,硬上限 90min(plan 约定)
  const _sectionsTotal = Math.max(_customSections.length || 0, 1)
  const _estimatedSecondsDraft = Math.max(600, _sectionsTotal * 300)
  const _hardMaxSecondsDraft = 5400

  // 心跳:server 通常把 last_heartbeat_at 写在 meta 或 status.json,view 优先用 status.json
  function _isRunningSection(name) {
    const row = _byName[name]
    return row && row.section_run_status === 'running'
  }

  // ============================================================
  // 数据源 chip helper(给每个 LLM 按钮旁边显示"会带哪些数据")
  // ============================================================
  // _dataChip(emoji, label, value, ok)
  //   ok=true  → 绿色 + 数字
  //   ok=false → 灰色 + ✗
  function _dataChip(emoji, label, value, ok) {
    // 2026-05-25:配色加深 — 之前 bg-emerald-50 太浅 ("亮"和"不亮"区分度低),
    //   现在 ok=true 用 emerald-100 / 900 (明显的"已就绪"绿),
    //   ok=false 用 slate-200 / 500 + amber-tinted ✗ (明显的"缺数据"灰红)
    const cls = ok ? 'bg-emerald-100 text-emerald-900 border-emerald-300'
                   : 'bg-slate-200 text-slate-500 border-slate-300'
    const valStr = (value !== null && value !== undefined && value !== '')
      ? ` <span class="font-mono ml-0.5">${value}</span>` : ''
    const okMark = ok ? '' : ' <span class="text-rose-600 font-bold">✗</span>'
    return `<span class="inline-flex items-center gap-0.5 rounded border px-1.5 py-0.5 text-[10px] font-medium whitespace-nowrap ${cls}" title="${label}${ok ? '' : ' — 缺数据'}">${emoji} ${label}${valStr}${okMark}</span>`
  }

  // 每按钮对应的 chip 集合(从 ingestSummary 读)
  //   返回 HTML 串(带 wrapper),caller 用 unescaped EJS output 直接渲染
  //
  // 2026-05-25 重写:确保 chip 准确反映每步真实带入数据
  //   - 矩阵 chip 区分 raw 全集(rawMatrixRows)+ paperProfiles(skipMatrix 模式下不重复 matrix)
  //   - RoB chip 给所有写章节步骤(以前漏了)
  //   - methodologyCapabilities 新加 🔒 chip(M36)
  //   - dateRangeAlignment 新加 📅 chip(只在 has_gap 时)
  //   - PDF chunks 新加 📑 chip(advanced 用户)
  function _btnChips(_is, kind) {
    if (!_is) return ''
    const chips = []
    function add(emoji, label, value, ok) { chips.push(_dataChip(emoji, label, value, ok)) }
    const totalPapers = _is.papers?.included_n || 0
    const matrixN     = _is.matrix?.rows_n || 0
    const robN        = _is.rob?.pass1_n || _is.rob?.rows_n || 0
    const robPass2    = _is.rob?.pass2_n || 0
    const hasMethCaps = (typeof methodologyCapabilities !== 'undefined') && methodologyCapabilities && (
         methodologyCapabilities.dual_reviewer_screening
      || methodologyCapabilities.dual_reviewer_extraction
      || methodologyCapabilities.third_adjudicator
      || methodologyCapabilities.cohens_kappa_value !== null
      || methodologyCapabilities.prospero_id
      || methodologyCapabilities.publication_bias_assessed
      || methodologyCapabilities.follows_prisma_p
      || methodologyCapabilities.notes
    )

    // ── 协议 PICO+RQ ────────────────────────────────────────────
    const allUsers = ['overlay', 'plan', 'section', 'table_recommend', 'figure_prompts', 'prisma_validate', 'latex', 'table_polish', 'table_polish_batch']
    if (allUsers.includes(kind)) {
      add('📋', '协议',  _is.protocol.loaded ? ('v' + _is.protocol.version) : '?', _is.protocol.loaded)
    }

    // ── 主题 / 跨主题 / 主题证据 / SoF(写章节 + overlay/plan/recommend/figure)──
    const usesThemes = ['overlay', 'plan', 'section', 'table_recommend', 'figure_prompts', 'table_polish', 'table_polish_batch', 'latex']
    if (usesThemes.includes(kind)) {
      add('🎯', '主题', _is.synthesis.themes_n, _is.synthesis.themes_n > 0)
    }
    const usesCrossCutting = ['overlay', 'plan', 'section', 'table_recommend', 'figure_prompts']
    if (usesCrossCutting.includes(kind)) {
      add('🔭', '跨主题', _is.synthesis.cross_cutting_n, _is.synthesis.cross_cutting_n > 0)
    }
    const usesCertainty = ['overlay', 'plan', 'section', 'table_recommend', 'figure_prompts', 'table_polish', 'table_polish_batch']
    if (usesCertainty.includes(kind)) {
      add('⊕', '主题证据', _is.certainty.theme_rollup_n, _is.certainty.theme_rollup_n > 0)
    }
    const usesSof = ['overlay', 'plan', 'section', 'table_recommend', 'figure_prompts', 'table_polish', 'table_polish_batch']
    if (usesSof.includes(kind)) {
      add('📈', 'SoF', _is.certainty.outcome_sof_n, _is.certainty.outcome_sof_n > 0)
    }

    // ── 论文 / 矩阵 / RoB(2026-05-25:每步喂全集矩阵,显示真实数据量)──
    if (kind === 'section') {
      // section 路径:
      //   - paperProfiles 121 篇 metadata-only(skipMatrix 互补)
      //   - rawMatrixRows 121 篇 完整不截断
      //   - RoB 包含在 paperProfile 里
      add('📚', '论文', totalPapers, totalPapers > 0)
      add('📊', '矩阵', `${matrixN} 全集 raw + ${totalPapers} profile(skipMatrix)`, matrixN > 0)
      add('⚖️', 'RoB', `${robN}${robPass2 ? '+' + robPass2 : ''}`, robN > 0)
    } else if (kind === 'overlay') {
      // overlay:samplePapers 4 篇 formatPaperProfile(含 matrix 截断) + rawMatrixRows 全集
      add('📊', '矩阵', `${matrixN} 全集 raw + 4 paper profile`, matrixN > 0)
      add('⚖️', 'RoB', `${robN}`, robN > 0)
    } else if (kind === 'plan') {
      // plan:samplePapers 6 篇 + rawMatrixRows 全集
      add('📊', '矩阵', `${matrixN} 全集 raw + 6 paper profile`, matrixN > 0)
      add('⚖️', 'RoB', `${robN}`, robN > 0)
    } else if (kind === 'figure_prompts') {
      // figure prompts:rawMatrixRows 全集(刚升级)+ samplePapers 4 篇
      add('📊', '矩阵', `${matrixN} 全集 raw + 4 paper profile`, matrixN > 0)
    } else if (kind === 'table_recommend') {
      add('📊', '矩阵', `${matrixN} 全集 raw`, matrixN > 0)
    } else if (kind === 'table_polish' || kind === 'table_polish_batch') {
      // polish 主输入是 derivedMarkdown,矩阵不直接喂 — 仅 certainty 调语气
      add('📝', '派生 MD', kind === 'table_polish' ? '该表' : '每表(批量)', true)
      if (kind === 'table_polish_batch') {
        add('📊', '矩阵', '已通过 certainty 传入', _is.certainty.theme_rollup_n > 0)
      }
    } else if (kind === 'prisma_validate') {
      // PRISMA validate 主看 draft sections + protocol + 检索式;不喂矩阵
      add('✍️', '草稿全文', _customSections.length, _customSections.length > 0)
    }

    // ── 检索式 / 期刊模板 / PRISMA counts ───────────────────────
    if (['overlay', 'plan', 'section', 'table_recommend', 'prisma_validate'].includes(kind)) {
      add('🔍', '检索式', '锁定', true)
    }
    if (['overlay', 'plan', 'section', 'table_recommend', 'figure_prompts', 'table_polish', 'table_polish_batch', 'latex'].includes(kind)) {
      add('📑', '期刊', _is.journal_template.loaded ? '✓' : '?', _is.journal_template.loaded)
    }
    if (kind === 'table_recommend' && _is.journal_template.loaded && _is.journal_template.table_count != null) {
      add('📊', '期刊表数', _is.journal_template.table_count + '(参考)', true)
    }
    if (kind === 'figure_prompts' && _is.journal_template.loaded && _is.journal_template.figure_count != null) {
      add('🖼️', '期刊图数', _is.journal_template.figure_count + '(参考)', true)
    }
    if (['overlay', 'plan', 'section', 'figure_prompts', 'prisma_validate'].includes(kind)) {
      add('📐', 'PRISMA', _is.prisma.included, _is.prisma.included > 0)
    }

    // ── 方法学声明(M36 capabilities)+ dateRangeAlignment ─────
    if (['overlay', 'plan', 'section', 'prisma_validate', 'figure_prompts'].includes(kind)) {
      add('🔒', '诚信门', hasMethCaps ? '已声明' : 'default', true)
    }

    // ── Figures / Tables manifest(写章节用)──────────────────
    if (['overlay', 'plan', 'section', 'latex'].includes(kind)) {
      const upl = _is.figures.user_uploaded_n || 0
      const ai  = _is.figures.ai_prompts_n || 0
      add('🖼️', '图', `${upl}↑/${ai} prompts`, (upl + ai) > 0)
      add('📋', '表 manifest', '15', true)
    }

    // ── Overlay / Plan 互依 ────────────────────────────────────
    if (['plan', 'section'].includes(kind)) {
      add('⚙️', 'overlay', _is.overlay.loaded ? ('v' + _is.overlay.at_version) : '✗', _is.overlay.loaded && !_is.overlay.stale)
    }
    if (kind === 'section') {
      add('🗺️', 'plan', _is.plan.loaded ? (_is.plan.sections_planned_n) : '✗', _is.plan.loaded && !_is.plan.stale)
      add('🔗', '前章 summaries', '动态', true)
      add('📚', 'cheat sheet', '121 引文', _is.papers.included_n > 0)
    }

    // ── PRISMA validate 专有 ─────────────────────────────────
    if (kind === 'prisma_validate') {
      add('📐', '27 项 checklist', '全套', true)
    }

    // ── LaTeX render 专有 ────────────────────────────────────
    if (kind === 'latex') {
      add('📄', 'LaTeX 模板', '上传', true)
      add('✍️', '草稿全文', _customSections.length, _customSections.length > 0)
      add('👤', 'authors', '可选', true)
      add('🔗', '引文 BibTeX', '自动', true)
    }

    return chips.join(' ')
  }
%>

<%# 2026-05-26 真修宽度问题:section 加 min-w-0 — CSS Grid 经典坑,
     子项默认 min-width: auto = 内容最小宽,如果 section 里有不可压缩元素
    (长 chip 串 / pre 块 / 长 record_id 字符串等)整个 grid 会被强制撑开
     超出 max-w-5xl main 边界 → 横向滚动 → 体感"超宽"。
     /screening / synthesis 等姊妹页都加了 min-w-0,/report 当时漏了。
     加上后跟 /screening 视觉宽度完全一致。 %>
<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress, currentStep: 'report' }) %>

  <section class="space-y-6 min-w-0">
    <!-- Step 8 是综述输出 — PRISMA 在这里要前台,因为最终成稿必须 PRISMA 合规 -->
    <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 px-4 py-3">
      <p class="text-xs font-medium uppercase tracking-wider text-emerald-700">第 8 步 / 共 8 步</p>
      <h1 class="mt-1 text-lg font-semibold text-slate-900">撰写综述初稿</h1>
      <p class="mt-1 text-sm text-slate-600">
        最终成稿环节,全文按 PRISMA 2020 规范输出。本步骤自动完成:① 分章生成初稿,每条事实回溯至原文献;② 依据筛选日志生成 PRISMA 流程图;③ 导出 Markdown 时附 27 项 PRISMA 清单与检索式附录。
      </p>
      <p class="mt-2 text-xs text-emerald-700">
        ✓ 覆盖 PRISMA
        <% (stepItems || []).forEach((it, i) => { %><span class="font-mono">#<%= it.item_number %></span><%= i < (stepItems||[]).length - 1 ? ' · ' : '' %><% }) %>
      </p>
    </div>

    <!-- ============================================================ -->
    <!-- 优化打磨包:Step 8/9 拆分后,投稿就绪状态卡 + LaTeX 投稿模板卡   -->
    <!--   都搬到了 /:id/submission(Step 9)。这里只留一个轻量提示。     -->
    <!-- ============================================================ -->
    <div class="rounded-2xl border border-violet-200 bg-violet-50/40 p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <h2 class="text-sm font-semibold text-violet-900">🎯 完成撰写后,去 Step 9 投稿准备</h2>
          <p class="mt-1 text-xs text-slate-700">LaTeX 模板上传 / 作者表 / PDF 渲染 / 一键投稿包,都在那里。本页只负责文稿本身。</p>
        </div>
        <a href="/projects/<%= project.id %>/submission"
           class="flex-none rounded-lg border border-violet-300 bg-white px-3 py-1.5 text-xs font-medium text-violet-700 hover:bg-violet-100">
          → 去 Step 9 投稿准备
        </a>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- 2026-05-25 NEW · 页面内 sticky 子导航                         -->
    <!--   用户反馈:撰写编辑器埋在 ~2300 行 setup 卡片之后,要滚很久 -->
    <!--   解决:sticky 顶部 chip 行,任意点击直接跳到对应卡片 anchor   -->
    <!--   同时显示 "✍ 已写 N/M 章" 进度,给用户即刻反馈              -->
    <!-- ============================================================ -->
    <%
      // 实时统计章节进度(给 chip badge 用)
      let _navGenerated = 0, _navFailed = 0, _navTotal = 0
      const _navHallucinated = (typeof _draftSummary !== 'undefined' && _draftSummary && _draftSummary.total_hallucinated) || 0
      for (const _s of (_customSections || [])) {
        if (_s.generated === 'auto') continue
        _navTotal++
        const _b = (typeof _byName !== 'undefined' && _byName) ? _byName[_s.name] : null
        if (_b?.status === 'generated') _navGenerated++
        else if (_b?.status === 'failed') _navFailed++
      }
    %>
    <%
      // 2026-05-25 nav 升级:把 8 个跳转项归一描述,后面用同一份数据渲染
      //   - 小屏(lg 以下):顶部横向 sticky chip(保旧体验)
      //   - 大屏(lg+):右侧 fixed 垂直浮条,IntersectionObserver 高亮当前 section
      //   - 排版预览 ↗ 作为底部外链(target=_blank),不参与 scroll-spy
      // 2026-05-25:nav 顺序必须跟 page anchor 顺序一致(否则 scroll-spy 视觉跳跃)
      //   实际 anchor 行号:setup(518) → plan(747) → prisma(1220) → figures(1542)
      //   → tables(1664) → manuscript(2641) → coverage(2918) → validation(3030)
      const _navItems = [
        { target: 'nav-setup',      icon: '⚙️',  label: '设置',     badge: '', dot: 'slate' },
        { target: 'nav-plan',       icon: '🗺️',  label: '大纲',     badge: '', dot: 'slate' },
        { target: 'nav-prisma',     icon: '📐',  label: 'PRISMA',   badge: '', dot: 'slate' },
        { target: 'nav-figures',    icon: '🖼️',  label: '图',       badge: '', dot: 'slate' },
        { target: 'nav-tables',     icon: '📋',  label: '表',       badge: '', dot: 'slate' },
        {
          target: 'nav-manuscript', icon: '✍️',  label: '综述初稿',
          badge: `${_navGenerated}/${_navTotal}` + (_navFailed > 0 ? ` ⚠${_navFailed}` : ''),
          dot: _navFailed > 0 ? 'rose' : 'emerald',
          accent: 'emerald',
        },
        {
          target: 'nav-coverage',   icon: '📑',  label: '引用覆盖',
          badge: _navHallucinated > 0 ? `⚠${_navHallucinated}` : '',
          dot: _navHallucinated > 0 ? 'rose' : 'slate',
          accent: _navHallucinated > 0 ? 'rose' : '',
        },
        { target: 'nav-validation', icon: '✅',  label: 'PRISMA 27', badge: '', dot: 'slate' },
      ]
    %>

    <!-- ─── 小屏横向 sticky chip(原有体验)── -->
    <nav id="report-subnav-mobile"
         class="sticky top-0 z-20 -mx-2 mb-1 rounded-xl border border-slate-200 bg-white/95 px-3 py-2 shadow-sm backdrop-blur lg:hidden"
         style="margin-top: -0.25rem;">
      <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
        <span class="font-semibold text-slate-500 mr-1">跳转:</span>
        <% _navItems.forEach(function(it) {
             const isEmer = it.accent === 'emerald'
             const isRose = it.accent === 'rose'
             const cls = isEmer
               ? 'border-emerald-300 bg-emerald-50 font-semibold text-emerald-700 hover:bg-emerald-100'
               : isRose
                 ? 'border-rose-300 bg-rose-50 text-rose-700 hover:bg-rose-100'
                 : 'border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100'
        %>
          <a href="#<%= it.target %>" data-nav-target="<%= it.target %>"
             class="report-subnav-link rounded-md border <%= cls %> px-2 py-1">
            <%= it.icon %> <%= it.label %>
            <% if (it.badge) { %>
              <span class="ml-1 font-mono"><%= it.badge %></span>
            <% } %>
          </a>
        <% }) %>
        <a href="/projects/<%= project.id %>/report/preview" target="_blank"
           class="ml-auto rounded-md border border-blue-300 bg-blue-50 px-2.5 py-1 font-semibold text-blue-700 hover:bg-blue-100">📖 排版预览 ↗</a>
      </div>
    </nav>

    <!-- ─── 大屏右侧 fixed 浮条(垂直,scroll-spy 高亮当前 section)──
         2026-05-26:断点从 lg (1024px) 升到 2xl (1536px)。
           - main = max-w-5xl (1024px) 居中 → viewport ≥ 1536px 时两侧各 ≥ 256px 空白
           - 浮条 w-44 (176px) + 32px 间隙 = 208px,正好放进右侧空白
           - viewport < 1536px(13"/14"/15" 笔记本)只用顶部 mobile nav,
             不再压在卡片上方 / 撑出页外,/report 跟 /screening 视觉宽度一致 -->
    <nav id="report-subnav-desktop"
         class="hidden 2xl:flex fixed right-3 top-1/2 -translate-y-1/2 z-30 flex-col gap-1.5 rounded-2xl border border-slate-200 bg-white/95 px-2.5 py-3 shadow-lg backdrop-blur w-44"
         aria-label="报告页内导航">
      <p class="px-1.5 pb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400 border-b border-slate-200">页内跳转</p>
      <% _navItems.forEach(function(it) {
           const isEmer = it.accent === 'emerald'
           const isRose = it.accent === 'rose'
           const baseCls = isEmer
             ? 'border-emerald-200 bg-emerald-50 text-emerald-800 hover:bg-emerald-100'
             : isRose
               ? 'border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100'
               : 'border-transparent text-slate-700 hover:bg-slate-100'
      %>
        <a href="#<%= it.target %>" data-nav-target="<%= it.target %>"
           class="report-subnav-link group flex items-center justify-between gap-2 rounded-md border <%= baseCls %> px-2 py-1.5 text-xs transition">
          <span class="flex items-center gap-1.5 min-w-0">
            <span class="text-sm leading-none"><%= it.icon %></span>
            <span class="truncate"><%= it.label %></span>
          </span>
          <% if (it.badge) { %>
            <span class="ml-1 shrink-0 rounded-full bg-white/80 px-1.5 py-0.5 text-[10px] font-mono <%= isRose ? 'text-rose-700' : isEmer ? 'text-emerald-700' : 'text-slate-600' %>"><%= it.badge %></span>
          <% } %>
        </a>
      <% }) %>
      <div class="my-1 border-t border-slate-200"></div>
      <a href="/projects/<%= project.id %>/report/preview" target="_blank"
         class="flex items-center justify-between gap-2 rounded-md border border-blue-300 bg-blue-50 px-2 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100">
        <span class="flex items-center gap-1.5"><span class="text-sm leading-none">📖</span>排版预览</span>
        <span class="text-[10px]">↗</span>
      </a>
    </nav>

    <!-- ─── scroll-spy:IntersectionObserver 高亮当前 section ── -->
    <style>
      .report-subnav-link.is-active {
        background: #2563eb !important;   /* blue-600 */
        color: #fff !important;
        border-color: #2563eb !important;
        font-weight: 600;
      }
      .report-subnav-link.is-active span,
      .report-subnav-link.is-active .font-mono {
        color: #fff !important;
        background: rgba(255,255,255,0.18) !important;
      }
    </style>
    <script>
    (function() {
      // 2026-05-25 重写:用 scroll 事件 + rAF 节流 替代 IntersectionObserver
      //   原因:Observer 只在 entry 跨越 threshold 时触发;用户在两个 anchor 之间
      //   长距离滚动(比如 综述初稿段 500-1000px)时 observer 不会再触发,
      //   active 保持 stale。改用 scroll listener 每帧重算,实时跟随。
      const targets = Array.from(document.querySelectorAll('span[id^="nav-"]'))
      if (targets.length === 0) return

      const linksByTarget = {}
      document.querySelectorAll('.report-subnav-link').forEach(a => {
        const t = a.getAttribute('data-nav-target')
        if (!t) return
        ;(linksByTarget[t] = linksByTarget[t] || []).push(a)
      })

      let activeTarget = null
      function setActive(targetId) {
        if (targetId === activeTarget) return
        activeTarget = targetId
        Object.keys(linksByTarget).forEach(t => {
          linksByTarget[t].forEach(a => a.classList.toggle('is-active', t === targetId))
        })
      }

      function recompute() {
        // 激活线:视口顶部下方 120px (避开 sticky toolbar 高度)
        const triggerY = 120
        let bestTarget = targets[0].id
        let bestTop = -Infinity
        for (const t of targets) {
          const r = t.getBoundingClientRect()
          // 选"已越过 trigger 线但最接近的"那个
          if (r.top <= triggerY && r.top > bestTop) {
            bestTop = r.top
            bestTarget = t.id
          }
        }
        // 边界:滚到底页时,如果最后一个 target 已超出底部,但视口最后 30% 都没东西,
        //   保持最后一个 anchor active(避免回滚到 targets[0])
        if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
          bestTarget = targets[targets.length - 1].id
        }
        setActive(bestTarget)
      }

      let ticking = false
      function onScroll() {
        if (ticking) return
        ticking = true
        window.requestAnimationFrame(() => {
          ticking = false
          recompute()
        })
      }

      window.addEventListener('scroll', onScroll, { passive: true })
      window.addEventListener('resize', onScroll, { passive: true })

      // 首次激活 + 给 hash anchor 跳转后再纠正(scroll-margin-top 完成后)
      recompute()
      window.addEventListener('hashchange', () => {
        window.requestAnimationFrame(recompute)
      })
    })()
    </script>


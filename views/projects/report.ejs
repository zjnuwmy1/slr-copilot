<%- include('../partials/header', { title: project.title + ' · ' + stepLabel }) %>
<%- include('partials/project-header', { project }) %>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress, currentStep: 'report' }) %>

  <section class="space-y-6">
    <!-- Step 8 是综述输出 — PRISMA 在这里要前台,因为最终成稿必须 PRISMA 合规 -->
    <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 px-4 py-3">
      <p class="text-xs font-medium uppercase tracking-wider text-emerald-700">第 8 步 / 共 8 步</p>
      <h1 class="mt-1 text-lg font-semibold text-slate-900">写成可投稿的综述</h1>
      <p class="mt-1 text-sm text-slate-600">
        最终成稿环节 — 整文必须 PRISMA 2020 合规。下方会:① 生成 9 章节,每个事实陈述带 [record_id] 占位 + 强校验;② 自动算 PRISMA flow diagram(从筛选日志);③ 导出 Markdown 时把 PRISMA 27 项清单作为附录。
      </p>
      <p class="mt-2 text-xs text-emerald-700">
        ✓ 覆盖 PRISMA
        <% (stepItems || []).forEach((it, i) => { %><span class="font-mono">#<%= it.item_number %></span><%= i < (stepItems||[]).length - 1 ? ' · ' : '' %><% }) %>
      </p>
    </div>

    <!-- 期刊模板卡(Phase 9 Agent W)-->
    <% const tplEx = (journalTemplate && journalTemplate.extracted_structure) || null %>
    <div class="rounded-2xl border <%= journalTemplate ? 'border-emerald-200 bg-emerald-50/30' : 'border-amber-200 bg-amber-50/30' %> p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-medium uppercase tracking-wider <%= journalTemplate ? 'text-emerald-700' : 'text-amber-700' %>">目标期刊模板</span>
            <% if (journalTemplate) { %>
              <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-700">已上传</span>
            <% } else { %>
              <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-medium text-amber-700">未上传</span>
            <% } %>
          </div>
          <% if (journalTemplate && tplEx) { %>
            <p class="mt-1 text-sm text-slate-800">
              <strong><%= tplEx.journal_name || '(期刊名未识别)' %></strong>
              <% if (tplEx.article_title) { %>
                <span class="ml-1 text-slate-500">· <%= tplEx.article_title.slice(0, 80) %></span>
              <% } %>
            </p>
            <p class="mt-0.5 text-xs text-slate-500">
              <%= (tplEx.sections || []).length %> 章节模板 · 已注入到下方各章节生成 prompt
            </p>
          <% } else { %>
            <p class="mt-1 text-sm text-slate-700">未上传目标期刊样稿。上传后,各章节生成会贴近目标刊的字数 / moves / 风格。</p>
            <p class="mt-0.5 text-xs text-slate-500">可选 — 不上传也能生成,用通用 SLR 默认值。</p>
          <% } %>
        </div>
        <a href="/projects/<%= project.id %>/journal-template"
           class="flex-none rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">
          <%= journalTemplate ? '查看 / 替换 模板' : '上传期刊样稿' %>
        </a>
      </div>
    </div>

    <!-- 顶部操作条 -->
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4">
      <div>
        <h2 class="text-base font-semibold text-slate-800">综述初稿编辑器</h2>
        <p class="mt-1 text-xs text-slate-500">9 个章节单独跑或一键生成全部。每个事实陈述带 [record_id] 占位,导出时强校验。</p>
      </div>
      <div class="flex gap-2">
        <form method="post" action="/projects/<%= project.id %>/report/generate-all"
              onsubmit="return confirm('将顺序生成 8 个 LLM 章节 + References,约 30-60 分钟。已有章节会被覆盖。是否继续?')">
          <button type="submit"
                  class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700 disabled:bg-slate-300"
                  <%= job && !job.done ? 'disabled' : '' %>>
            <%= job && !job.done ? '生成中…' : '一键生成全部' %>
          </button>
        </form>
        <a href="/projects/<%= project.id %>/report/export.md"
           class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">⬇ 导出 Markdown</a>
      </div>
    </div>

    <!-- 进度条 -->
    <% if (job) { %>
      <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-4 text-sm">
        <div class="flex items-center justify-between">
          <p class="font-medium text-blue-800">
            <%= job.done ? '✓ 全部生成完成' : '⏳ 正在生成…' %>
            <span class="text-xs font-normal text-blue-600">
              已完成 <%= job.completed.length %> / <%= job.sections.length %><%= job.current ? ' · 当前:' + job.current : '' %>
            </span>
          </p>
          <span class="text-xs text-blue-600">开始于 <%= job.startedAt %></span>
        </div>
        <% if (job.errors && job.errors.length) { %>
          <details class="mt-2">
            <summary class="cursor-pointer text-xs text-red-700">⚠ <%= job.errors.length %> 个章节失败</summary>
            <ul class="mt-1 space-y-0.5 text-xs text-red-700">
              <% job.errors.forEach(e => { %>
                <li>· <%= e.section %>: <%= e.msg %></li>
              <% }) %>
            </ul>
          </details>
        <% } %>
      </div>
    <% } %>

    <!-- PRISMA Flow Diagram -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <h3 class="text-sm font-medium uppercase text-slate-400">PRISMA Flow Diagram</h3>
      <p class="mt-1 text-xs text-slate-500">数字从数据库精确计算,不由 LLM 生成。</p>

      <div class="mt-3 grid gap-4 md:grid-cols-2">
        <!-- Mermaid 图 -->
        <div class="overflow-x-auto rounded-lg border border-slate-100 bg-slate-50 p-3">
          <pre class="mermaid text-xs"><%- prismaMermaid %></pre>
        </div>
        <!-- 数字概览 -->
        <div class="text-sm">
          <table class="w-full">
            <tbody class="divide-y divide-slate-100">
              <tr><td class="py-1 text-slate-500">检索命中(去重前)</td><td class="py-1 text-right font-mono"><%= prismaCounts.records_identified_total %></td></tr>
              <% Object.entries(prismaCounts.records_identified || {}).forEach(([k,n]) => { %>
                <tr><td class="py-1 pl-3 text-xs text-slate-400">· <%= k %></td><td class="py-1 text-right font-mono text-xs text-slate-400"><%= n %></td></tr>
              <% }) %>
              <tr><td class="py-1 text-slate-500">去重移除</td><td class="py-1 text-right font-mono"><%= prismaCounts.duplicates_removed %></td></tr>
              <tr><td class="py-1 text-slate-500">待筛选</td><td class="py-1 text-right font-mono"><%= prismaCounts.records_screened %></td></tr>
              <tr><td class="py-1 text-slate-500">标题/摘要排除</td><td class="py-1 text-right font-mono"><%= prismaCounts.excluded_title_abstract %></td></tr>
              <tr><td class="py-1 text-slate-500">全文评估</td><td class="py-1 text-right font-mono"><%= prismaCounts.full_text_assessed %></td></tr>
              <tr><td class="py-1 text-slate-500">全文排除</td><td class="py-1 text-right font-mono"><%= prismaCounts.full_text_excluded %></td></tr>
              <tr><td class="py-1 font-semibold text-slate-800">最终纳入</td><td class="py-1 text-right font-mono font-semibold text-slate-800"><%= prismaCounts.studies_included %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Section 卡片 -->
    <div class="space-y-3">
      <h3 class="text-sm font-medium uppercase text-slate-400">章节(<%= sectionList.length %> 个)</h3>
      <% sectionList.forEach((s, i) => {
        const statusCfg = s.has_content
          ? (s.user_edited ? ['bg-blue-100 text-blue-700', '已编辑'] : ['bg-emerald-100 text-emerald-700', '已生成'])
          : ['bg-slate-100 text-slate-500', '未生成']
      %>
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <details>
            <summary class="cursor-pointer list-none">
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-700"><%= i + 1 %></span>
                  <div>
                    <p class="text-sm font-semibold text-slate-800"><%= s.label %></p>
                    <% if (s.has_content) { %>
                      <p class="text-xs text-slate-500"><%= s.content_preview %>…</p>
                    <% } %>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <% if (s.citation_count > 0) { %>
                    <span class="text-xs text-slate-500"><%= s.citation_count %> 引用</span>
                  <% } %>
                  <span class="flex-none rounded-full px-2 py-0.5 text-[10px] <%= statusCfg[0] %>">
                    <%= statusCfg[1] %><%= s.version > 1 ? ' v' + s.version : '' %>
                  </span>
                </div>
              </div>
            </summary>

            <div class="mt-3 space-y-3">
              <% if (s.has_content) { %>
                <div class="rounded-lg border border-slate-100 bg-slate-50 p-3 text-sm whitespace-pre-wrap font-mono text-slate-800 max-h-96 overflow-y-auto"><%= s.content_markdown %></div>
              <% } %>

              <div class="flex flex-wrap items-center gap-2">
                <form method="post" action="/projects/<%= project.id %>/report/generate-section"
                      onsubmit="return confirm('调用 LLM 生成“<%= s.label %>”章节(单次约 8K tokens / 1-3 分钟)。是否继续?')">
                  <input type="hidden" name="section" value="<%= s.section_name %>">
                  <button type="submit" class="rounded-lg bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">
                    <%= s.has_content ? '重新生成' : '生成' %>
                  </button>
                </form>

                <% if (s.has_content && s.section_id) { %>
                  <button type="button"
                          class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50"
                          onclick="document.getElementById('edit-form-<%= s.section_name %>').classList.toggle('hidden')">
                    编辑
                  </button>
                <% } %>
              </div>

              <% if (s.has_content && s.section_id) { %>
                <form id="edit-form-<%= s.section_name %>" method="post"
                      action="/projects/<%= project.id %>/report/section/<%= s.section_id %>/edit"
                      class="hidden space-y-2 rounded-lg border border-slate-200 bg-white p-3">
                  <textarea name="content_markdown" rows="18"
                            class="w-full rounded border border-slate-300 px-2 py-1 text-xs font-mono"><%= s.content_markdown %></textarea>
                  <div class="flex justify-end gap-2">
                    <button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">保存为新版本</button>
                  </div>
                </form>
              <% } %>
            </div>
          </details>
        </div>
      <% }) %>
    </div>

    <!-- ========== 插图区(Phase 9 Agent W)========== -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <div class="flex items-baseline justify-between">
        <h3 class="text-sm font-medium uppercase text-slate-400">综述插图</h3>
        <span class="text-xs text-slate-500">程序生成 + AI 提示词</span>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        系统综述常配 3-5 张图。平台直接出"程序可算"的图(PRISMA flow / 年度趋势 / evidence map);
        其它(概念框架 / 主题关系)只能给你提示词,自己拿去 ChatGPT 或 Midjourney 跑。
      </p>

      <!-- 程序生成的图 -->
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
          <p class="text-xs font-medium text-slate-700">Figure 1 · 年度发表趋势</p>
          <p class="mt-0.5 text-[11px] text-slate-500">已纳入论文按年份聚合(<%= yearTrendData.total %> 篇,<%= yearTrendData.years.length %> 个年份)</p>
          <div class="mt-2 overflow-x-auto"><%- yearTrendSvg %></div>
        </div>
        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
          <p class="text-xs font-medium text-slate-700">Figure 2 · Evidence Map</p>
          <p class="mt-0.5 text-[11px] text-slate-500">主题 × 支持论文数(色块表证据强度)</p>
          <div class="mt-2 overflow-x-auto"><%- evidenceMapSvg %></div>
        </div>
      </div>
      <p class="mt-2 text-[11px] text-slate-400">PRISMA flow diagram 见上方独立卡片。导出 Markdown 时会自动包含。</p>

      <!-- AI 提示词 -->
      <div class="mt-5 border-t border-slate-100 pt-4">
        <p class="text-xs font-medium uppercase text-slate-500">AI 生成提示词(不在平台内出图)</p>
        <div class="mt-1 rounded-lg bg-blue-50 px-3 py-2 text-xs text-blue-800">
          <strong>说明:</strong> 平台后端用的是文本模型(Claude / GPT 系列),<u>不能直接生成图像</u>。
          下面给的是 prompt,请复制到 <a href="https://chat.openai.com/" target="_blank" rel="noopener" class="underline">ChatGPT(自带 DALL-E)</a>
          或 Midjourney / Stable Diffusion 网页版,由那边的图像模型出图。
        </div>

        <div class="mt-3 space-y-3">
          <% (figurePrompts || []).forEach((fp, i) => { %>
            <details class="rounded-lg border border-slate-200 bg-white">
              <summary class="cursor-pointer list-none px-4 py-3">
                <div class="flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-slate-800">Figure <%= 3 + i %> · <%= fp.title %></p>
                    <p class="mt-0.5 text-xs text-slate-500"><%= fp.when_to_use %></p>
                  </div>
                  <span class="flex-none text-xs text-slate-400">展开 / 复制</span>
                </div>
              </summary>
              <div class="border-t border-slate-100 px-4 py-3 space-y-2">
                <p class="text-[11px] text-slate-500"><strong>用法:</strong> <%= fp.copy_hint %></p>
                <textarea id="figprompt-<%= fp.id %>"
                          readonly rows="14"
                          class="w-full rounded border border-slate-300 bg-slate-50 px-2 py-1 text-xs font-mono text-slate-800"><%= fp.prompt %></textarea>
                <div class="flex justify-end">
                  <button type="button"
                          onclick="(function(){var t=document.getElementById('figprompt-<%= fp.id %>');t.select();document.execCommand('copy');this.textContent='✓ 已复制';setTimeout(()=>{this.textContent='复制提示词'}, 2000)}).call(this)"
                          class="rounded bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">
                    复制提示词
                  </button>
                </div>
              </div>
            </details>
          <% }) %>
        </div>
      </div>
    </div>

    <details class="rounded-2xl border border-slate-200 bg-white p-5">
      <summary class="cursor-pointer text-sm font-medium uppercase text-slate-400">本步骤覆盖的 PRISMA 2020 清单项</summary>
      <ul class="mt-3 space-y-3 text-sm">
        <% stepItems.forEach(it => { %>
          <li class="flex gap-3">
            <span class="flex-none rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700">#<%= it.item_number %></span>
            <div class="min-w-0">
              <p class="font-medium text-slate-800"><%= it.topic %> <span class="text-xs font-normal text-slate-400">· <%= it.section %></span></p>
              <p class="mt-0.5 text-xs text-slate-500"><%= it.recommendation %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    </details>

    <div class="flex justify-between text-sm">
      <a href="/projects/<%= project.id %>/certainty" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-700 hover:bg-slate-50">← 返回证据强度</a>
      <a href="/projects/<%= project.id %>" class="rounded-lg bg-slate-900 px-3 py-2 text-white hover:bg-slate-700">返回项目主页</a>
    </div>
  </section>
</div>

<!-- Mermaid + 轮询 -->
<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
<script>
  if (window.mermaid) {
    window.mermaid.initialize({ startOnLoad: true, theme: 'default' })
  }

  // 如果有正在跑的 job,每 5 秒轮询一次,完成后刷新页面
  <% if (job && !job.done) { %>
    (function() {
      const projectId = <%- JSON.stringify(project.id) %>
      function poll() {
        fetch('/projects/' + projectId + '/report/progress.json', { credentials: 'same-origin' })
          .then(r => r.json())
          .then(data => {
            if (data && data.job && data.job.done) {
              location.reload()
            } else {
              setTimeout(poll, 5000)
            }
          })
          .catch(() => setTimeout(poll, 10000))
      }
      setTimeout(poll, 5000)
    })()
  <% } %>
</script>

<%- include('../partials/footer') %>

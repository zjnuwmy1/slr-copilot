          <% } else { %>
            <form id="drafting-plan-form" method="post" action="/projects/<%= project.id %>/report/generate-plan">
              <% if (typeof ingestSummary !== 'undefined' && ingestSummary) { %>
                <div class="mb-1.5 flex max-w-[420px] flex-wrap justify-end gap-1"><%- _btnChips(ingestSummary, 'plan') %></div>
              <% } %>
              <button type="submit" id="drafting-plan-btn"
                      class="rounded-lg <%= _draftingPlanStale ? 'bg-amber-600 hover:bg-amber-500' : 'bg-indigo-600 hover:bg-indigo-500' %> px-3 py-2 text-xs font-medium text-white shadow-sm">
                <% if (_draftingPlanStale) { %>
                  <% if (_draftingPlanStaleReason === 'overlay_added' || _draftingPlanStaleReason === 'overlay_updated') { %>
                    ↻ 重新生成大纲(带入 overlay)
                  <% } else { %>
                    ↻ 重新生成大纲(协议已升级)
                  <% } %>
                <% } else { %>
                  ⚙️ 生成全局大纲(Opus 一次性,3-5 min)
                <% } %>
              </button>
            </form>
          <% } %>
        </div>
      </div>
      <% if (_draftingPlan && !_draftingPlanStale) { %>
        <details class="mt-3 text-xs">
          <summary class="cursor-pointer text-emerald-800 hover:text-emerald-900 font-medium">查看大纲(<%= _draftingPlan.sections ? _draftingPlan.sections.length : 0 %> 章 / <%= _planParaCount %> 段)▾</summary>
          <div class="mt-3 space-y-3 rounded-lg border border-emerald-200 bg-white p-3">
            <% if (_draftingPlan.narrative_arc) { %>
              <p class="text-[12px] text-slate-700"><span class="font-semibold">叙事弧:</span><%= _draftingPlan.narrative_arc %></p>
            <% } %>
            <% (_draftingPlan.sections || []).forEach(function(sec, si) { %>
              <div class="rounded border border-slate-200 bg-slate-50 p-2">
                <p class="text-[12px] font-semibold text-slate-900">§ <%= sec.name %><% if (sec.section_thesis) { %> — <span class="font-normal text-slate-600"><%= sec.section_thesis %></span><% } %></p>
                <% if (Array.isArray(sec.paragraphs) && sec.paragraphs.length) { %>
                  <ol class="mt-1 ml-4 list-decimal space-y-1 text-[11px] text-slate-700">
                    <% sec.paragraphs.forEach(function(p) { %>
                      <li>
                        <% if (p.kind) { %><span class="rounded bg-indigo-100 px-1 text-[10px] text-indigo-800"><%= p.kind %></span> <% } %>
                        <%= p.message || '' %>
                        <% if (Array.isArray(p.supporting_record_ids) && p.supporting_record_ids.length) { %>
                          <span class="ml-1 text-[10px] text-emerald-700">[<%= p.supporting_record_ids.slice(0,4).join(', ') %><%= p.supporting_record_ids.length > 4 ? '…' : '' %>]</span>
                        <% } %>
                        <% if (p.must_avoid) { %>
                          <div class="ml-1 text-[10px] text-amber-700">⚠ avoid: <%= p.must_avoid %></div>
                        <% } %>
                      </li>
                    <% }) %>
                  </ol>
                <% } %>
              </div>
            <% }) %>
            <% if (_draftingPlan.cross_section_handoffs && Object.keys(_draftingPlan.cross_section_handoffs).length) { %>
              <div class="rounded border border-slate-200 bg-white p-2">
                <p class="text-[11px] font-semibold text-slate-700">章节间交接</p>
                <ul class="mt-1 space-y-0.5 text-[11px] text-slate-600">
                  <% Object.entries(_draftingPlan.cross_section_handoffs).forEach(function(pair) { %>
                    <li><span class="font-mono text-slate-500"><%= pair[0] %></span> · <%= pair[1] %></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>
          </div>
        </details>
      <% } %>
    </div>

    <!-- ============================================================ -->
    <!-- Phase 8.A · 撰写主进度卡(对照 cert-run-card)-->
    <!-- ============================================================ -->
    <div id="drafting-run-card"
         class="rounded-2xl border <%= _draftingRunInFlight ? 'border-blue-300 bg-blue-50/40' : (_draftingRunStatus === 'failed' || _draftingRunStatus === 'aborted_by_restart' ? 'border-rose-300 bg-rose-50/40' : 'border-slate-200 bg-white') %> p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <h2 class="text-base font-semibold text-slate-900">📝 综述撰写主进度</h2>
          <p class="mt-1 text-sm text-slate-500">
            <% if (_customSections.length) { %>
              <%= _customSections.length %> 个章节 · 已生成 <%= _draftSummary.generated || 0 %>
              <% if (_draftSummary.in_progress) { %>· 进行中 <%= _draftSummary.in_progress %><% } %>
              <% if (_draftSummary.failed) { %>· 失败 <%= _draftSummary.failed %><% } %>
              · 待生成 <%= Math.max(0, (_draftSummary.pending || (_customSections.length - (_draftSummary.generated || 0)))) %>
            <% } else { %>
              章节模板尚未注入(等待 server 端 customSections)。可单独生成下方章节,或上传期刊模板后一键生成。
            <% } %>
          </p>
          <%
            // 优化打磨包 / Session-continuity 显示
            const _dsId = (typeof draftingSessionId !== 'undefined') ? draftingSessionId : null
            const _dsProv = (typeof draftingSessionProvider !== 'undefined') ? draftingSessionProvider : null
            const _dsFirst = (typeof draftingSessionFirstSection !== 'undefined') ? draftingSessionFirstSection : null
            const _dsStarted = (typeof draftingSessionStartedAt !== 'undefined') ? draftingSessionStartedAt : null
          %>
          <% if (_dsId) { %>
            <p class="mt-2 text-[11px] text-violet-700 bg-violet-50 inline-block rounded px-2 py-1">
              🔗 上次跑启用了 <strong>Session-continuity</strong>(<%= _dsProv || 'anthropic-cli' %>)·
              session = <code class="font-mono text-[10px]"><%= String(_dsId).slice(0, 8) %>…</code>
              <% if (_dsFirst) { %>· 首章 <code class="font-mono text-[10px]"><%= _dsFirst %></code><% } %>
              <% if (_dsStarted) { %>· 开始于 <%= _dsStarted %><% } %>
            </p>
            <p class="mt-1 text-[10px] text-slate-500">每章 LLM 真的看见上章原文,而不是 150 字摘要 — 给"语言一致性必须无瑕疵"的项目使用。</p>
          <% } else if (typeof draftingSessionProvider !== 'undefined') { %>
            <p class="mt-2 text-[10px] text-slate-500">
              一键生成时若 heavy 模型走 Claude CLI 会自动启用 Session-continuity(章节间共享对话上下文)。
            </p>
          <% } %>
        </div>
      </div>

      <!-- 进度卡(in-flight 时显示;3 段计时 已用 / 预估 / 最长 + 💓 心跳)-->
      <div id="drafting-run-progress" class="mt-4 <%= _draftingRunInFlight ? '' : 'hidden' %>"
           data-started="<%= _draftingRunStarted %>"
           data-estimated="<%= _estimatedSecondsDraft %>"
           data-hard-max="<%= _hardMaxSecondsDraft %>"
           data-sections-total="<%= _sectionsTotal %>">
        <div class="rounded-xl border border-blue-200 bg-white/70 p-4">
          <div class="flex items-center gap-3">
            <svg class="h-5 w-5 animate-spin text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 008-8h-4a4 4 0 01-4 4z"></path>
            </svg>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold text-blue-900">正在顺序生成综述章节</p>
              <p class="mt-0.5 text-xs text-blue-700">
                <%= _sectionsTotal %> 章 · 已完成 <span id="drafting-completed-n"><%= (_draftingRunMeta && _draftingRunMeta.sections_completed) || (_draftSummary.generated || 0) %></span>
                <span id="drafting-current-section">
                  <% if (_draftingRunMeta && _draftingRunMeta.current_section) { %> · 正在写 <%= _draftingRunMeta.current_section %><% } %>
                </span>
              </p>
            </div>
          </div>
          <div class="mt-3 grid grid-cols-3 gap-3 text-center">
            <div class="rounded-lg bg-blue-50 p-2">
              <p class="text-[10px] uppercase tracking-wide text-blue-600">已用</p>
              <p class="mt-0.5 text-xl font-mono font-bold text-blue-900"><span id="drafting-elapsed">0:00</span></p>
            </div>
            <div class="rounded-lg bg-emerald-50 p-2">
              <p class="text-[10px] uppercase tracking-wide text-emerald-600">预估</p>
              <p class="mt-0.5 text-xl font-mono font-bold text-emerald-800">~<%= Math.round(_estimatedSecondsDraft / 60) %>:00</p>
              <p class="text-[9px] text-emerald-500"><%= _sectionsTotal %> 章按 5 min/章</p>
            </div>
            <div class="rounded-lg bg-amber-50 p-2">
              <p class="text-[10px] uppercase tracking-wide text-amber-600">最长(硬超时)</p>
              <p class="mt-0.5 text-xl font-mono font-bold text-amber-800"><%= Math.round(_hardMaxSecondsDraft / 60) %>:00</p>
              <p class="text-[9px] text-amber-500">超时会自动中断</p>
            </div>
          </div>
          <div class="mt-3 h-2 w-full rounded-full bg-blue-100 overflow-hidden">
            <div id="drafting-progress-bar" class="h-full bg-blue-500 transition-all duration-1000" style="width: 0%"></div>
          </div>
          <div class="mt-2 flex items-center justify-between text-[11px]">
            <span id="drafting-stage-hint" class="text-blue-600">📡 提交 LLM 中…(可关闭页面,后台继续)</span>
            <span id="drafting-heartbeat" class="text-slate-500 font-mono">💓 等待心跳…</span>
          </div>
        </div>
      </div>

      <!-- 失败 / 成功摘要 -->
      <% if (!_draftingRunInFlight && (_draftingRunStatus === 'failed' || _draftingRunStatus === 'aborted_by_restart')) { %>
        <div class="mt-4 rounded-xl border border-rose-200 bg-white p-4">
          <p class="text-sm font-semibold text-rose-900">⚠ 上次撰写失败<% if (_draftingRunStatus === 'aborted_by_restart') { %>(服务重启中断)<% } %></p>
          <% if (_draftingRunError) { %>
            <pre class="mt-2 max-h-32 overflow-auto whitespace-pre-wrap rounded border border-rose-200 bg-rose-50 p-2 text-[11px] text-rose-900"><%= _draftingRunError %></pre>
          <% } %>
          <p class="mt-2 text-xs text-rose-700">已生成的章节会保留;直接重跑会从未完成处继续(失败章节会覆盖重写)。</p>
        </div>
      <% } %>
      <% if (!_draftingRunInFlight && _draftingRunStatus === 'success' && _draftingRunMeta) { %>
        <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-3">
          <p class="text-xs text-emerald-800">
            ✓ 上次撰写成功 ·
            <%= _draftingRunMeta.sections_generated || _draftingRunMeta.sections_completed || _draftSummary.generated || '?' %> 章 ·
            <%= _draftingRunMeta.duration_ms ? Math.round(_draftingRunMeta.duration_ms / 1000) + 's' : '' %>
            <% if (_draftingRunMeta.model) { %> · <%= _draftingRunMeta.model %><% } %>
            <% if (_draftingRunFinished) { %> · <%= _draftingRunFinished %> UTC<% } %>
          </p>
        </div>
      <% } %>
    </div>

    <!-- 期刊模板卡已移至 overlay 卡之前(优化打磨包) -->
    <% /* placeholder — 已经在 overlay 卡上方渲染 */ %>

    <!-- ============================================================ -->
    <!-- 📊 这一步会带入的输入数据(对照 certainty / synthesis 同款画像)-->
    <!--   让用户看清楚 LLM 写每个章节时实际看见的全部数据来源 + 计数。 -->
    <!-- ============================================================ -->
    <% if (typeof ingestSummary !== 'undefined' && ingestSummary) { %>
      <%
        const _is = ingestSummary
        const dotOk    = '<span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 align-middle"></span>'
        const dotWarn  = '<span class="inline-block h-1.5 w-1.5 rounded-full bg-amber-500 align-middle"></span>'
        const dotMiss  = '<span class="inline-block h-1.5 w-1.5 rounded-full bg-slate-300 align-middle"></span>'
      %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold text-slate-900">📊 这一步会带入的输入数据</h2>
            <p class="mt-1 text-xs text-slate-500">
              撰写每个章节时,LLM 都会看到下面这些数据。<strong>原汁原味注入</strong> —— 不再做截断 / 摘要 / 二次概括。
              数字直接来自数据库(实时计数),不是估算。
            </p>
          </div>
          <div class="text-[11px] text-slate-400">
            写作顺序:① 通用骨架 → ② 项目 overlay → ③ 章节级写作 system → ④ 全部下列数据
          </div>
        </div>

        <!-- 第一排:协议 · 文献池 · 矩阵 · RoB -->
        <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <!-- a) 协议 -->
          <div class="rounded-lg border <%= _is.protocol.loaded ? 'border-emerald-200 bg-emerald-50/40' : 'border-rose-200 bg-rose-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">① 已批协议</p>
            <% if (_is.protocol.loaded) { %>
              <p class="mt-1 text-xl font-bold text-emerald-700 leading-none">v<%= _is.protocol.version %></p>
              <p class="mt-1 text-[11px] text-slate-600">
                RQ × <%= _is.protocol.rq_count %> · 概念组 × <%= _is.protocol.pico_concept_count %>
              </p>
            <% } else { %>
              <p class="mt-1 text-xl font-bold text-rose-700 leading-none">未批</p>
              <p class="mt-1 text-[11px] text-rose-600">需先在 Step 1 审批协议</p>
            <% } %>
          </div>

          <!-- b) 纳入论文 -->
          <div class="rounded-lg border <%= (_is.papers.included_n > 0) ? 'border-emerald-200 bg-emerald-50/40' : 'border-slate-200 bg-slate-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">② 纳入论文</p>
            <p class="mt-1 text-xl font-bold <%= _is.papers.included_n > 0 ? 'text-emerald-700' : 'text-slate-400' %> leading-none"><%= _is.papers.included_n %></p>
            <p class="mt-1 text-[11px] text-slate-600">全文 include · 去重后</p>
          </div>

          <!-- c) Step 4 矩阵 -->
          <div class="rounded-lg border <%= (_is.matrix.rows_n > 0) ? 'border-emerald-200 bg-emerald-50/40' : 'border-amber-200 bg-amber-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">③ 文献矩阵</p>
            <p class="mt-1 text-xl font-bold <%= _is.matrix.rows_n > 0 ? 'text-emerald-700' : 'text-amber-700' %> leading-none"><%= _is.matrix.rows_n %></p>
            <p class="mt-1 text-[11px] text-slate-600">Step 4 抽取字段(全量,无截断)</p>
          </div>

          <!-- d) Step 5 RoB(主评 pass-1 + 复核 pass-2 拆分显示)-->
          <div class="rounded-lg border <%= (_is.rob.pass1_n > 0) ? 'border-emerald-200 bg-emerald-50/40' : 'border-amber-200 bg-amber-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">④ 偏倚风险评估</p>
            <p class="mt-1 text-xl font-bold <%= _is.rob.pass1_n > 0 ? 'text-emerald-700' : 'text-amber-700' %> leading-none"><%= _is.rob.pass1_n != null ? _is.rob.pass1_n : _is.rob.rows_n %></p>
            <p class="mt-1 text-[11px] text-slate-600">
              主评(pass-1)<% if (_is.rob.pass2_n > 0) { %> · 复核(pass-2)+<%= _is.rob.pass2_n %><% } %>
            </p>
          </div>
        </div>

        <!-- 第二排:Step 6 主题 · Step 7 证据强度 -->
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <!-- e) Step 6 主题 -->
          <div class="rounded-lg border <%= (_is.synthesis.themes_n > 0) ? 'border-violet-200 bg-violet-50/40' : 'border-slate-200 bg-slate-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑤ 主题</p>
            <p class="mt-1 text-xl font-bold <%= _is.synthesis.themes_n > 0 ? 'text-violet-700' : 'text-slate-400' %> leading-none"><%= _is.synthesis.themes_n %></p>
            <p class="mt-1 text-[11px] text-slate-600">Step 6(含 study_design_mix + rob_profile + methodological_note)</p>
          </div>

          <!-- e2) Step 6 跨主题观察 + 协议覆盖 -->
          <div class="rounded-lg border <%= (_is.synthesis.cross_cutting_n > 0 || _is.synthesis.protocol_coverage_rq_n > 0) ? 'border-violet-200 bg-violet-50/40' : 'border-slate-200 bg-slate-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑥ 综合元数据</p>
            <p class="mt-1 text-xl font-bold <%= (_is.synthesis.cross_cutting_n > 0 || _is.synthesis.protocol_coverage_rq_n > 0) ? 'text-violet-700' : 'text-slate-400' %> leading-none">
              <%= _is.synthesis.cross_cutting_n %><span class="text-slate-400 text-base"> + </span><%= _is.synthesis.protocol_coverage_rq_n %>
            </p>
            <p class="mt-1 text-[11px] text-slate-600">跨主题观察 + RQ 覆盖映射</p>
          </div>

          <!-- f) Step 7 主题级 GRADE+CERQual -->
          <div class="rounded-lg border <%= (_is.certainty.theme_rollup_n > 0) ? 'border-indigo-200 bg-indigo-50/40' : 'border-amber-200 bg-amber-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑦ 主题级证据强度</p>
            <p class="mt-1 text-xl font-bold <%= _is.certainty.theme_rollup_n > 0 ? 'text-indigo-700' : 'text-amber-700' %> leading-none"><%= _is.certainty.theme_rollup_n %></p>
            <p class="mt-1 text-[11px] text-slate-600">
              GRADE <%= _is.certainty.grade_themes_n %> · CERQual <%= _is.certainty.cerqual_themes_n %> · Hybrid <%= _is.certainty.hybrid_themes_n %>
            </p>
          </div>

          <!-- g) Step 7 outcome 级 SoF -->
          <div class="rounded-lg border <%= (_is.certainty.outcome_sof_n > 0) ? 'border-indigo-200 bg-indigo-50/40' : 'border-slate-200 bg-slate-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑧ Outcome 级 SoF</p>
            <p class="mt-1 text-xl font-bold <%= _is.certainty.outcome_sof_n > 0 ? 'text-indigo-700' : 'text-slate-400' %> leading-none"><%= _is.certainty.outcome_sof_n %></p>
            <p class="mt-1 text-[11px] text-slate-600">具体 outcome 5+3 维评级 + effect_size</p>
          </div>
        </div>

        <!-- 第三排:期刊模板 · overlay · plan · figures -->
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <!-- h) 期刊模板 -->
          <div class="rounded-lg border <%= _is.journal_template.loaded ? 'border-emerald-200 bg-emerald-50/40' : 'border-slate-200 bg-slate-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑨ 目标期刊模板</p>
            <p class="mt-1 text-xl font-bold <%= _is.journal_template.loaded ? 'text-emerald-700' : 'text-slate-400' %> leading-none">
              <%= _is.journal_template.loaded ? '✓' : '—' %>
            </p>
            <p class="mt-1 text-[11px] text-slate-600">
              <% if (_is.journal_template.loaded) { %>章节结构 × <%= _is.journal_template.sections_n %> · voice / 引文密度<% } else { %>未上传(将用通用 9 章节)<% } %>
            </p>
          </div>

          <!-- i) overlay -->
          <div class="rounded-lg border <%= _is.overlay.loaded ? 'border-emerald-200 bg-emerald-50/40' : (_is.overlay.stale ? 'border-amber-200 bg-amber-50/40' : 'border-slate-200 bg-slate-50/40') %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑩ 项目 overlay</p>
            <p class="mt-1 text-xl font-bold <%= _is.overlay.loaded ? 'text-emerald-700' : (_is.overlay.stale ? 'text-amber-700' : 'text-slate-400') %> leading-none">
              <% if (_is.overlay.loaded) { %>v<%= _is.overlay.at_version || '?' %><% } else if (_is.overlay.stale) { %>过期<% } else { %>—<% } %>
            </p>
            <p class="mt-1 text-[11px] text-slate-600">
              <% if (_is.overlay.loaded) { %>项目专用写作指引<% } else if (_is.overlay.stale) { %>需重新生成<% } else { %>未生成(可跳过)<% } %>
            </p>
          </div>

          <!-- j) plan(manuscript thesis + 段落级 outline)-->
          <div class="rounded-lg border <%= _is.plan.loaded ? 'border-emerald-200 bg-emerald-50/40' : (_is.plan.stale ? 'border-amber-200 bg-amber-50/40' : 'border-slate-200 bg-slate-50/40') %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑪ 全文大纲(plan)</p>
            <p class="mt-1 text-xl font-bold <%= _is.plan.loaded ? 'text-emerald-700' : (_is.plan.stale ? 'text-amber-700' : 'text-slate-400') %> leading-none">
              <%= _is.plan.loaded ? _is.plan.sections_planned_n : (_is.plan.stale ? '过期' : '—') %>
            </p>
            <p class="mt-1 text-[11px] text-slate-600">
              <% if (_is.plan.loaded) { %>段落级 outline + 跨章节论点<% } else if (_is.plan.stale) { %>需重新生成<% } else { %>未生成(可跳过)<% } %>
            </p>
          </div>

          <!-- k) figures -->
          <div class="rounded-lg border <%= (_is.figures.ai_prompts_n + _is.figures.user_uploaded_n > 0) ? 'border-emerald-200 bg-emerald-50/40' : 'border-slate-200 bg-slate-50/40' %> p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500">⑫ 图(可插入)</p>
            <p class="mt-1 text-xl font-bold <%= (_is.figures.ai_prompts_n + _is.figures.user_uploaded_n > 0) ? 'text-emerald-700' : 'text-slate-400' %> leading-none">
              <%= _is.figures.user_uploaded_n %><span class="text-slate-400 text-base">/</span><%= _is.figures.ai_prompts_n %>
            </p>
            <p class="mt-1 text-[11px] text-slate-600">已上传 / AI 推荐图位</p>
          </div>
        </div>

        <!-- 章节信息条 -->
        <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50/40 p-3 text-xs text-slate-600">
          <div class="flex flex-wrap items-center gap-4">
            <span><strong class="text-slate-800">章节数:</strong><%= _is.sections.total %></span>
            <span><strong class="text-slate-800">含字数目标:</strong><%= _is.sections.with_target_words %></span>
            <span><strong class="text-slate-800">PRISMA 命中:</strong>检索 <%= _is.prisma.identified_total %> → 纳入 <%= _is.prisma.included %></span>
          </div>
        </div>

        <!-- 折叠详情:每条数据"怎么用 + 在哪个章节出场" -->
        <details class="mt-3 text-xs">
          <summary class="cursor-pointer text-slate-600 hover:text-slate-800 font-medium">查看每个数据源的具体用途 ▾</summary>
          <div class="mt-3 grid gap-2 md:grid-cols-2">
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">① 协议 + RQ</p>
              <p class="mt-1 text-slate-600">所有章节都锚定 PICO / 研究问题。Introduction 的 rationale 段直接引用;Methods 写检索 / 入排;Results / Discussion 按 RQ 组织。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">② 纳入论文 + ③ 文献矩阵</p>
              <p class="mt-1 text-slate-600">原汁原味喂入(每篇 matrix.fields 全字段,无截断)。Results 段引文 + 量化数据全部来自这里;Discussion 的"已有发现 vs 本综述"对照也基于此。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">④ RoB 评估</p>
              <p class="mt-1 text-slate-600">Methods 写"我们用 X 工具评 RoB";Results 写"N 篇低 RoB / M 篇高 RoB";Discussion 的 "limitations" 段说明质量分布对结论的影响。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">⑤ 主题 + ⑥ 综合元数据</p>
              <p class="mt-1 text-slate-600">Results 的主体结构 — 每个主题一节,带 study_design_mix / rob_profile / methodological_note。"跨主题观察"喂入 Discussion;"RQ 覆盖映射"喂入 Discussion 的 "evidence gap" 段。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">⑦ 主题级证据强度 + ⑧ Outcome SoF</p>
              <p class="mt-1 text-slate-600">每个主题/outcome 的 GRADE/CERQual 评级 + body_of_evidence_summary + implications。Discussion 的"strength of evidence"段直接引用;Conclusion 的 practice / research implication 段也基于此。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">⑨ 期刊模板</p>
              <p class="mt-1 text-slate-600">动态生成章节列表(替代通用 9 章节)、voice / register、引文密度建议、各 section 长度上限 — 全部按目标期刊的真实样本反推。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">⑩ Overlay(可选 · 强烈推荐)</p>
              <p class="mt-1 text-slate-600">由 Opus 一次性基于本项目协议 + 主题 + 期刊模板生成的 "项目专用写作指引"。锚定本项目特定术语 / 数字 / 关键贡献点 — 避免生成泛而平的句子。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">⑪ Plan(可选 · 强烈推荐)</p>
              <p class="mt-1 text-slate-600">段落级 outline + manuscript_thesis + 章节间 handoff(每章末段如何衔接下一章)+ must_avoid(防跨章重复)。"⚡ 一键生成全部" 时,每章节按 plan 段落写,统一论点贯穿。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">⑫ Figures(用户上传 + AI 推荐)</p>
              <p class="mt-1 text-slate-600">AI 推荐图位 + 用户外部生成(BioRender / draw.io / 自己画)的图片资产。LLM 写 Results / Discussion 时插入 [fig:fig_xxx] 占位,导出时自动替换为图片引用。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">+ Citation cheat sheet</p>
              <p class="mt-1 text-slate-600">每篇 record 的 inline citation 预渲染表(Author, Year),LLM 用 [rec_xxx] 占位,导出时自动替换为 (Smith et al., 2024)。</p>
            </div>
            <div class="rounded border border-slate-200 bg-white p-3">
              <p class="font-semibold text-slate-800">+ Prior section summaries(session 内)</p>
              <p class="mt-1 text-slate-600">"⚡ 一键生成全部" 时,后写的章节看得到先写章节的 150 字 peer_summary — 杜绝重复 + 保证论点贯穿。</p>
            </div>
          </div>
        </details>
      </div>
    <% } %>

    <!-- ============================================================ -->
    <span id="nav-prisma" class="block" style="scroll-margin-top: 80px;"></span>
    <!-- 📐 PRISMA Flow Diagram(系统 Figure 1 · 数据派生,纯计算)     -->
    <!--   写作时序:                                                  -->
    <!--     ① PRISMA Flow(本卡,自动派生)                            -->
    <!--     ② 数据型表(下一卡,15 张派生表 + AI 推荐过滤)              -->
    <!--     ③ 概念型图(底部 figure 区,用户外部生成 + 上传)             -->
    <!--     ④ 综述初稿编辑器(LLM 写,引用 [fig:xxx] [tbl:xxx])         -->
    <!-- ============================================================ -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="text-sm font-medium uppercase text-slate-400">📐 PRISMA Flow Diagram <span class="ml-2 text-[10px] text-slate-400">[fig:prisma · 系统 Figure 1]</span></h3>
        <span class="text-[11px] text-slate-500">数字从数据库精确计算,不由 LLM 生成。</span>
      </div>

      <div class="mt-3 grid gap-4 md:grid-cols-2">
        <!-- Mermaid 图 -->
        <div class="overflow-x-auto rounded-lg border border-slate-100 bg-slate-50 p-3">
          <pre class="mermaid text-xs"><%- prismaMermaid %></pre>
        </div>
        <!-- 数字概览 -->
        <div class="text-sm">
          <table class="w-full">
            <tbody class="divide-y divide-slate-100">
              <tr><td class="py-1 text-slate-500">检索命中(去重前)</td><td class="py-1 text-right font-mono"><%= prismaCounts.records_identified_total %></td></tr>
              <% Object.entries(prismaCounts.records_identified || {}).forEach(([k,n]) => { %>
                <tr><td class="py-1 pl-3 text-xs text-slate-400">· <%= k %></td><td class="py-1 text-right font-mono text-xs text-slate-400"><%= n %></td></tr>
              <% }) %>
              <tr><td class="py-1 text-slate-500">去重移除</td><td class="py-1 text-right font-mono"><%= prismaCounts.duplicates_removed %></td></tr>
              <tr><td class="py-1 text-slate-500">待筛选</td><td class="py-1 text-right font-mono"><%= prismaCounts.records_screened %></td></tr>
              <% if ((prismaCounts.excluded_title_abstract || 0) > 0) { %>
                <tr><td class="py-1 text-slate-500">标题/摘要排除</td><td class="py-1 text-right font-mono text-rose-600"><%= prismaCounts.excluded_title_abstract %></td></tr>
              <% } %>
              <tr><td class="py-1 text-slate-500">全文评估</td><td class="py-1 text-right font-mono"><%= prismaCounts.full_text_assessed %></td></tr>
              <% if ((prismaCounts.full_text_excluded || 0) > 0) { %>
                <tr><td class="py-1 text-slate-500">全文排除</td><td class="py-1 text-right font-mono text-rose-600"><%= prismaCounts.full_text_excluded %></td></tr>
              <% } %>
              <% if ((prismaCounts.rob_excluded || 0) > 0) { %>
                <tr><td class="py-1 text-slate-500">通过全文筛(待 RoB 评)</td><td class="py-1 text-right font-mono"><%= prismaCounts.studies_eligible_for_rob %></td></tr>
                <tr><td class="py-1 text-slate-500">RoB 阶段排除(Step 5)</td><td class="py-1 text-right font-mono text-rose-600"><%= prismaCounts.rob_excluded %></td></tr>
              <% } %>
              <tr><td class="py-1 font-semibold text-slate-800">最终纳入(综合用)</td><td class="py-1 text-right font-mono font-semibold text-slate-800"><%= prismaCounts.studies_included %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 🎨 综述插图区(用户外部生成 + 上传:概念图 / 框架图,与上方 PRISMA Flow 互补)-->
    <%
      // 2026-05-26 算所有上传插图总数(给"删除全部"按钮显示 + 隐藏判断)
      let _allUploadsN = 0
      try {
        if (typeof figureAssetsByKey !== 'undefined' && figureAssetsByKey) {
          for (const k of Object.keys(figureAssetsByKey)) {
            _allUploadsN += (figureAssetsByKey[k] || []).length
          }
        }
      } catch {}
    %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5" id="nav-figures">
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="text-sm font-medium uppercase text-slate-400">🎨 综述插图区 <span class="ml-2 text-[10px] text-slate-400">(用户外部生成 + 上传)</span></h3>
        <div class="flex items-center gap-2">
          <% if (_allUploadsN > 0) { %>
            <%# 2026-05-26 一键删全部 — 跨所有 figure prompt 卡的上传插图,DB + 文件全清 %>
            <form method="post" action="/projects/<%= project.id %>/report/figures/delete-all"
                  onsubmit="return confirm('确定删除全部 <%= _allUploadsN %> 张上传插图?\n文件 + DB 记录都会被永久删除(不影响 AI 出的 prompt 文本)。');"
                  class="inline">
              <button type="submit"
                      class="rounded-md border border-rose-300 bg-rose-50 px-2 py-1 text-[11px] font-medium text-rose-700 hover:bg-rose-100"
                      title="清空当前所有上传插图(<%= _allUploadsN %> 张)— 跨所有 figure prompt 卡,DB + 文件全删,不可恢复">
                🗑 删除全部上传插图(<%= _allUploadsN %>)
              </button>
            </form>
          <% } %>
          <span class="text-xs text-slate-500">程序生成 + AI 提示词</span>
        </div>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        系统综述常配 3-5 张图。平台直接出"程序可算"的图(PRISMA flow / 年度趋势 / evidence map);
        其它(概念框架 / 主题关系)只能给你提示词,自己拿去 ChatGPT 或 Midjourney 跑。
      </p>

      <!-- 程序生成的图 -->
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
          <p class="text-xs font-medium text-slate-700">Figure 1 · 年度发表趋势</p>
          <p class="mt-0.5 text-[11px] text-slate-500">已纳入论文按年份聚合(<%= yearTrendData.total %> 篇,<%= yearTrendData.years.length %> 个年份)</p>
          <div class="mt-2 overflow-x-auto"><%- yearTrendSvg %></div>
        </div>
        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
          <p class="text-xs font-medium text-slate-700">Figure 2 · Evidence Map</p>
          <p class="mt-0.5 text-[11px] text-slate-500">主题 × 支持论文数(色块表证据强度)</p>
          <div class="mt-2 overflow-x-auto"><%- evidenceMapSvg %></div>
        </div>
      </div>
      <p class="mt-2 text-[11px] text-slate-400">PRISMA flow diagram 见上方独立卡片。导出 Markdown 时会自动包含。</p>

      <!-- AI 提示词 -->
      <div class="mt-5 border-t border-slate-100 pt-4">
        <%
          // 2026-05-25:状态变量提到 outer 作用域,头条 + 卡片都用同一份
          //   关键:in-flight 时 hide 老 figures(不再以为"没在跑")
          const _figOptInFlight = !!(typeof figureOptimizeInFlight !== 'undefined' && figureOptimizeInFlight)
          const _figOptStarted  = (typeof figureOptimizeStartedAt !== 'undefined') ? (figureOptimizeStartedAt || '') : ''
          const _figOptStatus   = (typeof figureOptimizeStatus    !== 'undefined') ? (figureOptimizeStatus    || '') : ''
          const _figOptError    = (typeof figureOptimizeError     !== 'undefined') ? (figureOptimizeError     || '') : ''
          const _hasAiFigs      = !!(typeof aiOptimizedFigures !== 'undefined' && aiOptimizedFigures && aiOptimizedFigures.length)
        %>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="text-xs font-medium uppercase text-slate-500">AI 生成提示词(不在平台内出图)</p>
          <% if (_figOptInFlight) { %>
            <span id="fig-opt-status" class="rounded-lg bg-blue-100 px-3 py-1.5 text-xs font-mono text-blue-800"
                  data-started="<%= _figOptStarted %>"
                  title="LLM 正在跑 — 老版本暂时隐藏避免误用,完成后自动刷新">
              ⏳ 生成中…(已用 <span id="fig-opt-elapsed">0</span>s)<% if (_hasAiFigs) { %> · 老版本暂时隐藏<% } %>
            </span>
          <% } else if (_hasAiFigs) { %>
            <span class="rounded bg-violet-100 px-2 py-0.5 text-[11px] font-medium text-violet-800">✓ AI 一键优化(<%= aiOptimizedFigures.length %> 张项目专属)</span>
          <% } else { %>
            <form id="optimize-fig-form" method="post" action="/projects/<%= project.id %>/report/optimize-figure-prompts" class="inline">
              <% if (typeof ingestSummary !== 'undefined' && ingestSummary) { %>
                <div class="mb-1.5 flex flex-wrap gap-1"><%- _btnChips(ingestSummary, 'figure_prompts') %></div>
              <% } %>
              <button type="submit" id="optimize-fig-btn"
                      class="rounded-lg bg-violet-600 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-violet-500 transition"
                      title="Opus 4.8 + ultrathink 基于本项目协议 + 主题 + findings 一次性生成 5-8 张项目专属插图提示词;3-8 min,异步执行,关页面也不影响">
                ⚙️ AI 一键生成本项目专属插图 prompt
              </button>
            </form>
          <% } %>
          <% if (!_figOptInFlight && _figOptStatus === 'failed' && _figOptError) { %>
            <p class="mt-1 text-[11px] text-rose-700" title="<%= _figOptError %>">⚠ 上次失败:<%= String(_figOptError).slice(0, 100) %></p>
          <% } %>
        </div>
        <div class="mt-2 rounded-lg bg-blue-50 px-3 py-2 text-xs text-blue-800">
          <strong>说明:</strong> 平台后端用的是文本模型(Claude / GPT 系列),<u>不能直接生成图像</u>。
          下面给的是 prompt,请复制到 <a href="https://chat.openai.com/" target="_blank" rel="noopener" class="underline">ChatGPT(自带 DALL-E)</a>
          或 Midjourney / Stable Diffusion 网页版,由那边的图像模型出图。
        </div>

        <!-- 2026-05-25:in-flight 时 hide 老的 figure 卡片 — 避免用户以为没在跑 / 用老 prompt 出图 -->
        <% if (_figOptInFlight) { %>
        <div class="mt-3 rounded-lg border-2 border-dashed border-blue-300 bg-blue-50/40 p-4 text-center">
          <div class="flex items-center justify-center gap-2 text-sm text-blue-900">
            <svg class="h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 008-8h-4a4 4 0 01-4 4z"></path>
            </svg>
            <span class="font-medium">Opus 4.8 + ultrathink 正在重生成插图 prompt</span>
          </div>
          <p class="mt-2 text-[12px] text-blue-700">
            预计 3-8 分钟。<% if (_hasAiFigs) { %>已有的 <%= aiOptimizedFigures.length %> 张老版本暂时隐藏(避免你误复制老 prompt 去外部出图),完成后自动展示新版。<% } %>
          </p>
          <p class="mt-1 text-[11px] text-blue-600">
            📡 后台异步执行,可关闭浏览器 — 完成后页面会自动刷新显示新 prompt。
          </p>
        </div>
        <% } else if (_hasAiFigs) { %>
        <div class="mt-3 rounded-lg border-2 border-violet-200 bg-violet-50/40 p-3">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="text-xs font-medium text-violet-900">🎨 AI 优化的项目专属图(基于协议 + 主题 + findings)</p>
            <form method="post" action="/projects/<%= project.id %>/report/optimize-figure-prompts" class="inline" onsubmit="return confirm('重新生成?在新版完成前,老版会被暂时隐藏(LLM 跑 3-8 min)。')">
              <button type="submit" class="text-[11px] text-violet-700 hover:underline">↻ 重新生成</button>
            </form>
          </div>
          <div class="mt-2 space-y-2">
            <% aiOptimizedFigures.forEach(function(fp, i) { %>
              <%
                var uploadsForFig = (typeof figureAssetsByKey !== 'undefined' && figureAssetsByKey && figureAssetsByKey[fp.id]) ? figureAssetsByKey[fp.id] : []
                var hasMermaid = !!(fp.mermaid_code && String(fp.mermaid_code).trim().length > 10)
                var extPrompt = fp.external_tool_prompt || fp.prompt || ''
              %>
              <details class="rounded border border-violet-200 bg-white">
                <summary class="cursor-pointer list-none px-3 py-2">
                  <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-violet-900">
                        AI Figure <%= i + 1 %> · <%= fp.title %>
                        <% if (fp.figure_type) { %><span class="ml-1 rounded bg-violet-100 px-1.5 py-0.5 text-[10px] font-normal text-violet-700"><%= fp.figure_type %></span><% } %>
                        <% if (fp.intended_section) { %><span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-normal text-slate-600"><%= fp.intended_section %></span><% } %>
                        <% if (uploadsForFig.length) { %><span class="ml-1 rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-medium text-emerald-700">✓ 已上传 <%= uploadsForFig.length %></span><% } %>
                      </p>
                      <p class="mt-0.5 text-[11px] text-slate-500"><%= fp.when_to_use %></p>
                    </div>
                    <span class="flex-none text-[11px] text-violet-600">展开 / 复制 / 上传</span>
                  </div>
                </summary>
                <div class="border-t border-violet-100 px-3 py-2 space-y-3">

                  <!-- mermaid 代码块(如果 LLM 给了 mermaid)-->
                  <% if (hasMermaid) { %>
                    <div>
                      <p class="text-[11px] font-medium text-slate-600 mb-1">📐 Mermaid 代码(可直接在 mermaid.live 渲染)</p>
                      <textarea id="ai-figmermaid-<%= fp.id %>" readonly rows="8" class="w-full rounded border border-slate-300 bg-slate-50 px-2 py-1 text-[11px] font-mono text-slate-800"><%= fp.mermaid_code %></textarea>
                      <div class="mt-1 flex justify-end gap-2">
                        <a href="https://mermaid.live/" target="_blank" rel="noopener" class="text-[11px] text-blue-600 hover:underline">→ mermaid.live</a>
                        <button type="button"
                                onclick="(function(){var t=document.getElementById('ai-figmermaid-<%= fp.id %>');t.select();document.execCommand('copy');this.textContent='✓ 已复制';var s=this;setTimeout(function(){s.textContent='复制 mermaid'}, 2000)}).call(this)"
                                class="rounded bg-slate-700 px-2 py-1 text-[11px] text-white hover:bg-slate-600">
                          复制 mermaid
                        </button>
                      </div>
                    </div>
                  <% } %>

                  <!-- 外部工具 prompt(BioRender / draw.io / DALL-E)-->
                  <div>
                    <p class="text-[11px] font-medium text-slate-600 mb-1">
                      🎨 外部工具提示词
                      <% if (fp.copy_hint) { %><span class="font-normal text-slate-500">— <%= fp.copy_hint %></span><% } %>
                    </p>
                    <textarea id="ai-figprompt-<%= fp.id %>" readonly rows="12" class="w-full rounded border border-slate-300 bg-slate-50 px-2 py-1 text-xs font-mono text-slate-800"><%= extPrompt %></textarea>
                    <div class="mt-1 flex justify-end">
                      <button type="button"
                              onclick="(function(){var t=document.getElementById('ai-figprompt-<%= fp.id %>');t.select();document.execCommand('copy');this.textContent='✓ 已复制';var s=this;setTimeout(function(){s.textContent='复制提示词'}, 2000)}).call(this)"
                              class="rounded bg-violet-600 px-3 py-1.5 text-xs text-white hover:bg-violet-500">
                        复制提示词
                      </button>
                    </div>
                  </div>

                  <!-- 我已在外部生成,上传图片(优化打磨包:更友好的拖拽区 + 选中文件预览)
                       2026-05-25 M34:title/caption/altText 预填 LLM 推荐内容,
                       用户不改也能直接上传,后端 saveFigureAsset 即使收到空值也会
                       从 figure_prompts_ai_optimized 自动回填。
                  -->
                  <%
                    const _fpAutoTitle   = (fp.title   || '').toString()
                    const _fpAutoCaption = (fp.caption || fp.description || '').toString()
                    const _fpAutoAlt     = (fp.alt_text || '').toString()
                    const _hasAuto = !!(_fpAutoTitle || _fpAutoCaption || _fpAutoAlt)
                  %>
                  <div class="rounded-lg border border-dashed border-emerald-300 bg-emerald-50/30 p-3">
                    <p class="text-[11px] font-medium text-emerald-800">📤 我已在外部生成,上传图片</p>
                    <% if (_hasAuto) { %>
                      <p class="mt-0.5 text-[10px] text-emerald-700">✨ 标题 / Caption / Alt text 已由 AI 自动填好 — 直接选文件上传即可,不必逐项打字。</p>
                    <% } %>
                    <form method="post" enctype="multipart/form-data"
                          action="/projects/<%= project.id %>/report/figures/upload"
                          class="mt-2 space-y-2"
                          data-slr-fig-form="<%= fp.id %>">
                      <input type="hidden" name="figureKey" value="<%= fp.id %>" />
                      <input type="hidden" name="intendedSection" value="<%= fp.intended_section || '' %>" />
                      <label class="block cursor-pointer rounded-lg border-2 border-dashed border-emerald-300 bg-white px-4 py-6 text-center hover:border-emerald-500 hover:bg-emerald-50/50 transition slr-fig-drop"
                             data-target="slr-fig-input-<%= fp.id %>">
                        <span class="block text-2xl">🖼️</span>
                        <span class="mt-1 block text-xs font-medium text-emerald-700">点击选择 或 拖拽文件到此处</span>
                        <span class="mt-0.5 block text-[10px] text-slate-500">PNG / JPG / SVG / PDF · 最大 10 MB · 推荐 300 dpi / 矢量</span>
                        <span class="mt-1 block text-[10px] text-emerald-600 slr-fig-filename">(尚未选择文件)</span>
                        <input id="slr-fig-input-<%= fp.id %>" type="file" name="file"
                               accept="image/png,image/jpeg,image/svg+xml,application/pdf"
                               required
                               class="hidden slr-fig-input" />
                      </label>
                      <details <%= _hasAuto ? '' : 'open' %> class="text-[11px]">
                        <summary class="cursor-pointer text-[10px] text-slate-500 hover:text-slate-700">
                          <% if (_hasAuto) { %>编辑标题 / Caption / Alt(已自动填,通常不需要改)<% } else { %>输入标题 / Caption / Alt<% } %>
                        </summary>
                        <div class="mt-2 space-y-2">
                          <input type="text" name="title" value="<%= _fpAutoTitle %>"
                                 placeholder="Title(短标题,如 'Theme network across RoB tiers')"
                                 class="w-full rounded border border-slate-300 px-2 py-1 text-[11px] text-slate-700" />
                          <textarea name="caption" rows="3"
                                    placeholder="Caption(论文中印在图下的完整说明,英文 60-180 词)"
                                    class="w-full rounded border border-slate-300 px-2 py-1 text-[11px] text-slate-700"><%= _fpAutoCaption %></textarea>
                          <textarea name="altText" rows="2"
                                    placeholder="Alt text(无障碍简述,英文 30-60 词)"
                                    class="w-full rounded border border-slate-300 px-2 py-1 text-[11px] text-slate-700"><%= _fpAutoAlt %></textarea>
                        </div>
                      </details>
                      <div class="flex justify-end">
                        <button type="submit"
                                class="rounded bg-emerald-600 px-3 py-1.5 text-[11px] font-medium text-white hover:bg-emerald-500 disabled:bg-slate-300 slr-fig-submit"
                                disabled>
                          上传图片
                        </button>
                      </div>
                    </form>

                    <!-- 已上传的缩略图 -->
                    <% if (uploadsForFig.length) { %>
                      <div class="mt-3 grid gap-2 sm:grid-cols-2">
                        <% uploadsForFig.forEach(function(fa) {
                          var isPdf = (fa.mime_type || '').indexOf('pdf') >= 0
                          var isImg = (fa.mime_type || '').indexOf('image') >= 0
                        %>
                          <div class="rounded border border-emerald-200 bg-white p-2">
                            <% if (isImg) { %>
                              <a href="/projects/<%= project.id %>/report/figures/<%= fa.id %>/file" target="_blank" rel="noopener">
                                <img src="/projects/<%= project.id %>/report/figures/<%= fa.id %>/file"
                                     alt="<%= fa.alt_text || fa.original_filename %>"
                                     class="max-h-32 w-full object-contain rounded bg-slate-50" />
                              </a>
                            <% } else if (isPdf) { %>
                              <a href="/projects/<%= project.id %>/report/figures/<%= fa.id %>/file" target="_blank" rel="noopener"
                                 class="block rounded bg-slate-100 px-3 py-4 text-center text-xs text-slate-700 hover:bg-slate-200">
                                📄 <%= fa.original_filename || 'PDF' %>
                              </a>
                            <% } %>
                            <% if (fa.title) { %>
                              <p class="mt-1 text-[10px] font-medium text-slate-700" title="title"><%= fa.title %></p>
                            <% } %>
                            <p class="mt-0.5 truncate text-[10px] text-slate-500" title="<%= fa.original_filename %>"><%= fa.original_filename %></p>
                            <% if (fa.caption) { %><p class="mt-0.5 text-[10px] text-slate-600 line-clamp-2"><%= fa.caption %></p><% } %>
                            <div class="mt-1 flex items-center justify-between gap-1">
                              <details class="flex-1">
                                <summary class="cursor-pointer text-[10px] text-slate-500 hover:text-slate-700">编辑</summary>
                                <form method="post" action="/projects/<%= project.id %>/report/figures/<%= fa.id %>/edit" class="mt-1 space-y-1">
                                  <input type="text" name="title" value="<%= fa.title || '' %>" placeholder="Title(短标题)" class="w-full rounded border border-slate-300 px-1 py-0.5 text-[10px]" />
                                  <textarea name="caption" rows="2" placeholder="Caption(图注)" class="w-full rounded border border-slate-300 px-1 py-0.5 text-[10px]"><%= fa.caption || '' %></textarea>
                                  <input type="text" name="altText" value="<%= fa.alt_text || '' %>" placeholder="Alt text" class="w-full rounded border border-slate-300 px-1 py-0.5 text-[10px]" />
                                  <input type="text" name="intendedSection" value="<%= fa.intended_section || '' %>" placeholder="section" class="w-full rounded border border-slate-300 px-1 py-0.5 text-[10px]" />
                                  <button type="submit" class="rounded bg-slate-700 px-2 py-0.5 text-[10px] text-white hover:bg-slate-600">保存</button>
                                </form>
                              </details>
                              <form method="post" action="/projects/<%= project.id %>/report/figures/<%= fa.id %>/delete"
                                    onsubmit="return confirm('删除这张图?文件会被永久删除。');" class="inline">
                                <button type="submit" class="text-[10px] text-rose-600 hover:underline">删除</button>
                              </form>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    <% } %>
                  </div>
                </div>
              </details>
            <% }) %>
          </div>
        </div>
        <p class="mt-2 text-[11px] text-slate-500">— 下面是 3 个通用图片 prompt 模板(作为对比 / 补充)—</p>
        <% } %>

        <div class="mt-3 space-y-3">
          <% (figurePrompts || []).forEach((fp, i) => { %>
            <details class="rounded-lg border border-slate-200 bg-white">
              <summary class="cursor-pointer list-none px-4 py-3">
                <div class="flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-slate-800">Figure <%= 3 + i %> · <%= fp.title %></p>
                    <p class="mt-0.5 text-xs text-slate-500"><%= fp.when_to_use %></p>
                  </div>
                  <span class="flex-none text-xs text-slate-400">展开 / 复制</span>
                </div>
              </summary>
              <div class="border-t border-slate-100 px-4 py-3 space-y-2">
                <p class="text-[11px] text-slate-500"><strong>用法:</strong> <%= fp.copy_hint %></p>
                <textarea id="figprompt-<%= fp.id %>"
                          readonly rows="14"
                          class="w-full rounded border border-slate-300 bg-slate-50 px-2 py-1 text-xs font-mono text-slate-800"><%= fp.prompt %></textarea>
                <div class="flex justify-end">
                  <button type="button"
                          onclick="(function(){var t=document.getElementById('figprompt-<%= fp.id %>');t.select();document.execCommand('copy');this.textContent='✓ 已复制';setTimeout(()=>{this.textContent='复制提示词'}, 2000)}).call(this)"
                          class="rounded bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">
                    复制提示词
                  </button>
                </div>
              </div>
            </details>
          <% }) %>
        </div>
      </div>
    </div>

    <span id="nav-figures" class="block" style="scroll-margin-top: 80px;"></span>
    <!-- Phase 8.C — 已上传的图(figureAssets) 总览 -->
    <% if (typeof figureAssets !== 'undefined' && figureAssets && figureAssets.length) { %>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/30 p-5">
      <div class="flex items-baseline justify-between">
        <h3 class="text-sm font-medium uppercase text-emerald-700">已上传的图(<%= figureAssets.length %>)</h3>
        <span class="text-xs text-emerald-700">外部生成的最终成稿图</span>
      </div>
      <p class="mt-1 text-xs text-slate-600">
        下面是你在 BioRender / draw.io / DALL-E 等外部工具生成后上传到本项目的图片。
        投稿时直接用这里的最终版,而不是 prompt。
      </p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% figureAssets.forEach(function(fa) {
          var isPdf = (fa.mime_type || '').indexOf('pdf') >= 0
          var isImg = (fa.mime_type || '').indexOf('image') >= 0
          var sizeKb = fa.size_bytes ? Math.round(fa.size_bytes / 1024) : 0
        %>
          <div class="rounded-lg border border-emerald-200 bg-white p-3">
            <% if (isImg) { %>
              <a href="/projects/<%= project.id %>/report/figures/<%= fa.id %>/file" target="_blank" rel="noopener">
                <img src="/projects/<%= project.id %>/report/figures/<%= fa.id %>/file"
                     alt="<%= fa.alt_text || fa.original_filename %>"
                     class="max-h-40 w-full object-contain rounded bg-slate-50" />
              </a>
            <% } else if (isPdf) { %>
              <a href="/projects/<%= project.id %>/report/figures/<%= fa.id %>/file" target="_blank" rel="noopener"
                 class="block rounded bg-slate-100 px-3 py-6 text-center text-sm text-slate-700 hover:bg-slate-200">
                📄 PDF<br />
                <span class="text-xs"><%= fa.original_filename %></span>
              </a>
            <% } %>
            <div class="mt-2">
              <% if (fa.title) { %>
                <p class="text-xs font-semibold text-slate-900"><%= fa.title %></p>
              <% } %>
              <p class="<%= fa.title ? 'mt-0.5' : '' %> text-xs font-medium text-slate-800 truncate" title="<%= fa.original_filename %>">
                <%= fa.original_filename || '(未命名)' %>
              </p>
              <p class="mt-0.5 text-[10px] text-slate-500">
                <span class="rounded bg-violet-100 px-1.5 py-0.5 text-violet-700"><%= fa.figure_key %></span>
                <% if (fa.intended_section) { %><span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-slate-600"><%= fa.intended_section %></span><% } %>
                <span class="ml-1"><%= sizeKb %> KB</span>
              </p>
              <% if (fa.caption) { %>
                <p class="mt-1 text-[11px] text-slate-700"><strong>Caption:</strong> <%= fa.caption %></p>
              <% } %>
              <div class="mt-2 flex items-center justify-between gap-1">
                <details class="flex-1">
                  <summary class="cursor-pointer text-[11px] text-slate-500 hover:text-slate-700">编辑 title / caption / alt</summary>
                  <form method="post" action="/projects/<%= project.id %>/report/figures/<%= fa.id %>/edit" class="mt-1 space-y-1">
                    <input type="text" name="title" value="<%= fa.title || '' %>" placeholder="Title(短标题)" class="w-full rounded border border-slate-300 px-1.5 py-1 text-[11px]" />
                    <textarea name="caption" rows="3" placeholder="Caption(完整图注)" class="w-full rounded border border-slate-300 px-1.5 py-1 text-[11px]"><%= fa.caption || '' %></textarea>
                    <input type="text" name="altText" value="<%= fa.alt_text || '' %>" placeholder="Alt text" class="w-full rounded border border-slate-300 px-1.5 py-1 text-[11px]" />
                    <input type="text" name="intendedSection" value="<%= fa.intended_section || '' %>" placeholder="intended_section(eg. results)" class="w-full rounded border border-slate-300 px-1.5 py-1 text-[11px]" />
                    <button type="submit" class="rounded bg-slate-700 px-2 py-1 text-[11px] text-white hover:bg-slate-600">保存</button>
                  </form>
                </details>
                <form method="post" action="/projects/<%= project.id %>/report/figures/<%= fa.id %>/delete"
                      onsubmit="return confirm('删除这张图?文件会被永久删除。');" class="inline">
                  <button type="submit" class="text-[11px] text-rose-600 hover:underline">删除</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- 通用上传(figure_key = 'manual')-->
      <div class="mt-4 rounded-lg border border-dashed border-emerald-300 bg-white p-3">
        <p class="text-[11px] font-medium text-emerald-800">📤 直接上传(不绑定特定 figure 槽位)</p>
        <form method="post" enctype="multipart/form-data"
              action="/projects/<%= project.id %>/report/figures/upload"
              class="mt-2 grid gap-2 sm:grid-cols-2">
          <input type="hidden" name="figureKey" value="manual" />
          <input type="file" name="file"
                 accept="image/png,image/jpeg,image/svg+xml,application/pdf"
                 required
                 class="block w-full text-[11px] text-slate-700 file:mr-2 file:rounded file:border-0 file:bg-emerald-100 file:px-2 file:py-1 file:text-[11px] file:font-medium file:text-emerald-700 hover:file:bg-emerald-200" />
          <input type="text" name="intendedSection" placeholder="intended_section(可选,eg. results)" class="w-full rounded border border-slate-300 px-2 py-1 text-[11px]" />
          <textarea name="caption" rows="2" placeholder="Caption(可选)"
                    class="w-full rounded border border-slate-300 px-2 py-1 text-[11px] sm:col-span-2"></textarea>
          <div class="flex justify-end sm:col-span-2">
            <button type="submit"
                    class="rounded bg-emerald-600 px-3 py-1.5 text-[11px] font-medium text-white hover:bg-emerald-500">
              上传(PNG / JPG / SVG / PDF, ≤ 10 MB)
            </button>
          </div>
        </form>
      </div>
    </div>
    <% } else { %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-5">
      <div class="flex items-baseline justify-between">
        <h3 class="text-sm font-medium uppercase text-slate-400">已上传的图</h3>
        <span class="text-xs text-slate-400">还没有</span>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        在外部用 BioRender / draw.io / DALL-E 生成图片后,可在上方每个 AI Figure 卡片里上传。
        也可以下方任意上传一张不绑定特定槽位的图。
      </p>
      <form method="post" enctype="multipart/form-data"
            action="/projects/<%= project.id %>/report/figures/upload"
            class="mt-3 grid gap-2 sm:grid-cols-2">
        <input type="hidden" name="figureKey" value="manual" />
        <input type="file" name="file"
               accept="image/png,image/jpeg,image/svg+xml,application/pdf"
               required
               class="block w-full text-[11px] text-slate-700 file:mr-2 file:rounded file:border-0 file:bg-slate-100 file:px-2 file:py-1 file:text-[11px] file:font-medium file:text-slate-700 hover:file:bg-slate-200" />
        <input type="text" name="intendedSection" placeholder="intended_section(可选)" class="w-full rounded border border-slate-300 px-2 py-1 text-[11px]" />
        <textarea name="caption" rows="2" placeholder="Caption(可选)"
                  class="w-full rounded border border-slate-300 px-2 py-1 text-[11px] sm:col-span-2"></textarea>
        <div class="flex justify-end sm:col-span-2">
          <button type="submit"
                  class="rounded bg-slate-900 px-3 py-1.5 text-[11px] font-medium text-white hover:bg-slate-700">
            上传(PNG / JPG / SVG / PDF, ≤ 10 MB)
          </button>
        </div>
      </form>
    </div>
    <% } %>

    <span id="nav-tables" class="block" style="scroll-margin-top: 80px;"></span>
    <!-- ============================================================ -->
    <!-- 📋 数据型表(自动派生,无需 LLM · 投稿用) -->
    <!--   Cochrane Handbook / JBI 标准 4 表 + 10 张扩展派生表 -->
    <!--   推荐过滤展示:13 张推荐表优先 + 2 张未推荐折叠 -->
    <!-- ============================================================ -->
    <% if (typeof reviewTables !== 'undefined' && reviewTables) { %>
      <%
        const _rt = reviewTables
        // tone → 圆点颜色
        function _dot(tone) {
          const cls = ({ good: 'bg-emerald-500', middle: 'bg-amber-500', bad: 'bg-rose-500', unclear: 'bg-slate-300' })[tone] || 'bg-slate-300'
          return `<span class="inline-block h-2.5 w-2.5 rounded-full ${cls} align-middle" title="${tone}"></span>`
        }
      %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold text-slate-900">📋 数据型表(自动派生,无需 LLM · 投稿用)</h2>
            <p class="mt-1 text-xs text-slate-500">
              Cochrane Handbook / JBI 标准 4 张表 — 从你已有的 Step 4 矩阵 + Step 5 RoB + Step 7 GRADE/CERQual 派生。
              <strong>初稿写作时会引用这些表号</strong>(Table 1a, Table 2…)<strong>,所以应该先定下来再写初稿</strong>。
            </p>
          </div>
          <div class="text-[11px] text-slate-400">
            写作时序:① 数据表(在这里 · 共 <%= tableDefs ? tableDefs.length : 4 %> 张) → ② 概念图(下一卡) → ③ 初稿引用
          </div>
        </div>

        <!-- 4 张 Cochrane 标准表的快速概览条(扩展表在下面 details 里) -->
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <div class="rounded-lg border border-slate-200 bg-slate-50/40 p-3 text-center">
            <p class="text-[10px] uppercase tracking-wide text-slate-500">Table 1</p>
            <p class="mt-1 text-xl font-bold text-slate-900 leading-none"><%= _rt.table1.subtables.length %></p>
            <p class="mt-1 text-[10px] text-slate-500">子表(<%= _rt.table1.total_studies %> 篇)</p>
          </div>
          <div class="rounded-lg border border-slate-200 bg-slate-50/40 p-3 text-center">
            <p class="text-[10px] uppercase tracking-wide text-slate-500">Table 2 (SoF)</p>
            <p class="mt-1 text-xl font-bold text-slate-900 leading-none"><%= _rt.table2.total_outcomes %></p>
            <p class="mt-1 text-[10px] text-slate-500">outcomes</p>
          </div>
          <div class="rounded-lg border border-slate-200 bg-slate-50/40 p-3 text-center">
            <p class="text-[10px] uppercase tracking-wide text-slate-500">Table 3 (RoB)</p>
            <p class="mt-1 text-xl font-bold text-slate-900 leading-none"><%= _rt.table3a.total_studies %></p>
            <p class="mt-1 text-[10px] text-slate-500"><%= _rt.table3a.tools.length %> 工具 / <%= _rt.table3a.total_studies %> 篇</p>
          </div>
          <div class="rounded-lg border border-slate-200 bg-slate-50/40 p-3 text-center">
            <p class="text-[10px] uppercase tracking-wide text-slate-500">Table 4 (EP)</p>
            <p class="mt-1 text-xl font-bold text-slate-900 leading-none"><%= _rt.table4.total_themes %></p>
            <p class="mt-1 text-[10px] text-slate-500">themes</p>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- ⚡ Phase A5 · AI 推荐:本论文该用哪几张表(Opus 一次性看完项目 + manifest) -->
        <!-- ============================================================ -->
        <div id="table-recommend-card" class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50/30 p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <div>
              <h3 class="text-sm font-semibold text-indigo-900">⚡ AI 推荐:本论文该用哪几张表</h3>
              <p class="mt-1 text-[11px] text-indigo-700">
                Opus 4.8 + ultrathink 看完你的协议 / 主题 / 期刊模板 / <%= (typeof tableDefs !== 'undefined' && tableDefs) ? tableDefs.length : 15 %> 张派生表 manifest,推荐每张表的优先级 / 章节 / caption。
              </p>
              <% if (typeof ingestSummary !== 'undefined' && ingestSummary && ingestSummary.journal_template && ingestSummary.journal_template.loaded && ingestSummary.journal_template.table_count != null) { %>
                <p class="mt-1 text-[11px] text-indigo-800 bg-indigo-100/60 rounded px-2 py-1 inline-block">
                  💡 期刊参考论文用了 <span class="font-mono font-semibold"><%= ingestSummary.journal_template.table_count %></span> 张表(供参考,不强制)
                  <% if (typeof recommendedTables !== 'undefined' && recommendedTables && Array.isArray(recommendedTables.recommended_for_paper)) { %>
                    · 当前推荐 <span class="font-mono font-semibold"><%= recommendedTables.recommended_for_paper.length %></span> 张
                  <% } %>
                </p>
              <% } %>
              <p class="mt-1 text-[11px] text-indigo-600">
                状态:
                <% if (typeof recommendInFlight !== 'undefined' && recommendInFlight) { %>
                  <span class="font-semibold">生成中…(3-6 分钟,可关页面)</span>
                <% } else if (typeof recommendedTables !== 'undefined' && recommendedTables) { %>
                  <% if (typeof recommendStale !== 'undefined' && recommendStale) { %>
                    <span class="font-semibold text-amber-700">已过期</span>
                    <% if (recommendStaleReason === 'protocol_upgraded') { %>(协议已升级)<% } %>
                    <% if (recommendStaleReason === 'system_prompt_upgraded') { %>(通用 prompt 已升级到 <%= recommendSystemVersion %>)<% } %>
                    <% if (recommendStaleReason === 'old_no_version') { %>(老数据,无版本号)<% } %>
                  <% } else { %>
                    <span class="font-semibold text-emerald-700">已生成</span>
                    <% if (recommendAtProtocolVersion) { %>· 基于协议 v<%= recommendAtProtocolVersion %><% } %>
                    <% if (recommendAtSystemVersion) { %>· prompt <%= recommendAtSystemVersion %><% } %>
                  <% } %>
                <% } else if (typeof recommendStatus !== 'undefined' && recommendStatus === 'failed') { %>
                  <span class="font-semibold text-rose-700">上次失败</span>
                  <% if (typeof recommendError !== 'undefined' && recommendError) { %>
                    — <span class="text-rose-600"><%= recommendError.slice(0, 200) %></span>
                  <% } %>
                <% } else { %>
                  <span class="text-indigo-500">未生成</span>
                <% } %>
              </p>
              <p id="table-recommend-progress"
                 class="mt-1 text-[11px] text-indigo-600 <%= (typeof recommendInFlight !== 'undefined' && recommendInFlight) ? '' : 'hidden' %>">
                <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-indigo-500 align-middle"></span>
                <span data-elapsed>已运行 <span data-elapsed-s>0</span> 秒</span>
              </p>
            </div>
            <form id="table-recommend-form"
                  action="/projects/<%= project.id %>/report/tables/recommend"
                  method="POST"
                  class="shrink-0">
              <% if (typeof ingestSummary !== 'undefined' && ingestSummary) { %>
                <div class="mb-1.5 flex max-w-[420px] flex-wrap justify-end gap-1"><%- _btnChips(ingestSummary, 'table_recommend') %></div>
              <% } %>
              <button type="submit"
                      class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60"
                      <%= (typeof recommendInFlight !== 'undefined' && recommendInFlight) ? 'disabled' : '' %>>
                <% if (typeof recommendedTables !== 'undefined' && recommendedTables && !recommendStale) { %>
                  ⚡ 重新推荐
                <% } else { %>
                  ⚡ 生成推荐
                <% } %>
              </button>
            </form>
          </div>

          <% if (typeof recommendedTables !== 'undefined' && recommendedTables) { %>
            <%
              const _rec = recommendedTables
              const _rfp = Array.isArray(_rec.recommended_for_paper) ? _rec.recommended_for_paper : []
              const _pct = Array.isArray(_rec.proposed_custom_tables) ? _rec.proposed_custom_tables : []
              // priority → tailwind class
              function _prioCls(p) {
                if (p === 'critical')      return 'bg-rose-100 text-rose-800'
                if (p === 'important')     return 'bg-amber-100 text-amber-800'
                if (p === 'supplementary') return 'bg-slate-100 text-slate-700'
                return 'bg-slate-100 text-slate-600'
              }
              // table_key → label(从 tableDefs 反查)
              const _defMap = {}
              if (typeof tableDefs !== 'undefined' && Array.isArray(tableDefs)) {
                tableDefs.forEach((d) => { _defMap[d.key] = d })
              }
            %>

            <!-- ────── recommended_for_paper 列表 ────── -->
            <% if (_rfp.length) { %>
              <div class="mt-4">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-indigo-700">推荐入稿 (<%= _rfp.length %> 张)</p>
                <ul class="mt-2 space-y-2">
                  <% _rfp.forEach((r) => {
                       const def = _defMap[r.table_key]
                       const label = def ? def.label : r.table_key
                  %>
                    <li class="rounded-lg border border-indigo-100 bg-white p-3">
                      <div class="flex flex-wrap items-center gap-2">
                        <code class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-mono text-slate-700"><%= r.table_key %></code>
                        <span class="text-xs font-semibold text-slate-800"><%= label %></span>
                        <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold <%= _prioCls(r.priority) %>"><%= r.priority %></span>
                        <% if (r.intended_section) { %>
                          <span class="rounded bg-violet-50 px-1.5 py-0.5 text-[10px] font-medium text-violet-700">→ <%= r.intended_section %></span>
                        <% } %>
                      </div>
                      <% if (r.suggested_caption) { %>
                        <p class="mt-1.5 text-[12px] italic text-slate-700">"<%= r.suggested_caption %>"</p>
                      <% } %>
                      <% if (r.why_recommended) { %>
                        <p class="mt-1 text-[11px] text-slate-600"><%= r.why_recommended %></p>
                      <% } %>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <!-- ────── proposed_custom_tables(registry 外的建议)────── -->
            <% if (_pct.length) { %>
              <div class="mt-4">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-indigo-700">建议新增(registry 外,Stage 3 手动添加)</p>
                <ul class="mt-2 space-y-2">
                  <% _pct.forEach((p) => { %>
                    <li class="rounded-lg border border-dashed border-indigo-200 bg-white/50 p-3">
                      <p class="text-xs font-semibold text-slate-800"><%= p.name %></p>
                      <% if (Array.isArray(p.columns) && p.columns.length) { %>
                        <p class="mt-1 text-[11px] text-slate-500">
                          列:
                          <% p.columns.forEach((c, ci) => { %>
                            <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-[10px] text-slate-700"><%= c %></code><% if (ci < p.columns.length - 1) { %> <% } %>
                          <% }) %>
                        </p>
                      <% } %>
                      <% if (p.derive_hint) { %>
                        <p class="mt-1 text-[11px] text-slate-600">数据来源:<%= p.derive_hint %></p>
                      <% } %>
                      <% if (p.why) { %>
                        <p class="mt-1 text-[11px] text-slate-600"><strong>为什么:</strong><%= p.why %></p>
                      <% } %>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <!-- ────── combination_strategy + discipline_inference ────── -->
            <% if (_rec.combination_strategy || _rec.discipline_inference) { %>
              <div class="mt-4 rounded-lg border border-indigo-100 bg-white/60 p-3 text-[11px] text-slate-700">
                <% if (_rec.combination_strategy) { %>
                  <p><strong class="text-indigo-800">主稿 vs 附录策略:</strong><%= _rec.combination_strategy %></p>
                <% } %>
                <% if (_rec.discipline_inference) { %>
                  <p class="<%= _rec.combination_strategy ? 'mt-1.5' : '' %>"><strong class="text-indigo-800">学科判定:</strong><%= _rec.discipline_inference %></p>
                <% } %>
              </div>
            <% } %>
          <% } %>
        </div>

        <!-- ────── Phase A5 · 进度轮询 + 表单 AJAX 提交(同 synthesis overlay 模式)────── -->
        <script>
          (function () {
            const form    = document.getElementById('table-recommend-form')
            const card    = document.getElementById('table-recommend-card')
            const prog    = document.getElementById('table-recommend-progress')
            const elapsed = prog ? prog.querySelector('[data-elapsed-s]') : null
            if (!form || !card) return
            const statusUrl = '/projects/<%= project.id %>/report/tables/recommend/status.json'
            let pollHandle = null
            let elapsedHandle = null
            let elapsedSec = 0

            function startElapsed(startedAt) {
              if (elapsedHandle) clearInterval(elapsedHandle)
              const base = startedAt ? Date.parse(startedAt + ' UTC') : Date.now()
              elapsedHandle = setInterval(() => {
                elapsedSec = Math.max(0, Math.floor((Date.now() - base) / 1000))
                if (elapsed) elapsed.textContent = String(elapsedSec)
              }, 1000)
            }
            function stopElapsed() {
              if (elapsedHandle) { clearInterval(elapsedHandle); elapsedHandle = null }
            }

            function startPolling() {
              if (prog) prog.classList.remove('hidden')
              if (pollHandle) clearInterval(pollHandle)
              pollHandle = setInterval(async () => {
                try {
                  const r = await fetch(statusUrl, { headers: { Accept: 'application/json' } })
                  if (!r.ok) return
                  const d = await r.json()
                  if (!d.in_flight) {
                    clearInterval(pollHandle); pollHandle = null
                    stopElapsed()
                    // reload 让 EJS 重新渲染整张推荐卡 + status
                    setTimeout(() => { window.location.reload() }, 300)
                  }
                } catch {}
              }, 5000)
            }

            // 如果页面进来时已经 in_flight,直接开始轮询 + 计时
            <% if (typeof recommendInFlight !== 'undefined' && recommendInFlight) { %>
              startElapsed('<%= (typeof recommendStarted !== "undefined" && recommendStarted) ? recommendStarted : "" %>')
              startPolling()
            <% } %>

            // AJAX 提交(支持 force=1 重试覆盖 already_recommended gate)
            async function submitRecommend(force) {
              const btn = form.querySelector('button[type="submit"]')
              if (btn) btn.disabled = true
              try {
                const body = new URLSearchParams()
                if (force) body.set('force', '1')
                const r = await fetch(form.action, {
                  method: 'POST',
                  headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'fetch',
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'CSRF-Token': (document.querySelector('meta[name="csrf-token"]')?.content || ''),
                  },
                  body: body.toString(),
                })
                const d = await r.json().catch(() => ({}))
                if (r.ok && d.ok) {
                  startElapsed(new Date().toISOString().slice(0, 19).replace('T', ' '))
                  startPolling()
                  return
                }
                // already_recommended:协议/通用 prompt 都没升级 → 问要不要强制重跑
                if (r.status === 409 && d.error_code === 'already_recommended' && !force) {
                  if (btn) btn.disabled = false
                  const lines = [
                    '已基于以下条件生成过推荐:',
                    `· 协议版本:v${d.recommended_at_protocol_version ?? '?'}(当前 v${d.protocol_version ?? '?'})`,
                    `· 通用 prompt 版本:${d.system_version ?? '?'}`,
                    '',
                    '协议或通用 prompt 升级后会自动允许重生成。',
                    '现在强制重新跑会花一次 Opus tokens — 确定要继续吗?',
                  ]
                  if (confirm(lines.join('\n'))) {
                    await submitRecommend(true)
                  }
                  return
                }
                if (r.status === 409 && d.error_code === 'in_flight') {
                  alert('已有一个表格推荐任务在跑(10 min 内),请等它完成或刷新页面看进度')
                  if (btn) btn.disabled = false
                  return
                }
                alert('启动失败:' + (d.message || d.error || `HTTP ${r.status}`))
                if (btn) btn.disabled = false
              } catch (e) {
                alert('网络错误:' + (e?.message || e))
                if (btn) btn.disabled = false
              }
            }
            form.addEventListener('submit', (ev) => {
              ev.preventDefault()
              submitRecommend(false)
            })
          })()
        </script>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!--  推荐过滤展示:                                                       -->
        <!--    ① 有 recommendedTableKeys → "★ 推荐表"区(按 priority 顺序),     -->
        <!--       "▾ 其他 N 张未推荐"折叠                                          -->
        <!--    ② 无推荐 → 全 15 张按 registry 顺序铺开(fallback)                -->
        <!--                                                                       -->
        <!--  所有单表渲染通过 partials/review-table.ejs include 完成。             -->
        <!-- ════════════════════════════════════════════════════════════════════ -->

        <% if (typeof recommendedTableKeys !== 'undefined' && recommendedTableKeys && recommendedTableKeys.length > 0) { %>
          <%
            // N2 — 批量精修 orchestrator state(view-side computed,降默认)
            const _pbInFlight  = !!(typeof polishBatchInFlight !== 'undefined' && polishBatchInFlight)
            const _pbStatus    = (typeof polishBatchStatus     !== 'undefined') ? polishBatchStatus     : null
            const _pbMeta      = (typeof polishBatchMeta       !== 'undefined') ? polishBatchMeta       : null
            const _pbStarted   = (typeof polishBatchStartedAt  !== 'undefined') ? polishBatchStartedAt  : null
            const _pbFinished  = (typeof polishBatchFinishedAt !== 'undefined') ? polishBatchFinishedAt : null
            const _pbElapsed0  = (typeof polishBatchElapsedS   !== 'undefined') ? (polishBatchElapsedS|0) : 0
            const _pbCompleted = Array.isArray(_pbMeta?.completed) ? _pbMeta.completed.length : 0
            const _pbFailed    = Array.isArray(_pbMeta?.failed)    ? _pbMeta.failed.length    : 0
            const _pbTotal     = (_pbMeta?.total || recommendedTableKeys.length)
            // 推荐表中已精修 N 张(view 自己数,不需要后端再算)
            let _polishedNow = 0
            if (typeof polishedTablesByKey !== 'undefined' && polishedTablesByKey) {
              for (const k of recommendedTableKeys) {
                const e = polishedTablesByKey[k]
                if (e && e.polished_caption) _polishedNow++
              }
            }
          %>

          <%# ───── ✨ 一键精修推荐表(N2)───── %>
          <div id="polish-batch-card" class="mt-4 rounded-lg border border-fuchsia-200 bg-fuchsia-50/30 p-3">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <p class="text-xs font-semibold text-fuchsia-900">
                  ✨ 一键精修推荐表(批量,共 <%= recommendedTableKeys.length %> 张)
                </p>
                <p class="mt-0.5 text-[11px] text-fuchsia-700">
                  Opus 4.8 + ultrathink 顺序精修 — caption / column labels / paragraph_lead / footnotes(反编造校验)。
                  <strong>预估 25-40 min</strong>,可关页面(后台跑)。已精修 <%= _polishedNow %> / <%= recommendedTableKeys.length %>。
                </p>
                <p id="polish-batch-status" class="mt-1 text-[11px] text-fuchsia-700 <%= _pbInFlight ? '' : 'hidden' %>">
                  <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-fuchsia-500 align-middle"></span>
                  <span data-pb-progress>
                    <span data-pb-completed><%= _pbCompleted %></span> / <span data-pb-total><%= _pbTotal %></span> 完成
                    · 失败 <span data-pb-failed><%= _pbFailed %></span>
                    · 当前 <span data-pb-current><%= _pbMeta?.current_key || '—' %></span>
                    · 已运行 <span data-pb-elapsed><%= Math.floor(_pbElapsed0 / 60) %>:<%= String(_pbElapsed0 % 60).padStart(2, '0') %></span>
                  </span>
                </p>
                <% if (!_pbInFlight && _pbStatus && _pbStatus !== 'running') { %>
                  <p class="mt-1 text-[11px]">
                    上次状态:
                    <% if (_pbStatus === 'success') { %>
                      <span class="font-semibold text-emerald-700">success</span>(<%= _pbCompleted %>/<%= _pbTotal %> 全部成功)
                    <% } else if (_pbStatus === 'partial') { %>
                      <span class="font-semibold text-amber-700">partial</span>(<%= _pbCompleted %>/<%= _pbTotal %> 成功,<%= _pbFailed %> 失败)
                    <% } else if (_pbStatus === 'failed') { %>
                      <span class="font-semibold text-rose-700">failed</span>
                    <% } else if (_pbStatus === 'aborted_by_restart') { %>
                      <span class="font-semibold text-slate-600">aborted_by_restart</span>(服务重启,可重新启动)
                    <% } else { %>
                      <span class="font-semibold text-slate-600"><%= _pbStatus %></span>
                    <% } %>
                    <% if (_pbFinished) { %>· at <%= _pbFinished %><% } %>
                  </p>
                <% } %>
              </div>
              <form id="polish-batch-form"
                    action="/projects/<%= project.id %>/report/tables/polish-batch"
                    method="POST"
                    class="shrink-0">
                <% if (typeof ingestSummary !== 'undefined' && ingestSummary) { %>
                  <div class="mb-1.5 flex max-w-[420px] flex-wrap justify-end gap-1"><%- _btnChips(ingestSummary, 'table_polish_batch') %></div>
                <% } %>
                <button type="submit"
                        class="rounded-lg bg-fuchsia-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-fuchsia-700 disabled:cursor-not-allowed disabled:opacity-60"
                        <%= _pbInFlight ? 'disabled' : '' %>>
                  <% if (_pbInFlight) { %>⏳ 精修中…
                  <% } else if (_polishedNow >= recommendedTableKeys.length) { %>✨ 全部重新精修
                  <% } else if (_polishedNow > 0) { %>✨ 精修剩余 <%= (recommendedTableKeys.length - _polishedNow) %> 张
                  <% } else { %>✨ 一键精修所有推荐表
                  <% } %>
                </button>
              </form>
            </div>
          </div>

          <script>
            (function () {
              const form    = document.getElementById('polish-batch-form')
              const card    = document.getElementById('polish-batch-card')
              const status  = document.getElementById('polish-batch-status')
              if (!form || !card) return
              const statusUrl = '/projects/<%= project.id %>/report/tables/polish-batch/status.json'
              let pollHandle = null
              let elapsedHandle = null
              let elapsedSec = <%= _pbElapsed0 %>

              function fmtMMSS(s) {
                const m = Math.floor(s / 60), r = s % 60
                return m + ':' + String(r).padStart(2, '0')
              }
              function setEl(sel, v) {
                const el = card.querySelector(sel)
                if (el) el.textContent = String(v)
              }
              function startElapsed(startedAtStr) {
                if (elapsedHandle) clearInterval(elapsedHandle)
                const base = startedAtStr ? Date.parse(startedAtStr + ' UTC') : Date.now() - elapsedSec * 1000
                elapsedHandle = setInterval(() => {
                  elapsedSec = Math.max(0, Math.floor((Date.now() - base) / 1000))
                  setEl('[data-pb-elapsed]', fmtMMSS(elapsedSec))
                }, 1000)
              }
              function stopElapsed() {
                if (elapsedHandle) { clearInterval(elapsedHandle); elapsedHandle = null }
              }
              function startPolling() {
                if (status) status.classList.remove('hidden')
                if (pollHandle) clearInterval(pollHandle)
                pollHandle = setInterval(async () => {
                  try {
                    const r = await fetch(statusUrl, { headers: { Accept: 'application/json' } })
                    if (!r.ok) return
                    const d = await r.json()
                    if (d && d.ok) {
                      setEl('[data-pb-completed]', d.completed_n || 0)
                      setEl('[data-pb-total]',     d.total       || 0)
                      setEl('[data-pb-failed]',    d.failed_n    || 0)
                      setEl('[data-pb-current]',   d.current_key || '—')
                      if (!d.in_flight) {
                        clearInterval(pollHandle); pollHandle = null
                        stopElapsed()
                        // reload 让 EJS 重新渲染所有 ✓ 已精修 chip + paragraph + footnotes
                        setTimeout(() => { window.location.reload() }, 400)
                      }
                    }
                  } catch {}
                }, 5000)
              }

              <% if (_pbInFlight) { %>
                startElapsed('<%= _pbStarted || "" %>')
                startPolling()
              <% } %>

              form.addEventListener('submit', async (ev) => {
                ev.preventDefault()
                const btn = form.querySelector('button[type="submit"]')
                if (btn) btn.disabled = true
                try {
                  const r = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                      'Accept': 'application/json',
                      'Content-Type': 'application/json',
                      'X-Requested-With': 'fetch',
                      'CSRF-Token': (document.querySelector('meta[name="csrf-token"]')?.content || ''),
                    },
                    body: JSON.stringify({}),  // 默认让后端走 recommendedTableKeys
                  })
                  const d = await r.json().catch(() => ({}))
                  if (r.ok && d.ok) {
                    elapsedSec = 0
                    if (status) {
                      status.classList.remove('hidden')
                      setEl('[data-pb-total]', d.total || 0)
                      setEl('[data-pb-completed]', 0)
                      setEl('[data-pb-failed]', 0)
                      setEl('[data-pb-current]', '—')
                    }
                    startElapsed(new Date().toISOString().slice(0, 19).replace('T', ' '))
                    startPolling()
                  } else {
                    alert('启动失败:' + (d.message || d.error || r.status))
                    if (btn) btn.disabled = false
                  }
                } catch (e) {
                  alert('网络错误:' + (e?.message || e))
                  if (btn) btn.disabled = false
                }
              })
            })()
          </script>

          <%# ───── ★ 推荐表区(LLM 选出的 N 张,按 critical → important → supplementary 排序)───── %>
          <div class="mt-4 rounded-lg border border-indigo-200 bg-indigo-50/20 p-3">
            <p class="text-xs font-semibold text-indigo-900">
              ★ 推荐表(<%= recommendedTableKeys.length %> 张 · 按优先级)— 应进入正式投稿
            </p>
            <p class="mt-0.5 text-[11px] text-indigo-700">
              下方每张表用 <strong>LLM 推荐 caption</strong> 作标题,真实数据保持不变(0 LLM token,纯派生)。
            </p>
          </div>
          <% recommendedTableKeys.forEach((k) => {
               const td = _rt[k]
               const def = (tableDefs || []).find(d => d.key === k)
               const rec = recommendationByKey ? recommendationByKey[k] : null
               if (!td || !def) return
          %>
            <%- include('partials/review-table', {
                  project: project,
                  tableKey: k,
                  tableData: td,
                  tableDef: def,
                  recommendation: rec,
                  polishedTable:  (typeof polishedTablesByKey !== 'undefined' && polishedTablesByKey) ? polishedTablesByKey[k] : null,
                  polishInFlight: !!(typeof polishInFlightByKey  !== 'undefined' && polishInFlightByKey  && polishInFlightByKey[k]),
                  polishStale:    (typeof polishStaleByKey !== 'undefined' && polishStaleByKey) ? (polishStaleByKey[k] || null) : null,
                }) %>
          <% }) %>

          <%# ───── ▾ 其他未推荐表(折叠)───── %>
          <% if (unrecommendedTableKeys && unrecommendedTableKeys.length > 0) { %>
            <details class="mt-5 rounded-lg border border-dashed border-slate-300 bg-slate-50/30 p-3">
              <summary class="cursor-pointer text-xs font-medium text-slate-600 hover:text-slate-800">
                ▾ 其他 <%= unrecommendedTableKeys.length %> 张未被 LLM 推荐的表(完整 registry,展开查看)
              </summary>
              <p class="mt-2 text-[11px] text-slate-500">
                LLM 觉得本论文不需要单独引这些表,但你仍可手动加入 supplementary appendix。
              </p>
              <% unrecommendedTableKeys.forEach((k) => {
                   const td = _rt[k]
                   const def = (tableDefs || []).find(d => d.key === k)
                   if (!td || !def) return
              %>
                <%- include('partials/review-table', {
                      project: project,
                      tableKey: k,
                      tableData: td,
                      tableDef: def,
                      recommendation: null,
                      polishedTable:  (typeof polishedTablesByKey !== 'undefined' && polishedTablesByKey) ? polishedTablesByKey[k] : null,
                      polishInFlight: !!(typeof polishInFlightByKey  !== 'undefined' && polishInFlightByKey  && polishInFlightByKey[k]),
                      polishStale:    (typeof polishStaleByKey !== 'undefined' && polishStaleByKey) ? (polishStaleByKey[k] || null) : null,
                    }) %>
              <% }) %>
            </details>
          <% } %>

        <% } else { %>
          <%# ───── Fallback:没推荐时,按 registry 顺序铺开全部 15 张 ───── %>
          <p class="mt-4 rounded border border-slate-200 bg-slate-50/40 p-2 text-[11px] text-slate-600">

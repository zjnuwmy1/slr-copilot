<!-- Phase 8.A · 撰写主进度 + per-section 进度 + AJAX submit -->
<!-- ============================================================ -->
<script>
(function () {
  var projectId = <%- JSON.stringify(project.id) %>
  var topoOrder = <%- JSON.stringify(_topoSortedSections.map(function(s){ return { name: s.name, target_words: s.target_words || s.target_word_count || null, depends_on: s.depends_on || [] } })) %>

  function fmtElapsed(s) {
    var m = Math.floor(s / 60)
    var ss = s % 60
    return m + ':' + (ss < 10 ? '0' : '') + ss
  }
  function paintHeartbeat(el, ago) {
    if (!el) return
    if (ago == null) {
      el.textContent = '💓 等待第一次心跳…'
      el.className = (el.className || '').replace(/text-(emerald|amber|rose|slate)-\d+/g, '') + ' text-amber-500'
    } else if (ago < 60) {
      el.textContent = '💓 ' + ago + 's 前(后台真的在跑)'
      el.className = (el.className || '').replace(/text-(emerald|amber|rose|slate)-\d+/g, '') + ' text-emerald-600'
    } else if (ago < 90) {
      el.textContent = '💓 ' + ago + 's 前(下次 30s 内)'
      el.className = (el.className || '').replace(/text-(emerald|amber|rose|slate)-\d+/g, '') + ' text-amber-500'
    } else {
      el.textContent = '⚠ 心跳停 ' + ago + 's(可能卡死,等硬超时)'
      el.className = (el.className || '').replace(/text-(emerald|amber|rose|slate)-\d+/g, '') + ' text-rose-600'
    }
  }

  // -----------------------------------------------------------
  // 撰写主进度 — drafting-run-progress
  // -----------------------------------------------------------
  function startDraftingProgressTicker() {
    var pane = document.getElementById('drafting-run-progress')
    if (!pane || pane.classList.contains('hidden')) return null
    var startedISO = pane.getAttribute('data-started')
    var startedMs = startedISO ? Date.parse(String(startedISO).replace(' ', 'T') + (String(startedISO).indexOf('Z') < 0 ? 'Z' : '')) : Date.now()
    if (!isFinite(startedMs)) startedMs = Date.now()
    var ESTIMATED_S = parseInt(pane.getAttribute('data-estimated') || '1500', 10) || 1500
    var HARD_TIMEOUT_S = parseInt(pane.getAttribute('data-hard-max') || '5400', 10) || 5400
    var elapsedEl = document.getElementById('drafting-elapsed')
    var barEl = document.getElementById('drafting-progress-bar')
    var stageEl = document.getElementById('drafting-stage-hint')
    function tick() {
      var s = Math.max(0, Math.floor((Date.now() - startedMs) / 1000))
      if (elapsedEl) elapsedEl.textContent = fmtElapsed(s)
      if (barEl) barEl.style.width = Math.min(95, Math.round((s / HARD_TIMEOUT_S) * 100)) + '%'
      if (stageEl) {
        if (s < 30) stageEl.textContent = '📡 提交 LLM…(可以关闭页面,撰写会在后台继续)'
        else if (s < 180) stageEl.textContent = '🧠 模型阅读 themes + matrix + RoB + certainty(thinking 阶段不出 token,正常)…'
        else if (s < ESTIMATED_S * 0.6) stageEl.textContent = '✍️ 正在按拓扑顺序逐章撰写…'
        else if (s < ESTIMATED_S) stageEl.textContent = '✍️ 接近完成,生成 References / Abstract…'
        else if (s < HARD_TIMEOUT_S) stageEl.textContent = '⏳ 已超预估,硬超时(' + Math.round(HARD_TIMEOUT_S/60) + ' min)内都正常…'
        else stageEl.textContent = '⚠ 已达硬超时,正在中断…'
      }
    }
    tick()
    return setInterval(tick, 1000)
  }

  function startDraftingPolling() {
    var pane = document.getElementById('drafting-run-progress')
    if (!pane || pane.classList.contains('hidden')) return
    var tickerId = startDraftingProgressTicker()
    var hbEl = document.getElementById('drafting-heartbeat')
    var completedEl = document.getElementById('drafting-completed-n')
    var currentEl = document.getElementById('drafting-current-section')
    var pollId = setInterval(function () {
      fetch('/projects/' + projectId + '/report/run/status.json', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      }).then(function (r) { return r.ok ? r.json() : null })
        .then(function (s) {
          if (!s || !s.ok) return
          paintHeartbeat(hbEl, s.heartbeat_ago_s == null ? null : s.heartbeat_ago_s)
          if (s.meta && completedEl && s.meta.sections_completed != null) {
            completedEl.textContent = s.meta.sections_completed
          }
          if (s.meta && currentEl && s.meta.current_section) {
            currentEl.textContent = ' · 正在写 ' + s.meta.current_section
          }
          if (s.in_flight) return
          clearInterval(pollId)
          if (tickerId) clearInterval(tickerId)
          var barEl = document.getElementById('drafting-progress-bar')
          if (barEl) barEl.style.width = '100%'
          setTimeout(function () { window.location.reload() }, 600)
        }).catch(function () {})
    }, 5000)
  }
  startDraftingPolling()

  // -----------------------------------------------------------
  // per-section 进度 — section-run-progress-<name>
  // -----------------------------------------------------------
  function startSectionPolling(sectionName) {
    var pane = document.getElementById('section-run-progress-' + sectionName)
    if (!pane) return
    var startedISO = pane.getAttribute('data-started')
    var startedMs = startedISO ? Date.parse(String(startedISO).replace(' ', 'T') + (String(startedISO).indexOf('Z') < 0 ? 'Z' : '')) : Date.now()
    if (!isFinite(startedMs)) startedMs = Date.now()
    var ESTIMATED_S = parseInt(pane.getAttribute('data-estimated') || '300', 10) || 300
    var HARD_TIMEOUT_S = parseInt(pane.getAttribute('data-hard-max') || '1800', 10) || 1800
    var elapsedEl = pane.querySelector('.section-elapsed')
    var barEl = pane.querySelector('.section-progress-bar')
    var stageEl = pane.querySelector('.section-stage-hint')
    var hbEl = pane.querySelector('.section-heartbeat')

    function tick() {
      var s = Math.max(0, Math.floor((Date.now() - startedMs) / 1000))
      if (elapsedEl) elapsedEl.textContent = fmtElapsed(s)
      if (barEl) barEl.style.width = Math.min(95, Math.round((s / HARD_TIMEOUT_S) * 100)) + '%'
      if (stageEl) {
        if (s < 20) stageEl.textContent = '📡 提交 LLM…'
        else if (s < 60) stageEl.textContent = '🧠 读上下文(thinking 不出 token)…'
        else if (s < ESTIMATED_S) stageEl.textContent = '✍️ 正在写本章节…'
        else if (s < HARD_TIMEOUT_S) stageEl.textContent = '⏳ 已超预估,' + Math.round(HARD_TIMEOUT_S/60) + ' min 内都正常…'
        else stageEl.textContent = '⚠ 已达硬超时…'
      }
    }
    tick()
    var tickerId = setInterval(tick, 1000)

    var pollId = setInterval(function () {
      fetch('/projects/' + projectId + '/report/section/' + encodeURIComponent(sectionName) + '/status.json', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      }).then(function (r) { return r.ok ? r.json() : null })
        .then(function (s) {
          if (!s || !s.ok) return
          paintHeartbeat(hbEl, s.heartbeat_ago_s == null ? null : s.heartbeat_ago_s)
          if (s.in_flight) return
          clearInterval(pollId); clearInterval(tickerId)
          if (barEl) barEl.style.width = '100%'
          setTimeout(function () { window.location.reload() }, 600)
        }).catch(function () {})
    }, 5000)
  }
  document.querySelectorAll('[id^="section-run-progress-"]').forEach(function (pane) {
    var name = pane.getAttribute('data-section')
    if (name) startSectionPolling(name)
  })

  // -----------------------------------------------------------
  // per-section generate AJAX — section-generate-form-<name>
  // -----------------------------------------------------------
  document.querySelectorAll('[id^="section-generate-form-"]').forEach(function (form) {
    form.addEventListener('submit', function (ev) {
      var sectionName = form.getAttribute('data-section') || ''
      if (!confirm('调用 LLM 生成「' + sectionName + '」章节(单次约 8K tokens / 1-3 分钟)。是否继续?')) {
        ev.preventDefault()
        return
      }
      ev.preventDefault()
      var btn = form.querySelector('button[type="submit"]')
      if (!btn || btn.disabled) return
      var orig = btn.textContent
      btn.disabled = true
      btn.textContent = '⏳ 启动中…'
      fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' },
        credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return { ok: false } }) })
        .then(function (j) {
          if (j && j.ok) {
            window.location.reload()
          } else if (j && j.error_code === 'in_flight') {
            window.location.reload()
          } else {
            btn.disabled = false
            btn.textContent = orig
            alert('启动失败:' + ((j && j.message) || (j && j.error) || '未知错误'))
          }
        }).catch(function (e) {
          btn.disabled = false
          btn.textContent = orig
          alert('请求失败:' + (e && e.message ? e.message : '网络错误'))
        })
    })
  })

  // -----------------------------------------------------------
  // 一键生成全部 AJAX + 确认弹窗(列出顺序)
  // -----------------------------------------------------------
  var allForm = document.getElementById('drafting-generate-all-form')
  var allBtn = document.getElementById('drafting-generate-all-btn')
  if (allForm && allBtn) {
    allForm.addEventListener('submit', function (ev) {
      ev.preventDefault()
      if (allBtn.disabled) return
      var orderLines = topoOrder && topoOrder.length
        ? topoOrder.map(function (s, i) {
            var dep = s.depends_on && s.depends_on.length ? '  (依赖: ' + s.depends_on.join(', ') + ')' : ''
            return (i + 1) + '. ' + s.name + (s.target_words ? ' (~' + s.target_words + ' words)' : '') + dep
          }).join('\n')
        : '(未配置 customSections,按默认 9 章顺序)'
      var msg = '将按以下顺序生成所有章节(约 30-90 分钟,后台跑,可关闭页面):\n\n' + orderLines + '\n\n⚠ 已有章节会被覆盖。是否继续?'
      if (!confirm(msg)) return
      var orig = allBtn.textContent
      allBtn.disabled = true
      allBtn.textContent = '⏳ 启动中…'
      fetch(allForm.action, {
        method: 'POST',
        headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' },
        credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return { ok: false } }) })
        .then(function (j) {
          if (j && (j.ok || j.in_flight)) {
            window.location.reload()
          } else if (j && j.error_code === 'in_flight') {
            window.location.reload()
          } else if (!j || (j && j.ok === undefined && j.error === undefined)) {
            // server 还没 AJAX 化 → 退化成普通 POST
            allForm.removeEventListener('submit', arguments.callee)
            allForm.submit()
          } else {
            allBtn.disabled = false
            allBtn.textContent = orig
            alert('启动失败:' + ((j && j.message) || (j && j.error) || '未知错误'))
          }
        }).catch(function () {
          // 网络错误 / server 还没 JSON 响应 → 走传统 form submit
          allForm.submit()
        })
    })
  }

  // -----------------------------------------------------------
  // Phase 8.B · 撰写 overlay 5s 轮询 + AJAX submit(对照 cert-overlay-*)
  // -----------------------------------------------------------
  var draftOvBadge = document.getElementById('drafting-overlay-status')
  if (draftOvBadge) {
    var draftOvPollId = setInterval(function () {
      fetch('/projects/' + projectId + '/report/optimize-overlay/status.json', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      }).then(function (r) { return r.ok ? r.json() : null })
        .then(function (s) {
          if (!s || !s.ok) return
          if (!s.in_flight) { clearInterval(draftOvPollId); window.location.reload() }
        }).catch(function () {})
    }, 5000)
  }

  var draftOvForm = document.getElementById('drafting-overlay-form')
  var draftOvBtn = document.getElementById('drafting-overlay-btn')
  if (draftOvForm && draftOvBtn) {
    draftOvForm.addEventListener('submit', function (ev) {
      ev.preventDefault()
      if (draftOvBtn.disabled) return
      var orig = draftOvBtn.textContent
      draftOvBtn.disabled = true
      draftOvBtn.textContent = '⏳ 启动中…'
      fetch(draftOvForm.action, {
        method: 'POST',
        headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' },
        credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return { ok: false } }) })
        .then(function (j) {
          if (j && j.ok) window.location.reload()
          else if (j && j.error_code === 'in_flight') window.location.reload()
          else {
            draftOvBtn.disabled = false
            draftOvBtn.textContent = orig
            alert('启动失败:' + ((j && j.error_code) || (j && j.message) || (j && j.error) || '未知错误'))
          }
        }).catch(function (e) {
          draftOvBtn.disabled = false
          draftOvBtn.textContent = orig
          alert('请求失败:' + (e && e.message ? e.message : '网络错误'))
        })
    })
  }

  // -----------------------------------------------------------
  // M32-f · 全局大纲卡 5s 轮询 + AJAX submit
  // -----------------------------------------------------------
  var draftPlanBadge = document.getElementById('drafting-plan-status')
  if (draftPlanBadge) {
    var draftPlanPollId = setInterval(function () {
      fetch('/projects/' + projectId + '/report/generate-plan/status.json', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      }).then(function (r) { return r.ok ? r.json() : null })
        .then(function (s) {
          if (!s || !s.ok) return
          if (!s.in_flight) { clearInterval(draftPlanPollId); window.location.reload() }
        }).catch(function () {})
    }, 5000)
  }

  // -----------------------------------------------------------
  // N8 · ⚙️ AI 一键生成图 prompt 异步:计时 + 5s 轮询 + 完成 reload
  // -----------------------------------------------------------
  var figOptStatus = document.getElementById('fig-opt-status')
  if (figOptStatus) {
    var figElapsed = document.getElementById('fig-opt-elapsed')
    var started = figOptStatus.getAttribute('data-started')
    var baseMs = started ? Date.parse(started + ' UTC') : Date.now()
    if (isNaN(baseMs)) baseMs = Date.now()
    function _figTick() {
      if (figElapsed) figElapsed.textContent = String(Math.max(0, Math.floor((Date.now() - baseMs) / 1000)))
    }
    _figTick()
    var figTickId = setInterval(_figTick, 1000)
    var figPollId = setInterval(function () {
      fetch('/projects/' + projectId + '/report/optimize-figure-prompts/status.json', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      }).then(function (r) { return r.ok ? r.json() : null })
        .then(function (s) {
          if (!s || !s.ok) return
          if (!s.in_flight) {
            clearInterval(figPollId); clearInterval(figTickId)
            window.location.reload()
          }
        }).catch(function () {})
    }, 5000)
  }
  // AJAX 提交 — 启动后立刻显示进度卡而不刷整页
  var figOptForm = document.getElementById('optimize-fig-form')
  var figOptBtn  = document.getElementById('optimize-fig-btn')
  if (figOptForm && figOptBtn) {
    figOptForm.addEventListener('submit', function (ev) {
      ev.preventDefault()
      if (figOptBtn.disabled) return
      figOptBtn.disabled = true
      var orig = figOptBtn.textContent
      figOptBtn.textContent = '⏳ 启动中…'
      fetch(figOptForm.action, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'fetch' },
        credentials: 'same-origin',
      }).then(function (r) { return r.ok ? r.json() : null })
        .then(function (d) {
          if (d && d.ok && d.in_flight) {
            window.location.reload()             // 重 render → 显示 in-flight 卡 + 轮询
          } else {
            figOptBtn.disabled = false
            figOptBtn.textContent = orig
            alert((d && d.message) || '启动失败')
          }
        }).catch(function (e) {
          figOptBtn.disabled = false
          figOptBtn.textContent = orig
          alert('网络错误:' + (e && e.message || e))
        })
    })
  }

  ;['drafting-plan-form', 'drafting-plan-regen-form'].forEach(function (formId) {
    var f = document.getElementById(formId)
    if (!f) return
    var btn = f.querySelector('button[type="submit"]')
    if (!btn) return
    f.addEventListener('submit', function (ev) {
      ev.preventDefault()
      if (btn.disabled) return
      var orig = btn.textContent
      btn.disabled = true
      btn.textContent = '⏳ 启动中…'
      fetch(f.action, {
        method: 'POST',
        headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' },
        credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return { ok: false } }) })
        .then(function (j) {
          if (j && j.ok) window.location.reload()
          else if (j && j.error_code === 'in_flight') window.location.reload()
          else {
            btn.disabled = false
            btn.textContent = orig
            alert('启动失败:' + ((j && j.error_code) || (j && j.message) || (j && j.error) || '未知错误'))
          }
        }).catch(function (e) {
          btn.disabled = false
          btn.textContent = orig
          alert('请求失败:' + (e && e.message ? e.message : '网络错误'))
        })
    })
  })
})()
</script>

<script>
  // 优化打磨包:figure 上传 — 拖拽区 + 选中文件名预览 + 启用提交按钮
  ;(function() {
    function wireOne(form) {
      var input = form.querySelector('.slr-fig-input')
      var drop = form.querySelector('.slr-fig-drop')
      var label = form.querySelector('.slr-fig-filename')
      var submit = form.querySelector('.slr-fig-submit')
      if (!input || !drop) return

      function reflect(file) {
        if (!file) {
          if (label) label.textContent = '(尚未选择文件)'
          if (submit) submit.disabled = true
          return
        }
        var sz = file.size > 1024 * 1024 ? (file.size / 1024 / 1024).toFixed(1) + ' MB' : Math.round(file.size / 1024) + ' KB'
        if (label) label.textContent = '✓ ' + file.name + ' (' + sz + ')'
        if (submit) submit.disabled = false
        if (file.size > 10 * 1024 * 1024) {
          if (label) label.textContent = '⚠ 超过 10 MB:' + file.name
          if (submit) submit.disabled = true
        }
      }

      input.addEventListener('change', function() { reflect(input.files && input.files[0]) })

      drop.addEventListener('dragover', function(e) { e.preventDefault(); drop.classList.add('bg-emerald-100') })
      drop.addEventListener('dragleave', function() { drop.classList.remove('bg-emerald-100') })
      drop.addEventListener('drop', function(e) {
        e.preventDefault()
        drop.classList.remove('bg-emerald-100')
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
          input.files = e.dataTransfer.files
          reflect(input.files[0])
        }
      })
    }
    document.querySelectorAll('form[data-slr-fig-form]').forEach(wireOne)
  })()
</script>


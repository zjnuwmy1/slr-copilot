          <p class="text-[10px] text-slate-500 mb-1">点 ⚡ 一键生成全部 / 各章节 ▶ 生成,每章节 LLM 都会喂下面这些数据:</p>
          <div class="flex flex-wrap gap-1"><%- _btnChips(ingestSummary, 'section') %></div>
        </div>
      <% } %>
    </div>

    <!-- 老 job 进度(legacy fallback;新进度卡上方已覆盖) -->
    <!-- 2026-05-25 P0-8 重写:从 _byName 实时统计,跟下方 per-section 卡片保持一致, -->
    <!-- 避免 "顶部说 method 失败 / 下方卡片说 method 已生成" 之类的上下矛盾。     -->
    <!-- 同时 P0-6:如有累计幻觉引文,红色 banner 直接 surface 数字 + 跳引用覆盖率卡。 -->
    <% if (job && !_draftingRunInFlight) { %>
      <%
        // 实时从 _byName 计数(忽略 'auto' 状态如 references)
        let liveGenerated = 0, liveFailed = 0, liveInProgress = 0, livePending = 0
        let liveSections = []
        for (const sec of _customSections) {
          const sn = sec.name
          const s = _byName[sn]
          if (!s) { livePending++; liveSections.push({ name: sn, status: 'pending' }); continue }
          if (s.status === 'auto') continue
          liveSections.push({ name: sn, status: s.status, error: s.section_run_error })
          if (s.status === 'generated') liveGenerated++
          else if (s.status === 'failed') liveFailed++
          else if (s.status === 'in_progress') liveInProgress++
          else livePending++
        }
        const liveTotal = liveSections.length
        const liveDone = liveGenerated === liveTotal && liveFailed === 0 && liveInProgress === 0
        const totalHallucinated = (_draftSummary && _draftSummary.total_hallucinated) || 0
        const failedNames = liveSections.filter((s) => s.status === 'failed').map((s) => s.name)
      %>
      <div class="rounded-2xl border <%= liveFailed > 0 ? 'border-rose-200 bg-rose-50/40' : 'border-blue-200 bg-blue-50/60' %> p-4 text-sm">
        <div class="flex items-center justify-between">
          <p class="font-medium <%= liveFailed > 0 ? 'text-rose-800' : 'text-blue-800' %>">
            <% if (liveDone) { %>✓ 全部生成完成
            <% } else if (liveInProgress > 0) { %>⏳ 正在生成…
            <% } else if (liveFailed > 0) { %>⚠ 部分失败
            <% } else { %>已完成<% } %>
            <span class="text-xs font-normal">
              ✓ <%= liveGenerated %> · ⚠ <%= liveFailed %> · ⏳ <%= liveInProgress %> · ○ <%= livePending %> / 共 <%= liveTotal %><%= job.current ? ' · 当前:' + job.current : '' %>
            </span>
          </p>
          <span class="text-xs <%= liveFailed > 0 ? 'text-rose-600' : 'text-blue-600' %>">开始于 <%= job.startedAt %></span>
        </div>
        <% if (failedNames.length > 0) { %>
          <details class="mt-2" <%= failedNames.length > 0 ? 'open' : '' %>>
            <summary class="cursor-pointer text-xs text-rose-700">⚠ <%= failedNames.length %> 个章节失败:<%= failedNames.join(', ') %></summary>
            <ul class="mt-1 space-y-0.5 text-xs text-rose-700">
              <% liveSections.filter((s) => s.status === 'failed').forEach((s) => { %>
                <li>· <span class="font-mono"><%= s.name %></span><% if (s.error) { %>: <%= s.error.slice(0, 200) %><% } %></li>
              <% }) %>
            </ul>
          </details>
        <% } %>
        <% if (totalHallucinated > 0) { %>
          <div class="mt-2 rounded-lg border border-rose-300 bg-rose-50 px-3 py-2 text-xs text-rose-800">
            ⚠ <strong><%= totalHallucinated %></strong> 处幻觉引文(LLM 引了不在 include 集合的 rec_id)— 滚下方「📑 引用覆盖率分析」卡查看具体哪几个章节
          </div>
        <% } %>
        <%
          // P2-13:lint warnings banner(未知 [tbl:]/[fig:] 占位)
          const _lintT = (_draftSummary && _draftSummary.total_lint_unknown_tables) || 0
          const _lintF = (_draftSummary && _draftSummary.total_lint_unknown_figures) || 0
        %>
        <% if (_lintT > 0 || _lintF > 0) { %>
          <div class="mt-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900">
            ⚠ 占位符警告:LLM 引用了<% if (_lintT > 0) { %><strong> <%= _lintT %> 个未知表 key</strong><% } %><% if (_lintT > 0 && _lintF > 0) { %> · <% } %><% if (_lintF > 0) { %><strong> <%= _lintF %> 个未知图 id</strong><% } %> — preview 页正文会标 [unknown table/figure],导出 Markdown 占位不会被替换,需要手动修。
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- PRISMA Flow Diagram 已移到数据型表卡之前(UI 重排:数据派生先于撰写)-->
    <% /* placeholder — 已在表卡上方渲染 */ %>

    <span id="nav-manuscript" class="block" style="scroll-margin-top: 80px;"></span>
    <!-- ============================================================ -->
    <!-- Phase 8.A · 章节卡(动态 customSections;fallback 到 sectionList)-->
    <!-- ============================================================ -->
    <% if (_customSections.length) { %>
      <div class="space-y-3">
        <div class="flex items-baseline justify-between">
          <h3 class="text-sm font-medium uppercase text-slate-400">章节(<%= _customSections.length %> 个 · 基于期刊模板 / 项目模板)</h3>
          <span class="text-[11px] text-slate-400">写作顺序:按依赖关系拓扑排序</span>
        </div>

        <% _customSections.forEach(function(s, i) {
             const sName = s.name
             const summary = _byName[sName] || null
             // generated = 既有 version,且 status 真的是 generated(有正文)
             //   2026-05-25 修:之前只看 version > 0,导致 failed 行(version=1,
             //   但 content_markdown=空)被误判为 ✓ 已生成 — 跟顶部 job summary
             //   "method 失败"自相矛盾
             const sRunStatus = (summary && summary.section_run_status) || null
             const sRunning = sRunStatus === 'running'
             const sFailed = sRunStatus === 'failed' || sRunStatus === 'aborted_by_restart'
             const generated = !!(summary && (summary.version || 0) > 0
                                  && summary.status === 'generated'
                                  && !sFailed)
             const sMeta = (summary && summary.section_run_meta_parsed) || null
             const isAbstract = sName === 'abstract'
             const isReferences = sName === 'references'
             const dependsOn = Array.isArray(s.depends_on) ? s.depends_on : []
             const targetWords = s.target_words || s.target_word_count || null
             const cardCls = sRunning
               ? 'border-blue-300 bg-blue-50/40'
               : sFailed
                 ? 'border-rose-300 bg-rose-50/30'
                 : (isAbstract ? 'border-yellow-300 bg-yellow-50/30'
                   : (isReferences ? 'border-slate-300 bg-slate-50/40'
                     : (generated ? 'border-emerald-200 bg-white' : 'border-slate-200 bg-white')))
        %>
          <div id="section-card-<%= sName %>" class="rounded-2xl border <%= cardCls %> overflow-hidden">
            <!-- ribbon (abstract / references) -->
            <% if (isAbstract) { %>
              <div class="bg-yellow-100 px-4 py-1 text-[11px] text-yellow-900">📝 摘要在所有正文写完后自动生成(基于反推)</div>
            <% } else if (isReferences) { %>
              <div class="bg-slate-200 px-4 py-1 text-[11px] text-slate-700">🔗 References 自动从引文 map 拼装,不调 LLM</div>
            <% } %>

            <details <%= sRunning ? 'open' : '' %>>
              <summary class="cursor-pointer list-none px-4 py-3">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-700"><%= s.order || (i + 1) %></span>
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="text-sm font-semibold text-slate-800"><%= sName %></p>
                        <% if (targetWords) { %>
                          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-600">~<%= targetWords %> words</span>
                        <% } %>
                        <% if (s.required === false) { %>
                          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500">可选</span>
                        <% } %>
                        <% if (dependsOn.length) { %>
                          <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] text-indigo-700" title="依赖:<%= dependsOn.join(', ') %>">↳ depends: <%= dependsOn.slice(0,3).join(', ') %><%= dependsOn.length > 3 ? '…' : '' %></span>
                        <% } %>
                      </div>
                      <% if (generated && summary) { %>
                        <p class="mt-0.5 text-[11px] text-slate-500">
                          v<%= summary.version %>
                          <% if (summary.words) { %> · <%= summary.words %> words<% } %>
                          <% if (summary.model) { %> · <%= summary.model %><% } %>
                          <% if (summary.updated_at) { %> · <%= summary.updated_at %><% } %>
                        </p>
                      <% } %>
                    </div>
                  </div>
                  <div class="flex flex-none items-center gap-2">
                    <% if (sRunning) { %>
                      <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[10px] text-blue-700">⏳ 生成中</span>
                    <% } else if (sFailed) { %>
                      <span class="rounded-full bg-rose-100 px-2 py-0.5 text-[10px] text-rose-700">⚠ 失败</span>
                    <% } else if (generated) { %>
                      <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] text-emerald-700">✓ 已生成</span>
                    <% } else { %>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500">未生成</span>
                    <% } %>
                  </div>
                </div>
              </summary>

              <!-- per-section 进度卡(inline,sRunning 时显示) -->
              <% if (sRunning) { %>
                <%
                  const sStartedISO = (sMeta && (sMeta.started_at || sMeta.section_started_at)) || ''
                  const sEstimateS = Math.max(180, (targetWords ? Math.round(targetWords / 4) : 300))   // ~4 word/s output rate,至少 3 min
                  const sHardMaxS = 1800
                %>
                <div id="section-run-progress-<%= sName %>" class="mx-4 mb-3 rounded-xl border border-blue-200 bg-blue-50/40 p-3"
                     data-section="<%= sName %>"
                     data-started="<%= sStartedISO %>"
                     data-estimated="<%= sEstimateS %>"
                     data-hard-max="<%= sHardMaxS %>">
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 animate-spin text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 008-8h-4a4 4 0 01-4 4z"></path>
                    </svg>
                    <span class="text-xs font-medium text-blue-900">正在写「<%= sName %>」章节…</span>
                  </div>
                  <div class="mt-2 grid grid-cols-3 gap-2 text-center">
                    <div class="rounded bg-white p-1.5">
                      <p class="text-[9px] uppercase tracking-wide text-blue-600">已用</p>
                      <p class="text-sm font-mono font-bold text-blue-900"><span class="section-elapsed">0:00</span></p>
                    </div>
                    <div class="rounded bg-white p-1.5">
                      <p class="text-[9px] uppercase tracking-wide text-emerald-600">预估</p>
                      <p class="text-sm font-mono font-bold text-emerald-800">~<%= Math.round(sEstimateS / 60) %>:00</p>
                    </div>
                    <div class="rounded bg-white p-1.5">
                      <p class="text-[9px] uppercase tracking-wide text-amber-600">最长</p>
                      <p class="text-sm font-mono font-bold text-amber-800"><%= Math.round(sHardMaxS / 60) %>:00</p>
                    </div>
                  </div>
                  <div class="mt-2 h-1.5 w-full rounded-full bg-blue-100 overflow-hidden">
                    <div class="section-progress-bar h-full bg-blue-500 transition-all duration-1000" style="width: 0%"></div>
                  </div>
                  <p class="mt-1.5 flex items-center justify-between text-[10px]">
                    <span class="section-stage-hint text-blue-600">📡 提交 LLM…</span>
                    <span class="section-heartbeat text-slate-500 font-mono">💓 等待心跳…</span>
                  </p>
                </div>
              <% } %>

              <div class="px-4 pb-4 space-y-3">
                <% if (sFailed && summary) { %>
                  <div class="rounded-lg border border-rose-200 bg-rose-50/40 px-3 py-2 text-xs text-rose-800">
                    ⚠ 上次生成失败<% if (summary.section_run_error) { %>:<span class="font-mono"><%= summary.section_run_error %></span><% } %>。点 ↻ 重写按钮重试,或编辑章节名(避免 LLM 把不认识的 section 标 config_error)。
                  </div>
                <% } %>
                <% if (generated && summary && summary.content_markdown) { %>
                  <%
                    // 真·正文阅读区:全文显示 + 大字号 + serif + 充足行距
                    // 不再用 max-h-48 + font-mono 的"代码片段"样式
                    // ★ 用户硬性要求:写完了正文必须给用户看
                    const _articleText = summary.content_markdown
                    const _articleWords = summary.words || 0
                    const _cite = summary.citation_count || 0
                  %>
                  <article class="rounded-xl border border-slate-200 bg-white p-5 leading-relaxed"
                           style="font-family: 'Georgia', 'Times New Roman', 'PingFang SC', 'Microsoft YaHei', serif; font-size: 15px; line-height: 1.8; color: #1e293b; max-height: 70vh; overflow-y: auto;">
                    <div class="mb-3 flex items-center gap-3 border-b border-slate-100 pb-2 text-[11px] text-slate-500" style="font-family: ui-sans-serif, system-ui;">
                      <span>📄 <%= sName %></span>
                      <% if (_articleWords) { %><span>· <%= _articleWords %> words</span><% } %>
                      <% if (_cite) { %><span>· <%= _cite %> citations</span><% } %>
                      <% if (summary.version) { %><span>· v<%= summary.version %></span><% } %>
                      <span class="ml-auto">↕ 滚动查看全文</span>
                    </div>
                    <div class="whitespace-pre-wrap"><%= _articleText %></div>
                  </article>
                <% } %>

                <div class="flex flex-wrap items-center gap-2">
                  <% if (!isReferences) { %>
                    <form id="section-generate-form-<%= sName %>" method="post"
                          action="/projects/<%= project.id %>/report/generate-section/<%= encodeURIComponent(sName) %>"
                          data-section="<%= sName %>"
                          class="inline">
                      <input type="hidden" name="section" value="<%= sName %>">
                      <button type="submit"
                              class="rounded-lg bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700 disabled:bg-slate-300"
                              <%= sRunning ? 'disabled' : '' %>>
                        <% if (sRunning) { %>⏳ 生成中…<% } else if (generated) { %>↻ 重写此章节<% } else { %>⚡ 生成此章节<% } %>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-[11px] text-slate-500">References 在导出 Markdown 时自动从已写章节的 citation_map 中拼装,不调 LLM。</span>
                  <% } %>

                  <% if (generated && summary && summary.section_id) { %>
                    <button type="button"
                            class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50"
                            onclick="document.getElementById('section-edit-form-<%= sName %>').classList.toggle('hidden')">
                      ✎ 编辑
                    </button>
                  <% } %>
                </div>

                <% if (generated && summary && summary.section_id) { %>
                  <form id="section-edit-form-<%= sName %>" method="post"
                        action="/projects/<%= project.id %>/report/section/<%= summary.section_id %>/edit"
                        class="hidden space-y-2 rounded-lg border border-slate-200 bg-white p-3">
                    <textarea name="content_markdown" rows="18"
                              class="w-full rounded border border-slate-300 px-2 py-1 text-xs font-mono"><%= summary.content_markdown || summary.content_markdown_preview || '' %></textarea>
                    <div class="flex justify-end gap-2">
                      <button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">保存为新版本</button>
                    </div>
                  </form>
                <% } %>
              </div>
            </details>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <!-- Fallback:Agent B 还没传 customSections 时,沿用老 sectionList -->
      <div class="space-y-3">
        <h3 class="text-sm font-medium uppercase text-slate-400">章节(<%= sectionList.length %> 个)</h3>
        <% sectionList.forEach((s, i) => {
          const statusCfg = s.has_content
            ? (s.user_edited ? ['bg-blue-100 text-blue-700', '已编辑'] : ['bg-emerald-100 text-emerald-700', '已生成'])
            : ['bg-slate-100 text-slate-500', '未生成']
        %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <details>
              <summary class="cursor-pointer list-none">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-700"><%= i + 1 %></span>
                    <div>
                      <p class="text-sm font-semibold text-slate-800"><%= s.label %></p>
                      <% if (s.has_content) { %>
                        <p class="text-xs text-slate-500"><%= s.content_preview %>…</p>
                      <% } %>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <% if (s.citation_count > 0) { %>
                      <span class="text-xs text-slate-500"><%= s.citation_count %> 引用</span>
                    <% } %>
                    <span class="flex-none rounded-full px-2 py-0.5 text-[10px] <%= statusCfg[0] %>">
                      <%= statusCfg[1] %><%= s.version > 1 ? ' v' + s.version : '' %>
                    </span>
                  </div>
                </div>
              </summary>

              <div class="mt-3 space-y-3">
                <% if (s.has_content) { %>
                  <div class="rounded-lg border border-slate-100 bg-slate-50 p-3 text-sm whitespace-pre-wrap font-mono text-slate-800 max-h-96 overflow-y-auto"><%= s.content_markdown %></div>
                <% } %>

                <div class="flex flex-wrap items-center gap-2">
                  <form method="post" action="/projects/<%= project.id %>/report/generate-section"
                        onsubmit="return confirm('调用 LLM 生成「<%= s.label %>」章节(单次约 8K tokens / 1-3 分钟)。是否继续?')">
                    <input type="hidden" name="section" value="<%= s.section_name %>">
                    <button type="submit" class="rounded-lg bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">
                      <%= s.has_content ? '重新生成' : '生成' %>
                    </button>
                  </form>

                  <% if (s.has_content && s.section_id) { %>
                    <button type="button"
                            class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50"
                            onclick="document.getElementById('edit-form-<%= s.section_name %>').classList.toggle('hidden')">
                      编辑
                    </button>
                  <% } %>
                </div>

                <% if (s.has_content && s.section_id) { %>
                  <form id="edit-form-<%= s.section_name %>" method="post"
                        action="/projects/<%= project.id %>/report/section/<%= s.section_id %>/edit"
                        class="hidden space-y-2 rounded-lg border border-slate-200 bg-white p-3">
                    <textarea name="content_markdown" rows="18"
                              class="w-full rounded border border-slate-300 px-2 py-1 text-xs font-mono"><%= s.content_markdown %></textarea>
                    <div class="flex justify-end gap-2">
                      <button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">保存为新版本</button>
                    </div>
                  </form>
                <% } %>
              </div>
            </details>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- 综述插图区已上移到 PRISMA Flow 之后 / 数据型表卡之前(UI 重排:数据派生 → 综述插图 → 数据型表 → 综述初稿)-->

    <!-- ============================================================ -->
    <span id="nav-coverage" class="block" style="scroll-margin-top: 80px;"></span>
    <!-- 📑 引用覆盖率(2026-05-25 新加)— 哪些论文被引、哪些没被引 -->
    <!-- ============================================================ -->
    <% if (typeof citationCoverage !== 'undefined' && citationCoverage && citationCoverage.total_n > 0) { %>
      <%
        const _cc = citationCoverage
        const _pct = _cc.coverage_pct
        const _ccColor = _pct >= 80 ? 'emerald' : (_pct >= 50 ? 'amber' : 'rose')
      %>
      <!-- P1-14:幻觉 > 0 时默认展开 + 卡片加红边框警示 -->
      <details class="rounded-2xl border <%= _cc.hallucinated_n > 0 ? 'border-rose-300 bg-rose-50/30' : 'border-slate-200 bg-white' %> p-5" <%= _cc.hallucinated_n > 0 ? 'open' : '' %>>
        <summary class="cursor-pointer list-none">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-sm font-semibold text-slate-800">📑 引用覆盖率分析<% if (_cc.hallucinated_n > 0) { %> <span class="rounded-full bg-rose-200 px-2 py-0.5 text-[10px] text-rose-800">⚠ 有幻觉</span><% } %></h3>
              <p class="mt-0.5 text-xs text-slate-500">已纳入论文 <strong><%= _cc.total_n %></strong> 篇 · 在正文出现 <strong class="text-emerald-700"><%= _cc.cited_n %></strong> · 仅在 References 未被引 <strong class="<%= _cc.uncited_n > 0 ? 'text-rose-700' : 'text-slate-500' %>"><%= _cc.uncited_n %></strong><% if (_cc.hallucinated_n > 0) { %> · ⚠ 幻觉引文 <strong class="text-rose-700"><%= _cc.hallucinated_n %></strong><% } %></p>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-<%= _ccColor %>-100 px-2.5 py-0.5 text-xs font-semibold text-<%= _ccColor %>-800"><%= _pct %>%</span>
              <span class="text-xs text-slate-400">▾ 展开详情</span>
            </div>
          </div>
        </summary>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <!-- 被引用 -->
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/30 p-3">
            <h4 class="text-xs font-semibold text-emerald-900">✓ 已被正文引用(<%= _cc.cited_n %> 篇)</h4>
            <p class="mt-1 text-[10px] text-emerald-700">这些是 LLM 在初稿中真正用到的证据。</p>
            <% if (_cc.cited.length > 0) { %>
              <ul class="mt-2 max-h-72 space-y-1.5 overflow-y-auto text-[11px]">
                <% _cc.cited.slice(0, 200).forEach(function(r) { %>
                  <li class="rounded border border-emerald-100 bg-white px-2 py-1.5">
                    <p class="truncate font-medium text-slate-800" title="<%= r.title %>"><%= (r.year || '?') %>· <%= r.title.slice(0, 100) %></p>
                    <p class="mt-0.5 text-[10px] text-slate-500">
                      <% if (r.authors_text) { %><%= r.authors_text.slice(0, 60) %><% } %>
                      <% if (Array.isArray(r.in_sections) && r.in_sections.length) { %>
                        · 出现于:<%= r.in_sections.join(', ') %>
                      <% } %>
                    </p>
                  </li>
                <% }) %>
              </ul>
              <% if (_cc.cited.length > 200) { %>
                <p class="mt-1 text-[10px] text-emerald-600">…还有 <%= _cc.cited.length - 200 %> 篇,折叠展示前 200 条</p>
              <% } %>
            <% } %>
          </div>

          <!-- 未被引用 -->
          <div class="rounded-lg border <%= _cc.uncited_n > 0 ? 'border-rose-200 bg-rose-50/30' : 'border-slate-200 bg-slate-50/30' %> p-3">
            <h4 class="text-xs font-semibold <%= _cc.uncited_n > 0 ? 'text-rose-900' : 'text-slate-700' %>">⚠ 在 References 但未被正文引用(<%= _cc.uncited_n %> 篇)</h4>
            <p class="mt-1 text-[10px] <%= _cc.uncited_n > 0 ? 'text-rose-700' : 'text-slate-500' %>">
              <% if (_cc.uncited_n === 0) { %>
                太棒了 — 所有纳入论文都至少在某章节出现过。
              <% } else { %>
                这些论文会出现在导出的 References 段,但正文找不到对应引文。审稿人通常会问"为什么这篇 in references 但 not cited"。建议:① 在 Results / Discussion 补一句引用,或 ② 接受它就是"评估过但未发现可引价值"的状态。
              <% } %>
            </p>
            <% if (_cc.uncited.length > 0) { %>
              <ul class="mt-2 max-h-72 space-y-1.5 overflow-y-auto text-[11px]">
                <% _cc.uncited.slice(0, 200).forEach(function(r) { %>
                  <li class="rounded border border-rose-100 bg-white px-2 py-1.5">
                    <p class="truncate font-medium text-slate-800" title="<%= r.title %>"><%= (r.year || '?') %> · <%= r.title.slice(0, 100) %></p>
                    <p class="mt-0.5 text-[10px] text-slate-500">
                      <% if (r.authors_text) { %><%= r.authors_text.slice(0, 60) %><% } %>
                      · <span class="font-mono"><%= r.id %></span>
                    </p>
                  </li>
                <% }) %>
              </ul>
              <% if (_cc.uncited.length > 200) { %>
                <p class="mt-1 text-[10px] text-rose-600">…还有 <%= _cc.uncited.length - 200 %> 篇</p>
              <% } %>
            <% } %>
          </div>
        </div>

        <% if (Array.isArray(_cc.hallucinated) && _cc.hallucinated.length > 0) { %>
          <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50/60 p-3">
            <h4 class="text-xs font-semibold text-amber-900">⚠ 幻觉引文(<%= _cc.hallucinated.length %> 个 record_id 在正文出现但不在 include 集合)</h4>
            <p class="mt-1 text-[10px] text-amber-700">
              LLM 引了不存在的 record_id — 可能是编造,或者 include 集合在写完后被改了。导出 Markdown 时这些 placeholder 不会被替换成正式引文,需要你手动修。
            </p>
            <ul class="mt-2 space-y-1 text-[11px]">
              <% _cc.hallucinated.slice(0, 50).forEach(function(h) { %>
                <li class="rounded border border-amber-200 bg-white px-2 py-1">
                  <span class="font-mono text-amber-900"><%= h.id %></span> · 出现于 <%= h.in_sections.join(', ') %>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </details>
    <% } %>

    <details class="rounded-2xl border border-slate-200 bg-white p-5">
      <summary class="cursor-pointer text-sm font-medium uppercase text-slate-400">本步骤覆盖的 PRISMA 2020 清单项</summary>
      <ul class="mt-3 space-y-3 text-sm">
        <% stepItems.forEach(it => { %>
          <li class="flex gap-3">
            <span class="flex-none rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700">#<%= it.item_number %></span>
            <div class="min-w-0">
              <p class="font-medium text-slate-800"><%= it.topic %> <span class="text-xs font-normal text-slate-400">· <%= it.section %></span></p>
              <p class="mt-0.5 text-xs text-slate-500"><%= it.recommendation %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    </details>

    <!-- ============================================================ -->
    <span id="nav-validation" class="block" style="scroll-margin-top: 80px;"></span>
    <!-- Phase 8.D · PRISMA 27 项 AI 验证 — 全量覆盖度审计 -->
    <!-- ============================================================ -->
    <%
      // 8.D fallbacks(路由旧版本时 view 不能崩)
      const _prismaChecklistFull = (typeof prismaChecklistFull !== 'undefined' && Array.isArray(prismaChecklistFull)) ? prismaChecklistFull : []
      const _prismaValidateCounts = (typeof prismaValidateCounts !== 'undefined' && prismaValidateCounts && typeof prismaValidateCounts === 'object')
        ? prismaValidateCounts : { total: _prismaChecklistFull.length, validated: 0, covered: 0, partial: 0, missing: 0, unrated: _prismaChecklistFull.length }
      const _prismaValidateOverallScore = (typeof prismaValidateOverallScore !== 'undefined') ? Number(prismaValidateOverallScore) : 0
      const _prismaValidateInFlight = (typeof prismaValidateInFlight !== 'undefined') ? !!prismaValidateInFlight : false
      const _prismaValidateStatus = (typeof prismaValidateStatus !== 'undefined') ? (prismaValidateStatus || null) : null
      const _prismaValidateStarted = (typeof prismaValidateStarted !== 'undefined') ? (prismaValidateStarted || '') : ''
      const _prismaValidateFinished = (typeof prismaValidateFinished !== 'undefined') ? (prismaValidateFinished || null) : null
      const _prismaValidateError = (typeof prismaValidateError !== 'undefined') ? (prismaValidateError || null) : null
      const _prismaValidateLastAt = (typeof prismaValidateLastAt !== 'undefined') ? (prismaValidateLastAt || null) : null
      const _hasAnyValidation = (_prismaValidateCounts.validated || 0) > 0

      // 按 PRISMA section 分组(Title/Abstract/Introduction/Methods/Results/Discussion/Other)
      const _prismaBySection = {}
      const _sectionOrder = ['Title','Abstract','Introduction','Methods','Results','Discussion','Other']
      for (const it of _prismaChecklistFull) {
        const key = it.section || 'Other'
        if (!_prismaBySection[key]) _prismaBySection[key] = []
        _prismaBySection[key].push(it)
      }
    %>
    <div id="prisma-validate-card"
         class="rounded-2xl border <%= _prismaValidateInFlight ? 'border-blue-300 bg-blue-50/40' : (_prismaValidateStatus === 'failed' || _prismaValidateStatus === 'aborted_by_restart' ? 'border-rose-300 bg-rose-50/30' : (_hasAnyValidation ? 'border-emerald-200 bg-emerald-50/20' : 'border-violet-200 bg-violet-50/20')) %> p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <h2 class="text-base font-semibold text-slate-900">📋 PRISMA 27 项覆盖度审计</h2>
          <p class="mt-1 text-xs text-slate-600">
            Opus 4.8 通读已生成的全部章节,对照 PRISMA 2020 27 项清单逐项打 covered / partial / missing 标签 + 证据 + 改进建议。一次性,~3-10 min。
          </p>
          <% if (_hasAnyValidation && !_prismaValidateInFlight) { %>
            <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px]">
              <span class="rounded-full bg-emerald-100 px-2 py-0.5 font-medium text-emerald-800">✓ covered <%= _prismaValidateCounts.covered %></span>
              <span class="rounded-full bg-amber-100 px-2 py-0.5 font-medium text-amber-800">⚠ partial <%= _prismaValidateCounts.partial %></span>
              <span class="rounded-full bg-rose-100 px-2 py-0.5 font-medium text-rose-800">✗ missing <%= _prismaValidateCounts.missing %></span>
              <% if (_prismaValidateCounts.unrated > 0) { %>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-600">· 未评 <%= _prismaValidateCounts.unrated %></span>
              <% } %>
              <span class="rounded-full bg-slate-900 px-2 py-0.5 font-mono font-medium text-white">总分 <%= _prismaValidateOverallScore %>/100</span>
              <a href="/projects/<%= project.id %>/report/prisma-checklist.md"
                 class="rounded-full border border-blue-300 bg-blue-50 px-2 py-0.5 font-medium text-blue-700 hover:bg-blue-100"
                 title="下载 27 项 AI 审计完整报告(可贴 cover letter / 给审稿人 / 留档)">⬇ 27 项审计报告 .md</a>
              <% if (_prismaValidateLastAt) { %>
                <span class="text-slate-500">· 上次评估 <%= _prismaValidateLastAt %> UTC</span>
              <% } %>
            </div>
          <% } %>
        </div>
        <div class="flex flex-none flex-col items-end gap-2">
          <% if (_prismaValidateInFlight) { %>
            <span id="prisma-validate-status-pill"
                  class="rounded-lg bg-blue-100 px-3 py-2 text-xs font-mono text-blue-800"
                  data-started="<%= _prismaValidateStarted %>">
              ⏳ 验证中…(开始于 <%= _prismaValidateStarted %> UTC)
            </span>
          <% } else { %>
            <form id="prisma-validate-form" method="post"
                  action="/projects/<%= project.id %>/report/prisma-validate"
                  onsubmit="return confirm('调用 Opus 4.8 通读全部章节验证 PRISMA 27 项覆盖度(~3-10 min)。是否继续?')">
              <% if (typeof ingestSummary !== 'undefined' && ingestSummary) { %>
                <div class="mb-1.5 flex max-w-[420px] flex-wrap justify-end gap-1"><%- _btnChips(ingestSummary, 'prisma_validate') %></div>
              <% } %>
              <button type="submit" id="prisma-validate-btn"
                      class="rounded-lg <%= _hasAnyValidation ? 'bg-emerald-600 hover:bg-emerald-500' : 'bg-violet-600 hover:bg-violet-500' %> px-3 py-2 text-xs font-medium text-white shadow-sm">
                <%= _hasAnyValidation ? '↻ 重新验证 27 项' : '⚡ AI 验证 PRISMA 27 项覆盖度' %>
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <!-- in-flight 进度卡(类似 drafting overlay 的简版) -->
      <% if (_prismaValidateInFlight) { %>
        <div id="prisma-validate-progress"
             class="mt-3 rounded-xl border border-blue-200 bg-white/70 p-3"
             data-started="<%= _prismaValidateStarted %>">
          <div class="flex items-center gap-3">
            <svg class="h-5 w-5 animate-spin text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 008-8h-4a4 4 0 01-4 4z"></path>
            </svg>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold text-blue-900">正在 AI 验证 27 项 PRISMA 覆盖度</p>
              <p class="mt-0.5 text-xs text-blue-700">Opus 4.8 通读 <%= (typeof draftSummary !== 'undefined' && draftSummary && draftSummary.generated) ? draftSummary.generated : '?' %> 个章节 + 27 项 checklist…</p>
            </div>
          </div>
          <div class="mt-2 grid grid-cols-3 gap-2 text-center">
            <div class="rounded bg-blue-50 p-1.5">
              <p class="text-[9px] uppercase tracking-wide text-blue-600">已用</p>
              <p class="text-sm font-mono font-bold text-blue-900"><span id="prisma-validate-elapsed">0:00</span></p>
            </div>
            <div class="rounded bg-emerald-50 p-1.5">
              <p class="text-[9px] uppercase tracking-wide text-emerald-600">预估</p>
              <p class="text-sm font-mono font-bold text-emerald-800">~5:00</p>
            </div>
            <div class="rounded bg-amber-50 p-1.5">
              <p class="text-[9px] uppercase tracking-wide text-amber-600">最长</p>
              <p class="text-sm font-mono font-bold text-amber-800">15:00</p>
            </div>
          </div>
          <div class="mt-2 h-1.5 w-full rounded-full bg-blue-100 overflow-hidden">
            <div id="prisma-validate-progress-bar" class="h-full bg-blue-500 transition-all duration-1000" style="width: 0%"></div>
          </div>
          <p class="mt-1.5 text-[10px] text-blue-600">📡 后台运行中,可关闭页面 — 完成后页面刷新会显示结果。</p>
        </div>
      <% } %>

      <!-- 失败 banner -->
      <% if (!_prismaValidateInFlight && (_prismaValidateStatus === 'failed' || _prismaValidateStatus === 'aborted_by_restart')) { %>
        <div class="mt-3 rounded-xl border border-rose-200 bg-white p-3">
          <p class="text-sm font-semibold text-rose-900">⚠ 上次验证失败<% if (_prismaValidateStatus === 'aborted_by_restart') { %>(服务重启中断)<% } %></p>
          <% if (_prismaValidateError) { %>
            <pre class="mt-2 max-h-32 overflow-auto whitespace-pre-wrap rounded border border-rose-200 bg-rose-50 p-2 text-[11px] text-rose-900"><%= _prismaValidateError %></pre>
          <% } %>
          <p class="mt-2 text-xs text-rose-700">已有的验证结果会保留;重新点验证会全量重跑。</p>
        </div>
      <% } %>

      <!-- 2026-05-25:缺项 actionable banner — 跑完 AI 验证后,把所有 missing / partial
           的项整合一个 to-do 列表,带 section 上下文 + AI 建议,用户能直接看出
           "下面要改什么、改在哪一段" -->
      <% if (_hasAnyValidation && !_prismaValidateInFlight && (_prismaValidateCounts.missing + _prismaValidateCounts.partial > 0)) { %>
        <details class="mt-3 rounded-xl border border-rose-200 bg-rose-50/30" open>
          <summary class="cursor-pointer list-none px-4 py-2.5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-semibold text-rose-900">
                🔧 投稿前要补的 PRISMA 项(<%= _prismaValidateCounts.missing + _prismaValidateCounts.partial %>)
              </p>
              <span class="text-[10px] text-rose-700">▾ 展开 / 收起</span>
            </div>
            <p class="mt-0.5 text-[11px] text-rose-700">
              下方每条都给出:① 应该放在哪个 section · ② AI 建议怎么补 · ③ 一键跳到那个 section 编辑器。改完重跑 AI 验证。
            </p>
          </summary>
          <ul class="border-t border-rose-100 divide-y divide-rose-50 text-[12px]">
            <%
              // 把 missing / partial 项扁平化,按 PRISMA section + item_number 排序
              const _todoItems = _prismaChecklistFull
                .filter(function(x){ return x.ai_validation_status === 'missing' || x.ai_validation_status === 'partial' })
                .slice().sort(function(a,b){
                  const sa = _sectionOrder.indexOf(a.section||'Other')
                  const sb = _sectionOrder.indexOf(b.section||'Other')
                  if (sa !== sb) return sa - sb
                  return Number(a.item_number||0) - Number(b.item_number||0)
                })
              // section name → drafting section key,给"跳到那个 section 编辑器"的链接用
              const _secToDraft = {
                Title: 'title', Abstract: 'abstract', Introduction: 'introduction',
                Methods: 'methods', Results: 'results', Discussion: 'discussion',
              }
            %>
            <% _todoItems.forEach(function(it) {
                 let ev = it.ai_validation_evidence_parsed || null
                 const isMissing = it.ai_validation_status === 'missing'
                 const chipCls = isMissing ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800'
                 const chipText = isMissing ? '✗ missing' : '⚠ partial'
                 const draftKey = ev && ev.section ? String(ev.section).toLowerCase() : _secToDraft[it.section] || ''
                 const recText = (ev && ev.recommendation) ? ev.recommendation : (it.recommendation || '')
            %>
              <li class="px-4 py-2.5">
                <div class="flex items-start gap-2">
                  <span class="flex-none rounded bg-white border border-rose-200 px-1.5 py-0.5 font-mono text-[10px] text-rose-700">#<%= it.item_number %></span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2 flex-wrap">
                      <span class="text-[10px] font-medium uppercase text-rose-600"><%= it.section || 'Other' %></span>
                      <span class="font-medium text-slate-800"><%= it.topic %></span>
                      <span class="flex-none rounded-full px-2 py-0.5 text-[10px] font-medium <%= chipCls %>"><%= chipText %></span>
                    </div>
                    <% if (recText) { %>
                      <p class="mt-1 text-[11px] text-slate-700"><strong>需要补:</strong> <%= recText %></p>
                    <% } %>
                    <% if (draftKey) { %>
                      <a href="#nav-manuscript"
                         onclick="setTimeout(function(){var el=document.getElementById('draft-sec-'+'<%= draftKey %>');if(el){el.scrollIntoView({behavior:'smooth',block:'start'});var det=el.closest('details');if(det&&!det.open)det.open=true}}, 50)"
                         class="mt-1 inline-block text-[11px] text-blue-700 hover:text-blue-900 hover:underline">
                        → 在 <strong><%= it.section || draftKey %></strong> 段编辑器补这条
                      </a>
                    <% } %>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
        </details>
      <% } %>

      <!-- 27 项清单按 PRISMA section 分组渲染 -->
      <% if (_prismaChecklistFull.length) { %>
        <div class="mt-4 space-y-3">
          <% _sectionOrder.forEach(function(secKey) {
               const itemsInSec = _prismaBySection[secKey] || []
               if (!itemsInSec.length) return
          %>
            <details class="rounded-xl border border-slate-200 bg-white" <%= secKey === 'Methods' || secKey === 'Results' ? 'open' : '' %>>
              <summary class="cursor-pointer list-none px-4 py-2.5">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2">
                    <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500"><%= secKey %></span>
                    <span class="text-[10px] text-slate-400"><%= itemsInSec.length %> 项</span>
                  </div>
                  <%
                    const _secCovered = itemsInSec.filter(function(x){return x.ai_validation_status==='covered'}).length
                    const _secPartial = itemsInSec.filter(function(x){return x.ai_validation_status==='partial'}).length
                    const _secMissing = itemsInSec.filter(function(x){return x.ai_validation_status==='missing'}).length
                    const _secUnrated = itemsInSec.length - _secCovered - _secPartial - _secMissing
                  %>
                  <div class="flex items-center gap-1 text-[10px]">
                    <% if (_secCovered) { %><span class="rounded bg-emerald-100 px-1.5 py-0.5 text-emerald-800">✓<%= _secCovered %></span><% } %>
                    <% if (_secPartial) { %><span class="rounded bg-amber-100 px-1.5 py-0.5 text-amber-800">⚠<%= _secPartial %></span><% } %>
                    <% if (_secMissing) { %><span class="rounded bg-rose-100 px-1.5 py-0.5 text-rose-800">✗<%= _secMissing %></span><% } %>
                    <% if (_secUnrated) { %><span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-600">·<%= _secUnrated %></span><% } %>
                  </div>
                </div>
              </summary>
              <ul class="border-t border-slate-100 divide-y divide-slate-50">
                <% itemsInSec.forEach(function(it) {
                  let chipCls = 'bg-slate-100 text-slate-600'
                  let chipText = '· 未评'
                  if (it.ai_validation_status === 'covered') { chipCls = 'bg-emerald-100 text-emerald-800'; chipText = '✓ covered' }
                  else if (it.ai_validation_status === 'partial') { chipCls = 'bg-amber-100 text-amber-800'; chipText = '⚠ partial' }
                  else if (it.ai_validation_status === 'missing') { chipCls = 'bg-rose-100 text-rose-800'; chipText = '✗ missing' }
                  const ev = it.ai_validation_evidence_parsed || null
                  const hasEv = !!it.ai_validation_status
                %>
                  <li class="px-4 py-2.5">
                    <details>
                      <summary class="cursor-pointer list-none">
                        <div class="flex items-start gap-3">
                          <span class="flex-none rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] text-slate-700">#<%= it.item_number %></span>
                          <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium text-slate-800"><%= it.topic %></p>
                            <p class="mt-0.5 text-[11px] text-slate-500"><%= it.recommendation %></p>
                          </div>
                          <span class="flex-none rounded-full px-2 py-0.5 text-[10px] font-medium <%= chipCls %>" title="<%= hasEv ? '点击展开 AI 评估证据' : '尚未 AI 评估' %>">
                            <%= chipText %>
                          </span>
                        </div>
                      </summary>
                      <% if (hasEv && ev) { %>
                        <div class="mt-2 ml-9 rounded-lg border border-slate-100 bg-slate-50 p-3 space-y-2 text-[11px]">
                          <% if (ev.quote) { %>
                            <div>
                              <p class="font-medium uppercase tracking-wide text-slate-400 text-[10px]">📌 证据(verbatim quote)</p>
                              <blockquote class="mt-1 border-l-2 border-slate-300 pl-2 text-slate-700"><%= ev.quote %></blockquote>
                            </div>
                          <% } %>
                          <% if (ev.section) { %>
                            <p class="text-slate-600"><span class="font-medium uppercase tracking-wide text-slate-400 text-[10px]">📍 出处:</span> <code class="rounded bg-white px-1.5 py-0.5 text-[10px] font-mono text-slate-700 border border-slate-200"><%= ev.section %></code></p>
                          <% } %>
                          <% if (ev.recommendation) { %>
                            <div>
                              <p class="font-medium uppercase tracking-wide text-slate-400 text-[10px]">💡 改进建议</p>
                              <p class="mt-1 text-slate-700"><%= ev.recommendation %></p>
                            </div>
                          <% } %>
                          <% if (it.ai_validated_at) { %>
                            <p class="text-[10px] text-slate-400">评估时间:<%= it.ai_validated_at %> UTC</p>
                          <% } %>
                        </div>
                      <% } else { %>
                        <p class="mt-2 ml-9 text-[11px] text-slate-400 italic">尚未 AI 评估 — 点击顶部「AI 验证 PRISMA 27 项覆盖度」按钮触发。</p>
                      <% } %>
                    </details>
                  </li>
                <% }) %>
              </ul>
            </details>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- ============================================================ -->
    <!-- Phase 8.E · LaTeX 投稿模板:已迁到 Step 9 /:id/submission           -->
    <!-- ============================================================ -->
    <% if (false) { /* LaTeX 卡已迁到 Step 9 submission.ejs */ %>
    <%
      const _latexTemplate = (typeof latexTemplate !== 'undefined' && latexTemplate && typeof latexTemplate === 'object')
        ? latexTemplate
        : { zip_path: null, extracted_at: null, extract_dir: null, main_tex_filename: null, tex_files: [] }
      const _latexAuthors = (typeof latexAuthors !== 'undefined' && latexAuthors && typeof latexAuthors === 'object')
        ? latexAuthors
        : { authors: [], affiliations: [], correspondence_email: '', funding_text: '', acknowledgements_text: '' }
      const _latexLastRender = (typeof latexLastRender !== 'undefined') ? latexLastRender : null
      const _latexRenderInFlight = (typeof latexRenderInFlight !== 'undefined') ? !!latexRenderInFlight : false
      const _latexHasTemplate = !!(_latexTemplate && _latexTemplate.extracted_at)
      const _latexHasMain = !!(_latexTemplate && _latexTemplate.main_tex_filename)
      const _latexAuthorsList = Array.isArray(_latexAuthors.authors) ? _latexAuthors.authors : []
      const _latexAffsList = Array.isArray(_latexAuthors.affiliations) ? _latexAuthors.affiliations : []
      const _latexTexFiles = Array.isArray(_latexTemplate.tex_files) ? _latexTemplate.tex_files : []
      const _latexFillSystemVersion = (typeof latexFillSystemVersion !== 'undefined') ? (latexFillSystemVersion || '') : ''
    %>
    <div id="latex-card"
         class="rounded-2xl border <%= _latexRenderInFlight ? 'border-blue-300 bg-blue-50/40' : (_latexLastRender && _latexLastRender.status === 'failed' ? 'border-rose-300 bg-rose-50/30' : (_latexLastRender && _latexLastRender.status === 'success' ? 'border-emerald-200 bg-emerald-50/20' : 'border-amber-200 bg-amber-50/30')) %> p-6 mt-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <h2 class="text-base font-semibold text-slate-900">🎯 LaTeX 投稿模板</h2>
          <p class="mt-1 text-sm text-slate-600">
            上传期刊提供的 LaTeX 模板 .zip → 平台用 Opus 4.8 把已写好的初稿章节按模板格式填进去 → 服务器 pdflatex 渲染 PDF 供预览 → 下载 .tex 源 ZIP 直接投稿。
          </p>
          <p class="mt-1 text-xs text-slate-500">
            提示词版本 <code class="font-mono text-[10px]"><%= _latexFillSystemVersion %></code> · 需要 prod 端 TeX Live 2023(本地仅作 LLM 填充测试)
          </p>
        </div>
      </div>

      <!-- ── 1. 上传 .zip 模板 ── -->
      <div class="mt-5 rounded-xl border border-slate-200 bg-white p-4">
        <h3 class="text-sm font-semibold text-slate-800">① 上传 LaTeX 模板 .zip</h3>
        <% if (_latexHasTemplate) { %>
          <p class="mt-1 text-xs text-emerald-700">✓ 已解压:<%= _latexTexFiles.length %> 个 .tex 文件 · 上次上传 <%= _latexTemplate.extracted_at %> UTC</p>
        <% } else { %>
          <p class="mt-1 text-xs text-amber-700">⚠ 还未上传模板;请从 Elsevier / IEEE / Springer 官方下载 LaTeX 投稿包(.zip)</p>
        <% } %>
        <form method="post" action="/projects/<%= project.id %>/report/latex/upload"
              enctype="multipart/form-data" class="mt-3 flex flex-wrap items-center gap-3">
          <input type="file" name="file" accept=".zip,application/zip" required
                 class="block w-full max-w-md text-xs text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-violet-600 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-white hover:file:bg-violet-500" />
          <button type="submit"
                  class="rounded-lg bg-violet-600 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-violet-500">
            <%= _latexHasTemplate ? '↻ 重新上传' : '⬆ 上传模板' %>
          </button>
        </form>
      </div>

      <!-- ── 2. 挑 main.tex ── -->
      <% if (_latexHasTemplate && _latexTexFiles.length > 0) { %>
        <div class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-sm font-semibold text-slate-800">② 选择主 .tex 文件</h3>
          <p class="mt-1 text-xs text-slate-500">通常是 <code class="font-mono">main.tex</code> / <code class="font-mono">manuscript.tex</code> / <code class="font-mono">elsarticle-template.tex</code>;Opus 会基于这个文件填内容。</p>
          <form method="post" action="/projects/<%= project.id %>/report/latex/main-entry" class="mt-3 flex flex-wrap items-center gap-3">
            <select name="main_tex" required
                    class="rounded-md border border-slate-300 px-3 py-1.5 text-xs">
              <% _latexTexFiles.forEach(function (f) { %>
                <option value="<%= f %>" <%= (_latexTemplate.main_tex_filename === f) ? 'selected' : '' %>><%= f %></option>
              <% }) %>
            </select>
            <button type="submit"
                    class="rounded-lg bg-slate-700 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-slate-600">保存</button>
            <% if (_latexHasMain) { %>
              <span class="text-xs text-emerald-700">✓ 当前:<code class="font-mono"><%= _latexTemplate.main_tex_filename %></code></span>
            <% } %>
          </form>
        </div>
      <% } %>

      <!-- ── 3. 作者 + 单位 + 致谢 ── -->
      <% if (_latexHasMain) { %>
        <div class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-sm font-semibold text-slate-800">③ 作者 / 单位 / 致谢</h3>
          <p class="mt-1 text-xs text-slate-500">动态增删行;留空字段会被忽略。Opus 会按模板的 \author / \affiliation 宏填进去。</p>
          <form id="latex-authors-form" method="post"
                action="/projects/<%= project.id %>/report/latex/authors-form"
                class="mt-3 space-y-4">
            <!-- 隐藏 JSON 字段(JS 在提交时填充) -->
            <input type="hidden" name="authors_json" id="latex-authors-json" />
            <input type="hidden" name="affiliations_json" id="latex-affiliations-json" />

            <!-- Authors -->
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-600 uppercase tracking-wide">Authors</span>
                <button type="button" id="latex-add-author"
                        class="rounded-md border border-slate-300 px-2 py-1 text-[11px] hover:bg-slate-50">+ 添加作者</button>
              </div>
              <div id="latex-authors-rows" class="mt-2 space-y-2"></div>
            </div>

            <!-- Affiliations -->
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-600 uppercase tracking-wide">Affiliations</span>
                <button type="button" id="latex-add-affiliation"
                        class="rounded-md border border-slate-300 px-2 py-1 text-[11px] hover:bg-slate-50">+ 添加单位</button>
              </div>
              <div id="latex-affiliations-rows" class="mt-2 space-y-2"></div>
            </div>

            <!-- Email + funding + ack -->
            <div class="grid gap-3 md:grid-cols-3">
              <label class="text-[11px] text-slate-600">
                通讯作者 email
                <input name="correspondence_email" type="email" value="<%= _latexAuthors.correspondence_email || '' %>"
                       class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-xs" />
              </label>
              <label class="text-[11px] text-slate-600 md:col-span-2">
                资助声明(funding)
                <input name="funding_text" type="text" value="<%= _latexAuthors.funding_text || '' %>"
                       class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-xs" />
              </label>
            </div>
            <label class="block text-[11px] text-slate-600">
              致谢(acknowledgements)
              <textarea name="acknowledgements_text" rows="2"
                        class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-xs"><%= _latexAuthors.acknowledgements_text || '' %></textarea>
            </label>

            <div class="flex items-center gap-2">
              <button type="submit"
                      class="rounded-lg bg-slate-700 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-slate-600">保存作者表单</button>
              <span class="text-[11px] text-slate-400">当前:<%= _latexAuthorsList.length %> 位作者 · <%= _latexAffsList.length %> 个单位</span>
            </div>
          </form>
        </div>
      <% } %>

      <!-- ── 4. 渲染 PDF ── -->
      <% if (_latexHasMain) { %>
        <div class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-sm font-semibold text-slate-800">④ 渲染 PDF 预览</h3>
          <p class="mt-1 text-xs text-slate-500">Opus 4.8 把 draft_sections 按模板格式填进 main.tex,服务器跑 latexmk(120s 超时)→ PDF。整个流程 3-8 min。</p>

          <% if (_latexRenderInFlight) { %>
            <div id="latex-render-progress"
                 class="mt-3 rounded-lg border border-blue-200 bg-blue-50/60 p-3"
                 data-render-id="<%= _latexLastRender.id %>"
                 data-started="<%= _latexLastRender.started_at %>">
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 animate-spin text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 008-8h-4a4 4 0 01-4 4z"></path>
                </svg>
                <span class="text-xs text-blue-800">渲染中…(<span id="latex-render-elapsed">0</span>s,可关页面)</span>
              </div>
              <p class="mt-1 text-[11px] text-blue-600">render_id = <code class="font-mono"><%= _latexLastRender.id %></code></p>
            </div>
          <% } else { %>
            <form method="post" action="/projects/<%= project.id %>/report/latex/render" class="mt-3"
                  onsubmit="return confirm('调用 Opus 4.8 + 跑 pdflatex(~3-8 min)。是否继续?')">
              <button type="submit"
                      class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-emerald-500">
                <%= _latexLastRender ? '↻ 重新渲染' : '⚡ 渲染 PDF 预览' %>
              </button>
            </form>
          <% } %>

          <!-- 最近一次 render 结果 -->
          <% if (_latexLastRender) { %>
            <div class="mt-4 border-t border-slate-100 pt-4">
              <% if (_latexLastRender.status === 'success' && !_latexRenderInFlight) { %>
                <p class="text-xs text-emerald-700">
                  ✓ 上次渲染成功 · <%= _latexLastRender.finished_at %> UTC
                  <% if (_latexLastRender.llm_usage_log_id) { %> · usage_log #<%= _latexLastRender.llm_usage_log_id %><% } %>
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <a href="/projects/<%= project.id %>/report/latex/render/<%= _latexLastRender.id %>/source.zip"
                     class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">⬇ 下载 .tex 源 zip</a>
                  <a href="/projects/<%= project.id %>/report/latex/render/<%= _latexLastRender.id %>/pdf" target="_blank"
                     class="rounded-md border border-emerald-300 px-3 py-1.5 text-xs font-medium text-emerald-700 hover:bg-emerald-50">↗ 在新窗口打开 PDF</a>
                </div>
                <iframe src="/projects/<%= project.id %>/report/latex/render/<%= _latexLastRender.id %>/pdf"
                        class="mt-3 w-full rounded border border-slate-200" style="height: 800px;"
                        title="LaTeX render preview"></iframe>
              <% } else if (_latexLastRender.status === 'failed') { %>
                <p class="text-xs font-medium text-rose-800">⚠ 上次渲染失败 · <%= _latexLastRender.finished_at %> UTC</p>
                <% if (_latexLastRender.error) { %>
                  <pre class="mt-2 max-h-64 overflow-auto whitespace-pre-wrap rounded border border-rose-200 bg-rose-50 p-2 text-[10px] text-rose-900"><%= _latexLastRender.error.slice(-2000) %></pre>
                <% } %>
                <% if (_latexLastRender.llm_usage_log_id) { %>
                  <p class="mt-1 text-[11px] text-slate-500">LLM usage log #<%= _latexLastRender.llm_usage_log_id %>(供超管诊断)</p>
                <% } %>
              <% } else if (_latexLastRender.status === 'aborted_by_restart') { %>
                <p class="text-xs text-amber-700">⚠ 上次渲染被服务重启中断 · <%= _latexLastRender.finished_at %> UTC · 直接重跑即可</p>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
    <% } /* end if(false) — LaTeX 卡已迁到 Step 9 */ %>

    <!-- ============================================================ -->
    <!-- Phase 8.E 客户端脚本:已随 LaTeX 卡迁走;这里跳过                -->
    <!-- ============================================================ -->
    <% if (false) { %>
    <script>
    (function () {
      // ── 动态作者 / affiliation 表 ─────────────────────────────
      var initialAuthors = <%- JSON.stringify(_latexAuthorsList) %>
      var initialAffs = <%- JSON.stringify(_latexAffsList) %>
      var authorsBox = document.getElementById('latex-authors-rows')
      var affsBox = document.getElementById('latex-affiliations-rows')
      if (!authorsBox || !affsBox) return  // 模板还未上传时整个表单不显示

      function renderAuthor(a, idx) {
        var row = document.createElement('div')
        row.className = 'flex flex-wrap items-center gap-2 rounded border border-slate-200 bg-slate-50 p-2'
        row.dataset.role = 'author-row'
        row.innerHTML =
          '<input data-k="first" placeholder="First name" value="' + (a.first || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs w-28" />' +
          '<input data-k="last" placeholder="Last name" value="' + (a.last || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs w-32" />' +
          '<input data-k="email" placeholder="email" value="' + (a.email || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs w-44" />' +
          '<input data-k="orcid" placeholder="ORCID" value="' + (a.orcid || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs w-36" />' +
          '<input data-k="affiliation_id" placeholder="affiliation_id" value="' + (a.affiliation_id || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs w-28" />' +
          '<button type="button" data-role="del" class="rounded border border-rose-300 px-2 py-1 text-[10px] text-rose-700 hover:bg-rose-50">删</button>'
        row.querySelector('[data-role="del"]').addEventListener('click', function () { row.remove() })
        return row
      }
      function renderAff(a, idx) {
        var row = document.createElement('div')
        row.className = 'flex flex-wrap items-center gap-2 rounded border border-slate-200 bg-slate-50 p-2'
        row.dataset.role = 'aff-row'
        row.innerHTML =
          '<input data-k="id" placeholder="id (a/b/1/...)" value="' + (a.id || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs w-24" />' +
          '<input data-k="name" placeholder="Institution name" value="' + (a.name || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs flex-1 min-w-[180px]" />' +
          '<input data-k="department" placeholder="Department" value="' + (a.department || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs flex-1 min-w-[140px]" />' +
          '<input data-k="address" placeholder="Address" value="' + (a.address || '').replace(/"/g, '&quot;') + '" class="rounded border border-slate-300 px-2 py-1 text-xs flex-1 min-w-[160px]" />' +
          '<button type="button" data-role="del" class="rounded border border-rose-300 px-2 py-1 text-[10px] text-rose-700 hover:bg-rose-50">删</button>'
        row.querySelector('[data-role="del"]').addEventListener('click', function () { row.remove() })
        return row
      }

      if (initialAuthors.length === 0) initialAuthors = [{ first: '', last: '', email: '', orcid: '', affiliation_id: 'a' }]
      if (initialAffs.length === 0) initialAffs = [{ id: 'a', name: '', department: '', address: '' }]
      initialAuthors.forEach(function (a, i) { authorsBox.appendChild(renderAuthor(a, i)) })
      initialAffs.forEach(function (a, i) { affsBox.appendChild(renderAff(a, i)) })

      var addAuthorBtn = document.getElementById('latex-add-author')
      var addAffBtn = document.getElementById('latex-add-affiliation')
      if (addAuthorBtn) addAuthorBtn.addEventListener('click', function () { authorsBox.appendChild(renderAuthor({}, 0)) })
      if (addAffBtn) addAffBtn.addEventListener('click', function () { affsBox.appendChild(renderAff({}, 0)) })

      function rowToObj(row) {
        var out = {}
        row.querySelectorAll('input[data-k]').forEach(function (inp) {
          var k = inp.getAttribute('data-k')
          out[k] = inp.value.trim()
        })
        return out
      }
      var form = document.getElementById('latex-authors-form')
      if (form) {
        form.addEventListener('submit', function () {
          var authors = []
          authorsBox.querySelectorAll('[data-role="author-row"]').forEach(function (row) {
            var o = rowToObj(row)
            // 至少要有 first 或 last 才视为有效行
            if (o.first || o.last) authors.push(o)
          })
          var affs = []
          affsBox.querySelectorAll('[data-role="aff-row"]').forEach(function (row) {
            var o = rowToObj(row)
            if (o.id || o.name) affs.push(o)
          })
          document.getElementById('latex-authors-json').value = JSON.stringify(authors)
          document.getElementById('latex-affiliations-json').value = JSON.stringify(affs)
        })
      }

      // ── 渲染状态轮询 ─────────────────────────────────────────
      var renderProg = document.getElementById('latex-render-progress')
      if (renderProg) {
        var renderId = renderProg.getAttribute('data-render-id')
        var startedISO = renderProg.getAttribute('data-started') || ''
        var startedMs = startedISO ? Date.parse(String(startedISO).replace(' ', 'T') + (String(startedISO).indexOf('Z') < 0 ? 'Z' : '')) : Date.now()
        if (!isFinite(startedMs)) startedMs = Date.now()
        var elEl = document.getElementById('latex-render-elapsed')
        function tickLatex() {
          var s = Math.max(0, Math.floor((Date.now() - startedMs) / 1000))
          if (elEl) elEl.textContent = s
        }
        tickLatex()
        var tickInt = setInterval(tickLatex, 1000)

        var projectIdJs = <%- JSON.stringify(project.id) %>
        function pollLatex() {
          fetch('/projects/' + projectIdJs + '/report/latex/render/' + renderId + '/status.json',
                { headers: { 'X-Requested-With': 'fetch' } })
            .then(function (r) { return r.json() })
            .then(function (j) {
              if (!j || !j.ok || !j.render) return
              if (!j.render.in_flight) {
                clearInterval(tickInt)
                clearInterval(pollInt)
                window.location.reload()
              }
            })
            .catch(function () {})
        }
        var pollInt = setInterval(pollLatex, 8000)
        setTimeout(pollLatex, 2000)
      }
    })()
    </script>
    <% } /* end if(false) — LaTeX 脚本已迁到 submission.ejs */ %>

    <!-- 底部导航:← 证据强度 · 进入 Step 9 投稿 -->
    <div class="flex flex-wrap justify-between gap-3 text-sm">
      <a href="/projects/<%= project.id %>/certainty" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-700 hover:bg-slate-50">← 返回证据强度</a>
      <a href="/projects/<%= project.id %>/submission" class="rounded-lg bg-emerald-600 px-3 py-2 text-white hover:bg-emerald-500">→ 进入 Step 9 投稿准备</a>
    </div>
  </section>
</div>

<!-- ============================================================ -->
<!-- Phase 8.D · PRISMA 27 项验证 — 客户端轮询 + tick -->
<!-- ============================================================ -->
<script>
(function () {
  var card = document.getElementById('prisma-validate-progress')
  var pill = document.getElementById('prisma-validate-status-pill')
  var btn = document.getElementById('prisma-validate-btn')
  if (!card && !pill) return  // 不在 in-flight 状态,无需轮询

  var startedISO = (card || pill).getAttribute('data-started') || ''
  var startedMs = startedISO ? Date.parse(String(startedISO).replace(' ', 'T') + (String(startedISO).indexOf('Z') < 0 ? 'Z' : '')) : Date.now()
  if (!isFinite(startedMs)) startedMs = Date.now()
  var HARD_TIMEOUT_S = 900   // 15 min(对齐锁)

  function fmt(s) {
    var m = Math.floor(s / 60), ss = s % 60
    return m + ':' + (ss < 10 ? '0' : '') + ss
  }
  var elapsedEl = document.getElementById('prisma-validate-elapsed')
  var barEl = document.getElementById('prisma-validate-progress-bar')
  function tick() {
    var s = Math.max(0, Math.floor((Date.now() - startedMs) / 1000))
    if (elapsedEl) elapsedEl.textContent = fmt(s)
    if (barEl) barEl.style.width = Math.min(95, Math.round((s / HARD_TIMEOUT_S) * 100)) + '%'
  }
  tick()
  var tickerId = setInterval(tick, 1000)

  var projectId = <%- JSON.stringify(project.id) %>
  function poll() {
    fetch('/projects/' + projectId + '/report/prisma-validate/status.json', { headers: { 'X-Requested-With': 'fetch' } })
      .then(function (r) { return r.json() })
      .then(function (j) {
        if (!j || !j.ok) return
        if (!j.in_flight) {
          // 完成 — 刷新整页让 server-side 渲染最新结果
          clearInterval(tickerId)
          clearInterval(pollerId)
          window.location.reload()
        }
      })
      .catch(function () { /* 静默重试 */ })
  }
  var pollerId = setInterval(poll, 8000)
  // 立刻拉一次
  setTimeout(poll, 2000)
})()
</script>


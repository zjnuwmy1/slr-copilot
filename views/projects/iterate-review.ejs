<%- include('../partials/header', { title }) %>
<%- include('partials/project-header', { project }) %>

<%
  const d = pending.data
  const diag = d.diagnosis
  const np = d.new_protocol
  const cp = currentProtocol  // 可能为 null
  const confColor = diag.confidence === 'high' ? 'emerald' : (diag.confidence === 'low' ? 'rose' : 'amber')
%>

<section class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-purple-600">复盘 → 审阅</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">AI 给出的诊断 + 优化协议</h1>
      <p class="mt-1 text-xs text-slate-500">
        模型:<%= pending.model %> · 思考:<%= pending.reasoning || '默认' %> · 耗时 <%= pending.durationMs %>ms ·
        <%= pending.createdAt %>
      </p>
    </div>
    <form method="post" action="/projects/<%= project.id %>/iterate/discard" class="inline"
          onsubmit="return confirm('丢弃 AI 诊断结果?')">
      <button type="submit" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
        丢弃,不采用
      </button>
    </form>
  </div>

  <!-- Diagnosis -->
  <section class="rounded-2xl border border-<%= confColor %>-300 bg-<%= confColor %>-50/40 p-5">
    <div class="flex items-center gap-2">
      <h2 class="text-base font-semibold text-<%= confColor %>-900">诊断</h2>
      <span class="rounded-full bg-<%= confColor %>-100 px-2 py-0.5 text-[11px] font-medium text-<%= confColor %>-700">
        置信度:<%= diag.confidence === 'high' ? '高' : (diag.confidence === 'low' ? '低 — 仅供参考' : '中') %>
      </span>
    </div>
    <p class="mt-3 text-sm text-slate-800 whitespace-pre-wrap"><%= diag.summary %></p>
    <% if (diag.specific_signals && diag.specific_signals.length) { %>
      <div class="mt-4">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">基于以下证据</p>
        <ul class="mt-2 space-y-1 text-sm text-slate-700 list-disc pl-5">
          <% diag.specific_signals.forEach(s => { %><li><%= s %></li><% }) %>
        </ul>
      </div>
    <% } %>
  </section>

  <!-- Proposed changes(具体改动列表) -->
  <% if (d.proposed_changes && d.proposed_changes.length) { %>
    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-medium uppercase tracking-wider text-slate-500">提出的改动(<%= d.proposed_changes.length %> 处)</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% d.proposed_changes.forEach(c => {
             const typeColor = c.type.startsWith('add') ? 'emerald' : (c.type.startsWith('remove') ? 'rose' : 'blue')
             const typeLabel = ({
               add_concept_group_term:'+ 概念词',
               remove_concept_group_term:'- 概念词',
               add_inclusion:'+ 纳入标准',
               remove_inclusion:'- 纳入标准',
               add_exclusion:'+ 排除标准',
               remove_exclusion:'- 排除标准',
               modify_research_question:'⟳ 研究问题',
             })[c.type] || c.type
        %>
          <li class="flex gap-3 items-start">
            <span class="shrink-0 rounded-full bg-<%= typeColor %>-100 px-2 py-0.5 text-[11px] font-medium text-<%= typeColor %>-700"><%= typeLabel %></span>
            <div class="min-w-0 flex-1">
              <% if (c.before) { %>
                <p class="text-xs text-slate-500"><span class="text-rose-600 line-through"><%= c.before %></span></p>
              <% } %>
              <p class="text-sm text-slate-800"><%= c.after %></p>
              <% if (c.rationale) { %>
                <p class="mt-0.5 text-xs text-slate-500">理由:<%= c.rationale %></p>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <!-- 新协议 vs 当前协议(并列对比) -->
  <section class="rounded-2xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium uppercase tracking-wider text-slate-500">完整协议对比</h2>
    <div class="mt-3 grid gap-4 lg:grid-cols-2">

      <!-- 当前 -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/40 p-4">
        <p class="text-xs font-semibold text-slate-600">当前 v<%= cp ? cp.version : '?' %></p>
        <% if (cp) { %>
          <% if (cp.research_questions.length) { %>
            <p class="mt-3 text-xs font-medium text-slate-500">研究问题</p>
            <ul class="mt-1 space-y-0.5 text-xs text-slate-700 list-decimal pl-5">
              <% cp.research_questions.forEach(q => { %><li><%= q %></li><% }) %>
            </ul>
          <% } %>
          <% if (cp.concept_groups.length) { %>
            <p class="mt-3 text-xs font-medium text-slate-500">概念组</p>
            <ul class="mt-1 space-y-1 text-xs text-slate-700">
              <% cp.concept_groups.forEach(g => { %>
                <li><span class="font-medium"><%= g.name %>:</span>
                    <span class="text-slate-600"><%= (g.terms || []).join(' | ') %></span></li>
              <% }) %>
            </ul>
          <% } %>
          <% if (cp.inclusion_criteria.length) { %>
            <p class="mt-3 text-xs font-medium text-slate-500">纳入</p>
            <ul class="mt-1 space-y-0.5 text-xs text-slate-700 list-disc pl-5">
              <% cp.inclusion_criteria.forEach(c => { %><li><%= c %></li><% }) %>
            </ul>
          <% } %>
          <% if (cp.exclusion_criteria.length) { %>
            <p class="mt-3 text-xs font-medium text-slate-500">排除</p>
            <ul class="mt-1 space-y-0.5 text-xs text-slate-700 list-disc pl-5">
              <% cp.exclusion_criteria.forEach(c => { %><li><%= c %></li><% }) %>
            </ul>
          <% } %>
        <% } else { %>
          <p class="mt-3 text-xs text-slate-400">没有已审批的当前协议</p>
        <% } %>
      </div>

      <!-- 新协议 -->
      <div class="rounded-xl border-2 border-purple-300 bg-purple-50/30 p-4">
        <p class="text-xs font-semibold text-purple-700">AI 建议 v_next(待审批)</p>
        <% if (np.research_questions.length) { %>
          <p class="mt-3 text-xs font-medium text-purple-700">研究问题</p>
          <ul class="mt-1 space-y-0.5 text-xs text-slate-700 list-decimal pl-5">
            <% np.research_questions.forEach(q => { %><li><%= q %></li><% }) %>
          </ul>
        <% } %>
        <% if (np.concept_groups.length) { %>
          <p class="mt-3 text-xs font-medium text-purple-700">概念组</p>
          <ul class="mt-1 space-y-1 text-xs text-slate-700">
            <% np.concept_groups.forEach(g => { %>
              <li><span class="font-medium"><%= g.name %>:</span>
                  <span class="text-slate-600"><%= (g.terms || []).join(' | ') %></span></li>
            <% }) %>
          </ul>
        <% } %>
        <% if (np.inclusion_criteria.length) { %>
          <p class="mt-3 text-xs font-medium text-purple-700">纳入</p>
          <ul class="mt-1 space-y-0.5 text-xs text-slate-700 list-disc pl-5">
            <% np.inclusion_criteria.forEach(c => { %><li><%= c %></li><% }) %>
          </ul>
        <% } %>
        <% if (np.exclusion_criteria.length) { %>
          <p class="mt-3 text-xs font-medium text-purple-700">排除</p>
          <ul class="mt-1 space-y-0.5 text-xs text-slate-700 list-disc pl-5">
            <% np.exclusion_criteria.forEach(c => { %><li><%= c %></li><% }) %>
          </ul>
        <% } %>
        <% if (np.rationale) { %>
          <p class="mt-3 text-xs font-medium text-purple-700">改动综述</p>
          <p class="mt-1 text-xs text-slate-700 whitespace-pre-wrap"><%= np.rationale %></p>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Next steps -->
  <% if (d.next_steps_for_user && d.next_steps_for_user.length) { %>
    <section class="rounded-xl border border-blue-200 bg-blue-50/40 p-4 text-sm">
      <p class="font-medium text-blue-900">采纳后建议你做这些</p>
      <ul class="mt-2 space-y-0.5 text-blue-800 list-decimal pl-5">
        <% d.next_steps_for_user.forEach(s => { %><li><%= s %></li><% }) %>
      </ul>
    </section>
  <% } %>

  <!-- Warnings -->
  <% if (d.warnings && d.warnings.length) { %>
    <section class="rounded-xl border border-amber-200 bg-amber-50/60 p-4 text-sm">
      <p class="font-medium text-amber-900">⚠ AI 的风险提醒</p>
      <ul class="mt-2 space-y-0.5 text-amber-800 list-disc pl-5">
        <% d.warnings.forEach(w => { %><li><%= w %></li><% }) %>
      </ul>
    </section>
  <% } %>

  <!-- Action bar -->
  <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5">
    <div class="min-w-0">
      <p class="text-sm font-medium text-slate-800">采纳后会发生什么</p>
      <p class="mt-1 text-xs text-slate-500">
        ① 在本项目里创建新协议版本(unapproved);② 你被引导到协议页可以再编辑;
        ③ 审批后,你需要去 <strong>检索式</strong> 页重新跑 exploration / 重新优化主检索;
        ④ 原有的 records / screening / 主题等 <strong>不会被自动删除</strong>(由你决定要不要重置)。
      </p>
    </div>
    <form method="post" action="/projects/<%= project.id %>/iterate/adopt" class="shrink-0">
      <button type="submit"
              class="rounded-lg bg-purple-600 px-5 py-2 text-sm font-medium text-white hover:bg-purple-500">
        ✓ 采纳并生成 v_next(待审批)
      </button>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>

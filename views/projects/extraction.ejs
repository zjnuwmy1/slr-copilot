<%- include('../partials/header', { title: project.title + ' · ' + stepLabel }) %>
<%- include('partials/project-header', { project }) %>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress, currentStep: 'extraction' }) %>

  <section class="space-y-6">
    <div class="rounded-xl border border-blue-100 bg-blue-50/60 px-4 py-3">
      <p class="text-xs font-medium uppercase tracking-wider text-blue-700">Step 4 of 8 · <%= stepLabel %></p>
      <p class="mt-1 text-sm text-slate-600">
        覆盖 PRISMA
        <% stepItems.forEach((it, i) => { %><span class="font-mono">#<%= it.item_number %></span><%= i < stepItems.length - 1 ? ' · ' : '' %><% }) %>
      </p>
    </div>

    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="text-2xl">📋</p>
      <h2 class="mt-2 text-lg font-semibold text-slate-800">即将开放</h2>
      <p class="mt-1 text-sm text-slate-500">本步骤将在 Phase 4 接入。支持自定义抽取表单、AI 辅助字段抽取、PICO/PECO 模板。</p>
      <div class="mt-4 flex justify-center gap-2">
        <a href="/projects/<%= project.id %>/screening" class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">← 返回筛选</a>
        <a href="/projects/<%= project.id %>" class="rounded-lg bg-slate-900 px-3 py-2 text-sm text-white hover:bg-slate-700">跳到协议</a>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <h3 class="text-sm font-medium uppercase text-slate-400">本步骤覆盖的 PRISMA 2020 清单项</h3>
      <ul class="mt-3 space-y-3 text-sm">
        <% stepItems.forEach(it => { %>
          <li class="flex gap-3">
            <span class="flex-none rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700">#<%= it.item_number %></span>
            <div class="min-w-0">
              <p class="font-medium text-slate-800"><%= it.topic %> <span class="text-xs font-normal text-slate-400">· <%= it.section %></span></p>
              <p class="mt-0.5 text-xs text-slate-500"><%= it.recommendation %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header', { title: project.title + ' · ' + stepLabel }) %>
<%- include('partials/project-header', { project }) %>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress, currentStep: 'rob' }) %>

  <section class="space-y-6">
    <%- include('partials/step-banner', {
      stepNum: 5,
      stepTitle: '看每篇论文质量如何',
      stepIntro: '评估每篇文献的研究质量 / 偏倚风险 — 一篇质量低的论文不该跟一篇 RCT 同等权重。RoB 2 / ROBINS-I 工具支持中。',
      prismaItems: (stepItems || []).map((it) => `#${it.item_number}`).join(' · '),
    }) %>

    <div class="rounded-2xl border border-slate-200 bg-white p-8">
      <div class="flex flex-wrap items-start gap-6">
        <div class="flex-1 min-w-0">
          <h2 class="text-lg font-semibold text-slate-900">偏倚风险评估</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            站内的偏倚风险工具暂未开放。对当前工作流没有阻断 —— 你可以:
          </p>
          <ul class="mt-2 space-y-1 text-sm text-slate-600 list-disc pl-5">
            <li>在 <a href="/projects/<%= project.id %>/synthesis" class="text-slate-900 underline hover:no-underline">综合</a> 阶段把"研究质量"作为主题维度讨论;</li>
            <li>在 <a href="/projects/<%= project.id %>/certainty" class="text-slate-900 underline hover:no-underline">证据强度</a> 步骤的 risk_of_bias 维度里填整体评级 + 理由;</li>
            <li>在外部用 Cochrane RoB 2 / ROBINS-I / Newcastle-Ottawa 完成评估后,在最终报告的"方法"章节注明评估方式与结论。</li>
          </ul>
        </div>
        <div class="flex flex-none flex-col gap-2">
          <a href="/projects/<%= project.id %>/extraction" class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition">← 返回矩阵</a>
          <a href="/projects/<%= project.id %>/synthesis" class="rounded-lg bg-slate-900 px-3 py-2 text-sm text-white hover:bg-slate-700 transition">下一步:综合 →</a>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <h3 class="text-sm font-medium uppercase text-slate-400">本步骤覆盖的 PRISMA 2020 清单项</h3>
      <ul class="mt-3 space-y-3 text-sm">
        <% stepItems.forEach(it => { %>
          <li class="flex gap-3">
            <span class="flex-none rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700">#<%= it.item_number %></span>
            <div class="min-w-0">
              <p class="font-medium text-slate-800"><%= it.topic %> <span class="text-xs font-normal text-slate-400">· <%= it.section %></span></p>
              <p class="mt-0.5 text-xs text-slate-500"><%= it.recommendation %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header', { title }) %>

<%
  // 容错:Agent D 的 partial 如果还没合,fallback 到普通布局
  let hasStepper = true
  try { /* noop — include 失败会在下面 catch 不到,EJS 是编译期。所以这里靠 fs 判断不现实,
           直接 include,假设 D 已经在场(routes/projects/index.js 已经引用 stepper)*/ } catch { hasStepper = false }
%>

<%- include('partials/project-header', { project }) %>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress: progress || { stepStatus: {}, prismaProgress: { donePct: 0, done: 0, total: 42 } }, currentStep: 'search' }) %>

  <section class="space-y-6 min-w-0">

    <%- include('partials/step-banner', {
      stepNum: 2,
      stepTitle: '准备检索关键词',
      stepIntro: 'AI 帮你把协议里的概念组扩展成可直接粘到 Web of Science / Scopus / PubMed 的检索式 — 三库 × 高召回/平衡/高精确 共 9 条。',
      prismaItems: '#6 Information sources · #7 Search strategy',
    }) %>

    <!-- 顶部操作栏 -->
    <div class="flex items-start justify-between gap-4">
      <div></div>
      <% if (latestVersion != null) { %>
        <a href="/projects/<%= project.id %>/search/export.md"
           class="flex-none rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-100">
          导出 Markdown 附录
        </a>
      <% } %>
    </div>

    <!-- 协议状态卡 -->
    <% if (!approvedProtocol) { %>
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
        <p class="text-sm font-medium text-amber-900">请先审批研究协议</p>
        <p class="mt-1 text-sm text-amber-800">检索式必须基于已审批的协议(概念组 / 研究问题 / 纳排标准)生成。请回到协议步骤,生成并审批一份协议。</p>
        <a href="/projects/<%= project.id %>"
           class="mt-3 inline-flex items-center rounded-lg bg-amber-600 px-3 py-1.5 text-sm text-white hover:bg-amber-500">
          前往协议步骤
        </a>
      </div>
    <% } else { %>
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4">
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-emerald-900">已基于协议 v<%= approvedProtocol.version %> 进行检索式生成</p>
            <p class="mt-0.5 text-xs text-emerald-800">
              <%= (approvedProtocol.concept_groups || []).length %> 个概念组 ·
              <%= (approvedProtocol.research_questions || []).length %> 个研究问题
            </p>
          </div>
          <form method="post" action="/projects/<%= project.id %>/search/generate"
                onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='生成中…(2-5 分钟,请保持页面打开)';">
            <button type="submit"
                    class="rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700 disabled:bg-slate-500 disabled:cursor-wait">
              <%= latestVersion != null ? '重新生成检索式' : '让 Claude 生成检索式' %>
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <!-- 检索式区(三个数据库 tab) -->
    <% if (latestVersion == null) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white/60 p-10 text-center text-slate-500">
        <% if (approvedProtocol) { %>
          点击上方按钮,让 Claude 生成 9 条检索式(3 库 × 3 版本)。
        <% } else { %>
          需要先审批协议。
        <% } %>
      </div>
    <% } else { %>
      <%
        // 计算每个 database 是否有数据,首选有内容的第一个 tab
        const firstActiveDb = (dbOrder || ['wos','scopus','pubmed']).find(k => (byDatabase[k] || []).length > 0) || 'wos'
      %>
      <div class="rounded-2xl border border-slate-200 bg-white">
        <!-- Tabs -->
        <div class="flex border-b border-slate-200" role="tablist">
          <% (dbOrder || ['wos','scopus','pubmed']).forEach((dbKey, i) => {
               const list = byDatabase[dbKey] || []
               const isActive = (dbKey === firstActiveDb)
          %>
            <button type="button"
                    role="tab"
                    data-tab-target="tab-<%= dbKey %>"
                    class="search-tab-btn flex-1 px-4 py-3 text-sm font-medium border-b-2 <%= isActive ? 'border-blue-500 text-blue-700 bg-blue-50/40' : 'border-transparent text-slate-600 hover:text-slate-900' %>">
              <%= dbLabel[dbKey] || dbKey %>
              <span class="ml-1 text-xs text-slate-400">(<%= list.length %>)</span>
            </button>
          <% }) %>
        </div>

        <!-- Tab panels -->
        <% (dbOrder || ['wos','scopus','pubmed']).forEach((dbKey) => {
             const list = byDatabase[dbKey] || []
             const isActive = (dbKey === firstActiveDb)
        %>
          <div id="tab-<%= dbKey %>" class="search-tab-panel <%= isActive ? '' : 'hidden' %> p-5 space-y-4">
            <% if (list.length === 0) { %>
              <p class="text-sm text-slate-500">本数据库没有可用的检索式(LLM 可能跳过了),可以点上方"重新生成"。</p>
            <% } %>
            <% list.forEach(s => { %>
              <article class="rounded-xl border border-slate-200 bg-slate-50/30 p-4 space-y-3">
                <header class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2">
                    <%
                      const qtCls = ({
                        high_recall:    'bg-rose-100 text-rose-700',
                        balanced:       'bg-blue-100 text-blue-700',
                        high_precision: 'bg-emerald-100 text-emerald-700',
                      })[s.query_type] || 'bg-slate-100 text-slate-600'
                    %>
                    <span class="rounded-full px-2.5 py-0.5 text-xs font-medium <%= qtCls %>"><%= qtLabel[s.query_type] || s.query_type %></span>
                    <% if (s.model) { %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500"><%= s.model %></span><% } %>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500">v<%= s.version %></span>
                  </div>
                  <button type="button"
                          class="copy-btn rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-100"
                          data-copy-target="qtext-<%= s.id %>">
                    复制
                  </button>
                </header>

                <% if (s.rationale) { %>
                  <p class="text-xs text-slate-600"><span class="font-medium text-slate-700">设计理由:</span><%= s.rationale %></p>
                <% } %>

                <textarea id="qtext-<%= s.id %>" readonly rows="5"
                          class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-blue-500"><%= s.query_text %></textarea>

                <% if (s.filters) { %>
                  <div class="flex flex-wrap gap-2 text-xs text-slate-500">
                    <% if (s.filters.year_range) { %><span class="rounded bg-slate-100 px-2 py-0.5">年份: <%= s.filters.year_range.join('-') %></span><% } %>
                    <% if (s.filters.document_types) { %><span class="rounded bg-slate-100 px-2 py-0.5">类型: <%= s.filters.document_types.join('/') %></span><% } %>
                    <% if (s.filters.language) { %><span class="rounded bg-slate-100 px-2 py-0.5">语言: <%= s.filters.language.join('/') %></span><% } %>
                  </div>
                <% } %>

                <!-- 命中数 + 检索日期表单 -->
                <form method="post" action="/projects/<%= project.id %>/search/<%= s.id %>/log"
                      class="grid gap-2 sm:grid-cols-[1fr_1fr_auto] sm:items-end pt-2 border-t border-slate-200">
                  <div>
                    <label class="text-xs text-slate-600" for="rc-<%= s.id %>">命中数</label>
                    <input id="rc-<%= s.id %>" type="number" min="0" step="1" name="result_count"
                           value="<%= s.result_count != null ? s.result_count : '' %>"
                           placeholder="如 1234"
                           class="mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm">
                  </div>
                  <div>
                    <label class="text-xs text-slate-600" for="sd-<%= s.id %>">检索日期</label>
                    <input id="sd-<%= s.id %>" type="date" name="search_date"
                           value="<%= s.search_date || '' %>"
                           class="mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm">
                  </div>
                  <button type="submit"
                          class="rounded-md bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">
                    保存记录
                  </button>
                </form>

                <!-- 备注 -->
                <details class="text-xs text-slate-600">
                  <summary class="cursor-pointer text-slate-500 hover:text-slate-700">备注 / 修订记录<% if (s.notes) { %> <span class="text-emerald-600">·已填</span><% } %></summary>
                  <form method="post" action="/projects/<%= project.id %>/search/<%= s.id %>/notes" class="mt-2 space-y-2">
                    <textarea name="notes" rows="3"
                              placeholder="例如:WoS 实际跑出 1543 条,比预期少;尝试去掉 NEAR/5 后增加到 2010 条"
                              class="block w-full rounded-md border-slate-300 px-2 py-1.5 text-xs"><%= s.notes || '' %></textarea>
                    <div class="flex justify-end">
                      <button type="submit" class="rounded-md border border-slate-300 px-3 py-1 text-xs text-slate-700 hover:bg-slate-100">保存备注</button>
                    </div>
                  </form>
                </details>
              </article>
            <% }) %>
          </div>
        <% }) %>
      </div>

      <!-- 历史版本提示 -->
      <%
        const olderVersions = []
        const seen = new Set()
        for (const s of strategies) {
          if (s.version === latestVersion) continue
          if (seen.has(s.version)) continue
          seen.add(s.version)
          olderVersions.push(s.version)
        }
      %>
      <% if (olderVersions.length) { %>
        <p class="text-xs text-slate-400">历史检索式版本:<%= olderVersions.map(v => 'v' + v).join(' · ') %>(导出 Markdown 仅包含最新版)</p>
      <% } %>

      <!-- AI 优化主检索 — 为每个用户勾选的库优化生成一条最终主检索 -->
      <%
        const loggedNum = (typeof loggedCount === 'number') ? loggedCount : 0
        const canRecommend = loggedNum >= 2
        const targetDbs = (typeof targetDatabases !== 'undefined') ? (targetDatabases || []) : []
        const mainBatch = (typeof latestMainBatch !== 'undefined') ? (latestMainBatch || []) : []
        const mainV = (typeof latestMainVersion !== 'undefined') ? latestMainVersion : null
      %>
      <section class="rounded-2xl border border-indigo-300 bg-indigo-50/40 p-5 space-y-4">
        <header class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="text-base font-semibold text-indigo-900">AI 优化主检索</h3>
            <p class="mt-1 text-xs text-indigo-800">
              基于你已跑过的 exploration 检索式命中数 + 已审批协议,
              为你勾选的 <strong><%= targetDbs.map(d => d.toUpperCase()).join(' / ') || '所有库' %></strong>
              <strong>各重新合成 1 条优化后的主检索</strong>(不是从已有的里挑赢家)。
              这是后续正式筛选用的 source-of-truth。
            </p>
            <p class="mt-1 text-xs text-indigo-700">
              已回填 exploration 命中数:<span class="font-medium"><%= loggedNum %></span> 条
              <% if (!canRecommend) { %>
                <span class="ml-2 text-amber-700">至少填 2 条,AI 才能基于反馈优化</span>
              <% } %>
              <% if (mainV != null) { %>
                <span class="ml-2 text-slate-500">· 当前主检索:v<%= mainV %></span>
              <% } %>
            </p>
          </div>
          <form method="post" action="/projects/<%= project.id %>/search/recommend-best"
                onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='AI 优化中…(约 1-3 分钟)';">
            <button type="submit"
                    <% if (!canRecommend) { %>disabled title="先填至少 2 条命中数"<% } %>
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-500 disabled:bg-slate-300 disabled:cursor-not-allowed disabled:text-slate-500">
              <%= mainV != null ? '重新优化主检索' : '让 AI 优化主检索' %>
            </button>
          </form>
        </header>

        <% if (mainBatch.length > 0) { %>
          <div class="space-y-3 border-t border-indigo-200 pt-4">
            <p class="text-xs font-medium text-indigo-900">v<%= mainV %> · <%= mainBatch.length %> 条优化主检索:</p>

            <% mainBatch.forEach((s) => { %>
              <article class="rounded-xl border-2 border-indigo-300 bg-white p-4 space-y-3 shadow-sm">
                <header class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2">
                    <span class="rounded-full bg-indigo-600 px-2.5 py-0.5 text-xs font-medium text-white"><%= dbLabel[s.database_name] || s.database_name %></span>
                    <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[11px] font-medium text-indigo-800">主检索</span>
                    <% if (s.model) { %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500"><%= s.model %></span><% } %>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500">v<%= s.version %></span>
                  </div>
                  <button type="button"
                          class="copy-btn rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-100"
                          data-copy-target="qtext-<%= s.id %>">
                    复制
                  </button>
                </header>

                <% if (s.rationale) { %>
                  <p class="text-xs text-slate-600 whitespace-pre-wrap"><span class="font-medium text-slate-700">优化思路:</span><%= s.rationale %></p>
                <% } %>

                <textarea id="qtext-<%= s.id %>" readonly rows="6"
                          class="block w-full rounded-md border border-indigo-200 bg-indigo-50/30 px-3 py-2 font-mono text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-indigo-500"><%= s.query_text %></textarea>

                <% if (s.filters) { %>
                  <div class="flex flex-wrap gap-2 text-xs text-slate-500">
                    <% if (s.filters.year_range) { %><span class="rounded bg-slate-100 px-2 py-0.5">年份: <%= s.filters.year_range.join('-') %></span><% } %>
                    <% if (s.filters.document_types) { %><span class="rounded bg-slate-100 px-2 py-0.5">类型: <%= s.filters.document_types.join('/') %></span><% } %>
                    <% if (s.filters.language) { %><span class="rounded bg-slate-100 px-2 py-0.5">语言: <%= s.filters.language.join('/') %></span><% } %>
                  </div>
                <% } %>

                <!-- 命中数 + 检索日期表单(主检索也要回填) -->
                <form method="post" action="/projects/<%= project.id %>/search/<%= s.id %>/log"
                      class="grid gap-2 sm:grid-cols-[1fr_1fr_auto] sm:items-end pt-2 border-t border-indigo-100">
                  <div>
                    <label class="text-xs text-slate-600" for="rc-<%= s.id %>">实际命中数</label>
                    <input id="rc-<%= s.id %>" type="number" min="0" step="1" name="result_count"
                           value="<%= s.result_count != null ? s.result_count : '' %>"
                           placeholder="跑完再填"
                           class="mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm">
                  </div>
                  <div>
                    <label class="text-xs text-slate-600" for="sd-<%= s.id %>">检索日期</label>
                    <input id="sd-<%= s.id %>" type="date" name="search_date"
                           value="<%= s.search_date || '' %>"
                           class="mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm">
                  </div>
                  <button type="submit"
                          class="rounded-md bg-indigo-600 px-3 py-1.5 text-xs text-white hover:bg-indigo-500">
                    保存记录
                  </button>
                </form>
              </article>
            <% }) %>
          </div>
        <% } else if (canRecommend) { %>
          <p class="text-xs text-indigo-700 border-t border-indigo-200 pt-3">
            还没生成主检索。点击右上角按钮,AI 会基于你已跑过的命中数 + 协议,为每个目标库各合成一条。
          </p>
        <% } %>
      </section>

      <!-- ============ 锁定最终方案 ============ -->
      <%
        const ls = (typeof lockState !== 'undefined' && lockState) ? lockState : { isLocked:false, lockedAt:null, targetDatabases:[], records:{} }
        // 为每个目标库构造下拉候选(main 优先,然后 exploration,然后历史 batch 里的)
        const stratByDb = {}
        for (const s of (strategies || [])) {
          const d = s.database_name
          if (!stratByDb[d]) stratByDb[d] = []
          stratByDb[d].push(s)
        }
        // 每库内主检索优先,然后按 query_type / version 排
        const QT_ORDER_LOCK = { main: 0, balanced: 1, high_recall: 2, high_precision: 3 }
        for (const k of Object.keys(stratByDb)) {
          stratByDb[k].sort((a, b) => {
            const da = QT_ORDER_LOCK[a.query_type] ?? 9
            const dbb = QT_ORDER_LOCK[b.query_type] ?? 9
            if (da !== dbb) return da - dbb
            return (b.version || 0) - (a.version || 0)
          })
        }
      %>
      <section class="rounded-2xl border-2 <%= ls.isLocked ? 'border-emerald-300 bg-emerald-50/30' : 'border-amber-300 bg-amber-50/30' %> p-5 space-y-4">
        <header class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="text-base font-semibold <%= ls.isLocked ? 'text-emerald-900' : 'text-amber-900' %>">
              <%= ls.isLocked ? '✓ 检索方案已锁定' : '锁定最终检索方案(上传 CSV 前必做)' %>
            </h3>
            <p class="mt-1 text-xs <%= ls.isLocked ? 'text-emerald-800' : 'text-amber-800' %>">
              <% if (ls.isLocked) { %>
                已落盘:<%= ls.lockedAt %>。这是 PRISMA 报告里"实际跑了什么检索"的 source-of-truth。
                上传 CSV 后会按这套记录核对。需要改动,请先解锁。
              <% } else { %>
                把每个目标库实际用了什么检索式、跑出多少条、检索日期固定下来。
                **CSV 必须先锁定方案后才能上传**(PRISMA 流程图要靠这套数字)。
              <% } %>
            </p>
          </div>
          <% if (ls.isLocked) { %>
            <form method="post" action="/projects/<%= project.id %>/search/unlock"
                  onsubmit="return confirm('解锁后可修改,但已上传的 CSV 不会自动撤销。继续?')">
              <button type="submit" class="rounded-lg border border-amber-300 bg-white px-3 py-2 text-sm text-amber-700 hover:bg-amber-50">
                🔓 解锁修改
              </button>
            </form>
          <% } %>
        </header>

        <form method="post" action="/projects/<%= project.id %>/search/lock" class="space-y-3">
          <% (ls.targetDatabases || []).forEach((d) => {
               const rec = ls.records[d] || {}
               const candidates = stratByDb[d] || []
          %>
            <div class="rounded-xl border <%= rec.used ? 'border-emerald-200 bg-white' : 'border-slate-200 bg-white/60' %> p-4 space-y-3">
              <header class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="rounded-full bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-white"><%= dbLabel[d] || d %></span>
                  <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                    <input type="checkbox" name="<%= d %>__used" value="1"
                           <%= rec.used ? 'checked' : '' %>
                           <%= ls.isLocked ? 'disabled' : '' %>
                           data-db="<%= d %>"
                           class="lock-used-cb rounded">
                    我在这个库跑了检索
                  </label>
                </div>
              </header>

              <div class="lock-detail" data-db="<%= d %>" <%= rec.used ? '' : 'style="display:none"' %>>
                <% if (candidates.length > 0) { %>
                  <div>
                    <label class="text-xs text-slate-600">从已有版本选(可选,选了会自动填检索式)</label>
                    <select name="<%= d %>__strategy_id"
                            <%= ls.isLocked ? 'disabled' : '' %>
                            class="lock-strategy-select mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm"
                            data-db="<%= d %>">
                      <option value="">— 不引用已有版本 / 自己写 —</option>
                      <% candidates.forEach((s) => {
                           const isMain = s.query_type === 'main'
                           const lab = (qtLabel[s.query_type] || s.query_type) + ' v' + s.version +
                                       (s.result_count != null ? ' (' + s.result_count + ' 条)' : '')
                      %>
                        <option value="<%= s.id %>"
                                data-query-text="<%= s.query_text.replace(/"/g, '&quot;') %>"
                                <%= rec.strategy_id === s.id ? 'selected' : '' %>>
                          <%= isMain ? '★ ' : '' %><%= lab %>
                        </option>
                      <% }) %>
                    </select>
                  </div>
                <% } %>

                <div class="mt-3">
                  <label class="text-xs text-slate-600">最终检索式(必填,可以从上面选或直接粘贴/编辑)</label>
                  <textarea name="<%= d %>__query_text" rows="5"
                            <%= ls.isLocked ? 'readonly' : '' %>
                            class="lock-query-text mt-1 block w-full rounded-md border-slate-300 bg-white px-2 py-1.5 font-mono text-xs"
                            data-db="<%= d %>"
                            placeholder="粘贴你在 <%= dbLabel[d] || d %> 真实跑过的检索式"><%= rec.query_text || '' %></textarea>
                </div>

                <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
                  <div>
                    <label class="text-xs text-slate-600">实际命中数</label>
                    <input type="number" min="0" step="1" name="<%= d %>__result_count"
                           value="<%= rec.result_count != null ? rec.result_count : '' %>"
                           <%= ls.isLocked ? 'readonly' : '' %>
                           placeholder="例如 1234"
                           class="mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm">
                  </div>
                  <div>
                    <label class="text-xs text-slate-600">检索日期</label>
                    <input type="date" name="<%= d %>__search_date"
                           value="<%= rec.search_date || '' %>"
                           <%= ls.isLocked ? 'readonly' : '' %>
                           class="mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm">
                  </div>
                  <div>
                    <label class="text-xs text-slate-600">备注(可选)</label>
                    <input type="text" name="<%= d %>__notes" maxlength="200"
                           value="<%= rec.notes || '' %>"
                           <%= ls.isLocked ? 'readonly' : '' %>
                           placeholder="例如:用了图书馆订阅"
                           class="mt-1 block w-full rounded-md border-slate-300 px-2 py-1.5 text-sm">
                  </div>
                </div>
              </div>
            </div>
          <% }) %>

          <% if (!ls.isLocked) { %>
            <div class="flex items-center justify-between border-t border-slate-200 pt-3">
              <p class="text-xs text-slate-500">勾上"我在这个库跑了检索"会展开详情。至少要勾 1 个库才能锁定。</p>
              <button type="submit"
                      class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition">
                🔒 锁定并继续上传 CSV
              </button>
            </div>
          <% } else { %>
            <div class="rounded-lg border border-emerald-200 bg-white/60 p-3 text-xs text-emerald-800 flex items-center justify-between">
              <span>方案已锁定,可以进入下一步上传 CSV。</span>
              <a href="/projects/<%= project.id %>/zotero" class="rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-500">
                去上传 CSV →
              </a>
            </div>
          <% } %>
        </form>
      </section>
    <% } %>

  </section>
</div>

<script>
  // Tab 切换
  document.querySelectorAll('.search-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tgt = btn.getAttribute('data-tab-target')
      document.querySelectorAll('.search-tab-btn').forEach(b => {
        b.classList.remove('border-blue-500', 'text-blue-700', 'bg-blue-50/40')
        b.classList.add('border-transparent', 'text-slate-600')
      })
      btn.classList.remove('border-transparent', 'text-slate-600')
      btn.classList.add('border-blue-500', 'text-blue-700', 'bg-blue-50/40')
      document.querySelectorAll('.search-tab-panel').forEach(p => p.classList.add('hidden'))
      const panel = document.getElementById(tgt)
      if (panel) panel.classList.remove('hidden')
    })
  })

  // 锁定卡:勾选"已使用"展开 / 折叠详情
  document.querySelectorAll('.lock-used-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      const d = cb.dataset.db
      const detail = document.querySelector(`.lock-detail[data-db="${d}"]`)
      if (detail) detail.style.display = cb.checked ? '' : 'none'
    })
  })

  // 锁定卡:选了已有版本 → 自动填 query_text(若用户没改过)
  document.querySelectorAll('.lock-strategy-select').forEach(sel => {
    sel.addEventListener('change', () => {
      const d = sel.dataset.db
      const ta = document.querySelector(`.lock-query-text[data-db="${d}"]`)
      if (!ta) return
      const opt = sel.options[sel.selectedIndex]
      if (!opt) return
      const newText = opt.getAttribute('data-query-text') || ''
      // 用户已手改过(非空且不等于任何 option),不要覆盖
      const isEmpty = !ta.value.trim()
      const matchesExisting = Array.from(sel.options).some(o =>
        (o.getAttribute('data-query-text') || '') === ta.value)
      if (newText && (isEmpty || matchesExisting)) {
        ta.value = newText
      }
    })
  })

  // 复制按钮
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-copy-target')
      const ta = document.getElementById(id)
      if (!ta) return
      const text = ta.value || ta.textContent || ''
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text)
        } else {
          ta.select()
          document.execCommand('copy')
          ta.blur()
        }
        const original = btn.textContent
        btn.textContent = '已复制 ✓'
        btn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300')
        setTimeout(() => {
          btn.textContent = original
          btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300')
        }, 1500)
      } catch (e) {
        alert('复制失败,请手动选中文本复制')
      }
    })
  })
</script>

<%- include('../partials/footer') %>

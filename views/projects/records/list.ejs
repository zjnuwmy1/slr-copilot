<%- include('../../partials/header', { title }) %>
<%- include('../partials/project-header', { project }) %>

<%
  // helpers
  function escAttr(v) { return v == null ? '' : String(v) }
  // 当前 query 用于"清空过滤"或表单回填
  const q = filters.q || ''
  const yearFrom = filters.year_from || ''
  const yearTo = filters.year_to || ''
  const hideDup = !!filters.hide_duplicates
  const onlyPdf = !!filters.has_pdf
  const onlyDoi = !!filters.has_doi

  const hasAnyFilter = !!(q || yearFrom || yearTo || onlyPdf || onlyDoi || !hideDup)
  const recordsBase = `/projects/${project.id}/records`
  const screeningBase = `/projects/${project.id}/screening`
  // 当前完整 URL(给 AI 表单的 redirect_to,保留 page / filters)
  const currentUrl = (typeof rawQuery === 'object' && rawQuery)
    ? (function(){ const qs = new URLSearchParams(rawQuery).toString(); return qs ? `${recordsBase}?${qs}` : recordsBase })()
    : recordsBase

  const scrStats = (typeof screeningStats === 'object' && screeningStats) ? screeningStats : { total: 0, ai_done: 0, ai_pending: 0, human_done: 0, human_pending: 0, ai_include: 0, ai_exclude: 0, ai_uncertain: 0, human_include: 0, human_exclude: 0, human_uncertain: 0 }
  const protoOk = !!(typeof approvedProtocol === 'object' && approvedProtocol)
  const protoV = protoOk ? approvedProtocol.version : null

  // 徽章 helpers(沿用 screening.ejs 的配色)
  function aiBadge(s) {
    return ({
      include:   ['bg-emerald-100 text-emerald-700', '建议纳入'],
      exclude:   ['bg-rose-100 text-rose-700',       '建议排除'],
      uncertain: ['bg-amber-100 text-amber-800',     '不确定'],
      not_run:   ['bg-slate-100 text-slate-500',     '未跑'],
    })[s] || ['bg-slate-100 text-slate-500', s]
  }
  function humanBadge(s) {
    return ({
      include:     ['bg-emerald-600 text-white',   '纳入'],
      exclude:     ['bg-rose-600 text-white',      '排除'],
      uncertain:   ['bg-amber-500 text-white',     '不确定'],
      not_decided: ['bg-slate-200 text-slate-600', '未决定'],
    })[s] || ['bg-slate-200 text-slate-600', s]
  }
%>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('../partials/stepper', { project, progress: progress || { stepStatus: {}, prismaProgress: { donePct: 0, done: 0, total: 42 } }, currentStep: 'screening' }) %>

  <section class="space-y-6 min-w-0">
    <!-- 顶部标题 -->
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Records · 文献条目</p>
        <h2 class="mt-1 text-xl font-semibold text-slate-900">文献条目浏览</h2>
        <p class="mt-1 text-sm text-slate-500">
          从 Zotero RDF 解析得到的全部条目;在这里检视、过滤,准备进入双盲筛选。
        </p>
      </div>
      <div class="flex flex-none items-center gap-2">
        <a href="<%= recordsBase %>/new"
           class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-3 py-2 text-sm text-white hover:bg-slate-700">
          <span aria-hidden="true">+</span> 手动新增
        </a>

        <!-- 批量导出下拉 -->
        <div class="relative" data-export-menu>
          <button type="button"
                  aria-haspopup="true" aria-expanded="false"
                  onclick="(function(b){var m=b.parentNode.querySelector('[data-export-list]');var open=m.classList.toggle('hidden')===false;b.setAttribute('aria-expanded', open?'true':'false');})(this)"
                  class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
            批量导出
            <span aria-hidden="true" class="text-xs">▾</span>
          </button>
          <div data-export-list
               class="absolute right-0 z-10 mt-1 hidden w-56 rounded-lg border border-slate-200 bg-white shadow-lg">
            <a href="<%= recordsBase %>.bib" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">BibTeX (.bib)</a>
            <a href="<%= recordsBase %>.ris" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">RIS (.ris)</a>
            <a href="<%= recordsBase %>.csl.json" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">CSL JSON</a>
            <div class="border-t border-slate-100 px-3 py-1.5 text-[10px] font-medium uppercase tracking-wider text-slate-400">References Markdown</div>
            <a href="<%= recordsBase %>.refs.md?style=apa" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">APA</a>
            <a href="<%= recordsBase %>.refs.md?style=ieee" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">IEEE</a>
            <a href="<%= recordsBase %>.refs.md?style=gb_t_7714" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">GB/T 7714</a>
            <a href="<%= recordsBase %>.refs.md?style=chicago" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">Chicago</a>
            <a href="<%= recordsBase %>.refs.md?style=mla" class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">MLA</a>
          </div>
        </div>
      </div>
    </div>

    <script>
      // 点空白处收起下拉
      document.addEventListener('click', function (e) {
        document.querySelectorAll('[data-export-menu]').forEach(function (m) {
          if (!m.contains(e.target)) {
            var l = m.querySelector('[data-export-list]')
            if (l && !l.classList.contains('hidden')) l.classList.add('hidden')
            var b = m.querySelector('button[aria-expanded]')
            if (b) b.setAttribute('aria-expanded', 'false')
          }
        })
      })
    </script>

    <!-- 顶部统计卡 -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-slate-400">总数</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900"><%= stats.total %></p>
      </div>
      <div class="rounded-xl border border-emerald-100 bg-emerald-50/40 p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-emerald-700">含 PDF</p>
        <p class="mt-1 text-2xl font-semibold text-emerald-900"><%= stats.with_pdf %></p>
      </div>
      <div class="rounded-xl border border-blue-100 bg-blue-50/40 p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-blue-700">含 DOI</p>
        <p class="mt-1 text-2xl font-semibold text-blue-900"><%= stats.with_doi %></p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">重复</p>
        <p class="mt-1 text-2xl font-semibold text-slate-700"><%= stats.duplicates %></p>
      </div>
      <div class="rounded-xl border border-amber-100 bg-amber-50/40 p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-amber-700">缺 Abstract</p>
        <p class="mt-1 text-2xl font-semibold text-amber-900"><%= stats.missing_abstract %></p>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- AI 逐篇初筛 — 基于已审批协议的纳入/排除标准                   -->
    <!-- ============================================================ -->
    <section class="rounded-2xl border-2 border-blue-200 bg-blue-50/40 p-5 space-y-4">
      <header class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-base font-semibold text-blue-900">🤖 AI 逐篇判断纳入 / 排除</h3>
          <p class="mt-1 text-sm text-blue-800">
            AI 读每篇的<strong>标题 + 摘要</strong>,按你审批的<strong>纳入/排除标准</strong>给出
            <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-xs text-emerald-700">纳入</span>
            <span class="rounded bg-rose-100 px-1.5 py-0.5 text-xs text-rose-700">排除</span>
            <span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">不确定</span> 建议。
            你做最终人工决定 — 这一步过滤掉大部分不相关的,后面只对纳入的细读全文。
          </p>
        </div>
        <% if (protoOk) { %>
          <span class="flex-none rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">
            协议 v<%= protoV %> 已审批
          </span>
        <% } else { %>
          <a href="/projects/<%= project.id %>"
             class="flex-none rounded-full bg-amber-500 px-3 py-1 text-xs font-medium text-white hover:bg-amber-400">
            ⚠ 先审批协议 →
          </a>
        <% } %>
      </header>

      <!-- 4 个统计 -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-blue-100 bg-white p-3">
          <p class="text-[11px] font-medium uppercase tracking-wider text-blue-700">AI 已建议</p>
          <p class="mt-1 text-xl font-semibold text-blue-900"><%= scrStats.ai_done %> / <%= scrStats.total %></p>
          <p class="mt-0.5 text-[11px] text-blue-700/80">
            纳 <%= scrStats.ai_include %> · 排 <%= scrStats.ai_exclude %> · 疑 <%= scrStats.ai_uncertain %>
          </p>
        </div>
        <div class="rounded-xl border border-amber-100 bg-white p-3">
          <p class="text-[11px] font-medium uppercase tracking-wider text-amber-700">待跑 AI</p>
          <p class="mt-1 text-xl font-semibold text-amber-900"><%= scrStats.ai_pending %></p>
          <p class="mt-0.5 text-[11px] text-amber-700/80">点右侧批量运行</p>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-white p-3">
          <p class="text-[11px] font-medium uppercase tracking-wider text-emerald-700">人工已决</p>
          <p class="mt-1 text-xl font-semibold text-emerald-900"><%= scrStats.human_done %> / <%= scrStats.total %></p>
          <p class="mt-0.5 text-[11px] text-emerald-700/80">
            纳 <%= scrStats.human_include %> · 排 <%= scrStats.human_exclude %> · 疑 <%= scrStats.human_uncertain %>
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3">
          <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">待决定</p>
          <p class="mt-1 text-xl font-semibold text-slate-700"><%= scrStats.human_pending %></p>
          <p class="mt-0.5 text-[11px] text-slate-500">还需要你判断</p>
        </div>
      </div>

      <!-- 批量按钮 + 详细页跳转 -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <% if (protoOk) { %>
          <form method="post" action="<%= screeningBase %>/run-batch"
                onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='启动中…';">
            <input type="hidden" name="redirect_to" value="<%= currentUrl %>" />
            <button type="submit"
                    class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 disabled:bg-slate-300 disabled:cursor-wait">
              <% if (scrStats.ai_pending === 0) { %>
                ✓ 全部已跑 AI(可单条重跑)
              <% } else { %>
                对未跑的 <%= scrStats.ai_pending %> 条运行 AI(约 <%= Math.max(1, Math.ceil(scrStats.ai_pending * 18 / 60)) %> 分钟)
              <% } %>
            </button>
          </form>
        <% } else { %>
          <span class="text-sm text-amber-700">⚠ 协议未审批,无法跑 AI</span>
        <% } %>
        <a href="<%= screeningBase %>" class="text-xs text-blue-700 underline hover:text-blue-900">
          打开筛选专用页 ↗(过滤 / 详细 AI 理由 / CSV 导出)
        </a>
      </div>

      <!-- 危险区:手动清空论文池(只在有数据时显示) -->
      <% if (scrStats.total > 0) { %>
        <details class="rounded-lg border border-rose-200 bg-rose-50/30 text-xs">
          <summary class="cursor-pointer px-3 py-2 font-medium text-rose-700 hover:text-rose-900">
            ⚠ 论文池管理(危险区)
          </summary>
          <div class="border-t border-rose-100 px-3 py-2 space-y-2">
            <p class="text-rose-800">
              换了检索式后想重新导入?可以手动清空当前的
              <strong><%= scrStats.total %></strong> 篇论文 + 所有 AI 筛选 / 抽取记录,
              释放空间从头开始。
            </p>
            <a href="<%= recordsBase %>/clear-pool"
               class="inline-flex items-center gap-1 rounded border border-rose-300 bg-white px-3 py-1.5 text-rose-700 hover:bg-rose-50">
              🗑 清空论文池 →(需二次确认)
            </a>
          </div>
        </details>
      <% } %>
    </section>

      <!-- 进度条(运行中显示,JS 轮询填值)-->
      <div id="batch-progress" class="hidden">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span id="bp-status">运行中</span>
          <span id="bp-counts">0/0</span>
        </div>
        <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
          <div id="bp-bar" class="h-full bg-blue-500 transition-all duration-300" style="width:0%"></div>
        </div>
        <p id="bp-current" class="mt-1 truncate text-[11px] text-slate-400"></p>
      </div>
    </section>

    <!-- 过滤工具栏 -->
    <form method="get" action="<%= recordsBase %>" class="rounded-2xl border border-slate-200 bg-white p-4">
      <div class="flex flex-wrap items-end gap-3">
        <div class="min-w-[200px] flex-1">
          <label class="block text-xs font-medium text-slate-500">关键词</label>
          <input type="text" name="q" value="<%= escAttr(q) %>" placeholder="标题 / 作者 / 期刊 / DOI"
                 class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500">年份起</label>
          <input type="number" name="year_from" value="<%= escAttr(yearFrom) %>"
                 placeholder="<%= yearRange.min_year || '' %>"
                 min="1900" max="2100" inputmode="numeric"
                 class="mt-1 w-24 rounded-lg border border-slate-300 px-2 py-2 text-sm focus:border-slate-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500">年份止</label>
          <input type="number" name="year_to" value="<%= escAttr(yearTo) %>"
                 placeholder="<%= yearRange.max_year || '' %>"
                 min="1900" max="2100" inputmode="numeric"
                 class="mt-1 w-24 rounded-lg border border-slate-300 px-2 py-2 text-sm focus:border-slate-500 focus:outline-none" />
        </div>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <label class="inline-flex items-center gap-1.5">
            <input type="checkbox" name="has_pdf" value="1" <%= onlyPdf ? 'checked' : '' %>
                   class="rounded border-slate-300" />
            <span>仅含 PDF</span>
          </label>
          <label class="inline-flex items-center gap-1.5">
            <input type="checkbox" name="has_doi" value="1" <%= onlyDoi ? 'checked' : '' %>
                   class="rounded border-slate-300" />
            <span>仅含 DOI</span>
          </label>
          <label class="inline-flex items-center gap-1.5">
            <!-- 默认 hide_duplicates 选中;取消 = 提交 hide_duplicates=0 -->
            <input type="checkbox" name="hide_duplicates_ui" value="1" <%= hideDup ? 'checked' : '' %>
                   onchange="document.getElementById('hide_dup_val').value = this.checked ? '' : '0'"
                   class="rounded border-slate-300" />
            <span>隐藏重复</span>
          </label>
          <!-- 真正提交的字段:checkbox 不选时显式提交 0 -->
          <input type="hidden" id="hide_dup_val" name="hide_duplicates" value="<%= hideDup ? '' : '0' %>" />
          <label class="inline-flex items-center gap-1.5" title="WoS LA= 实际上是『语言列表包含英文』,韩文/中文期刊带英文摘要的论文会漏进来。勾上只看这些可疑条目。">
            <input type="checkbox" name="only_multi_language" value="1" <%= filters.only_multi_language ? 'checked' : '' %>
                   class="rounded border-slate-300" />
            <span class="text-amber-700">仅多语言</span>
          </label>
          <label class="inline-flex items-center gap-1.5" title="Language 字段不含英文(纯非英文论文)">
            <input type="checkbox" name="only_non_english" value="1" <%= filters.only_non_english ? 'checked' : '' %>
                   class="rounded border-slate-300" />
            <span class="text-rose-700">仅非英文</span>
          </label>
        </div>
        <div class="ml-auto flex gap-2">
          <button type="submit"
                  class="rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">
            筛选
          </button>
          <% if (hasAnyFilter) { %>
            <a href="<%= recordsBase %>"
               class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
              重置
            </a>
          <% } %>
        </div>
      </div>
    </form>

    <!-- 结果区 -->
    <% if (stats.total === 0) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <p class="text-2xl">📭</p>
        <h3 class="mt-2 text-base font-semibold text-slate-800">还没有文献条目</h3>
        <p class="mt-1 text-sm text-slate-500">
          请先上传一份 Zotero 导出包(RDF + PDF),系统会自动解析为条目。
        </p>
        <div class="mt-4">
          <a href="/projects/<%= project.id %>/zotero"
             class="inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">
            前往 Zotero 上传
          </a>
        </div>
      </div>
    <% } else if (totalFiltered === 0) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <p class="text-base text-slate-700">当前过滤条件下没有匹配的条目。</p>
        <a href="<%= recordsBase %>"
           class="mt-3 inline-block rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
          清除过滤
        </a>
      </div>
    <% } else { %>
      <!-- 结果摘要条 -->
      <div class="flex items-center justify-between text-xs text-slate-500">
        <span>
          显示第 <strong class="text-slate-700"><%= (page - 1) * pageSize + 1 %></strong>
          – <strong class="text-slate-700"><%= Math.min(page * pageSize, totalFiltered) %></strong>
          条,共 <strong class="text-slate-700"><%= totalFiltered %></strong> 条匹配
          <% if (totalFiltered !== stats.total) { %>(项目共 <%= stats.total %> 条)<% } %>
        </span>
        <span>第 <%= page %> / <%= totalPages %> 页</span>
      </div>

      <!-- 表格 -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="w-8 px-3 py-3"><input type="checkbox" title="全选(批量操作 — 下一步开放)" class="rounded border-slate-300"
                onclick="document.querySelectorAll('[data-rec-cb]').forEach(function(cb){cb.checked=this.checked}.bind(this))" /></th>
              <th class="px-3 py-3 text-left">标题 / 作者</th>
              <th class="px-3 py-3 text-left">年</th>
              <th class="px-3 py-3 text-left">期刊</th>
              <th class="px-3 py-3 text-left">标记</th>
              <th class="px-3 py-3 text-left w-44">AI 建议</th>
              <th class="px-3 py-3 text-left w-56">你的决定</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% records.forEach(r => {
                 const [aiCls, aiLabel]   = aiBadge(r.ai_suggestion)
                 const [huCls, huLabel]   = humanBadge(r.human_decision)
            %>
              <tr id="row-<%= r.id %>" class="hover:bg-slate-50/50 <%= r.human_decision === 'include' ? 'bg-emerald-50/30' : r.human_decision === 'exclude' ? 'bg-rose-50/20' : '' %>">
                <td class="px-3 py-3 align-top">
                  <input type="checkbox" data-rec-cb value="<%= r.id %>" class="rounded border-slate-300" />
                </td>
                <td class="px-3 py-3 align-top">
                  <a href="/projects/<%= project.id %>/records/<%= r.id %>"
                     class="font-medium text-slate-900 hover:text-blue-700 hover:underline">
                    <%= r.title %>
                  </a>
                  <% if (r.authors_short) { %>
                    <p class="mt-0.5 text-xs text-slate-500"><%= r.authors_short %></p>
                  <% } %>
                  <% if ((r.keywords_list || []).length) { %>
                    <p class="mt-1 flex flex-wrap gap-1">
                      <% r.keywords_list.slice(0, 5).forEach(k => { %>
                        <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600"><%= k %></span>
                      <% }) %>
                      <% if (r.keywords_list.length > 5) { %>
                        <span class="text-[10px] text-slate-400">+<%= r.keywords_list.length - 5 %></span>
                      <% } %>
                    </p>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-slate-700">
                  <%= r.year || '—' %>
                </td>
                <td class="px-3 py-3 align-top text-slate-700">
                  <span class="line-clamp-2"><%= r.journal || '—' %></span>
                </td>
                <td class="px-3 py-3 align-top">
                  <div class="flex flex-wrap gap-1">
                    <% (r.source_databases_list || []).forEach(function(d) {
                         const dbBadgeCls = ({
                           wos:    'bg-blue-100 text-blue-700',
                           scopus: 'bg-amber-100 text-amber-800',
                           pubmed: 'bg-emerald-100 text-emerald-700',
                           ieee:   'bg-rose-100 text-rose-700',
                         })[d] || 'bg-slate-100 text-slate-600'
                         const dbLabel = ({wos:'WoS',scopus:'Scopus',pubmed:'PubMed',ieee:'IEEE'})[d] || d.toUpperCase()
                    %>
                      <span class="rounded px-1.5 py-0.5 text-[10px] font-medium <%= dbBadgeCls %>"
                            title="来源:<%= dbLabel %>"><%= dbLabel %></span>
                    <% }) %>
                    <% if (r.is_non_english_only) { %>
                      <span class="rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-medium text-rose-700"
                            title="语言字段:<%= (r.language_list || []).join(' / ') %> — 不含英文,可能需要排除">非英文</span>
                    <% } else if (r.is_multi_language) { %>
                      <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-800"
                            title="语言字段:<%= (r.language_list || []).join(' / ') %> — 多语言论文(英文 + 其他),WoS LA=英文 会包含这种,人工复核">多语言</span>
                    <% } %>
                    <% if (r.has_pdf) { %>
                      <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[10px] font-medium text-emerald-700 ring-1 ring-emerald-200"
                            title="<%= r.pdf_count %> 个 PDF">PDF</span>
                    <% } %>
                    <% if (r.has_doi) { %>
                      <span class="rounded bg-slate-50 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 ring-1 ring-slate-200"
                            title="<%= r.doi %>">DOI</span>
                    <% } %>
                    <% if (r.has_notes) { %>
                      <span class="rounded bg-violet-100 px-1.5 py-0.5 text-[10px] font-medium text-violet-700"
                            title="Zotero 笔记">Note</span>
                    <% } %>
                    <% if (r.is_duplicate) { %>
                      <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-500"
                            title="此条已合并到其他记录">DUP</span>
                    <% } %>
                  </div>
                </td>

                <!-- AI 建议列 -->
                <td class="px-3 py-3 align-top">
                  <div class="space-y-1.5">
                    <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium <%= aiCls %>">
                      <%= aiLabel %>
                      <% if (r.ai_confidence != null) { %>
                        <span class="rounded bg-white/60 px-1 py-0 text-[9px] font-mono" title="置信度"><%= Number(r.ai_confidence).toFixed(2) %></span>
                      <% } %>
                    </span>
                    <% if (r.ai_reason) { %>
                      <details class="text-[11px] text-slate-600">
                        <summary class="cursor-pointer text-slate-500 hover:text-slate-800">AI 理由</summary>
                        <p class="mt-1 leading-relaxed rounded bg-slate-50/80 px-2 py-1.5"><%= r.ai_reason %></p>
                        <% if ((r.ai_matched_inclusion || []).length) { %>
                          <p class="mt-1 text-emerald-700">命中纳入:<%= r.ai_matched_inclusion.join(' · ') %></p>
                        <% } %>
                        <% if ((r.ai_matched_exclusion || []).length) { %>
                          <p class="mt-0.5 text-rose-700">命中排除:<%= r.ai_matched_exclusion.join(' · ') %></p>
                        <% } %>
                      </details>
                    <% } %>
                    <% if (protoOk) { %>
                      <form method="post" action="<%= screeningBase %>/run-one/<%= r.id %>"
                            onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='跑 AI 中…';">
                        <input type="hidden" name="redirect_to" value="<%= currentUrl %>" />
                        <button type="submit"
                                class="rounded-md border border-slate-300 px-2 py-0.5 text-[11px] text-slate-700 hover:bg-slate-50 disabled:cursor-wait disabled:opacity-60">
                          <%= r.ai_suggestion === 'not_run' ? '让 AI 建议' : '重跑 AI' %>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-[11px] text-slate-400">协议未审批</span>
                    <% } %>
                  </div>
                </td>

                <!-- 你的决定列 -->
                <td class="px-3 py-3 align-top">
                  <form method="post" action="<%= screeningBase %>/decide/<%= r.id %>"
                        class="space-y-1.5">
                    <input type="hidden" name="redirect_to" value="<%= currentUrl %>" />
                    <div class="flex flex-wrap gap-1">
                      <% ['include', 'exclude', 'uncertain'].forEach(v => {
                           const [cls, label] = humanBadge(v)
                           const checked = r.human_decision === v
                      %>
                        <label class="inline-flex items-center gap-1 rounded border <%= checked ? 'border-blue-500 ring-1 ring-blue-300' : 'border-slate-300' %> px-1.5 py-0.5 text-[11px] cursor-pointer hover:bg-slate-50">
                          <input type="radio" name="decision" value="<%= v %>" <%= checked ? 'checked' : '' %> class="h-3 w-3" />
                          <%= label %>
                        </label>
                      <% }) %>
                    </div>
                    <input type="text" name="reason" maxlength="2000"
                           value="<%= escAttr(r.human_reason) %>"
                           placeholder="备注(可选)"
                           class="block w-full rounded border border-slate-300 px-2 py-0.5 text-[11px] focus:border-slate-500 focus:outline-none" />
                    <button type="submit" class="w-full rounded-md bg-slate-900 px-2 py-0.5 text-[11px] text-white hover:bg-slate-700">
                      保存决定
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- 分页 -->
      <% if (totalPages > 1) { %>
        <div class="flex items-center justify-center gap-1 text-sm">
          <% if (page > 1) { %>
            <a href="<%= pageHref(page - 1) %>"
               class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50">← 上一页</a>
          <% } else { %>
            <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300">← 上一页</span>
          <% } %>

          <%
            // 简化的分页:首页 / 当前-1 / 当前 / 当前+1 / 末页
            const pagesToShow = new Set([1, totalPages, page - 1, page, page + 1])
            const sorted = Array.from(pagesToShow).filter(n => n >= 1 && n <= totalPages).sort((a, b) => a - b)
            let prev = 0
          %>
          <% sorted.forEach(n => { %>
            <% if (n - prev > 1) { %>
              <span class="px-2 text-slate-400">…</span>
            <% } %>
            <% if (n === page) { %>
              <span class="rounded-lg bg-slate-900 px-3 py-1.5 font-medium text-white"><%= n %></span>
            <% } else { %>
              <a href="<%= pageHref(n) %>"
                 class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50"><%= n %></a>
            <% } %>
            <% prev = n %>
          <% }) %>

          <% if (page < totalPages) { %>
            <a href="<%= pageHref(page + 1) %>"
               class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50">下一页 →</a>
          <% } else { %>
            <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300">下一页 →</span>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </section>
</div>

<script>
(function() {
  // ============================================================
  // 批量 AI 初筛进度轮询
  // 页面加载时探一次 /screening/progress.json,如果在跑则启动 3s 轮询
  // 跑完后短延迟刷新页面,把 records 表里的 AI 建议同步过来
  // ============================================================
  var pjId = <%- JSON.stringify(project.id) %>;
  var box     = document.getElementById('batch-progress');
  var bar     = document.getElementById('bp-bar');
  var status  = document.getElementById('bp-status');
  var counts  = document.getElementById('bp-counts');
  var current = document.getElementById('bp-current');
  if (!box) return;

  function applyState(p) {
    if (!p || !p.total) {
      box.classList.add('hidden');
      return false;
    }
    box.classList.remove('hidden');
    var pct = p.pct || 0;
    bar.style.width = pct + '%';
    status.textContent = p.running ? '运行中(' + pct + '%)' : '已完成';
    counts.textContent = p.done + '/' + p.total + (p.errors ? ' · 错 ' + p.errors : '');
    current.textContent = p.current_title ? '正在处理:' + p.current_title : '';
    return !!p.running;
  }

  var poll = function() {
    fetch('/projects/' + encodeURIComponent(pjId) + '/screening/progress.json', { credentials: 'same-origin' })
      .then(function(r) { return r.json() })
      .then(function(p) {
        var stillRunning = applyState(p);
        if (stillRunning) {
          setTimeout(poll, 3000);
        } else if (p && p.total) {
          // 跑完了:2 秒后刷新当前页(保留 query / 滚动)
          setTimeout(function() { window.location.reload(); }, 2000);
        }
      })
      .catch(function() {
        // 出错就 8s 后再试一次
        setTimeout(poll, 8000);
      });
  };

  // 首次探测,如果已经有任务在跑(可能用户刚启动批量后刷新页面)
  poll();
})();
</script>

<%- include('../../partials/footer') %>

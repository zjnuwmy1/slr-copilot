<%- include('../../partials/header', { title }) %>
<%- include('../partials/project-header', { project }) %>

<%
  function fmtBytes(n) {
    if (!Number.isFinite(n) || n <= 0) return '—'
    if (n < 1024) return `${n} B`
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`
    return `${(n / 1024 / 1024).toFixed(1)} MB`
  }
  const kindLabel = {
    pdf: 'PDF',
    html: 'HTML',
    snapshot: '快照',
    other: '其它',
  }
%>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('../partials/stepper', { project, progress: progress || { stepStatus: {}, prismaProgress: { donePct: 0, done: 0, total: 42 } }, currentStep: 'screening' }) %>

  <section class="space-y-6 min-w-0">
    <!-- 面包屑 -->
    <div class="flex items-center justify-between text-sm">
      <a href="/projects/<%= project.id %>/records"
         class="text-slate-500 hover:text-slate-900">← 返回文献列表</a>
      <div class="flex items-center gap-2 text-xs">
        <% if (record.is_duplicate) { %>
          <span class="rounded bg-slate-100 px-2 py-0.5 font-medium text-slate-500">已合并副本</span>
        <% } %>
        <% if (record.item_type) { %>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-slate-600"><%= record.item_type %></span>
        <% } %>
      </div>
    </div>

    <!-- 标题 + 元信息 -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h1 class="min-w-0 flex-1 text-xl font-semibold leading-snug text-slate-900"><%= record.title %></h1>
        <div class="flex flex-none items-center gap-2">
          <a href="/projects/<%= project.id %>/records/<%= record.id %>/edit"
             class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
            <span aria-hidden="true">✏️</span> 编辑
          </a>
          <% if (citations) { %>
            <div class="relative" data-copy-menu>
              <button type="button"
                      aria-haspopup="true" aria-expanded="false"
                      onclick="(function(b){var m=b.parentNode.querySelector('[data-copy-list]');var open=m.classList.toggle('hidden')===false;b.setAttribute('aria-expanded', open?'true':'false');})(this)"
                      class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                <span aria-hidden="true">📋</span> 复制为 <span class="text-[10px]">▾</span>
              </button>
              <div data-copy-list class="absolute right-0 z-10 mt-1 hidden w-44 rounded-lg border border-slate-200 bg-white shadow-lg">
                <button type="button" data-cite="apa" class="block w-full px-3 py-1.5 text-left text-xs text-slate-700 hover:bg-slate-50">APA 7th</button>
                <button type="button" data-cite="ieee" class="block w-full px-3 py-1.5 text-left text-xs text-slate-700 hover:bg-slate-50">IEEE</button>
                <button type="button" data-cite="gb_t_7714" class="block w-full px-3 py-1.5 text-left text-xs text-slate-700 hover:bg-slate-50">GB/T 7714-2015</button>
                <button type="button" data-cite="chicago" class="block w-full px-3 py-1.5 text-left text-xs text-slate-700 hover:bg-slate-50">Chicago author-date</button>
                <button type="button" data-cite="mla" class="block w-full px-3 py-1.5 text-left text-xs text-slate-700 hover:bg-slate-50">MLA 9th</button>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <% if ((record.authors_list || []).length) { %>
        <p class="mt-3 text-sm text-slate-700">
          <%
            const authors = record.authors_list
            const shown = authors.slice(0, 5)
          %>
          <% shown.forEach((a, i) => {
               const full = a.full || `${a.surname || ''} ${a.givenName || ''}`.trim() || ''
          %>
            <span><%= full %></span><%= i < shown.length - 1 ? ', ' : '' %>
          <% }) %>
          <% if (authors.length > 5) { %>
            <span class="text-slate-500">… 共 <%= authors.length %> 位作者</span>
          <% } %>
        </p>
      <% } else if (record.authors_text) { %>
        <p class="mt-3 text-sm text-slate-700"><%= record.authors_text %></p>
      <% } %>

      <!-- meta 网格 -->
      <dl class="mt-5 grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
        <% if (record.year || record.date_text) { %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">年份</dt>
            <dd class="mt-0.5 text-slate-800"><%= record.year || record.date_text %></dd>
          </div>
        <% } %>
        <% if (record.journal) { %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">期刊 / 来源</dt>
            <dd class="mt-0.5 text-slate-800"><%= record.journal %></dd>
          </div>
        <% } %>
        <% if (record.publisher) { %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">出版方</dt>
            <dd class="mt-0.5 text-slate-800"><%= record.publisher %></dd>
          </div>
        <% } %>
        <% if (record.doi) { %>
          <div class="min-w-0">
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">DOI</dt>
            <dd class="mt-0.5 break-all text-slate-800">
              <a href="https://doi.org/<%= encodeURIComponent(record.doi) %>" target="_blank" rel="noopener"
                 class="text-blue-700 hover:underline"><%= record.doi %></a>
            </dd>
          </div>
        <% } %>
        <% if (record.url) { %>
          <div class="min-w-0 sm:col-span-2">
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">URL</dt>
            <dd class="mt-0.5 break-all text-slate-800">
              <a href="<%= record.url %>" target="_blank" rel="noopener"
                 class="text-blue-700 hover:underline"><%= record.url %></a>
            </dd>
          </div>
        <% } %>
        <% if (record.zotero_item_id) { %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400">Zotero ID</dt>
            <dd class="mt-0.5 font-mono text-xs text-slate-600"><%= record.zotero_item_id %></dd>
          </div>
        <% } %>
      </dl>

      <!-- 关键词 -->
      <% if ((record.keywords_list || []).length) { %>
        <div class="mt-5">
          <p class="text-xs font-medium uppercase tracking-wider text-slate-400">关键词</p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% record.keywords_list.forEach(k => { %>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-700"><%= k %></span>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- 左右分栏:abstract+notes / attachments -->
    <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
      <div class="space-y-6 min-w-0">
        <!-- Abstract -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="text-sm font-medium uppercase tracking-wider text-slate-400">Abstract</h2>
          <% if (record.abstract && record.abstract.trim()) { %>
            <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-slate-800"><%= record.abstract %></p>
          <% } else { %>
            <p class="mt-3 text-sm italic text-slate-400">(未提供摘要)</p>
          <% } %>
        </div>

        <!-- Notes(Zotero annotation,可能含中文) -->
        <% if (record.has_notes) { %>
          <div class="rounded-2xl border border-violet-200 bg-violet-50/40 p-6">
            <h2 class="text-sm font-medium uppercase tracking-wider text-violet-700">Zotero 笔记</h2>
            <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-slate-800"><%= record.notes %></p>
          </div>
        <% } %>

        <!-- 重复信息 -->
        <% if (mergedInto) { %>
          <div class="rounded-2xl border border-slate-300 bg-slate-50/60 p-5">
            <p class="text-sm font-medium text-slate-700">此条目已合并到:</p>
            <a href="/projects/<%= project.id %>/records/<%= mergedInto.id %>"
               class="mt-2 block rounded-lg border border-slate-300 bg-white p-3 text-sm hover:border-slate-500">
              <p class="font-medium text-slate-900"><%= mergedInto.title %></p>
              <p class="mt-1 text-xs text-slate-500">
                <%= mergedInto.year || '—' %>
                <% if (mergedInto.journal) { %> · <%= mergedInto.journal %><% } %>
                <% if (mergedInto.doi) { %> · DOI <%= mergedInto.doi %><% } %>
              </p>
            </a>
          </div>
        <% } %>

        <% if ((duplicateGroup || []).length) { %>
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="text-sm font-medium uppercase tracking-wider text-slate-400">同组重复条目 (<%= duplicateGroup.length %>)</h2>
            <ul class="mt-3 space-y-2">
              <% duplicateGroup.forEach(d => { %>
                <li>
                  <a href="/projects/<%= project.id %>/records/<%= d.id %>"
                     class="block rounded-lg border border-slate-200 p-3 text-sm hover:border-slate-400">
                    <div class="flex items-start justify-between gap-3">
                      <p class="min-w-0 truncate font-medium text-slate-800"><%= d.title %></p>
                      <% if (!d.duplicate_of_record_id) { %>
                        <span class="flex-none rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-medium text-emerald-700">主</span>
                      <% } else { %>
                        <span class="flex-none rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-500">副</span>
                      <% } %>
                    </div>
                    <p class="mt-1 text-xs text-slate-500">
                      <%= d.year || '—' %>
                      <% if (d.journal) { %> · <%= d.journal %><% } %>
                    </p>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>

      <!-- 右侧附件列表 -->
      <aside class="space-y-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <h2 class="text-sm font-medium uppercase tracking-wider text-slate-400">附件</h2>
          <% if (!attachments.length) { %>
            <p class="mt-3 text-sm italic text-slate-400">无附件</p>
          <% } else { %>
            <ul class="mt-3 space-y-2">
              <% attachments.forEach(a => { %>
                <li class="rounded-lg border border-slate-200 p-3">
                  <div class="flex items-center justify-between gap-2">
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-600">
                      <%= kindLabel[a.attachment_kind] || a.attachment_kind %>
                    </span>
                    <span class="text-[11px] text-slate-400"><%= fmtBytes(a.size_bytes) %></span>
                  </div>
                  <p class="mt-1.5 break-all text-xs text-slate-700"><%= a.filename || '(未命名)' %></p>
                  <a href="/projects/<%= project.id %>/attachments/<%= a.id %>/download"
                     target="_blank" rel="noopener"
                     class="mt-2 inline-flex w-full items-center justify-center gap-1 rounded-lg bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700">
                    <% if (a.attachment_kind === 'pdf') { %>预览 PDF<% } else { %>下载<% } %>
                  </a>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <!-- 人工筛选决定区(AJAX 提交,不跳页)-->
        <% if (typeof screening !== 'undefined' && screening) {
             const aiSug = screening.ai_suggestion
             const huDec = screening.human_decision
             const aiBadgeMap = {
               include:   ['bg-emerald-100 text-emerald-700', '建议纳入'],
               exclude:   ['bg-rose-100 text-rose-700',       '建议排除'],
               uncertain: ['bg-amber-100 text-amber-800',     '不确定'],
               not_run:   ['bg-slate-100 text-slate-500',     '未跑'],
             }
             const huColors = {
               include:     ['#059669', '纳入',  'bg-emerald-600 text-white'],
               exclude:     ['#e11d48', '排除',  'bg-rose-600 text-white'],
               uncertain:   ['#d97706', '不确定','bg-amber-500 text-white'],
               not_decided: ['#64748b', '未决定','bg-slate-200 text-slate-700'],
             }
             const aiB = aiBadgeMap[aiSug] || aiBadgeMap.not_run
             const huB = huColors[huDec] || huColors.not_decided
        %>
          <section class="rounded-2xl border-2 <%= huDec === 'not_decided' ? 'border-amber-300 bg-amber-50/30' : 'border-emerald-300 bg-emerald-50/30' %> p-5">
            <header class="flex items-center justify-between gap-2 flex-wrap">
              <p class="text-sm font-semibold text-slate-900">📋 人工筛选决定</p>
              <span class="rounded-full <%= huB[2] %> px-2 py-0.5 text-[11px] font-medium">
                当前:<%= huB[1] %>
              </span>
            </header>

            <!-- AI 建议 -->
            <div class="mt-3 text-xs">
              <p class="text-slate-500">
                AI 建议:<span class="ml-1 rounded-full px-2 py-0.5 <%= aiB[0] %>"><%= aiB[1] %></span>
                <% if (screening.ai_confidence != null) { %>
                  <span class="ml-1 text-slate-500">置信 <%= Number(screening.ai_confidence).toFixed(2) %></span>
                <% } %>
              </p>
              <% if (screening.ai_reason) { %>
                <details class="mt-2 text-slate-600">
                  <summary class="cursor-pointer hover:text-slate-900">AI 理由(展开)</summary>
                  <p class="mt-1 rounded bg-white/70 px-2 py-1.5 leading-relaxed"><%= screening.ai_reason %></p>
                  <% if ((screening.ai_matched_inclusion || []).length) { %>
                    <p class="mt-1 text-emerald-700">命中纳入:<%= screening.ai_matched_inclusion.join(' · ') %></p>
                  <% } %>
                  <% if ((screening.ai_matched_exclusion || []).length) { %>
                    <p class="mt-1 text-rose-700">命中排除:<%= screening.ai_matched_exclusion.join(' · ') %></p>
                  <% } %>
                </details>
              <% } %>
            </div>

            <!-- 人工决定表单(AJAX) -->
            <form method="post" action="/projects/<%= project.id %>/screening/decide/<%= record.id %>"
                  data-ajax-decide-detail
                  class="mt-3 space-y-2">
              <input type="text" name="reason" maxlength="2000"
                     value="<%= screening.human_reason ? screening.human_reason.replace(/"/g, '&quot;') : '' %>"
                     placeholder="备注(可选,先填再点按钮)"
                     class="block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm focus:border-slate-500 focus:outline-none" />
              <div class="flex flex-wrap items-center gap-2">
                <% ['include', 'exclude', 'uncertain'].forEach(function(v) {
                     const col = huColors[v]
                     const isCur = huDec === v
                %>
                  <button type="submit" name="decision" value="<%= v %>"
                          class="rounded-md px-3 py-1.5 text-sm font-medium <%= isCur ? col[2] + ' ring-2 ring-blue-300' : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50' %>">
                    <%= col[1] %>
                  </button>
                <% }) %>
                <span class="ajax-feedback ml-2 text-xs text-slate-500" aria-live="polite"></span>
              </div>
            </form>

            <!-- 上 / 下一条 导航(按 /screening 排序) -->
            <% if (typeof neighbors !== 'undefined' && neighbors) { %>
              <div class="mt-4 flex items-center justify-between gap-2 border-t border-slate-200 pt-3 text-xs">
                <% if (neighbors.prev) { %>
                  <a href="/projects/<%= project.id %>/records/<%= neighbors.prev %>"
                     class="rounded-md border border-slate-300 bg-white px-2 py-1 text-slate-700 hover:bg-slate-50">← 上一条</a>
                <% } else { %>
                  <span class="rounded-md border border-slate-200 px-2 py-1 text-slate-300">← 已到第一条</span>
                <% } %>
                <span class="text-slate-500">第 <%= neighbors.pos %> / <%= neighbors.total %> 条(按"未决定优先"排序)</span>
                <% if (neighbors.next) { %>
                  <a href="/projects/<%= project.id %>/records/<%= neighbors.next %>"
                     class="rounded-md bg-slate-900 px-2 py-1 text-white hover:bg-slate-700">下一条 →</a>
                <% } else { %>
                  <span class="rounded-md border border-slate-200 px-2 py-1 text-slate-300">已到最后一条 →</span>
                <% } %>
              </div>
            <% } %>
          </section>
        <% } %>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 text-xs text-slate-500">
          <p class="font-medium text-slate-700">列表视图</p>
          <p class="mt-1">查看所有条目的筛选状态、批量操作、过滤等。</p>
          <a href="/projects/<%= project.id %>/screening"
             class="mt-2 inline-block text-blue-700 hover:underline">回筛选列表 →</a>
        </div>
      </aside>
    </div>

    <!-- AJAX 决定 — 直接在详情页提交不跳页 -->
    <script>
      (function() {
        var form = document.querySelector('form[data-ajax-decide-detail]')
        if (!form) return
        form.addEventListener('submit', function(e) {
          e.preventDefault()
          var fb = form.querySelector('.ajax-feedback')
          var submitter = e.submitter
          if (!submitter || !submitter.value) {
            if (fb) { fb.textContent = '请点击决定按钮'; fb.style.color = '#e11d48' }
            return
          }
          var decisionValue = submitter.value
          var prevText = submitter.textContent
          submitter.disabled = true
          submitter.textContent = '保存中…'
          if (fb) { fb.textContent = ''; fb.style.color = '' }

          var fd = new FormData(form)
          fd.set('decision', decisionValue)
          // ⚠ 用 URLSearchParams 避免 multipart(server 只装 urlencoded + json)
          var body = new URLSearchParams(fd)
          fetch(form.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: body,
          })
            .then(function(r) { return r.json().catch(function() { return { ok: false, error: 'HTTP ' + r.status } }) })
            .then(function(d) {
              submitter.disabled = false
              submitter.textContent = prevText
              if (!d || !d.ok) {
                if (fb) { fb.style.color = '#e11d48'; fb.textContent = '✗ ' + ((d && d.error) || '保存失败') }
                return
              }
              if (fb) {
                var labels = { include: '纳入', exclude: '排除', uncertain: '不确定' }
                fb.style.color = '#059669'
                fb.textContent = '✓ 已保存:' + (labels[d.decision] || d.decision)
              }
              // 1.2s 后跳到下一条(neighbors.next),让用户连续筛选
              <% if (neighbors && neighbors.next) { %>
                setTimeout(function() { window.location.href = '/projects/<%= project.id %>/records/<%= neighbors.next %>' }, 1200)
              <% } else { %>
                setTimeout(function() { window.location.reload() }, 1200)
              <% } %>
            })
            .catch(function() {
              submitter.disabled = false
              submitter.textContent = prevText
              if (fb) { fb.style.color = '#e11d48'; fb.textContent = '✗ 网络错误' }
            })
        })
      })()
    </script>

    <!-- 危险区:删除 -->
    <div class="rounded-2xl border border-rose-200 bg-rose-50/40 p-5">
      <p class="text-sm font-medium text-rose-800">删除此条目</p>
      <p class="mt-1 text-xs text-rose-700">
        会同时删除所有关联附件文件;此操作不可撤销。
      </p>
      <form method="post" action="/projects/<%= project.id %>/records/<%= record.id %>/delete"
            onsubmit="return confirm('确定删除此文献条目?所有附件文件也会被一并清除,不可恢复。');"
            class="mt-3">
        <button type="submit"
                class="rounded-lg border border-rose-300 bg-white px-3 py-1.5 text-xs font-medium text-rose-700 hover:bg-rose-100">
          删除条目
        </button>
      </form>
    </div>
  </section>
</div>

<% if (citations) { %>
<script>
  // 把 5 种 style 的字符串内嵌(JSON 转义 — 安全的标量字符串)
  window.__citations__ = <%- JSON.stringify(citations).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %>;
  (function () {
    function showToast(msg) {
      var n = document.createElement('div');
      n.textContent = msg;
      n.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#111827;color:#fff;padding:8px 14px;border-radius:8px;font-size:13px;z-index:9999;box-shadow:0 4px 16px rgba(0,0,0,.18);opacity:0;transition:opacity .15s';
      document.body.appendChild(n);
      requestAnimationFrame(function () { n.style.opacity = '1' });
      setTimeout(function () {
        n.style.opacity = '0';
        setTimeout(function () { n.remove() }, 200);
      }, 1500);
    }
    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy') } catch (e) {}
      ta.remove();
    }
    document.querySelectorAll('button[data-cite]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var style = btn.getAttribute('data-cite');
        var text = (window.__citations__ || {})[style] || '';
        if (!text) { showToast('没有可复制内容'); return }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text)
            .then(function () { showToast('已复制 ' + style.toUpperCase()) })
            .catch(function () { fallbackCopy(text); showToast('已复制 ' + style.toUpperCase()) });
        } else {
          fallbackCopy(text);
          showToast('已复制 ' + style.toUpperCase());
        }
        // 关掉菜单
        var menu = btn.closest('[data-copy-menu]');
        if (menu) {
          var list = menu.querySelector('[data-copy-list]');
          if (list) list.classList.add('hidden');
          var b = menu.querySelector('button[aria-expanded]');
          if (b) b.setAttribute('aria-expanded', 'false');
        }
      });
    });
    // 点空白处收起
    document.addEventListener('click', function (e) {
      document.querySelectorAll('[data-copy-menu]').forEach(function (m) {
        if (!m.contains(e.target)) {
          var l = m.querySelector('[data-copy-list]');
          if (l && !l.classList.contains('hidden')) l.classList.add('hidden');
          var b = m.querySelector('button[aria-expanded]');
          if (b) b.setAttribute('aria-expanded', 'false');
        }
      });
    });
  })();
</script>
<% } %>


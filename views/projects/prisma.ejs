<%- include('../partials/header', { title }) %>
<%- include('partials/project-header', { project }) %>

<%
  // status 徽章配色
  function statusBadge(st) {
    switch (st) {
      case 'done':           return ['bg-emerald-100 text-emerald-700', '已完成']
      case 'in_progress':    return ['bg-amber-100 text-amber-700',     '进行中']
      case 'not_applicable': return ['bg-slate-100 text-slate-500',     '不适用']
      default:               return ['bg-slate-100 text-slate-500',     '未开始']
    }
  }
  // section → 中文
  const sectionLabel = {
    Title: '标题(Title)',
    Abstract: '摘要(Abstract)',
    Introduction: '引言(Introduction)',
    Methods: '方法(Methods)',
    Results: '结果(Results)',
    Discussion: '讨论(Discussion)',
    Other: '其他(Other)',
  }
  // workflow_step → 中文 + step 序号
  const stepLabelMap = {}
  const stepIdxMap = {}
  ;(workflowSteps || []).forEach((s, i) => {
    stepLabelMap[s.id] = s.label
    stepIdxMap[s.id] = i + 1
  })
%>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress, currentStep: 'prisma' }) %>

  <section class="space-y-6">
    <!-- 面包屑 -->
    <p class="text-xs text-slate-500">
      PRISMA 2020 · 27 项报告清单(42 entries 含 sub-items)
    </p>

    <!-- 顶部完成度卡片 -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-400">PRISMA 完成度</p>
          <p class="mt-1 text-3xl font-semibold tracking-tight">
            <%= totals.done %><span class="text-base font-normal text-slate-400">/<%= totals.total %></span>
            <span class="ml-2 text-base font-mono text-emerald-600"><%= totals.donePct %>%</span>
          </p>
        </div>
        <a href="/projects/<%= project.id %>/prisma/export.md"
           class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 hover:border-slate-400 hover:bg-slate-50">
          ⬇ 导出 Markdown
        </a>
      </div>

      <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-slate-100">
        <div class="h-full bg-emerald-500" style="width: <%= totals.donePct %>%"></div>
      </div>

      <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
        <div class="rounded-lg bg-emerald-50 px-3 py-2">
          <dt class="text-xs text-emerald-700">已完成</dt>
          <dd class="font-mono text-lg text-emerald-700"><%= totals.done %></dd>
        </div>
        <div class="rounded-lg bg-amber-50 px-3 py-2">
          <dt class="text-xs text-amber-700">进行中</dt>
          <dd class="font-mono text-lg text-amber-700"><%= totals.in_progress %></dd>
        </div>
        <div class="rounded-lg bg-slate-50 px-3 py-2">
          <dt class="text-xs text-slate-600">未开始</dt>
          <dd class="font-mono text-lg text-slate-700"><%= totals.not_started %></dd>
        </div>
        <div class="rounded-lg bg-slate-50 px-3 py-2">
          <dt class="text-xs text-slate-600">不适用</dt>
          <dd class="font-mono text-lg text-slate-700"><%= totals.not_applicable %></dd>
        </div>
      </dl>
    </div>

    <!-- 一键标记 step 的按钮组 -->
    <details class="rounded-2xl border border-slate-200 bg-white">
      <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium text-slate-800 hover:bg-slate-50">
        ⚡ 按 workflow step 批量标记
      </summary>
      <div class="border-t border-slate-200 p-4">
        <p class="mb-3 text-xs text-slate-500">完成某个 step 后,可在这里一键把它涵盖的所有 PRISMA item 标为"完成"。</p>
        <div class="grid gap-2 sm:grid-cols-2">
          <% (workflowSteps || []).forEach((s) => {
               const st = stepStats[s.id] || { total: 0, done: 0 }
          %>
            <form action="/projects/<%= project.id %>/prisma/bulk-mark-step" method="post"
                  class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 px-3 py-2">
              <input type="hidden" name="workflow_step" value="<%= s.id %>">
              <input type="hidden" name="status" value="done">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-slate-800"><%= s.label %></p>
                <p class="text-xs text-slate-500"><%= st.done %>/<%= st.total %> 已完成</p>
              </div>
              <button type="submit"
                      class="flex-none rounded-md bg-emerald-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-emerald-700">
                标记完成
              </button>
            </form>
          <% }) %>
        </div>
      </div>
    </details>

    <!-- 7 个 section 折叠区 -->
    <% groups.forEach((g) => { %>
      <details class="rounded-2xl border border-slate-200 bg-white" open>
        <summary class="cursor-pointer select-none px-5 py-3 hover:bg-slate-50">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="text-base font-semibold text-slate-900"><%= sectionLabel[g.name] || g.name %></span>
              <span class="ml-2 text-xs text-slate-500"><%= g.items.length %> 项</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-emerald-700"><%= g.done %>/<%= g.total %></span>
              <div class="h-1.5 w-24 overflow-hidden rounded-full bg-slate-100">
                <div class="h-full bg-emerald-500" style="width: <%= g.donePct %>%"></div>
              </div>
            </div>
          </div>
        </summary>

        <div class="divide-y divide-slate-100 border-t border-slate-200">
          <% g.items.forEach((it) => {
               const [badgeCls, badgeText] = statusBadge(it.status)
               // 默认展开:未完成 / 进行中;done & not_applicable 默认折叠
               const collapsedByDefault = (it.status === 'done' || it.status === 'not_applicable')
               const stepIdx = stepIdxMap[it.workflow_step]
               const stepLabel = stepLabelMap[it.workflow_step] || it.workflow_step
          %>
            <div id="item-<%= it.item_number %>" class="p-5">
              <div class="flex flex-wrap items-start gap-3">
                <span class="flex h-8 min-w-8 flex-none items-center justify-center rounded-full bg-slate-100 px-2 text-xs font-semibold text-slate-700">
                  <%= it.item_number %>
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-sm font-semibold text-slate-900"><%= it.topic %></h3>
                    <span class="rounded-full px-2 py-0.5 text-[10px] <%= badgeCls %>"><%= badgeText %></span>
                    <% if (it.workflow_step) { %>
                      <a href="/projects/<%= project.id %>/<%= it.workflow_step %>"
                         class="rounded-full bg-blue-50 px-2 py-0.5 text-[10px] text-blue-700 hover:bg-blue-100">
                        → Step <%= stepIdx %> · <%= stepLabel %>
                      </a>
                    <% } %>
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-slate-600"><%= it.recommendation %></p>
                </div>
              </div>

              <details class="mt-3" <%= collapsedByDefault ? '' : 'open' %>>
                <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-800">
                  <%= it.notes || it.evidence_url ? '展开 / 编辑' : '记录状态与证据' %>
                </summary>

                <form action="/projects/<%= project.id %>/prisma/item/<%= encodeURIComponent(it.item_number) %>"
                      method="post"
                      class="mt-3 space-y-3 rounded-xl bg-slate-50 p-4">
                  <fieldset>
                    <legend class="mb-1 text-xs font-medium text-slate-700">状态</legend>
                    <div class="flex flex-wrap gap-3 text-sm">
                      <% ['not_started','in_progress','done','not_applicable'].forEach((opt) => {
                           const labels = { not_started: '未开始', in_progress: '进行中', done: '已完成', not_applicable: '不适用' }
                      %>
                        <label class="inline-flex items-center gap-1.5">
                          <input type="radio" name="status" value="<%= opt %>"
                                 <%= it.status === opt ? 'checked' : '' %>>
                          <span><%= labels[opt] %></span>
                        </label>
                      <% }) %>
                    </div>
                  </fieldset>

                  <div>
                    <label class="block text-xs font-medium text-slate-700">备注 / 完成说明</label>
                    <textarea name="notes" rows="2" maxlength="5000"
                              placeholder="例:已在 protocol v2 写明,经 PI 审阅"
                              class="mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm focus:border-slate-500 focus:outline-none"><%= it.notes || '' %></textarea>
                  </div>

                  <div>
                    <label class="block text-xs font-medium text-slate-700">证据链接</label>
                    <input type="text" name="evidence_url" maxlength="1000"
                           value="<%= it.evidence_url || '' %>"
                           placeholder="例:/projects/<%= project.id %>/protocol 或外部 URL"
                           class="mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm font-mono focus:border-slate-500 focus:outline-none">
                  </div>

                  <div class="flex items-center justify-between gap-3 text-xs text-slate-400">
                    <span>最后更新:<%- include('../partials/_time', { value: it.updated_at }) %></span>
                    <button type="submit"
                            class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-slate-700">
                      保存
                    </button>
                  </div>
                </form>
              </details>
            </div>
          <% }) %>
        </div>
      </details>
    <% }) %>

    <% if (groups.length === 0) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
        本项目尚未种入 PRISMA 清单。请联系管理员或重新创建项目。
      </div>
    <% } %>

  </section>
</div>

<%- include('../partials/footer') %>

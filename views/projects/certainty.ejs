<%- include('../partials/header', { title: project.title + ' · 证据强度' }) %>
<%- include('partials/project-header', { project }) %>

<div class="grid gap-6 lg:grid-cols-[260px_1fr]">
  <%- include('partials/stepper', { project, progress, currentStep: 'certainty' }) %>

  <section class="space-y-6 min-w-0">
    <%- include('partials/step-banner', {
      stepNum: 7,
      stepTitle: '证据有多可信',
      stepIntro: '对每个主题里的结局指标(outcome)用 GRADE 五维度打分:研究内偏倚 / 不一致性 / 间接性 / 不精确性 / 发表偏倚。AI 给初评,你审阅 + 调整。导出 Summary of Findings 表给审稿人看。',
      prismaItems: (stepItems || []).map((it) => `#${it.item_number}`).join(' · '),
    }) %>

    <!-- 顶部操作 / 导出 -->
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-card">
      <div>
        <p class="text-sm font-medium text-slate-800">Summary of Findings</p>
        <p class="text-xs text-slate-500 mt-0.5">每个 outcome 一行,5 维度评级 + 最终 4 档 certainty</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/projects/<%= project.id %>/certainty/sof.md"
           class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50 shadow-subtle">
          导出 Markdown
        </a>
        <a href="/projects/<%= project.id %>/certainty/sof.csv"
           class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50 shadow-subtle">
          导出 CSV (Excel)
        </a>
      </div>
    </div>

    <% if (themes.length === 0) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white/60 p-10 text-center">
        <p class="text-2xl mb-2">🌱</p>
        <p class="text-sm text-slate-500">还没有主题。先去 Step 6 跑主题聚类。</p>
        <a href="/projects/<%= project.id %>/synthesis"
           class="mt-3 inline-block rounded-md bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-700">
          ← 回到主题聚类
        </a>
      </div>
    <% } else { %>
      <!-- 每个 theme 一张卡片 -->
      <% themes.forEach((theme) => {
           const tAssessments = assessmentsByTheme[theme.id] || []
      %>
        <div id="theme-<%= theme.id %>" class="rounded-2xl border border-slate-200 bg-white shadow-card overflow-hidden">
          <!-- theme header -->
          <div class="flex items-start justify-between gap-3 border-b border-slate-200 bg-slate-50/60 px-5 py-3.5">
            <div class="min-w-0 flex-1">
              <h3 class="text-base font-semibold text-slate-900"><%= theme.name %></h3>
              <% if (theme.description) { %>
                <p class="mt-0.5 text-xs text-slate-500"><%= theme.description %></p>
              <% } %>
              <p class="mt-1 text-[11px] text-slate-400">
                <%= (theme.supporting_record_ids || []).length %> 篇支撑研究 · <%= tAssessments.length %> 个 outcome 已评
              </p>
            </div>
            <div class="flex flex-none gap-2">
              <form method="post" action="/projects/<%= project.id %>/certainty/ai-suggest/<%= theme.id %>"
                    onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='AI 评估中…';">
                <button type="submit"
                        class="rounded-md bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700 disabled:bg-slate-500 disabled:cursor-wait shadow-subtle">
                  让 AI 评估
                </button>
              </form>
              <details class="relative">
                <summary class="cursor-pointer rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50">+ 手动新增</summary>
                <form method="post" action="/projects/<%= project.id %>/certainty/manual-add/<%= theme.id %>"
                      class="absolute right-0 mt-1 z-10 w-72 rounded-lg border border-slate-200 bg-white p-3 shadow-hover">
                  <p class="text-xs text-slate-500 mb-2">结局指标名(如:学习成绩 / 学生参与度)</p>
                  <input name="outcome_label" required maxlength="200"
                         class="w-full rounded-md border-slate-300 px-2 py-1 text-sm">
                  <button type="submit" class="mt-2 w-full rounded-md bg-slate-900 px-3 py-1.5 text-xs text-white">新增</button>
                </form>
              </details>
            </div>
          </div>

          <!-- assessments(outcomes) -->
          <% if (tAssessments.length === 0) { %>
            <div class="px-5 py-6 text-center text-sm text-slate-400">
              这个主题还没有 outcome 评估。点上方"让 AI 评估"或"手动新增"开始。
            </div>
          <% } else { %>
            <% tAssessments.forEach((a) => {
                 const cMap = {
                   high:     ['bg-emerald-100 text-emerald-700 border-emerald-300', '高 ⊕⊕⊕⊕'],
                   moderate: ['bg-blue-100 text-blue-700 border-blue-300',          '中 ⊕⊕⊕○'],
                   low:      ['bg-amber-100 text-amber-700 border-amber-300',      '低 ⊕⊕○○'],
                   very_low: ['bg-rose-100 text-rose-700 border-rose-300',         '极低 ⊕○○○'],
                 }
                 const [cClass, cText] = cMap[a.effective_certainty] || ['bg-slate-100 text-slate-500 border-slate-300', '未评']
            %>
              <div id="grade-<%= a.id %>" class="border-t border-slate-100 px-5 py-4">
                <form method="post" action="/projects/<%= project.id %>/certainty/<%= a.id %>/edit" class="space-y-3">
                  <!-- 顶部行 -->
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="flex-1 min-w-0">
                      <input name="outcome_label" value="<%= a.outcome_label %>" maxlength="200"
                             class="w-full max-w-md rounded-md border-slate-300 px-2 py-1 text-sm font-semibold">
                      <p class="text-[11px] text-slate-400 mt-0.5">
                        生成方式:<%= a.generated_by === 'ai' ? 'AI 提议' : (a.generated_by === 'ai_edited' ? 'AI 提议(已人工编辑)' : '人工创建') %>
                        <% if (a.model) { %> · <%= a.model %><% } %>
                      </p>
                    </div>
                    <div class="flex-none">
                      <div class="rounded-md border <%= cClass %> px-3 py-1.5 text-xs font-medium text-center">
                        <%= cText %>
                      </div>
                      <% if (a.final_manual_override) { %>
                        <p class="text-[10px] text-slate-400 mt-0.5 text-center">🔒 人工锁定</p>
                      <% } else { %>
                        <p class="text-[10px] text-slate-400 mt-0.5 text-center">自动计算</p>
                      <% } %>
                    </div>
                  </div>

                  <!-- 描述 -->
                  <div>
                    <label class="text-[11px] text-slate-500">描述</label>
                    <input name="outcome_description" value="<%= a.outcome_description || '' %>" maxlength="500"
                           placeholder="这个 outcome 衡量什么(≤40 字)"
                           class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-sm">
                  </div>

                  <!-- 起始 + 重要性 + 计数 -->
                  <div class="grid gap-2 sm:grid-cols-4">
                    <label class="text-xs">
                      <span class="text-slate-500">起始等级</span>
                      <select name="starting_certainty" class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-sm">
                        <% constants.CERTAINTY_LEVELS.slice().reverse().forEach((lv) => { %>
                          <option value="<%= lv %>" <%= a.starting_certainty === lv ? 'selected' : '' %>>
                            <%= constants.GRADE_LABELS.certainty[lv] %>
                          </option>
                        <% }) %>
                      </select>
                    </label>
                    <label class="text-xs">
                      <span class="text-slate-500">重要性</span>
                      <select name="importance" class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-sm">
                        <% constants.IMPORTANCE_ENUM.forEach((lv) => { %>
                          <option value="<%= lv %>" <%= a.importance === lv ? 'selected' : '' %>><%= lv %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label class="text-xs">
                      <span class="text-slate-500">研究数 (n studies)</span>
                      <input name="num_studies" type="number" min="0" value="<%= a.num_studies ?? '' %>"
                             class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-sm">
                    </label>
                    <label class="text-xs">
                      <span class="text-slate-500">参与者总数</span>
                      <input name="num_participants" type="number" min="0" value="<%= a.num_participants ?? '' %>"
                             class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-sm">
                    </label>
                  </div>

                  <!-- 5 维度 -->
                  <details class="rounded-md border border-slate-200 bg-slate-50/50 p-3" open>
                    <summary class="cursor-pointer text-xs font-medium text-slate-700">
                      5 个下调维度(GRADE)
                    </summary>
                    <div class="mt-3 space-y-2">
                      <% constants.DOMAIN_META.forEach((dom) => {
                           const isPubBias = dom.key === 'publication_bias'
                           const enumList = isPubBias ? constants.PUB_BIAS_ENUM : constants.DOWNGRADE_ENUM
                           const labels   = isPubBias ? constants.GRADE_LABELS.publication_bias : constants.GRADE_LABELS.downgrade
                      %>
                        <div class="grid gap-2 sm:grid-cols-[180px_140px_1fr] items-start">
                          <div>
                            <p class="text-xs font-medium text-slate-700"><%= dom.label %></p>
                            <p class="text-[10px] text-slate-400"><%= dom.desc %></p>
                          </div>
                          <select name="<%= dom.key %>" class="rounded-md border-slate-300 px-2 py-1 text-xs">
                            <% enumList.forEach((v) => { %>
                              <option value="<%= v %>" <%= a[dom.key] === v ? 'selected' : '' %>><%= labels[v] %></option>
                            <% }) %>
                          </select>
                          <input name="rationales.<%= dom.key %>"
                                 value="<%= (a.rationales && a.rationales[dom.key]) || '' %>"
                                 maxlength="300"
                                 placeholder="为啥这么评(≤50 字)"
                                 class="rounded-md border-slate-300 px-2 py-1 text-xs">
                        </div>
                      <% }) %>
                    </div>
                  </details>

                  <!-- 升级因素(观察性专用) -->
                  <details class="rounded-md border border-slate-200 bg-slate-50/30 p-3">
                    <summary class="cursor-pointer text-xs font-medium text-slate-700">
                      升级因素(观察性研究专用)
                    </summary>
                    <div class="mt-3 grid gap-2 sm:grid-cols-3 items-start">
                      <label class="text-xs">
                        <span class="text-slate-500">效应量大小</span>
                        <select name="large_effect" class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-xs">
                          <% constants.UPGRADE_LARGE_EFFECT_ENUM.forEach((v) => { %>
                            <option value="<%= v %>" <%= a.large_effect === v ? 'selected' : '' %>><%= constants.GRADE_LABELS.large_effect[v] %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label class="text-xs flex items-center gap-2 mt-4">
                        <input type="checkbox" name="dose_response" value="1" <%= a.dose_response ? 'checked' : '' %>>
                        剂量-反应关系存在 (+1)
                      </label>
                      <label class="text-xs">
                        <span class="text-slate-500">残留混杂</span>
                        <select name="plausible_confounding" class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-xs">
                          <% constants.UPGRADE_PLAUSIBLE_CONF_ENUM.forEach((v) => { %>
                            <option value="<%= v %>" <%= a.plausible_confounding === v ? 'selected' : '' %>><%= constants.GRADE_LABELS.plausible_confounding[v] %></option>
                          <% }) %>
                        </select>
                      </label>
                    </div>
                  </details>

                  <!-- SoF 字段 -->
                  <div class="grid gap-2 sm:grid-cols-2">
                    <label class="text-xs sm:col-span-2">
                      <span class="text-slate-500">Summary of Findings(一句话总结,给 SoF 表)</span>
                      <input name="summary_of_findings" value="<%= a.summary_of_findings || '' %>" maxlength="500"
                             placeholder="对这个 outcome 现有证据告诉我们什么(≤80 字)"
                             class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-sm">
                    </label>
                    <label class="text-xs">
                      <span class="text-slate-500">效应量描述</span>
                      <input name="effect_size_text" value="<%= a.effect_size_text || '' %>" maxlength="200"
                             placeholder="RR 1.35 (95% CI 1.10–1.65) 或 narrative: 一致正向"
                             class="mt-0.5 w-full rounded-md border-slate-300 px-2 py-1 text-sm font-mono">
                    </label>
                    <div class="text-[10px] text-slate-400 self-end">
                      自动计算步骤:<br>
                      <% (a.computed_steps || []).forEach((s) => { %><span class="font-mono"><%= s %></span><br><% }) %>
                    </div>
                  </div>

                  <!-- 行动条 -->
                  <div class="flex items-center justify-between gap-3 border-t border-slate-100 pt-3">
                    <button type="submit" class="rounded-md bg-slate-900 px-3 py-1.5 text-xs text-white hover:bg-slate-700 shadow-subtle">
                      保存评估
                    </button>
                    <details class="text-xs">
                      <summary class="cursor-pointer text-slate-500 hover:text-slate-900">人工锁定最终等级 ▾</summary>
                    </details>
                  </div>
                </form>

                <!-- override + delete(独立 form,不和上面合并) -->
                <div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs">
                  <form method="post" action="/projects/<%= project.id %>/certainty/<%= a.id %>/override"
                        class="flex items-center gap-2">
                    <label class="flex items-center gap-1">
                      <input type="checkbox" name="override" value="1" <%= a.final_manual_override ? 'checked' : '' %>>
                      锁定为
                    </label>
                    <select name="final_certainty" class="rounded-md border-slate-300 px-2 py-0.5 text-xs">
                      <% constants.CERTAINTY_LEVELS.slice().reverse().forEach((lv) => { %>
                        <option value="<%= lv %>" <%= a.final_certainty === lv ? 'selected' : '' %>><%= constants.GRADE_LABELS.certainty[lv] %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="rounded-md border border-slate-300 px-2 py-0.5 text-slate-700 hover:bg-slate-100">应用</button>
                  </form>
                  <form method="post" action="/projects/<%= project.id %>/certainty/<%= a.id %>/delete"
                        onsubmit="return confirm('确定删除这个 outcome 评估?')">
                    <button type="submit" class="text-rose-600 hover:text-rose-800">删除此 outcome</button>
                  </form>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      <% }) %>
    <% } %>

  </section>
</div>

<%- include('../partials/footer') %>

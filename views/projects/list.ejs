<%- include('../partials/header', { title }) %>

<section class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Projects</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">研究项目</h1>
      <p class="mt-1 text-sm text-slate-500">每个项目独立维护协议、检索式、文献与综述草稿。</p>
    </div>
    <a href="/projects/new" class="rounded-lg bg-slate-900 px-3 py-2 text-sm text-white hover:bg-slate-700">
      + 新建项目
    </a>
  </div>

  <% if (projects.length === 0) { %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white/60 p-10 text-center">
      <p class="text-base text-slate-600">还没有项目。</p>
      <a href="/projects/new" class="mt-4 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">
        创建第一个研究项目
      </a>
    </div>
  <% } else { %>
    <div class="grid gap-4 md:grid-cols-2">
      <% projects.forEach(p => { %>
        <div class="group relative">
          <a href="/projects/<%= p.id %>" class="block rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-slate-400 hover:shadow-card">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-semibold text-slate-900 pr-10"><%= p.title %></h2>
              <% const statusCfg = ({
                draft: ['bg-slate-100 text-slate-600', '草稿'],
                protocol_pending: ['bg-amber-100 text-amber-700', '待审批'],
                protocol_approved: ['bg-emerald-100 text-emerald-700', '协议已审批'],
                searching: ['bg-blue-100 text-blue-700', '检索中'],
                screening: ['bg-blue-100 text-blue-700', '筛选中'],
                extracting: ['bg-blue-100 text-blue-700', '抽取中'],
                synthesizing: ['bg-blue-100 text-blue-700', '综合中'],
                complete: ['bg-emerald-100 text-emerald-700', '已完成'],
                archived: ['bg-slate-100 text-slate-500', '归档'],
              })[p.status] || ['bg-slate-100 text-slate-600', p.status] %>
              <span class="rounded-full px-2 py-0.5 text-xs <%= statusCfg[0] %>"><%= statusCfg[1] %></span>
            </div>
            <p class="mt-2 line-clamp-3 text-sm text-slate-600"><%= p.topic %></p>
            <div class="mt-3 flex items-center gap-3 text-xs text-slate-400">
              <% if (p.discipline) { %><span><%= p.discipline %></span><% } %>
              <% if (p.year_start || p.year_end) { %><span><%= p.year_start || '?' %>–<%= p.year_end || '?' %></span><% } %>
              <% if (p.approved_version) { %><span>协议 v<%= p.approved_version %> ✓</span>
              <% } else if (p.latest_version) { %><span>协议 v<%= p.latest_version %>(未审批)</span><% } %>
              <span class="ml-auto"><%= p.updated_at %></span>
            </div>
          </a>
          <!-- 删除按钮:hover 卡片才显示,点击不触发卡片链接 -->
          <form method="post" action="/projects/<%= p.id %>/delete"
                onsubmit="return confirm('确认删除项目「<%= p.title %>」?\n该项目的协议、检索式、文献、抽取、主题、综述草稿以及上传的 PDF 都会一并清除,无法撤销。')"
                class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition">
            <button type="submit"
                    title="删除项目"
                    class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-rose-600 hover:bg-rose-50 hover:border-rose-300 shadow-subtle">
              ✕
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>

<%#
  PRISMA Stepper — 左侧固定栏

  Locals:
    project       : { id, ... }
    progress      : getProjectProgress(db, projectId) 返回值
                    { stepStatus: { protocol: {status, summary}, ... }, prismaProgress: { donePct, done, total } }
    currentStep   : 'protocol' | 'search' | 'screening' | 'extraction' | 'rob' | 'synthesis' | 'certainty' | 'report'
%>
<aside class="space-y-3">
  <%
    const steps = [
      { id: 'protocol',   label: '协议',         sub: 'Protocol' },
      { id: 'search',     label: '检索式',       sub: 'Search' },
      { id: 'screening',  label: '筛选',         sub: 'Screening' },
      { id: 'extraction', label: '抽取',         sub: 'Extraction' },
      { id: 'rob',        label: '偏倚风险',     sub: 'Risk of Bias' },
      { id: 'synthesis',  label: '综合',         sub: 'Synthesis' },
      { id: 'certainty',  label: '证据强度',     sub: 'Certainty' },
      { id: 'report',     label: '报告',         sub: 'Report' },
    ]
    const prismaProgress = (progress && progress.prismaProgress) || { donePct: 0, done: 0, total: 42 }
    const stepStatus = (progress && progress.stepStatus) || {}
    function badgeFor(status) {
      switch (status) {
        case 'done':        return ['bg-emerald-100 text-emerald-700', '已完成']
        case 'in_progress': return ['bg-amber-100 text-amber-700',   '进行中']
        case 'locked':      return ['bg-slate-100 text-slate-400',   '🔒 锁定']
        default:            return ['bg-slate-100 text-slate-500',   '未开始']
      }
    }
  %>

  <!-- 顶部 PRISMA 进度条 -->
  <div class="rounded-2xl border border-slate-200 bg-white p-4">
    <div class="flex items-center justify-between text-xs">
      <span class="font-medium uppercase tracking-wider text-slate-400">PRISMA 2020</span>
      <span class="font-mono text-slate-600"><%= prismaProgress.donePct %>%</span>
    </div>
    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
      <div class="h-full bg-emerald-500" style="width: <%= prismaProgress.donePct %>%"></div>
    </div>
    <p class="mt-2 text-xs text-slate-500"><%= prismaProgress.done %>/<%= prismaProgress.total %> 项已完成</p>
  </div>

  <!-- 8 个 step 卡片 -->
  <nav class="space-y-2">
    <% steps.forEach((s, idx) => {
         const st = stepStatus[s.id] || { status: 'not_started', summary: '' }
         const isCurrent = (currentStep === s.id)
         const isLocked  = (st.status === 'locked')
         const [badgeCls, badgeText] = badgeFor(st.status)
         const baseCls = isCurrent
           ? 'border-l-4 border-blue-500 bg-blue-50/60'
           : 'border border-slate-200 bg-white hover:border-slate-300'
         const numCls = st.status === 'done'
           ? 'bg-emerald-500 text-white'
           : (isCurrent ? 'bg-blue-500 text-white' : (isLocked ? 'bg-slate-200 text-slate-400' : 'bg-slate-100 text-slate-600'))
         const href = `/projects/${project.id}/${s.id}`
    %>
      <% if (isLocked) { %>
        <div class="<%= baseCls %> flex cursor-not-allowed items-start gap-3 rounded-xl p-3 opacity-70">
      <% } else { %>
        <a href="<%= href %>" class="<%= baseCls %> flex items-start gap-3 rounded-xl p-3 transition">
      <% } %>
        <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full text-xs font-semibold <%= numCls %>">
          <%= idx + 1 %>
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between gap-2">
            <p class="truncate text-sm font-medium <%= isCurrent ? 'text-blue-900' : 'text-slate-800' %>">
              <%= s.label %>
            </p>
            <span class="flex-none rounded-full px-2 py-0.5 text-[10px] <%= badgeCls %>"><%= badgeText %></span>
          </div>
          <p class="mt-0.5 truncate text-[11px] text-slate-500"><%= st.summary || s.sub %></p>
        </div>
      <% if (isLocked) { %>
        </div>
      <% } else { %>
        </a>
      <% } %>
    <% }) %>
  </nav>
</aside>

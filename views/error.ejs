<%- include('partials/header', { title }) %>

<section class="rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm">
  <h1 class="text-2xl font-semibold tracking-tight"><%= title %></h1>
  <p class="mt-3 text-sm text-slate-600"><%= message %></p>
  <% const _rid = (typeof requestId !== 'undefined' && requestId) ? requestId : (locals.requestId || null) %>
  <% if (_rid) { %>
    <p class="mt-2 text-xs text-slate-400">请求编号 / Request ID: <code class="font-mono"><%= _rid %></code>(反馈问题时请附上)</p>
  <% } %>
  <a href="/" class="mt-6 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">
    返回首页
  </a>
</section>

<%- include('partials/footer') %>

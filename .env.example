# SLR Copilot — environment template
# 本地开发可以拷贝为 .env;生产环境对应 /etc/slr.env(root 写,640 root:slr)

NODE_ENV=production
PORT=3001

# 数据目录(生产建议 /var/lib/slr)
DATA_DIR=/var/lib/slr
DB_PATH=/var/lib/slr/db/slr.db

# Session
# 生成:openssl rand -hex 32
SESSION_SECRET=change-me-with-openssl-rand-hex-32
COOKIE_SECURE=true

# 数据库里凭证(API key / OAuth blob)的加密主密钥
# 必须 32 字节 = 64 hex 字符。生成:openssl rand -hex 32
ENCRYPTION_KEY=change-me-with-openssl-rand-hex-32

# 首次启动 bootstrap 一个 admin(仅在 users 表为空时生效)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-min-10-chars

# Claude Code CLI(headless 模式)
# 凭证目录:slr 用户的 HOME 指向这里,登录后 .claude/ 落在内部
CLAUDE_BIN=/usr/local/bin/claude
CLAUDE_HOME=/var/lib/slr/claude-home
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5
